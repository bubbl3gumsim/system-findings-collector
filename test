function Step-ACScript {
    Section "Anti-Cheat Recorder Script"
    $url = "https://raw.githubusercontent.com/hwnd/updatedac/refs/heads/master/acrec.ps1"
    Write-Host "This runs a remote script with admin rights: irm '$url' | iex" -ForegroundColor Red
    Write-Host "Confirm your league has reviewed the current contents of this URL." -ForegroundColor Red
    Read-Host "Press Enter to run it now (must be visible on your recording)"
    powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "irm '$url' | iex"
    Pause-ForCamera "Confirm the script ran and finished."
