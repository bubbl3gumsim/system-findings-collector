# =========================================================================
# ALWAYS-ON SECOND MONITOR WATCHDOG
# =========================================================================
# Polls display count every 5s for the whole session. It does not interrupt
# you mid-step; it records every change to a log and raises a flag that is
# surfaced at the next checkpoint and in the final findings package.
$global:MonitorLog       = [System.Collections.ArrayList]::new()
$global:MonitorAlert     = $false
$global:MonitorBaseline  = 1
$global:MonitorTimer     = $null

function Get-ActiveDisplayCount {
    try {
        Add-Type -AssemblyName System.Windows.Forms -ErrorAction SilentlyContinue
        $n = [System.Windows.Forms.Screen]::AllScreens.Count
        if ($n -ge 1) { return $n }
    } catch {}
    try {
        return @(Get-CimInstance Win32_DesktopMonitor -ErrorAction SilentlyContinue |
            Where-Object { $_.Availability -eq 3 }).Count
    } catch {}
    return 1
}

function Get-DisplayDetail {
    $rows = @()
    try {
        Add-Type -AssemblyName System.Windows.Forms -ErrorAction SilentlyContinue
        foreach ($s in [System.Windows.Forms.Screen]::AllScreens) {
            $rows += [PSCustomObject]@{
                DeviceName = $s.DeviceName
                Primary    = $s.Primary
                Bounds     = "$($s.Bounds.Width)x$($s.Bounds.Height) @ $($s.Bounds.X),$($s.Bounds.Y)"
            }
        }
    } catch {}
    return $rows
}

function Start-MonitorWatchdog {
    $global:MonitorBaseline = Get-ActiveDisplayCount
    [void]$global:MonitorLog.Add(("[{0}] Watchdog started. Baseline display count: {1}" -f (Get-Date -Format "HH:mm:ss"), $global:MonitorBaseline))

    $global:MonitorTimer = New-Object System.Timers.Timer
    $global:MonitorTimer.Interval = 5000
    $global:MonitorTimer.AutoReset = $true

    Register-ObjectEvent -InputObject $global:MonitorTimer -EventName Elapsed -SourceIdentifier "MonitorWatch" -Action {
        try {
            $count = Get-ActiveDisplayCount
            if ($count -ne $global:MonitorBaseline) {
                $stamp = Get-Date -Format "HH:mm:ss"
                [void]$global:MonitorLog.Add("[$stamp] DISPLAY COUNT CHANGED: $($global:MonitorBaseline) -> $count")
                if ($count -gt 1) { $global:MonitorAlert = $true }
                $global:MonitorBaseline = $count
            }
        } catch {}
    } | Out-Null

    $global:MonitorTimer.Start()
}

function Stop-MonitorWatchdog {
    try {
        if ($global:MonitorTimer) { $global:MonitorTimer.Stop(); $global:MonitorTimer.Dispose() }
        Unregister-Event -SourceIdentifier "MonitorWatch" -ErrorAction SilentlyContinue
    } catch {}
}

function Show-MonitorAlertIfAny {
    if ($global:MonitorAlert) {
        Write-Host ""
        Write-Host "!! SECOND DISPLAY DETECTED DURING THIS SESSION !!" -ForegroundColor Red
        Write-Host "   This was logged and will appear in your findings package." -ForegroundColor Red
        Write-Host "   Unplug the extra display now and explain it on camera." -ForegroundColor Red
        Write-Host ""
        $global:MonitorAlert = $false
    }
}

function Assert-SingleDisplay {
    while ($true) {
        $count = Get-ActiveDisplayCount
        if ($count -le 1) {
            Write-Host "Single display confirmed." -ForegroundColor Green
            return
        }
        Write-Host ""
        Write-Host "$count active displays detected. Only ONE is allowed." -ForegroundColor Red
        Get-DisplayDetail | ForEach-Object {
            Write-Host ("  - {0} {1} {2}" -f $_.DeviceName, $_.Bounds, $(if ($_.Primary) { "(primary)" } else { "" })) -ForegroundColor Red
        }
        Write-Host "Unplug / disable the extra display(s), then press Enter to re-check." -ForegroundColor Yellow
        Read-Host "Press Enter to re-check"
    }
}

