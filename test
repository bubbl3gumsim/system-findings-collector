)

$MalwarebytesOfficialDirs = @(
    "$env:ProgramFiles\Malwarebytes",
    "${env:ProgramFiles(x86)}\Malwarebytes",
    "$env:ProgramData\Malwarebytes"
)

# SHA256 of the official Anti-Malware binaries supplied by the league.
# Version-specific: a mismatch is NOT automatically bad (Malwarebytes updates
# often), it just means "not the exact build we have on file" and is reported.
$MalwarebytesKnownHashes = @{
