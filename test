function Pause-ForCamera($msg, $prompt = "Press Enter once this is shown on your recording") {
    Write-Host $msg -ForegroundColor $theme.Accent
    Read-Host $prompt
}

function Get-SizeMB($path) {
    try {
        if ($path -and (Test-Path -LiteralPath $path)) {
            return [math]::Round((Get-Item -LiteralPath $path -ErrorAction Stop).Length / 1MB, 3)
        }
    } catch {}
    return $null
}

function Write-Typewriter($text, $color, $delayMs = 6) {
    foreach ($ch in $text.ToCharArray()) {
        Write-Host -NoNewline $ch -ForegroundColor $color
        Start-Sleep -Milliseconds $delayMs
    }
    Write-Host ""
}

function Show-LoadingBar($label, $color, $steps = 24, $delayMs = 20) {
    Write-Host -NoNewline "$label " -ForegroundColor $color
    Write-Host -NoNewline "[" -ForegroundColor DarkGray
    for ($i = 0; $i -lt $steps; $i++) {
        Start-Sleep -Milliseconds $delayMs
        Write-Host -NoNewline "#" -ForegroundColor $color
    }
    Write-Host "] READY" -ForegroundColor $color
}

function Write-BoxLine($text, $color, $width = 66) {
    $pad = $width - $text.Length
    $left = [math]::Floor($pad / 2)
    $right = $pad - $left
    Write-Host ("  |" + (" " * $left) + $text + (" " * $right) + "|") -ForegroundColor $color
}

function Get-ActiveDisplayCount {
    try {
        Add-Type -AssemblyName System.Windows.Forms -ErrorAction SilentlyContinue
        $n = [System.Windows.Forms.Screen]::AllScreens.Count
        if ($n -ge 1) { return $n }
    } catch {}
    return 1
}

