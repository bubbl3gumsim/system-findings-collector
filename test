}

# =========================================================================
# FINDINGS COLLECTOR
# =========================================================================
function Invoke-FindingsCollector {
    Section "Findings Collection"

    $collector = {
        param($ExcludedReport, $CloseLog, $DuplicateReport, $MonitorLog, $MbVerified, $MbRejected, $RecorderFamily, $MossVerified, $MossRejected)

        $desktop = [Environment]::GetFolderPath('Desktop')
        $stamp   = Get-Date -Format "yyyy-MM-dd_HH-mm-ss"
        $temp    = Join-Path $env:TEMP "findings_$stamp"
        New-Item -ItemType Directory -Path $temp -Force | Out-Null

        function Save($name, $scriptblock) {
            $path = Join-Path $temp "$name.txt"
            try { (& $scriptblock) | Out-String -Width 500 | Set-Content -Path $path -Encoding UTF8 }
            catch { "ERROR: $_" | Set-Content -Path $path -Encoding UTF8 }
        }

        function SaveCsv($name, $data) {
            $path = Join-Path $temp "$name.csv"
            try {
                if ($data) { $data | Export-Csv -Path $path -NoTypeInformation -Encoding UTF8 }
                else { "no rows" | Set-Content -Path $path -Encoding UTF8 }
            } catch { "ERROR: $_" | Set-Content -Path $path -Encoding UTF8 }
        }

        function SizeMB($p) {
            try { if ($p -and (Test-Path -LiteralPath $p)) { return [math]::Round((Get-Item -LiteralPath $p).Length / 1MB, 3) } } catch {}
            return $null
        }

        Save "01_process_parentage" {
            $parentMap = @{}
            Get-Process | ForEach-Object { $parentMap[$_.Id] = $_.Name }
            Get-CimInstance Win32_Process | Select-Object Name, ProcessId, ParentProcessId,
                @{n='ParentName';e={ if ($parentMap.ContainsKey([int]$_.ParentProcessId)) { $parentMap[[int]$_.ParentProcessId] } else { $null } }},
                @{n='SizeMB';e={ SizeMB $_.ExecutablePath }},
                ExecutablePath, CommandLine
        }

        Save "02_process_details" {
            Get-CimInstance Win32_Process | ForEach-Object {
                [PSCustomObject]@{
                    ProcessId = $_.ProcessId; Name = $_.Name; ExecutablePath = $_.ExecutablePath
                    SizeMB = SizeMB $_.ExecutablePath
                    WorkingSetMB = [math]::Round($_.WorkingSetSize / 1MB, 2)
                    CommandLine = $_.CommandLine
                }
            } | Format-List
        }

        Save "03_systeminfo_virtualization" { systeminfo | findstr /i "hyper os version page virtualization boot" }
        Save "04_scheduled_tasks" { Get-ScheduledTask | Select-Object TaskPath, TaskName, State, Author }
        Save "05_tasklist" { tasklist /v }

        Save "06_process_starttimes" {
            Get-Process | ForEach-Object {
                $p = $null; try { $p = $_.Path } catch {}
                $st = $null; try { $st = $_.StartTime } catch {}
                [PSCustomObject]@{ Name = $_.Name; PID = $_.Id; StartTime = $st; SizeMB = SizeMB $p; Path = $p }
            } | Sort-Object StartTime -Descending
        }

        Save "07_services_all" {
            Get-CimInstance Win32_Service | ForEach-Object {
                $bin = $_.PathName; $exe = $null
                if ($bin) {
                    if ($bin -match '^"([^"]+)"') { $exe = $matches[1] }
                    elseif ($bin -match '^(\S+\.exe)') { $exe = $matches[1] }
                }
                [PSCustomObject]@{
                    Name = $_.Name; DisplayName = $_.DisplayName; State = $_.State
                    StartMode = $_.StartMode; ProcessId = $_.ProcessId; SizeMB = SizeMB $exe; PathName = $bin
                }
            } | Sort-Object State, Name
        }

        Save "08_background_services" {
            Get-Service | Where-Object { $_.Status -eq 'Running' } | Select-Object Name, DisplayName, Status
        }

        Save "09_duplicate_processes" {
            if (-not $DuplicateReport -or $DuplicateReport.Count -eq 0) {
                "No process had more than one running instance at cleanup time."
            } else {
                "Processes observed with more than one instance running."
                "Multiple instances are normal for browsers/Discord/svchost, but are listed"
                "here so a reviewer can spot an unexpected second copy of something."
                ""
                $DuplicateReport | Sort-Object Name, PID | Format-Table -AutoSize Name, InstanceCount, PID, SizeMB, StartTime, Whitelisted, Path
            }
        }
        SaveCsv "09_duplicate_processes" $DuplicateReport

        Save "10_excluded_from_closing" {
            "Processes deliberately NOT closed, with the reason each was spared."
            "Recorder family in use: $RecorderFamily"
            ""
            $ExcludedReport | Sort-Object Reason, Name | Format-Table -AutoSize Name, PID, SizeMB, Signature, Reason, Path
            ""
            "--- full paths ---"
            $ExcludedReport | Sort-Object Name | ForEach-Object {
                "{0} (PID {1})`n    path      : {2}`n    size      : {3} MB`n    signature : {4}`n    publisher : {5}`n    reason    : {6}`n" -f `
                    $_.Name, $_.PID, $_.Path, $_.SizeMB, $_.Signature, $_.Publisher, $_.Reason
            }
        }
        SaveCsv "10_excluded_from_closing" $ExcludedReport

        $failed = @($CloseLog | Where-Object { $_.Status -notlike "Closed*" })
        Save "11_failed_to_close" {
            if ($failed.Count -eq 0) {
                "Every non-excluded process was closed successfully."
            } else {
                "These processes survived the cleanup stage and were still running."
                ""
                $failed | Format-Table -AutoSize Name, PID, SizeMB, Signed, Status, Path
                ""
                "--- full paths ---"
                $failed | ForEach-Object {
                    "{0} (PID {1})`n    path   : {2}`n    size   : {3} MB`n    signed : {4}`n    status : {5}`n    notes  : {6}`n" -f `
                        $_.Name, $_.PID, $_.Path, $_.SizeMB, $_.Signed, $_.Status, $_.Notes
                }
            }
        }
        SaveCsv "11_failed_to_close" $failed
        SaveCsv "12_closed_processes" $CloseLog

        Save "13_network_connections" { netstat -anob }

        Save "14_driver_list" {
            Get-CimInstance Win32_SystemDriver | ForEach-Object {
                $p = $_.PathName
                if ($p) { $p = $p -replace '^\\\?\?\\', '' }
                $sig = $null
                try { if ($p -and (Test-Path -LiteralPath $p)) { $sig = (Get-AuthenticodeSignature -FilePath $p -ErrorAction Stop).Status } } catch {}
                [PSCustomObject]@{
                    Name = $_.Name; State = $_.State; StartMode = $_.StartMode
                    SizeMB = SizeMB $p; Signature = $sig; PathName = $p
                }
            } | Sort-Object State, Name
        }

        $pfPaths = @($env:ProgramFiles, ${env:ProgramFiles(x86)}) | Where-Object { $_ -and (Test-Path $_) } | Select-Object -Unique
        $pfFiles = Get-ChildItem -Path $pfPaths -Recurse -Include *.exe -ErrorAction SilentlyContinue
        $sizeMap = @{}
        foreach ($f in $pfFiles) { $sizeMap[$f.FullName] = $f.Length }

        $unsigned = $pfFiles | Get-AuthenticodeSignature |
            Where-Object { $_.Status -ne 'Valid' } |
            Select-Object Path, Status,
                @{n='SizeMB';e={ if ($sizeMap.ContainsKey($_.Path)) { [math]::Round($sizeMap[$_.Path] / 1MB, 3) } else { $null } }}

        Save "15_unsigned_program_files_exes" { $unsigned }

        Save "15b_unsigned_exe_hashes" {
            foreach ($i in $unsigned) {
                "-- $($i.Path) (Size: $($i.SizeMB) MB) --"
                try { (Get-FileHash -Path $i.Path -Algorithm SHA256 -ErrorAction Stop).Hash } catch { "Could not hash: $_" }
                ""
            }
            "NOTE: VirusTotal checking is manual."
        }

        Save "16_root_certificates" {
            Get-ChildItem Cert:\LocalMachine\Root |
                Select-Object Subject, Thumbprint, NotBefore, NotAfter |
                Sort-Object NotBefore -Descending
        }

        Save "17_prefetch_files" {
            Get-ChildItem "$env:WINDIR\Prefetch" -Filter *.pf -ErrorAction SilentlyContinue |
                Select-Object Name,
                    @{n='SizeKB';e={[math]::Round($_.Length / 1KB, 2)}},
                    @{n='SizeMB';e={[math]::Round($_.Length / 1MB, 4)}},
                    CreationTime, LastWriteTime, LastAccessTime |
                Sort-Object LastWriteTime -Descending
        }

        Save "18_recent_items" {
            Get-ChildItem "$env:APPDATA\Microsoft\Windows\Recent" -ErrorAction SilentlyContinue |
                Select-Object Name,
                    @{n='SizeKB';e={[math]::Round($_.Length / 1KB, 2)}},
                    CreationTime, LastWriteTime |
                Sort-Object LastWriteTime -Descending
        }

        Save "19_recent_items_targets" {
            $sh = New-Object -ComObject WScript.Shell
            Get-ChildItem "$env:APPDATA\Microsoft\Windows\Recent" -Filter *.lnk -ErrorAction SilentlyContinue |
                ForEach-Object {
                    try {
                        $lnk = $sh.CreateShortcut($_.FullName)
                        [PSCustomObject]@{
                            Name = $_.Name; Target = $lnk.TargetPath; Arguments = $lnk.Arguments
                            LnkSizeKB = [math]::Round($_.Length / 1KB, 2)
                            TargetSizeMB = SizeMB $lnk.TargetPath
                            LastWriteTime = $_.LastWriteTime
                        }
                    } catch {
                        [PSCustomObject]@{ Name = $_.Name; Target = "ERROR"; Arguments = ""; LnkSizeKB = $null; TargetSizeMB = $null; LastWriteTime = $_.LastWriteTime }
                    }
                }
        }

        Save "19b_shellbags" {
            $sbecmdDirs = @("$env:USERPROFILE\Desktop", "$env:USERPROFILE\Downloads", $env:ProgramFiles, ${env:ProgramFiles(x86)}) |
                Where-Object { $_ -and (Test-Path $_) }
            $sbecmd = $null
            foreach ($dir in $sbecmdDirs) {
                $hit = Get-ChildItem -Path $dir -Filter "SBECmd.exe" -Recurse -ErrorAction SilentlyContinue -File | Select-Object -First 1
                if ($hit) { $sbecmd = $hit.FullName; break }
            }

            if ($sbecmd) {
                "ShellBags parsed via SBECmd (Eric Zimmerman tools): $sbecmd"
                ""
                $sbOut = Join-Path $temp "shellbags_sbecmd"
                New-Item -ItemType Directory -Path $sbOut -Force | Out-Null
                try {
                    & $sbecmd --live --csv $sbOut 2>&1 | Out-String
                    "SBECmd finished - decoded CSV output is in shellbags_sbecmd\"
                } catch { "SBECmd run FAILED: $_" }
            } else {
                "SBECmd was not found on this machine. Below is a RAW dump of the shell bag"
                "registry keys (NOT a decoded listing). Install SBECmd (ericzimmerman.github.io)"
                "and re-run for a fully decoded shellbags.csv."
                ""
                $bagKeys = @(
                    "HKCU:\Software\Microsoft\Windows\Shell\BagMRU",
                    "HKCU:\Software\Microsoft\Windows\Shell\Bags",
                    "HKCU:\Software\Classes\Local Settings\Software\Microsoft\Windows\Shell\BagMRU",
                    "HKCU:\Software\Classes\Local Settings\Software\Microsoft\Windows\Shell\Bags",
                    "HKCU:\Software\Classes\Wow6432Node\Local Settings\Software\Microsoft\Windows\Shell\BagMRU"
                )
                foreach ($base in $bagKeys) {
                    if (Test-Path $base) {
                        "--- $base ---"
                        Get-ChildItem -Path $base -Recurse -ErrorAction SilentlyContinue | ForEach-Object {
                            $props = Get-ItemProperty -Path $_.PSPath -ErrorAction SilentlyContinue
                            if ($props) {
                                $props.PSObject.Properties | Where-Object { $_.Name -notlike "PS*" } | ForEach-Object {
                                    $readable = ""
                                    if ($_.Value -is [byte[]]) {
                                        $text = [System.Text.Encoding]::Unicode.GetString($_.Value)
                                        $found = [regex]::Matches($text, '[\x20-\x7E]{4,}')
                                        $readable = (($found | ForEach-Object { $_.Value }) -join ' | ')
                                    }
                                    "  [$($_.Name)]  readable-strings: $readable"
                                }
                            }
                        }
                        ""
                    }
                }
            }
        }

        Save "20_mui_cache" {
            "registry path: HKCU:\Software\Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache"
            ""
            $k = "HKCU:\Software\Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache"
            if (Test-Path $k) {
                $props = Get-ItemProperty -Path $k
                $props.PSObject.Properties | Where-Object { $_.Name -notlike "PS*" } | ForEach-Object {
                    $exe = ($_.Name -split '\.(FriendlyAppName|ApplicationCompany)$')[0]
                    [PSCustomObject]@{ Entry = $_.Name; Value = $_.Value; SizeMB = SizeMB $exe }
                } | Sort-Object Entry
            } else { "MuiCache key not present." }
        }

        Save "21_bam_summary" {
            "registry path: HKLM:\SYSTEM\CurrentControlSet\Services\bam\State\UserSettings"
            ""
            $bam = "HKLM:\SYSTEM\CurrentControlSet\Services\bam\State\UserSettings"
            if (Test-Path $bam) {
                Get-ChildItem $bam -ErrorAction SilentlyContinue | ForEach-Object {
                    "path: $($_.Name)"
                    $props = Get-ItemProperty -Path $_.PSPath
                    $props.PSObject.Properties | Where-Object { $_.Name -notlike "PS*" } | ForEach-Object {
                        $clean = $_.Name -replace '^\\Device\\HarddiskVolume\d+', $env:SystemDrive
                        "  {0}  [{1} MB]" -f $_.Name, (SizeMB $clean)
                    }
                    ""
                }
            } else { "BAM key not present." }
        }

        Save "22_usn_journal_activity" {
            "USN journal activity on $env:SystemDrive - executable-ish extensions only."
            "Journal records carry filename + parent reference, not a full path."
            ""
            try {
                $raw = & fsutil usn readjournal $env:SystemDrive csv 2>&1
                $raw | Where-Object { $_ -match '\.(exe|dll|sys|bat|cmd|ps1|vbs|scr|msi)\b' } | Select-Object -Last 2000
            } catch { "Could not read USN journal: $_" }
        }

        Save "23_security_summary" {
            try {
                $sb = Confirm-SecureBootUEFI -ErrorAction Stop
                if ($sb) { "SUCCESS: Secure Boot is ON" } else { "WARNING: Secure Boot is OFF" }
            } catch { "INFO: Secure Boot state unavailable (legacy BIOS or not permitted)" }

            try {
                $dg = Get-CimInstance -ClassName Win32_DeviceGuard -Namespace root\Microsoft\Windows\DeviceGuard -ErrorAction Stop
                if ($dg.VirtualizationBasedSecurityStatus -eq 2) { "SUCCESS: VBS is running" }
                else { "WARNING: VBS is not running (status $($dg.VirtualizationBasedSecurityStatus))" }
                if ($dg.CodeIntegrityPolicyEnforcementStatus -ge 1) { "SUCCESS: Memory Integrity / HVCI enforced" }
                else { "WARNING: Memory Integrity / HVCI not enforced" }
            } catch { "INFO: Device Guard status unavailable" }

            ""
            "--- registered antivirus products ---"
            try {
                Get-CimInstance -Namespace root\SecurityCenter2 -ClassName AntiVirusProduct -ErrorAction Stop |
                    ForEach-Object { "  {0}  (exe: {1})" -f $_.displayName, $_.pathToSignedProductExe }
            } catch { "  could not query SecurityCenter2" }

            ""
            "--- Malwarebytes verification result ---"
            "  recorder family in use: $RecorderFamily"
            if (@($MbVerified | Where-Object { $_ }).Count -gt 0) {
                "  SUCCESS: $(@($MbVerified).Count) verified-genuine Malwarebytes process(es) excluded from closing"
                $MbVerified | ForEach-Object {
                    "    {0} (PID {1}) {2} MB  knownBuild={3}`n      path: {4}`n      publisher: {5}`n      sha256: {6}" -f `
                        $_.Name, $_.PID, $_.SizeMB, $_.KnownBuild, $_.Path, $_.Publisher, $_.SHA256
                }
            } else { "  FAILURE: no Malwarebytes process passed verification" }
            if (@($MbRejected | Where-Object { $_ }).Count -gt 0) {
                ""
                "  WARNING: $(@($MbRejected).Count) process(es) named like Malwarebytes FAILED verification and were NOT excluded:"
                $MbRejected | ForEach-Object {
                    "    {0} (PID {1})`n      path: {2}`n      size: {3} MB`n      reason: {4}" -f `
                        $_.Name, $_.PID, $_.Path, $_.SizeMB, ($_.Reason -join "; ")
                }
            }

            ""
            "--- MOSS verification result ---"
            if (@($MossVerified | Where-Object { $_ }).Count -gt 0) {
                "  SUCCESS: $(@($MossVerified).Count) verified MOSS process(es) excluded from closing"
                $MossVerified | ForEach-Object {
                    "    {0} (PID {1}) {2} MB  knownBuild={3}`n      path: {4}`n      size: {5} bytes`n      signature: {6}`n      sha256: {7}`n      note: {8}" -f `
                        $_.Name, $_.PID, $_.SizeMB, $_.KnownBuild, $_.Path, $_.SizeBytes, $_.SignatureStatus, $_.SHA256, ($_.Reason -join "; ")
                }
            } else { "  INFO: no MOSS process passed verification (or MOSS was not running)" }
            if (@($MossRejected | Where-Object { $_ }).Count -gt 0) {
                ""
                "  WARNING: $(@($MossRejected).Count) process(es) named like MOSS FAILED verification and were NOT excluded:"
                $MossRejected | ForEach-Object {
                    "    {0} (PID {1})`n      path: {2}`n      size: {3} bytes`n      reason: {4}" -f `
                        $_.Name, $_.PID, $_.Path, $_.SizeBytes, ($_.Reason -join "; ")
                }
            }

            ""
            "--- Malwarebytes services ---"
            Get-Service -Name "MBAMService","MBAMProtection","mbamchameleon","MBVpnTunnelService" -ErrorAction SilentlyContinue |
                ForEach-Object { "  {0}: {1}" -f $_.Name, $_.Status }
        }

        Save "24_powershell_check" {
            "INFO: version $($PSVersionTable.PSVersion), edition $($PSVersionTable.PSEdition)"
            "INFO: language mode: $($ExecutionContext.SessionState.LanguageMode)"
            "INFO: host: $($Host.Name), pid: $PID"
            ""
            foreach ($c in @('get-ciminstance','get-service','get-itemproperty','get-filehash','copy-item','stop-process')) {
                try {
                    $cmd = Get-Command $c -ErrorAction Stop
                    "SUCCESS: '$c' resolves via '$($cmd.Source)'"
                } catch { "FAILURE: '$c' could not be resolved" }
            }
        }

        Save "25_display_snapshot" {
            "Display snapshot taken by the standalone cleanup script (no continuous watchdog)."
            ""
            if ($MonitorLog -and $MonitorLog.Count -gt 0) { $MonitorLog } else { "no entries" }
        }

        $critical = @($CloseLog | Where-Object { $_.Notes -like "*named like Malwarebytes*" -or $_.Notes -like "*named like MOSS*" }).Count `
                    + @($MbRejected | Where-Object { $_ }).Count `
                    + @($MossRejected | Where-Object { $_ }).Count
        $high     = @($CloseLog | Where-Object { $_.Suspicious -and $_.Notes -like "*temp/downloads*" }).Count
        $medium   = @($CloseLog | Where-Object { $_.Suspicious -and $_.Notes -like "*unsigned*" }).Count
        $low      = @($CloseLog | Where-Object { $_.Status -notlike "Closed*" }).Count

        Save "26_severity_summary" {
            "Findings by severity this session:"
            ""
            "Critical  : $critical"
            "High      : $high"
            "Medium    : $medium"
            "Low       : $low"
            ""
            "Critical = process impersonating verified security software"
            "High     = executing from a temp/downloads path"
            "Medium   = unsigned or invalid signature"
            "Low      = could not be closed (informational)"
            ""
            "These are heuristics, not verdicts. A flag means 'look closer', not 'guilty'."
        }

        $logsRoot = Join-Path $temp "artifacts"
        New-Item -ItemType Directory -Path $logsRoot -Force | Out-Null

        function Copy-Artifact($label, $source, $destSubfolder) {
            $dest = Join-Path $logsRoot $destSubfolder
            try {
                if (Test-Path $source) {
                    New-Item -ItemType Directory -Path $dest -Force | Out-Null
                    Copy-Item -Path (Join-Path $source '*') -Destination $dest -Recurse -Force -ErrorAction SilentlyContinue
                    $copied = @(Get-ChildItem $dest -Recurse -File -ErrorAction SilentlyContinue)
                    $sum    = ($copied | Measure-Object Length -Sum).Sum
                    $sizeMB = if ($null -eq $sum) { 0 } else { [math]::Round($sum / 1MB, 2) }
                    "OK   [$label] $($copied.Count) files, $sizeMB MB copied from '$source' -> artifacts\$destSubfolder"
                } else { "SKIP [$label] source not found: $source" }
            } catch { "FAIL [$label] error copying from '$source': $_" }
        }

        $copyLog = @()
        $copyLog += Copy-Artifact "Prefetch"           "$env:WINDIR\Prefetch"                  "Prefetch"
        $copyLog += Copy-Artifact "Recent items"       "$env:APPDATA\Microsoft\Windows\Recent" "Recent"
        $copyLog += Copy-Artifact "Windows Event Logs" "$env:WINDIR\System32\winevt\Logs"      "EventLogs"
        $copyLog | Set-Content -Path (Join-Path $temp "27_raw_artifact_copy_log.txt") -Encoding UTF8

        $manifest = @()
        $manifest += "format: SHA256 + size for every file in this package"
        $manifest += "created (UTC): $((Get-Date).ToUniversalTime().ToString('o'))"
        $allOut = @(Get-ChildItem $temp -Recurse -File | Sort-Object FullName)
        $manifest += "file count: $($allOut.Count)"
        $manifest += ""
        foreach ($f in $allOut) {
            $rel = $f.FullName.Substring($temp.Length + 1)
            $h = "UNREADABLE"
            try { $h = (Get-FileHash -Path $f.FullName -Algorithm SHA256 -ErrorAction Stop).Hash } catch {}
            $manifest += "path: $rel"
            $manifest += "size: $($f.Length)"
            $manifest += "sizeMB: $([math]::Round($f.Length / 1MB, 4))"
            $manifest += "sha256: $h"
            $manifest += ""
        }
        $manifest | Set-Content -Path (Join-Path $temp "00_checksums.txt") -Encoding UTF8

        $acFolder = Join-Path $desktop "AC-FINDINGS"
        New-Item -ItemType Directory -Path $acFolder -Force | Out-Null
        $zipPath = Join-Path $acFolder "FINDINGS-$stamp.zip"
        if (Test-Path $zipPath) { Remove-Item $zipPath -Force }

        Add-Type -AssemblyName System.IO.Compression.FileSystem
        [System.IO.Compression.ZipFile]::CreateFromDirectory($temp, $zipPath, [System.IO.Compression.CompressionLevel]::Optimal, $false)

        Remove-Item $temp -Recurse -Force
        return $zipPath
    }

    $displaySnapshot = @("[{0}] Display count at collection time: {1}" -f (Get-Date -Format "HH:mm:ss"), (Get-ActiveDisplayCount))

    $job = Start-Job -ScriptBlock $collector -ArgumentList @(
        $global:ExcludedReport,
        $global:CloseLog,
        $global:DuplicateReport,
        $displaySnapshot,
        $global:MalwarebytesVerified,
        $global:MalwarebytesRejected,
        $global:RecorderFamily,
        $global:MossVerified,
        $global:MossRejected
    )

    $spinner = @('|','/','-','\')
    $i = 0
    while ($job.State -eq 'Running') {
        Write-Host -NoNewline ("`r  Collecting findings... $($spinner[$i % $spinner.Length])  ")
        Start-Sleep -Milliseconds 150
        $i++
    }
    Write-Host -NoNewline "`r"

    if ($job.State -eq 'Failed') {
        Write-Host "  Findings collection FAILED." -ForegroundColor Red
        Receive-Job -Job $job -ErrorAction SilentlyContinue 2>&1 | ForEach-Object { Write-Host "  $_" -ForegroundColor Red }
        Remove-Job -Job $job -Force -ErrorAction SilentlyContinue
        return
    }

    $zipPath = Receive-Job -Job $job -ErrorAction SilentlyContinue | Where-Object { $_ -is [string] } | Select-Object -Last 1
    Remove-Job -Job $job -Force -ErrorAction SilentlyContinue

    if (-not $zipPath -or -not (Test-Path $zipPath)) {
        Write-Host "Findings collection finished, but the ZIP could not be located." -ForegroundColor Red
        return
    }

    $zipSizeMB = [math]::Round((Get-Item $zipPath).Length / 1MB, 2)
    Write-Host "Findings saved to: $zipPath" -ForegroundColor Green
    Write-Host "ZIP size: $zipSizeMB MB" -ForegroundColor Green
    $global:FindingsZip = $zipPath
}

