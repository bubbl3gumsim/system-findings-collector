# =========================================================================
# RECORDING SOFTWARE DETECTION
# =========================================================================
# Exactly one of OBS / NVIDIA ShadowPlay / AMD Adrenalin is expected. Only the
# one actually detected gets whitelisted from closure - the other vendors'
# processes are still fair game.
$gpuNames  = @(Get-CimInstance Win32_VideoController -ErrorAction SilentlyContinue | Select-Object -ExpandProperty Name)
$hasAMD    = $gpuNames -match 'AMD|Radeon'
$hasNVIDIA = $gpuNames -match 'NVIDIA|GeForce'
$hasIntel  = $gpuNames -match 'Intel'

$recorderFamilies = @{
    "OBS" = @{
        Detect  = @("obs64", "obs32")
        Whitelist = @("obs64", "obs32", "obs-browser-page", "obs-ffmpeg-mux", "obs-ffmpeg-mux32")
    }
    "NVIDIA" = @{
        Detect  = @("NVIDIA Share")
        Whitelist = @("NVIDIA Share", "nvcontainer", "NVIDIA Overlay", "NVDisplay.Container")
    }
    "AMD" = @{
        Detect  = @("RadeonSoftware", "AMDRSServ")
        Whitelist = @("RadeonSoftware", "AMDRSServ", "AMDRSSrcExt")
    }
}

function Get-ActiveRecorderFamily {
    $hits = @()
    foreach ($fam in $recorderFamilies.Keys) {
        foreach ($p in $recorderFamilies[$fam].Detect) {
            if (Get-Process -Name $p -ErrorAction SilentlyContinue) {
                $hits += $fam
                break
            }
        }
    }
    return ($hits | Select-Object -Unique)
}

function Invoke-RecorderDetection {
    Section "Recording Software Check"

    $expected = if ($hasNVIDIA) { "NVIDIA (ShadowPlay)" } elseif ($hasAMD) { "AMD (Adrenalin)" } elseif ($hasIntel) { "OBS" } else { "OBS" }
    Write-Host "GPU detected: $($gpuNames -join ', ')" -ForegroundColor Gray
    Write-Host "Expected recorder for this GPU: $expected" -ForegroundColor Gray
    Write-Host ""

    $families = @(Get-ActiveRecorderFamily)

    while ($families.Count -eq 0) {
        Write-Host "No recorder detected running (looked for OBS, NVIDIA Share, AMD Adrenalin)." -ForegroundColor Red
        Write-Host "Start your recorder now." -ForegroundColor Yellow
        Read-Host "Press Enter once it's running"
        $families = @(Get-ActiveRecorderFamily)
    }

    if ($families.Count -gt 1) {
        Write-Host "MORE THAN ONE recorder is running: $($families -join ', ')" -ForegroundColor Red
        Write-Host "Only one is permitted. Close the others now." -ForegroundColor Red
        Read-Host "Press Enter once only one remains"
        $families = @(Get-ActiveRecorderFamily)
    }

    $family = $families | Select-Object -First 1
    Write-Host "Active recorder: $family" -ForegroundColor Green

    # Note: process presence proves the app is OPEN, not that it is ROLLING.
    Write-Host ""
    Write-Host "Process detection can't prove you're actually recording - only that the app is open." -ForegroundColor Yellow
    $ok = $null
    while ($ok -notmatch '^[Yy]$') {
        $ok = Read-Host "Look at your recorder - is it actively recording (timer running / REC lit)? (Y)"
    }

    $names = @()
    foreach ($p in $recorderFamilies[$family].Whitelist) {
        if (Get-Process -Name $p -ErrorAction SilentlyContinue) { $names += $p }
    }
    # keep the full family list so helper processes spawned later are also spared
    $global:RecorderFamily = $family
    $global:RecorderWhitelist = $recorderFamilies[$family].Whitelist | ForEach-Object { $_.ToLower() }

    Write-Host "Whitelisted from closure ($family only): $($global:RecorderWhitelist -join ', ')" -ForegroundColor Green
    $otherFamilies = $recorderFamilies.Keys | Where-Object { $_ -ne $family }
    Write-Host "NOT whitelisted (other vendors): $($otherFamilies -join ', ')" -ForegroundColor DarkGray
}

# =========================================================================
# MALWAREBYTES: VERIFIED EXCLUSION
# =========================================================================
# Malwarebytes must stay running, but ONLY if the binaries are genuine.
# A process merely NAMED "MBAMService" is not proof of anything, so each
# candidate has to clear three independent gates before it is spared:
#   1. it lives under the official Malwarebytes install directory
#   2. its Authenticode signature is Valid
#   3. the signing certificate subject is actually Malwarebytes
# Anything named like Malwarebytes that fails these is treated as hostile:
# it is NOT whitelisted, it gets closed, and it is flagged in the report.
