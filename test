function Step-TaskManager {
    Section "Task Manager"
    Start-Process "taskmgr.exe"
    Write-Host "Configure Task Manager exactly like this:" -ForegroundColor Yellow
    Write-Host "  1. Right-click the Name column header and enable Process Name AND Command Line." -ForegroundColor White
    Write-Host "  2. Drag the Command Line column wider until Disk and Network are pushed OFF screen." -ForegroundColor White
