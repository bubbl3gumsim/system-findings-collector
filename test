function Invoke-ToolCheck {
    Section "Required Software Check"
    $missing = @()

    foreach ($tool in $requiredTools) {
        $detected = & $tool.Probe
        if ($detected) {
            Write-Host ("  {0,-14} found: {1}" -f $tool.Name, $detected) -ForegroundColor Green
        }

        $answer = $null
        while ($answer -notmatch '^[YyNn]$') {
            $answer = Read-Host "Do you have $($tool.Name) installed? (Y/N)"
        }

        if ($answer -match '^[Nn]$') {
            Write-Host ""
            Write-Host "  Download $($tool.Name):" -ForegroundColor Yellow
            Write-Host "    $($tool.Url)" -ForegroundColor Cyan
            Write-Host "    ($($tool.Note))" -ForegroundColor DarkGray
            try { Start-Process $tool.Url } catch {
                Write-Host "    Could not auto-open the link - copy it manually." -ForegroundColor DarkYellow
            }
            Read-Host "  Install it, then press Enter to continue"
            $missing += $tool.Name
        } elseif (-not $detected) {
            Write-Host "  Couldn't auto-locate $($tool.Name) on disk, continuing on your word." -ForegroundColor DarkYellow
        }
        Write-Host ""
    }

    if ($missing) {
        Write-Host "Installed during this run: $($missing -join ', ')" -ForegroundColor Green
    }
}

