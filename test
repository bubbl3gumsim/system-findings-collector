function Test-GenuineMalwarebytes($proc) {
    $result = [PSCustomObject]@{
        Name        = $proc.ProcessName
        PID         = $proc.Id
        Path        = $null
        SizeMB      = $null
        InOfficialDir = $false
        SignatureOK = $false
        PublisherOK = $false
        Publisher   = $null
        SHA256      = $null
        KnownBuild  = $false
        Genuine     = $false
        Reason      = @()
    }

    try { $result.Path = $proc.Path } catch { $result.Path = $null }

    if (-not $result.Path) {
        $result.Reason += "executable path unavailable"
        return $result
    }

    $result.SizeMB = Get-SizeMB $result.Path

    foreach ($dir in $MalwarebytesOfficialDirs) {
        if ($dir -and $result.Path.StartsWith($dir, [StringComparison]::OrdinalIgnoreCase)) {
            $result.InOfficialDir = $true
            break
        }
    }
    if (-not $result.InOfficialDir) { $result.Reason += "not in official Malwarebytes install directory" }

    try {
        $sig = Get-AuthenticodeSignature -FilePath $result.Path -ErrorAction Stop
        $result.SignatureOK = ($sig.Status -eq "Valid")
        if ($sig.SignerCertificate) { $result.Publisher = $sig.SignerCertificate.Subject }
        if (-not $result.SignatureOK) { $result.Reason += "signature status: $($sig.Status)" }
        if ($result.Publisher -and $result.Publisher -match 'Malwarebytes') {
            $result.PublisherOK = $true
        } else {
            $result.Reason += "signing publisher is not Malwarebytes"
        }
    } catch {
        $result.Reason += "signature could not be read"
    }

    try {
        $result.SHA256 = (Get-FileHash -Path $result.Path -Algorithm SHA256 -ErrorAction Stop).Hash
        if ($MalwarebytesKnownHashes.ContainsKey($result.SHA256)) { $result.KnownBuild = $true }
    } catch {}

    $result.Genuine = ($result.InOfficialDir -and $result.SignatureOK -and $result.PublisherOK)
    if ($result.Genuine -and $result.Reason.Count -eq 0) { $result.Reason += "verified genuine" }
    return $result
}

function Invoke-MalwarebytesVerification {
    Section "Malwarebytes Integrity Verification"

    $candidates = @()
    foreach ($n in $MalwarebytesProcessNames) {
        $candidates += Get-Process -Name $n -ErrorAction SilentlyContinue
    }
    $candidates = $candidates | Sort-Object Id -Unique

    $global:MalwarebytesVerified = @()
    $global:MalwarebytesRejected = @()

    if (-not $candidates) {
        Write-Host "No Malwarebytes processes are currently running." -ForegroundColor DarkYellow
        Write-Host "Start Malwarebytes before continuing - it must stay running." -ForegroundColor Yellow
        Read-Host "Press Enter once Malwarebytes is running"
        foreach ($n in $MalwarebytesProcessNames) {
            $candidates += Get-Process -Name $n -ErrorAction SilentlyContinue
        }
        $candidates = $candidates | Sort-Object Id -Unique
    }

    foreach ($proc in $candidates) {
        $v = Test-GenuineMalwarebytes $proc
        if ($v.Genuine) {
            $global:MalwarebytesVerified += $v
            $tag = if ($v.KnownBuild) { "verified + known build" } else { "verified (build not on file)" }
            Write-Host ("  OK    {0,-24} PID {1,-7} {2} MB  [{3}]" -f $v.Name, $v.PID, $v.SizeMB, $tag) -ForegroundColor Green
        } else {
            $global:MalwarebytesRejected += $v
            Write-Host ("  FAIL  {0,-24} PID {1,-7} {2}" -f $v.Name, $v.PID, ($v.Reason -join "; ")) -ForegroundColor Red
            Write-Host ("        path: {0}" -f $v.Path) -ForegroundColor Red
        }
    }

    # Only verified-genuine process names get spared.
    $global:MalwarebytesWhitelist = @($global:MalwarebytesVerified | ForEach-Object { $_.Name.ToLower() } | Select-Object -Unique)

    Write-Host ""
    if ($global:MalwarebytesRejected.Count -gt 0) {
        Write-Host "WARNING: $($global:MalwarebytesRejected.Count) process(es) named like Malwarebytes failed verification." -ForegroundColor Red
        Write-Host "They will NOT be excluded from closing and are flagged in the report." -ForegroundColor Red
    }
    Write-Host "Verified Malwarebytes components excluded from closing: $($global:MalwarebytesWhitelist.Count)" -ForegroundColor Green
}

# =========================================================================
# MOSS: VERIFIED EXCLUSION (must run for the whole match)
# =========================================================================
# MOSS has to stay running all match, so like Malwarebytes it gets excluded
# from the cleanup - but only after verification.
#
# IMPORTANT, READ THIS: the official MossX645.zip is AES-encrypted, so the
# SHA256 of the real MossX64.exe could not be extracted to embed here. That
# means MOSS is verified WEAKER than Malwarebytes:
#   Malwarebytes = install path + valid signature + publisher match  (strong)
#   MOSS         = filename + exact byte size + logged hash          (weaker)
# Exact byte size is a real check (it catches a repacked or patched binary),
# but it is forgeable by anyone who pads a file to the same length. Until the
# hash below is filled in, treat MOSS exclusion as "probably genuine",
# not "proven genuine", and rely on the on-camera MOSS session as well.
#
# TO UPGRADE THIS TO A REAL HASH CHECK:
#   1. extract MossX645.zip with the league password
#   2. run:  Get-FileHash .\MossX64.exe -Algorithm SHA256
#   3. paste the hash into $MossKnownHashes below
$MossProcessNames = @("MOSS", "MOSSX64", "MossX645", "MOSSCapture")

# Known-good metadata taken from the official MossX645.zip central directory.
$MossKnownFileName = "MossX64.exe"
$MossKnownSize     = 4220416          # bytes, from the official archive
$MossKnownZipSha   = "814824D4C279772A05C8A2E35E8F1E09B2CE4CBD682583A16A8E04F7D5E67637"

# Empty until someone extracts the archive and fills it in (see note above).
$MossKnownHashes = @(
    # "PASTE_SHA256_OF_MossX64.exe_HERE"
)

function Test-GenuineMoss($proc) {
    $r = [PSCustomObject]@{
        Name        = $proc.ProcessName
        PID         = $proc.Id
        Path        = $null
        SizeBytes   = $null
        SizeMB      = $null
        FileName    = $null
        NameOK      = $false
        SizeOK      = $false
        SignatureStatus = $null
        Publisher   = $null
        SHA256      = $null
        KnownBuild  = $false
        Genuine     = $false
        Reason      = @()
    }

    try { $r.Path = $proc.Path } catch {}
    if (-not $r.Path) { $r.Reason += "executable path unavailable"; return $r }

    try {
        $fi = Get-Item -LiteralPath $r.Path -ErrorAction Stop
        $r.SizeBytes = $fi.Length
        $r.SizeMB    = [math]::Round($fi.Length / 1MB, 3)
        $r.FileName  = $fi.Name
    } catch { $r.Reason += "could not stat file"; return $r }

    $r.NameOK = ($r.FileName -ieq $MossKnownFileName)
    if (-not $r.NameOK) { $r.Reason += "filename '$($r.FileName)' is not $MossKnownFileName" }

    $r.SizeOK = ($r.SizeBytes -eq $MossKnownSize)
    if (-not $r.SizeOK) { $r.Reason += "size $($r.SizeBytes) bytes != official $MossKnownSize bytes" }

    try {
        $sig = Get-AuthenticodeSignature -FilePath $r.Path -ErrorAction Stop
        $r.SignatureStatus = $sig.Status
        if ($sig.SignerCertificate) { $r.Publisher = $sig.SignerCertificate.Subject }
    } catch { $r.SignatureStatus = "unreadable" }

    try { $r.SHA256 = (Get-FileHash -Path $r.Path -Algorithm SHA256 -ErrorAction Stop).Hash } catch {}

    if ($MossKnownHashes.Count -gt 0) {
        # Hash list populated: this becomes the authoritative gate.
        $r.KnownBuild = ($MossKnownHashes -contains $r.SHA256)
        $r.Genuine    = $r.KnownBuild
        if (-not $r.KnownBuild) { $r.Reason += "SHA256 does not match any known-good MOSS build" }
    } else {
        # No hash on file: fall back to name + exact size.
        $r.Genuine = ($r.NameOK -and $r.SizeOK)
        $r.Reason += "no MOSS hash on file - verified by name+size only (weaker)"
    }

    return $r
}

function Invoke-MossVerification {
    Section "MOSS Integrity Verification"

    $candidates = @()
    foreach ($n in $MossProcessNames) {
        $candidates += Get-Process -Name $n -ErrorAction SilentlyContinue
    }
    $candidates = $candidates | Sort-Object Id -Unique

    $global:MossVerified = @()
    $global:MossRejected = @()

    if (-not $candidates) {
        if ($tier -in @('2','3')) {
            Write-Host "MOSS is not running yet - it is started later in the Before Launching steps." -ForegroundColor DarkYellow
        } else {
            Write-Host "MOSS not running (not required for Tier 1)." -ForegroundColor Gray
        }
        $global:MossWhitelist = @()
        return
    }

    if ($MossKnownHashes.Count -eq 0) {
        Write-Host "NOTE: no MOSS SHA256 on file (official zip is encrypted)." -ForegroundColor DarkYellow
        Write-Host "      Falling back to filename + exact byte size. This is weaker than a hash check." -ForegroundColor DarkYellow
        Write-Host ""
    }

    foreach ($proc in $candidates) {
        $v = Test-GenuineMoss $proc
        if ($v.Genuine) {
            $global:MossVerified += $v
            Write-Host ("  OK    {0,-24} PID {1,-7} {2} MB  sig={3}" -f $v.Name, $v.PID, $v.SizeMB, $v.SignatureStatus) -ForegroundColor Green
            Write-Host ("        sha256: {0}" -f $v.SHA256) -ForegroundColor DarkGray
        } else {
            $global:MossRejected += $v
            Write-Host ("  FAIL  {0,-24} PID {1,-7} {2}" -f $v.Name, $v.PID, ($v.Reason -join "; ")) -ForegroundColor Red
            Write-Host ("        path: {0}" -f $v.Path) -ForegroundColor Red
        }
    }

    $global:MossWhitelist = @($global:MossVerified | ForEach-Object { $_.Name.ToLower() } | Select-Object -Unique)

    Write-Host ""
    if ($global:MossRejected.Count -gt 0) {
        Write-Host "WARNING: $($global:MossRejected.Count) process(es) named like MOSS failed verification." -ForegroundColor Red
        Write-Host "They will NOT be excluded from closing and are flagged in the report." -ForegroundColor Red
    }
    Write-Host "Verified MOSS components excluded from closing: $($global:MossWhitelist.Count)" -ForegroundColor Green
}

function Get-MossWhitelist {
    # Re-verify at cleanup time: MOSS is usually launched partway through the
    # run, so the earlier pass may have found nothing.
    Invoke-MossVerification | Out-Null
    return @($global:MossWhitelist)
}

# =========================================================================
# STAGE: CLOSE NON-ESSENTIAL PROCESSES
# =========================================================================
function Invoke-CloseNonEssential {
    Section "Close Non-Essential Processes"

    $systemWhitelist = @(
        "System","Idle","Registry","smss","csrss","wininit","winlogon","services","lsass","lsm",
        "svchost","dwm","explorer","fontdrvhost","RuntimeBroker","sihost","taskhostw","ctfmon",
        "conhost","dllhost","WUDFHost","SearchIndexer","SearchHost","StartMenuExperienceHost",
        "ShellExperienceHost","ApplicationFrameHost","TextInputHost","spoolsv","audiodg",
        "powershell","pwsh","WindowsTerminal","OpenConsole","cmd","Secure System","Memory Compression"
    )

    $robloxWhitelist = @("RobloxPlayerBeta","RobloxPlayerLauncher","RobloxCrashHandler")
    $mossWhitelist   = @(Get-MossWhitelist)

    $whitelistMap = @{}
    foreach ($n in $systemWhitelist)                 { $whitelistMap[$n.ToLower()] = "core Windows process" }
    foreach ($n in $robloxWhitelist)                 { $whitelistMap[$n.ToLower()] = "Roblox (the game being recorded)" }
    foreach ($n in $global:RecorderWhitelist)        { $whitelistMap[$n.ToLower()] = "recording software ($global:RecorderFamily)" }
    foreach ($n in $global:MalwarebytesWhitelist)    { $whitelistMap[$n.ToLower()] = "Malwarebytes (signature-verified)" }
    foreach ($n in $mossWhitelist)                   { $whitelistMap[$n.ToLower()] = "MOSS (must run for whole match)" }
    foreach ($n in @($global:justifiedExtras))       { if ($n) { $whitelistMap[$n.ToLower()] = "user-justified on camera" } }

    Write-Host "Exclusions in effect:" -ForegroundColor Magenta
    Write-Host "  Recorder    : $($global:RecorderFamily) -> $($global:RecorderWhitelist -join ', ')" -ForegroundColor Green
    Write-Host "  Malwarebytes: $(if ($global:MalwarebytesWhitelist) { $global:MalwarebytesWhitelist -join ', ' } else { 'NONE VERIFIED' })" -ForegroundColor Green
    Write-Host "  MOSS        : $(if ($mossWhitelist) { $mossWhitelist -join ', ' } else { 'not running' })" -ForegroundColor Green
    if ($global:justifiedExtras) {
        Write-Host "  Justified   : $($global:justifiedExtras -join ', ')" -ForegroundColor Green
    }
    Write-Host ""

    $allProcs = @(Get-Process | Sort-Object ProcessName, Id)
    $selfPid  = $PID

    # ---- duplicate instance detection (runs across EVERY process) ----
    $dupGroups = $allProcs | Group-Object ProcessName | Where-Object { $_.Count -gt 1 }
    $global:DuplicateReport = @()
    foreach ($g in $dupGroups) {
        foreach ($p in $g.Group) {
            $path = $null
            try { $path = $p.Path } catch {}
            $st = $null
            try { $st = $p.StartTime } catch {}
            $global:DuplicateReport += [PSCustomObject]@{
                Name          = $g.Name
                InstanceCount = $g.Count
                PID           = $p.Id
                Path          = $path
                SizeMB        = Get-SizeMB $path
                StartTime     = $st
                Whitelisted   = $whitelistMap.ContainsKey($g.Name.ToLower())
            }
        }
    }
    if ($dupGroups) {
        Write-Host "Processes running with MULTIPLE instances:" -ForegroundColor Yellow
        foreach ($g in $dupGroups) {
            Write-Host ("  {0,-28} x{1}  (PIDs: {2})" -f $g.Name, $g.Count, (($g.Group | ForEach-Object { $_.Id }) -join ', ')) -ForegroundColor Yellow
        }
        Write-Host ""
    }

    # ---- build excluded list with full detail ----
    $global:ExcludedReport = @()
    foreach ($p in $allProcs) {
        $key = $p.ProcessName.ToLower()
        if ($whitelistMap.ContainsKey($key) -or $p.Id -eq $selfPid) {
            $path = $null
            try { $path = $p.Path } catch {}
            $signed = $null
            $publisher = $null
            if ($path) {
                try {
                    $sig = Get-AuthenticodeSignature -FilePath $path -ErrorAction Stop
                    $signed = $sig.Status
                    if ($sig.SignerCertificate) { $publisher = $sig.SignerCertificate.Subject }
                } catch { $signed = "unreadable" }
            }
            $global:ExcludedReport += [PSCustomObject]@{
                Name      = $p.ProcessName
                PID       = $p.Id
                Path      = $path
                SizeMB    = Get-SizeMB $path
                Signature = $signed
                Publisher = $publisher
                Reason    = if ($p.Id -eq $selfPid) { "this script's own PowerShell process" } else { $whitelistMap[$key] }
            }
        }
    }

    $candidates = @($allProcs | Where-Object {
        $_.Id -ne $selfPid -and (-not $whitelistMap.ContainsKey($_.ProcessName.ToLower()))
    })

    if (-not $candidates) {
        Write-Host "Nothing to close - only excluded processes are running." -ForegroundColor Gray
        $global:CloseLog = @()
        return
    }

    Write-Host "Found $($candidates.Count) non-essential process(es). Closing..." -ForegroundColor Cyan
    Write-Host ""

    $log = @()

    foreach ($proc in $candidates) {
        $path = $null
        $signed = $null
        $publisher = $null
        $suspicious = $false
        $reason = @()
        $status = "Unknown"
        $startTime = $null

        try { $path = $proc.Path } catch { $path = $null }
        try { $startTime = $proc.StartTime } catch {}
        $sizeMB = Get-SizeMB $path

        if ($path) {
            try {
                $sig = Get-AuthenticodeSignature -FilePath $path -ErrorAction Stop
                $signed = ($sig.Status -eq "Valid")
                if ($sig.SignerCertificate) { $publisher = $sig.SignerCertificate.Subject }
            } catch { $signed = $false }

            if (-not $signed) { $suspicious = $true; $reason += "unsigned or invalid signature" }
            if ($path -match '\\(Temp|Downloads|AppData\\Local\\Temp)\\') {
                $suspicious = $true; $reason += "running from a temp/downloads folder"
            }
            # anything pretending to be Malwarebytes but not verified
            if ($MalwarebytesProcessNames -contains $proc.ProcessName) {
                $suspicious = $true; $reason += "named like Malwarebytes but FAILED verification"
            }
            if ($MossProcessNames -contains $proc.ProcessName) {
                $suspicious = $true; $reason += "named like MOSS but FAILED verification"
            }
        } else {
            $reason += "path unavailable"
        }

        try {
            Stop-Process -Id $proc.Id -Force -ErrorAction Stop
            $status = "Closed"
        } catch {
            try {
                $servicesForPid = Get-CimInstance Win32_Service -Filter "ProcessId = $($proc.Id)" -ErrorAction Stop
                if ($servicesForPid) {
                    $stoppedServiceNames = @()
                    foreach ($svc in $servicesForPid) {
                        try {
                            $service = Get-Service -Name $svc.Name -ErrorAction Stop
                            if ($service.Status -ne "Stopped") {
                                Stop-Service -Name $svc.Name -Force -ErrorAction Stop
                                $service.WaitForStatus("Stopped", [TimeSpan]::FromSeconds(10))
                            }
                            $stoppedServiceNames += $svc.Name
                        } catch { }
                    }
                    Start-Sleep -Milliseconds 500
                    if (-not (Get-Process -Id $proc.Id -ErrorAction SilentlyContinue)) {
                        if ($stoppedServiceNames.Count -gt 0) {
                            $status = "Closed (service stopped: $($stoppedServiceNames -join ', '))"
                        } else {
                            $status = "Service found, but could not be stopped"
                        }
                    } else {
                        try {
                            $tkOut = & taskkill /F /PID $proc.Id 2>&1
                            if ($LASTEXITCODE -eq 0) { $status = "Closed (service stopped + taskkill)" }
                            else { $status = "Failed to close: $tkOut" }
                        } catch { $status = "Failed to close: $($_.Exception.Message)" }
                    }
                } else {
                    try {
                        $tkOut = & taskkill /F /PID $proc.Id 2>&1
                        if ($LASTEXITCODE -eq 0) { $status = "Closed (via taskkill fallback)" }
                        else { $status = "Failed to close: $tkOut" }
                    } catch { $status = "Failed to close: $($_.Exception.Message)" }
                }
            } catch { $status = "Failed to close: $($_.Exception.Message)" }
        }

        $log += [PSCustomObject]@{
            Name       = $proc.ProcessName
            PID        = $proc.Id
            Path       = $path
            SizeMB     = $sizeMB
            Signed     = $signed
            Publisher  = $publisher
            StartTime  = $startTime
            Suspicious = $suspicious
            Notes      = ($reason -join "; ")
            Status     = $status
        }

        $color = if ($suspicious) { "Red" } elseif ($status -like "Closed*") { "Green" } elseif ($status -like "Failed*") { "DarkYellow" } else { "Gray" }
        Write-Host ("{0,-25} PID {1,-7} {2,-9} {3}" -f $proc.ProcessName, $proc.Id, "$sizeMB MB", $status) -ForegroundColor $color
    }

    $global:CloseLog = $log

    Write-Host ""
    $suspiciousCount = @($log | Where-Object { $_.Suspicious }).Count
    $closedCount     = @($log | Where-Object { $_.Status -like "Closed*" }).Count
    $failedCount     = @($log | Where-Object { $_.Status -notlike "Closed*" }).Count

    Write-Host "Closed $closedCount of $($candidates.Count); $failedCount could not be closed; $suspiciousCount flagged." -ForegroundColor Green

    if ($failedCount -gt 0) {
        Write-Host ""
        Write-Host "Could NOT be closed (these stay running - explain them on camera):" -ForegroundColor DarkYellow
        $log | Where-Object { $_.Status -notlike "Closed*" } | ForEach-Object {
            Write-Host ("  {0} (PID {1}) {2} MB - {3}" -f $_.Name, $_.PID, $_.SizeMB, $_.Path) -ForegroundColor DarkYellow
        }
    }

    if ($suspiciousCount -gt 0) {
        Write-Host ""
        Write-Host "Flagged processes:" -ForegroundColor Red
        $log | Where-Object { $_.Suspicious } | ForEach-Object {
            Write-Host ("  {0} (PID {1}) {2} MB - {3}" -f $_.Name, $_.PID, $_.SizeMB, $_.Path) -ForegroundColor Red
            Write-Host ("    Reason: {0}" -f $_.Notes) -ForegroundColor Red
        }
        Write-Host ""
        Write-Host "A flag is not proof of malicious activity; some legitimate tools are unsigned." -ForegroundColor Yellow
    }
}

# =========================================================================
# FINDINGS COLLECTOR
# =========================================================================
function Invoke-FindingsCollector {
    Section "Findings Collection"

    $collector = {
        param($ExcludedReport, $CloseLog, $DuplicateReport, $MonitorLog, $MbVerified, $MbRejected, $RecorderFamily, $MossVerified, $MossRejected)

        $desktop = [Environment]::GetFolderPath('Desktop')
        $stamp   = Get-Date -Format "yyyy-MM-dd_HH-mm-ss"
        $temp    = Join-Path $env:TEMP "findings_$stamp"
        New-Item -ItemType Directory -Path $temp -Force | Out-Null

        function Save($name, $scriptblock) {
            $path = Join-Path $temp "$name.txt"
            try {
                (& $scriptblock) | Out-String -Width 500 | Set-Content -Path $path -Encoding UTF8
            } catch {
                "ERROR: $_" | Set-Content -Path $path -Encoding UTF8
            }
        }

        function SaveCsv($name, $data) {
            $path = Join-Path $temp "$name.csv"
            try {
                if ($data) { $data | Export-Csv -Path $path -NoTypeInformation -Encoding UTF8 }
                else { "no rows" | Set-Content -Path $path -Encoding UTF8 }
            } catch { "ERROR: $_" | Set-Content -Path $path -Encoding UTF8 }
        }

        function SizeMB($p) {
            try { if ($p -and (Test-Path -LiteralPath $p)) { return [math]::Round((Get-Item -LiteralPath $p).Length / 1MB, 3) } } catch {}
            return $null
        }

        # ---- 01 process parentage, with size ----
        Save "01_process_parentage" {
            $parentMap = @{}
            Get-Process | ForEach-Object { $parentMap[$_.Id] = $_.Name }
            Get-CimInstance Win32_Process | Select-Object Name, ProcessId, ParentProcessId,
                @{n='ParentName';e={ if ($parentMap.ContainsKey([int]$_.ParentProcessId)) { $parentMap[[int]$_.ParentProcessId] } else { $null } }},
                @{n='SizeMB';e={ SizeMB $_.ExecutablePath }},
                ExecutablePath, CommandLine
        }

        # ---- 02 full process detail ----
        Save "02_process_details" {
            Get-CimInstance Win32_Process | ForEach-Object {
                [PSCustomObject]@{
                    ProcessId      = $_.ProcessId
                    Name           = $_.Name
                    ExecutablePath = $_.ExecutablePath
                    SizeMB         = SizeMB $_.ExecutablePath
                    WorkingSetMB   = [math]::Round($_.WorkingSetSize / 1MB, 2)
                    CommandLine    = $_.CommandLine
                }
            } | Format-List
        }

        # ---- 03 virtualization / system info ----
        Save "03_systeminfo_virtualization" { systeminfo | findstr /i "hyper os version page virtualization boot" }

        # ---- 04 scheduled tasks ----
        Save "04_scheduled_tasks" { Get-ScheduledTask | Select-Object TaskPath, TaskName, State, Author }

        # ---- 05 tasklist ----
        Save "05_tasklist" { tasklist /v }

        # ---- 06 process start times ----
        Save "06_process_starttimes" {
            Get-Process | ForEach-Object {
                $p = $null; try { $p = $_.Path } catch {}
                $st = $null; try { $st = $_.StartTime } catch {}
                [PSCustomObject]@{
                    Name      = $_.Name
                    PID       = $_.Id
                    StartTime = $st
                    SizeMB    = SizeMB $p
                    Path      = $p
                }
            } | Sort-Object StartTime -Descending
        }

        # ---- 07 all services with binary path + size ----
        Save "07_services_all" {
            Get-CimInstance Win32_Service | ForEach-Object {
                $bin = $_.PathName
                $exe = $null
                if ($bin) {
                    if ($bin -match '^"([^"]+)"') { $exe = $matches[1] }
                    elseif ($bin -match '^(\S+\.exe)') { $exe = $matches[1] }
                }
                [PSCustomObject]@{
                    Name        = $_.Name
                    DisplayName = $_.DisplayName
                    State       = $_.State
                    StartMode   = $_.StartMode
                    ProcessId   = $_.ProcessId
                    SizeMB      = SizeMB $exe
                    PathName    = $bin
                }
            } | Sort-Object State, Name
        }

        # ---- 08 background / running services only ----
        Save "08_background_services" {
            Get-Service | Where-Object { $_.Status -eq 'Running' } | Select-Object Name, DisplayName, Status
        }

        # ---- 09 DUPLICATE PROCESS INSTANCES ----
        Save "09_duplicate_processes" {
            if (-not $DuplicateReport -or $DuplicateReport.Count -eq 0) {
                "No process had more than one running instance at cleanup time."
            } else {
                "Processes observed with more than one instance running."
                "Multiple instances are normal for browsers/Discord/svchost, but are listed"
                "here so a reviewer can spot an unexpected second copy of something."
                ""
                $DuplicateReport | Sort-Object Name, PID | Format-Table -AutoSize Name, InstanceCount, PID, SizeMB, StartTime, Whitelisted, Path
            }
        }
        SaveCsv "09_duplicate_processes" $DuplicateReport

        # ---- 10 EXCLUDED FROM CLOSING ----
        Save "10_excluded_from_closing" {
            "Processes deliberately NOT closed, with the reason each was spared."
            "Recorder family in use: $RecorderFamily"
            ""
            $ExcludedReport | Sort-Object Reason, Name | Format-Table -AutoSize Name, PID, SizeMB, Signature, Reason, Path
            ""
            "--- full paths ---"
            $ExcludedReport | Sort-Object Name | ForEach-Object {
                "{0} (PID {1})`n    path      : {2}`n    size      : {3} MB`n    signature : {4}`n    publisher : {5}`n    reason    : {6}`n" -f `
                    $_.Name, $_.PID, $_.Path, $_.SizeMB, $_.Signature, $_.Publisher, $_.Reason
            }
        }
        SaveCsv "10_excluded_from_closing" $ExcludedReport

        # ---- 11 FAILED TO CLOSE ----
        $failed = @($CloseLog | Where-Object { $_.Status -notlike "Closed*" })
        Save "11_failed_to_close" {
            if ($failed.Count -eq 0) {
                "Every non-excluded process was closed successfully."
            } else {
                "These processes survived the cleanup stage and were still running."
                ""
                $failed | Format-Table -AutoSize Name, PID, SizeMB, Signed, Status, Path
                ""
                "--- full paths ---"
                $failed | ForEach-Object {
                    "{0} (PID {1})`n    path   : {2}`n    size   : {3} MB`n    signed : {4}`n    status : {5}`n    notes  : {6}`n" -f `
                        $_.Name, $_.PID, $_.Path, $_.SizeMB, $_.Signed, $_.Status, $_.Notes
                }
            }
        }
        SaveCsv "11_failed_to_close" $failed

        # ---- 12 everything the cleanup touched ----
        SaveCsv "12_closed_processes" $CloseLog

        # ---- 13 network connections ----
        Save "13_network_connections" { netstat -anob }

        # ---- 14 drivers with size + signature ----
        Save "14_driver_list" {
            Get-CimInstance Win32_SystemDriver | ForEach-Object {
                $p = $_.PathName
                if ($p) { $p = $p -replace '^\\\?\?\\', '' }
                $sig = $null
                try { if ($p -and (Test-Path -LiteralPath $p)) { $sig = (Get-AuthenticodeSignature -FilePath $p -ErrorAction Stop).Status } } catch {}
                [PSCustomObject]@{
                    Name      = $_.Name
                    State     = $_.State
                    StartMode = $_.StartMode
                    SizeMB    = SizeMB $p
                    Signature = $sig
                    PathName  = $p
                }
            } | Sort-Object State, Name
        }

        # ---- 15 unsigned exes in Program Files ----
        $pfPaths = @($env:ProgramFiles, ${env:ProgramFiles(x86)}) | Where-Object { $_ -and (Test-Path $_) } | Select-Object -Unique
        $pfFiles = Get-ChildItem -Path $pfPaths -Recurse -Include *.exe -ErrorAction SilentlyContinue
        $sizeMap = @{}
        foreach ($f in $pfFiles) { $sizeMap[$f.FullName] = $f.Length }

        $unsigned = $pfFiles | Get-AuthenticodeSignature |
            Where-Object { $_.Status -ne 'Valid' } |
            Select-Object Path, Status,
                @{n='SizeMB';e={ if ($sizeMap.ContainsKey($_.Path)) { [math]::Round($sizeMap[$_.Path] / 1MB, 3) } else { $null } }}

        Save "15_unsigned_program_files_exes" { $unsigned }

        Save "15b_unsigned_exe_hashes" {
            foreach ($i in $unsigned) {
                "-- $($i.Path) (Size: $($i.SizeMB) MB) --"
                try { (Get-FileHash -Path $i.Path -Algorithm SHA256 -ErrorAction Stop).Hash } catch { "Could not hash: $_" }
                ""
            }
            "NOTE: VirusTotal checking is manual."
        }

        # ---- 16 root certificates ----
        Save "16_root_certificates" {
            Get-ChildItem Cert:\LocalMachine\Root |
                Select-Object Subject, Thumbprint, NotBefore, NotAfter |
                Sort-Object NotBefore -Descending
        }

        # ---- 17 prefetch metadata ----
        Save "17_prefetch_files" {
            Get-ChildItem "$env:WINDIR\Prefetch" -Filter *.pf -ErrorAction SilentlyContinue |
                Select-Object Name,
                    @{n='SizeKB';e={[math]::Round($_.Length / 1KB, 2)}},
                    @{n='SizeMB';e={[math]::Round($_.Length / 1MB, 4)}},
                    CreationTime, LastWriteTime, LastAccessTime |
                Sort-Object LastWriteTime -Descending
        }

        # ---- 18 recent items ----
        Save "18_recent_items" {
            Get-ChildItem "$env:APPDATA\Microsoft\Windows\Recent" -ErrorAction SilentlyContinue |
                Select-Object Name,
                    @{n='SizeKB';e={[math]::Round($_.Length / 1KB, 2)}},
                    CreationTime, LastWriteTime |
                Sort-Object LastWriteTime -Descending
        }

        # ---- 19 recent item targets ----
        Save "19_recent_items_targets" {
            $sh = New-Object -ComObject WScript.Shell
            Get-ChildItem "$env:APPDATA\Microsoft\Windows\Recent" -Filter *.lnk -ErrorAction SilentlyContinue |
                ForEach-Object {
                    try {
                        $lnk = $sh.CreateShortcut($_.FullName)
                        [PSCustomObject]@{
                            Name          = $_.Name
                            Target        = $lnk.TargetPath
                            Arguments     = $lnk.Arguments
                            LnkSizeKB     = [math]::Round($_.Length / 1KB, 2)
                            TargetSizeMB  = SizeMB $lnk.TargetPath
                            LastWriteTime = $_.LastWriteTime
                        }
                    } catch {
                        [PSCustomObject]@{ Name = $_.Name; Target = "ERROR"; Arguments = ""; LnkSizeKB = $null; TargetSizeMB = $null; LastWriteTime = $_.LastWriteTime }
                    }
                }
        }

        # ---- 20 MUI cache (apps that have been run, survives uninstall) ----
        Save "20_mui_cache" {
            "registry path: HKCU:\Software\Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache"
            ""
            $k = "HKCU:\Software\Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache"
            if (Test-Path $k) {
                $props = Get-ItemProperty -Path $k
                $props.PSObject.Properties |
                    Where-Object { $_.Name -notlike "PS*" } |
                    ForEach-Object {
                        $exe = ($_.Name -split '\.(FriendlyAppName|ApplicationCompany)$')[0]
                        [PSCustomObject]@{
                            Entry  = $_.Name
                            Value  = $_.Value
                            SizeMB = SizeMB $exe
                        }
                    } | Sort-Object Entry
            } else { "MuiCache key not present." }
        }

        # ---- 21 BAM (background activity moderator - last run times) ----
        Save "21_bam_summary" {
            "registry path: HKLM:\SYSTEM\CurrentControlSet\Services\bam\State\UserSettings"
            ""
            $bam = "HKLM:\SYSTEM\CurrentControlSet\Services\bam\State\UserSettings"
            if (Test-Path $bam) {
                Get-ChildItem $bam -ErrorAction SilentlyContinue | ForEach-Object {
                    "path: $($_.Name)"
                    $props = Get-ItemProperty -Path $_.PSPath
                    $props.PSObject.Properties | Where-Object { $_.Name -notlike "PS*" } | ForEach-Object {
                        $clean = $_.Name -replace '^\\Device\\HarddiskVolume\d+', $env:SystemDrive
                        "  {0}  [{1} MB]" -f $_.Name, (SizeMB $clean)
                    }
                    ""
                }
            } else { "BAM key not present." }
        }

        # ---- 22 USN journal (file create/delete since boot) ----
        Save "22_usn_journal_activity" {
            "USN journal activity on $env:SystemDrive - executable-ish extensions only."
            "Journal records carry filename + parent reference, not a full path."
            ""
            try {
                $raw = & fsutil usn readjournal $env:SystemDrive csv 2>&1
                $raw | Where-Object { $_ -match '\.(exe|dll|sys|bat|cmd|ps1|vbs|scr|msi)\b' } | Select-Object -Last 2000
            } catch { "Could not read USN journal: $_" }
        }

        # ---- 23 security posture (Malwarebytes-aware) ----
        Save "23_security_summary" {
            try {
                $sb = Confirm-SecureBootUEFI -ErrorAction Stop
                if ($sb) { "SUCCESS: Secure Boot is ON" } else { "WARNING: Secure Boot is OFF" }
            } catch { "INFO: Secure Boot state unavailable (legacy BIOS or not permitted)" }

            try {
                $dg = Get-CimInstance -ClassName Win32_DeviceGuard -Namespace root\Microsoft\Windows\DeviceGuard -ErrorAction Stop
                if ($dg.VirtualizationBasedSecurityStatus -eq 2) { "SUCCESS: VBS is running" }
                else { "WARNING: VBS is not running (status $($dg.VirtualizationBasedSecurityStatus))" }
                if ($dg.CodeIntegrityPolicyEnforcementStatus -ge 1) { "SUCCESS: Memory Integrity / HVCI enforced" }
                else { "WARNING: Memory Integrity / HVCI not enforced" }
            } catch { "INFO: Device Guard status unavailable" }

            ""
            "--- registered antivirus products ---"
            try {
                Get-CimInstance -Namespace root\SecurityCenter2 -ClassName AntiVirusProduct -ErrorAction Stop |
                    ForEach-Object { "  {0}  (exe: {1})" -f $_.displayName, $_.pathToSignedProductExe }
            } catch { "  could not query SecurityCenter2" }

            ""
            "--- Malwarebytes verification result ---"
            "  recorder family in use: $RecorderFamily"
            if (@($MbVerified | Where-Object { $_ }).Count -gt 0) {
                "  SUCCESS: $($MbVerified.Count) verified-genuine Malwarebytes process(es) excluded from closing"
                $MbVerified | ForEach-Object {
                    "    {0} (PID {1}) {2} MB  knownBuild={3}`n      path: {4}`n      publisher: {5}`n      sha256: {6}" -f `
                        $_.Name, $_.PID, $_.SizeMB, $_.KnownBuild, $_.Path, $_.Publisher, $_.SHA256
                }
            } else {
                "  FAILURE: no Malwarebytes process passed verification"
            }
            if (@($MbRejected | Where-Object { $_ }).Count -gt 0) {
                ""
                "  WARNING: $($MbRejected.Count) process(es) named like Malwarebytes FAILED verification and were NOT excluded:"
                $MbRejected | ForEach-Object {
                    "    {0} (PID {1})`n      path: {2}`n      size: {3} MB`n      reason: {4}" -f `
                        $_.Name, $_.PID, $_.Path, $_.SizeMB, ($_.Reason -join "; ")
                }
            }

            ""
            "--- MOSS verification result ---"
            if (@($MossVerified | Where-Object { $_ }).Count -gt 0) {
                "  SUCCESS: $(@($MossVerified).Count) verified MOSS process(es) excluded from closing"
                $MossVerified | ForEach-Object {
                    "    {0} (PID {1}) {2} MB  knownBuild={3}`n      path: {4}`n      size: {5} bytes`n      signature: {6}`n      sha256: {7}`n      note: {8}" -f `
                        $_.Name, $_.PID, $_.SizeMB, $_.KnownBuild, $_.Path, $_.SizeBytes, $_.SignatureStatus, $_.SHA256, ($_.Reason -join "; ")
                }
            } else {
                "  INFO: no MOSS process passed verification (or MOSS was not running)"
            }
            if (@($MossRejected | Where-Object { $_ }).Count -gt 0) {
                ""
                "  WARNING: $(@($MossRejected).Count) process(es) named like MOSS FAILED verification and were NOT excluded:"
                $MossRejected | ForEach-Object {
                    "    {0} (PID {1})`n      path: {2}`n      size: {3} bytes`n      reason: {4}" -f `
                        $_.Name, $_.PID, $_.Path, $_.SizeBytes, ($_.Reason -join "; ")
                }
            }

            ""
            "--- Malwarebytes services ---"
            Get-Service -Name "MBAMService","MBAMProtection","mbamchameleon","MBVpnTunnelService" -ErrorAction SilentlyContinue |
                ForEach-Object { "  {0}: {1}" -f $_.Name, $_.Status }
        }

        # ---- 24 PowerShell environment ----
        Save "24_powershell_check" {
            "INFO: version $($PSVersionTable.PSVersion), edition $($PSVersionTable.PSEdition)"
            "INFO: language mode: $($ExecutionContext.SessionState.LanguageMode)"
            "INFO: host: $($Host.Name), pid: $PID"
            ""
            foreach ($c in @('get-ciminstance','get-service','get-itemproperty','get-filehash','copy-item','stop-process')) {
                try {
                    $cmd = Get-Command $c -ErrorAction Stop
                    "SUCCESS: '$c' resolves via '$($cmd.Source)'"
                } catch { "FAILURE: '$c' could not be resolved" }
            }
        }

        # ---- 25 monitor watchdog log ----
        Save "25_display_watchdog" {
            "Continuous second-display monitoring for this session."
            ""
            if ($MonitorLog -and $MonitorLog.Count -gt 0) { $MonitorLog } else { "no entries" }
        }

        # ---- 26 severity summary ----
        $critical = @($CloseLog | Where-Object { $_.Notes -like "*named like Malwarebytes*" -or $_.Notes -like "*named like MOSS*" }).Count `
                    + @($MbRejected | Where-Object { $_ }).Count `
                    + @($MossRejected | Where-Object { $_ }).Count
        $high     = @($CloseLog | Where-Object { $_.Suspicious -and $_.Notes -like "*temp/downloads*" }).Count
        $medium   = @($CloseLog | Where-Object { $_.Suspicious -and $_.Notes -like "*unsigned*" }).Count
        $low      = @($CloseLog | Where-Object { $_.Status -notlike "Closed*" }).Count

        Save "26_severity_summary" {
            "Findings by severity this session:"
            ""
            "Critical  : $critical"
            "High      : $high"
            "Medium    : $medium"
            "Low       : $low"
            ""
            "Critical = process impersonating verified security software"
            "High     = executing from a temp/downloads path"
            "Medium   = unsigned or invalid signature"
            "Low      = could not be closed (informational)"
            ""
            "These are heuristics, not verdicts. A flag means 'look closer', not 'guilty'."
        }

        # ---- raw artifact copies ----
        $logsRoot = Join-Path $temp "artifacts"
        New-Item -ItemType Directory -Path $logsRoot -Force | Out-Null

        function Copy-Artifact($label, $source, $destSubfolder) {
            $dest = Join-Path $logsRoot $destSubfolder
            try {
                if (Test-Path $source) {
                    New-Item -ItemType Directory -Path $dest -Force | Out-Null
                    Copy-Item -Path (Join-Path $source '*') -Destination $dest -Recurse -Force -ErrorAction SilentlyContinue
                    $copied = @(Get-ChildItem $dest -Recurse -File -ErrorAction SilentlyContinue)
                    $sum    = ($copied | Measure-Object Length -Sum).Sum
                    $sizeMB = if ($null -eq $sum) { 0 } else { [math]::Round($sum / 1MB, 2) }
                    "OK   [$label] $($copied.Count) files, $sizeMB MB copied from '$source' -> artifacts\$destSubfolder"
                } else { "SKIP [$label] source not found: $source" }
            } catch { "FAIL [$label] error copying from '$source': $_" }
        }

        $copyLog = @()
        $copyLog += Copy-Artifact "Prefetch"           "$env:WINDIR\Prefetch"                  "Prefetch"
        $copyLog += Copy-Artifact "Recent items"       "$env:APPDATA\Microsoft\Windows\Recent" "Recent"
        $copyLog += Copy-Artifact "Windows Event Logs" "$env:WINDIR\System32\winevt\Logs"      "EventLogs"
        $copyLog | Set-Content -Path (Join-Path $temp "27_raw_artifact_copy_log.txt") -Encoding UTF8

        # ---- checksum manifest: size + SHA256 for EVERY file in the package ----
        $manifest = @()
        $manifest += "format: SHA256 + size for every file in this package"
        $manifest += "created (UTC): $((Get-Date).ToUniversalTime().ToString('o'))"
        $allOut = @(Get-ChildItem $temp -Recurse -File | Sort-Object FullName)
        $manifest += "file count: $($allOut.Count)"
        $manifest += ""
        foreach ($f in $allOut) {
            $rel = $f.FullName.Substring($temp.Length + 1)
            $h = "UNREADABLE"
            try { $h = (Get-FileHash -Path $f.FullName -Algorithm SHA256 -ErrorAction Stop).Hash } catch {}
            $manifest += "path: $rel"
            $manifest += "size: $($f.Length)"
            $manifest += "sizeMB: $([math]::Round($f.Length / 1MB, 4))"
            $manifest += "sha256: $h"
            $manifest += ""
        }
        $manifest | Set-Content -Path (Join-Path $temp "00_checksums.txt") -Encoding UTF8

        # ---- package ----
        $acFolder = Join-Path $desktop "AC-FINDINGS"
        New-Item -ItemType Directory -Path $acFolder -Force | Out-Null
        $zipPath = Join-Path $acFolder "FINDINGS-$stamp.zip"
        if (Test-Path $zipPath) { Remove-Item $zipPath -Force }

        Add-Type -AssemblyName System.IO.Compression.FileSystem
        [System.IO.Compression.ZipFile]::CreateFromDirectory(
            $temp, $zipPath, [System.IO.Compression.CompressionLevel]::Optimal, $false)

        Remove-Item $temp -Recurse -Force
        return $zipPath
    }

    $job = Start-Job -ScriptBlock $collector -ArgumentList @(
        $global:ExcludedReport,
        $global:CloseLog,
        $global:DuplicateReport,
        @($global:MonitorLog),
        $global:MalwarebytesVerified,
        $global:MalwarebytesRejected,
        $global:RecorderFamily,
        $global:MossVerified,
        $global:MossRejected
    )

    $spinner = @('|','/','-','\')
    $i = 0
    while ($job.State -eq 'Running') {
        Write-Host -NoNewline ("`r  Collecting findings... $($spinner[$i % $spinner.Length])  ")
        Start-Sleep -Milliseconds 150
        $i++
    }
    Write-Host -NoNewline "`r"

    if ($job.State -eq 'Failed') {
        Write-Host "  Findings collection FAILED." -ForegroundColor Red
        Receive-Job -Job $job -ErrorAction SilentlyContinue 2>&1 | ForEach-Object { Write-Host "  $_" -ForegroundColor Red }
        Remove-Job -Job $job -Force -ErrorAction SilentlyContinue
        return
    }

    $zipPath = Receive-Job -Job $job -ErrorAction SilentlyContinue | Where-Object { $_ -is [string] } | Select-Object -Last 1
    Remove-Job -Job $job -Force -ErrorAction SilentlyContinue

    if (-not $zipPath -or -not (Test-Path $zipPath)) {
        Write-Host "Findings collection finished, but the ZIP could not be located." -ForegroundColor Red
        return
    }

    $zipSizeMB = [math]::Round((Get-Item $zipPath).Length / 1MB, 2)
    Write-Host "Findings saved to: $zipPath" -ForegroundColor Green
    Write-Host "ZIP size: $zipSizeMB MB" -ForegroundColor Green
    $global:FindingsZip = $zipPath
}

# =========================================================================
# STAGE: CLEAN REINSTALL (Tier 2/3 only)
# =========================================================================
function Invoke-RobloxReinstall {
    Section "Roblox Clean Reinstall"
    $robloxProcs = Get-Process RobloxPlayerBeta, RobloxPlayerLauncher, RobloxCrashHandler -ErrorAction SilentlyContinue
    if ($robloxProcs) {
        Write-Host "Closing Roblox..." -ForegroundColor Cyan
        $robloxProcs | Stop-Process -Force
        $robloxProcs | Wait-Process -Timeout 10 -ErrorAction SilentlyContinue
        Start-Sleep -Seconds 1
    }

    $robloxPath = "$env:LOCALAPPDATA\Roblox"
    if (Test-Path $robloxPath) {
        for ($attempt = 1; $attempt -le 3; $attempt++) {
            try {
                Remove-Item $robloxPath -Recurse -Force -ErrorAction Stop
                Write-Host "Removed: $robloxPath" -ForegroundColor Green
                break
            } catch {
                if ($attempt -lt 3) { Start-Sleep -Seconds 2 } else { Write-Host "Could not fully delete $robloxPath : $_" -ForegroundColor Red }
            }
        }
    }

    Write-Host "Opening the Roblox download page - install it yourself, this will detect when it's done." -ForegroundColor Cyan
    Start-Process "https://www.roblox.com/download"

    $installed = $false
    $elapsed = 0
    while (-not $installed -and $elapsed -lt 600) {
        Start-Sleep -Seconds 3
        $elapsed += 3
        if ((Test-Path (Join-Path $robloxPath "Versions")) -or (Get-Process RobloxPlayerBeta, RobloxPlayerLauncher -ErrorAction SilentlyContinue)) {
            $installed = $true
        } else { Write-Host "." -NoNewline -ForegroundColor DarkGray }
    }
    Write-Host ""
    if (-not $installed) {
        Write-Host "Didn't detect a completed install after 10 minutes. Launch Roblox once manually, then re-run." -ForegroundColor Red
        return $false
    }
    Write-Host "Roblox install detected." -ForegroundColor Green
    return $true
}

# =========================================================================
# BEFORE-LAUNCHING STEP FUNCTIONS
# =========================================================================
function Step-TrayIcons {
    Section "Hidden Tray Icons"
    Pause-ForCamera "Click the small arrow in the system tray ('Show hidden icons') and hover over each one."
}

function Step-Autoruns {
    Section "Sysinternals Autoruns"
    $exe = Find-Exe @("autoruns64.exe", "autoruns.exe") $searchDirs
    if ($exe) { Start-Process $exe -Verb RunAs } else { Write-Host "Launch Autoruns manually as Administrator." -ForegroundColor DarkYellow }
    Pause-ForCamera "Go to the 'Everything' tab, wait for the scan, click Expand All, scroll slowly top to bottom."
}

function Step-Moss {
    Section "MOSS"
    $exe = Find-Exe @("MOSS.exe", "MOSSX64.exe", "MossX645.exe") $searchDirs
    if ($exe) { Start-Process $exe } else { Write-Host "Launch MOSS manually." -ForegroundColor DarkYellow }
    Write-Host "MOSS is excluded from the process cleanup and must stay running all match." -ForegroundColor Green
    Pause-ForCamera "File > Parameters > Pick Roblox > OK > Capture > Start."
}

function Step-DeviceManager {
    Section "Device Manager"
    Start-Process "devmgmt.msc"
    Pause-ForCamera "View > Show Hidden Devices, expand Display Adapters and Monitors."
}

function Step-UAC {
    Section "UAC Level"
    try { Start-Process "UserAccountControlSettings" } catch { Start-Process "control.exe" -ArgumentList "/name Microsoft.UserAccounts" }
    Pause-ForCamera "Confirm UAC slider is on the second-lowest setting."
}

function Step-RegeditExclusions {
    Section "Defender Exclusions (Registry)"
    $regeditKey = "HKCU:\Software\Microsoft\Windows\CurrentVersion\Applets\Regedit"
    try {
        if (-not (Test-Path $regeditKey)) { New-Item -Path $regeditKey -Force | Out-Null }
        Set-ItemProperty -Path $regeditKey -Name "LastKey" -Value "Computer\HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Defender\Exclusions" -Force
    } catch {}
    Start-Process "regedit.exe"
    Pause-ForCamera "Confirm it opened at ...\Windows Defender\Exclusions and click through all 5 subfolders."
}

function Step-Prefetch {
    Section "Prefetch Folder"
    Start-Process "explorer.exe" -ArgumentList "$env:WINDIR\Prefetch"
    Pause-ForCamera "Scroll to the bottom. Open and show contents of any subfolders present."
}

function Step-RecentItems {
    Section "Recent Items"
    Start-Process "explorer.exe" -ArgumentList "shell:recent"
    Pause-ForCamera "Scroll to the bottom. Open and show contents of any subfolders present."
}

function Step-Malwarebytes([switch]$SkipScan) {
    Section "Malwarebytes"
    $exe = Find-Exe @("MBAM.exe", "Malwarebytes.exe", "mbam.exe") @("$env:ProgramFiles\Malwarebytes\Anti-Malware", "$env:ProgramFiles\Malwarebytes", "${env:ProgramFiles(x86)}\Malwarebytes")
    if ($exe) { Start-Process $exe } else { Write-Host "Launch Malwarebytes manually." -ForegroundColor DarkYellow }
    Pause-ForCamera "Dashboard > Detection History > Allow List: only nohope.eu and http://download.ericzimmermanstools.com/ permitted."
    Pause-ForCamera "Settings > Scan and Detections: confirm 'Scan for Rootkits' is enabled."
    if (-not $SkipScan) { Pause-ForCamera "Dashboard > Scanner > Scan. Wait, then quarantine all detections." }
    Pause-ForCamera "Settings > Notifications: confirm all Protection notifications are on."
}

function Step-Bootstrapper {
    Section "Bootstrapper Integrations"
    $found = @("Bloxstrap", "Fishstrap") | Where-Object { Get-Process -Name $_ -ErrorAction SilentlyContinue }
    if (-not $found) { Write-Host "None detected. Open yours manually if you use one." -ForegroundColor Gray }
    Pause-ForCamera "Open your bootstrapper -> Integrations -> scroll to the bottom."
}

function Step-CoreIsolation {
    Section "Core Isolation / Memory Integrity"
    Start-Process "windowsdefender://coreisolation"
    Pause-ForCamera "Show Core Isolation ON."
    Pause-ForCamera "Show Kernel-Mode Hardware-enforced Stack Protection ON."
    Pause-ForCamera "Show Microsoft Vulnerable Driver Blocklist ON."
}

function Step-Hotkeys {
    Section "Recording Software Hotkeys"
    Pause-ForCamera "Open your recorder's hotkey settings and show them."
}

function Step-UnnecessarySoftwareCheck {
    Section "Unnecessary Hotkey/Mouse Software"
    Write-Host "Rule: close anything unnecessary. If something must stay open, you have to justify it on camera." -ForegroundColor $theme.Accent
    $extra = Read-Host "List any extra process names you're keeping open and can justify (comma separated, or leave blank)"
    if ($extra) {
        Pause-ForCamera "Explain on camera why each of these is necessary: $extra"
        return ($extra -split ',' | ForEach-Object { $_.Trim().ToLower() } | Where-Object { $_ })
    }
    return @()
}

function Step-ProxyLock {
    Section "WinHTTP Proxy Lock"
    if (-not (Get-Job -Name "ProxyLock" -ErrorAction SilentlyContinue)) {
        Start-Job -Name "ProxyLock" -ScriptBlock { while ($true) { netsh winhttp set proxy 127.0.0.1:1 | Out-Null } } | Out-Null
        Write-Host "Started proxy lock." -ForegroundColor Green
    }
    Write-Host "Leave THIS window open for the rest of the match." -ForegroundColor Red
    Pause-ForCamera "Show the proxy lock command/output before continuing."
}

function Step-JoinGame([switch]$Repeat) {
    Section "Join Game"
    if ($Repeat) {
        Write-Host "Press Windows + Tab now. Only one desktop is allowed." -ForegroundColor $theme.Accent
        Read-Host "Press Enter once shown"
    } else {
        Write-Host "Hold Windows + Tab while joining until fully loaded. Only one desktop is allowed." -ForegroundColor $theme.Accent
        Read-Host "Once joined and loaded, press Enter to continue"
    }
    Show-MonitorAlertIfAny
}

function Step-TaskManager {
    Section "Task Manager"
    Start-Process "taskmgr.exe"
    Write-Host "Configure Task Manager exactly like this:" -ForegroundColor Yellow
    Write-Host "  1. Right-click the Name column header and enable Process Name AND Command Line." -ForegroundColor White
    Write-Host "  2. Drag the Command Line column wider until Disk and Network are pushed OFF screen." -ForegroundColor White
    Write-Host "     CPU and Memory MUST still be visible - do not push those off." -ForegroundColor Red
    Write-Host "  3. View > Expand All (3 dots, top right)." -ForegroundColor White
    Write-Host "  4. Scroll to the VERY BOTTOM so every process is shown." -ForegroundColor White
    Pause-ForCamera "Show Task Manager with Command Line wide, Disk/Network hidden, CPU + Memory visible."
}

function Step-PowerShellDump {
    Section "PowerShell Process/System Dump"
    Get-CimInstance Win32_Process | Select-Object Name, ProcessId,
        @{n='SizeMB';e={ Get-SizeMB $_.ExecutablePath }}, CommandLine | Format-Table -AutoSize
    Pause-ForCamera "Scroll this output top to bottom, then back up."
    systeminfo | findstr /i "hyper os version page virtualization"
    Pause-ForCamera "Confirm this output is visible."
}

function Invoke-BeforeLaunching([switch]$Repeat) {
    Step-TrayIcons
    if ($tier -in @('2','3')) { Step-Autoruns; Step-Moss }
    if ($tier -eq '3') { Step-DeviceManager }
    Step-UAC
    Step-RegeditExclusions
    if ($tier -in @('1','3')) { Step-Prefetch; Step-RecentItems }
    Step-Malwarebytes -SkipScan:$Repeat
    Step-Bootstrapper
    Step-CoreIsolation
    if ($tier -in @('2','3')) { Step-Hotkeys }
    if (-not $Repeat) { $global:justifiedExtras = Step-UnnecessarySoftwareCheck }
    Step-ProxyLock
    Step-JoinGame -Repeat:$Repeat
}

function Invoke-AfterLaunching([switch]$Repeat) {
    Step-TaskManager
    if ($tier -eq '1') { Step-PowerShellDump }
}

