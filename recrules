function Remove-RobloxStrap($names) {
    # Kill strap + Roblox, then delete strap folder, uninstall entry and shortcuts.
    foreach ($n in $names) {
        Get-Process -Name $n -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
    }
    Get-Process RobloxPlayerBeta, RobloxPlayerLauncher, RobloxCrashHandler -ErrorAction SilentlyContinue |
        Stop-Process -Force -ErrorAction SilentlyContinue
    Start-Sleep -Seconds 2

    $allGone = $true
    foreach ($n in $names) {
        $dir = Join-Path $env:LOCALAPPDATA $n
        if (Test-Path $dir) {
            try {
                Remove-Item $dir -Recurse -Force -ErrorAction Stop
                Write-Host "    Deleted: $dir" -ForegroundColor Green
            } catch {
                Write-Host "    Could not delete $dir : $($_.Exception.Message)" -ForegroundColor Red
                $allGone = $false
            }
        }
        $key = "HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\$n"
        if (Test-Path $key) { Remove-Item $key -Recurse -Force -ErrorAction SilentlyContinue }
        foreach ($d in @("$env:APPDATA\Microsoft\Windows\Start Menu\Programs", [Environment]::GetFolderPath('Desktop'))) {
            if (Test-Path $d) {
                Get-ChildItem -Path $d -Filter "$n*.lnk" -Recurse -ErrorAction SilentlyContinue |
                    Remove-Item -Force -ErrorAction SilentlyContinue
            }
        }
    }
    return $allGone
}

