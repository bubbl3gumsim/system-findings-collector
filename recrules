# The "only allowed programs" rule applies from the moment the player is told everything is closed
# (Tier 2/3) or from the start of the match (Tier 1), until the match ends.
function Test-RuleWindow([datetime]$t) {
    $s = $global:RuleStart
    if (-not $s) { $s = $global:MatchStart }
    if (-not $s -or $t -lt $s) { return $false }
    if ($global:MatchEnd -and $t -gt $global:MatchEnd) { return $false }
    return $true
}

function Test-SessionIntegrity {
    foreach ($s in $global:ShadowRemoved) {
        Add-Finding 'CHECK' 'Tampering evidence' 'The PowerShell window already had a user-defined alias or function replacing a command the script uses (the script removed it)' $s
    }
    if ($global:NativePreexisting) {
        Add-Finding 'CHECK' 'Tampering evidence' 'A type named RecNative already existed in this PowerShell window before the script defined it (the script did not use it)' 'The script may have been run earlier in the same window'
    }
    try {
        foreach ($pp in @($PROFILE.AllUsersAllHosts, $PROFILE.AllUsersCurrentHost, $PROFILE.CurrentUserAllHosts, $PROFILE.CurrentUserCurrentHost)) {
            if ($pp -and (Test-Path -LiteralPath $pp)) { Add-Finding 'CHECK' 'Tampering evidence' 'A PowerShell profile script exists (it runs before this script starts)' "$pp (sha256 $(Get-FileSha $pp))" }
        }
    } catch {}
}

function Get-PhaseFor([datetime]$when) {
    if (-not $global:MatchStart -or $when -lt $global:MatchStart) { return 'BEFORE' }
    if ($global:MatchEnd -and $when -gt $global:MatchEnd) { return 'AFTER' }
    return 'DURING'
}

function Add-TL([string]$src, [string]$msg, $when = $null) {
    if ($null -eq $when) { $when = Get-Date }
    [void]$global:Timeline.Add([PSCustomObject]@{
        Time = [datetime]$when; Phase = (Get-PhaseFor ([datetime]$when)); Source = $src; Detail = $msg })
}

function Add-Finding([string]$kind, [string]$area, [string]$title, [string]$detail = '', $when = $null) {
    $key = "$kind|$area|$title|$detail"
    if ($global:FindingKeys.ContainsKey($key)) { return }
    $global:FindingKeys[$key] = $true
    $t = Get-Date
    if ($when) { $t = [datetime]$when } elseif ($global:FindingTimeOverride) { $t = [datetime]$global:FindingTimeOverride }
    [void]$global:Findings.Add([PSCustomObject]@{
        Time = $t; Phase = (Get-PhaseFor $t); Kind = $kind; Area = $area; Title = $title; Detail = $detail })
    Add-TL 'FINDING' ("[{0}/{1}] {2} {3}" -f $kind, $area, $title, $detail) $t
}

function Add-Note([string]$msg) { [void]$global:ScanNotes.Add(("[{0}] {1}" -f (Get-Date -Format 'HH:mm:ss'), $msg)) }
function Set-RuleChecked([string]$id) { $global:RuleChecked[$id] = $true }

# ---------- paths and signatures ----------
function Normalize-Path([string]$p) {
    if (-not $p) { return $null }
    $p = $p.Trim().Trim('"')
    $p = $p -replace '^\\\\\?\\', ''
    $p = $p -replace '^\\\?\?\\', ''
    if ($p -match '^\\SystemRoot\\') { $p = $p -replace '^\\SystemRoot', $env:WINDIR }
    if ($p -eq '') { return $null }
    return $p
}

function Get-SigInfo($path) {
    if (-not $path) { return [PSCustomObject]@{ Status = 'NoPath'; Publisher = $null; Cn = $null } }
    $k = $path.ToLower()
    if ($global:SigCache.ContainsKey($k)) { return $global:SigCache[$k] }
    $r = [PSCustomObject]@{ Status = 'Missing'; Publisher = $null; Cn = $null }
    try {
        if (Test-Path -LiteralPath $path) {
            $s = Get-AuthenticodeSignature -LiteralPath $path -ErrorAction Stop
            $pub = $null; $cn = $null
            if ($s.SignerCertificate) {
                $pub = $s.SignerCertificate.Subject
                if ($pub -match 'CN="?([^",]+)') { $cn = $matches[1].Trim() }
            }
            $r = [PSCustomObject]@{ Status = [string]$s.Status; Publisher = $pub; Cn = $cn }
        }
    } catch { $r = [PSCustomObject]@{ Status = 'Unreadable'; Publisher = $null; Cn = $null } }
    $global:SigCache[$k] = $r
    return $r
}

function Get-FileSha([string]$p) {
    try { return (Get-FileHash -LiteralPath $p -Algorithm SHA256 -ErrorAction Stop).Hash } catch { return 'UNREADABLE' }
}

function Get-ShaIfSmall([string]$p) {
    try {
        if ($p -and (Test-Path -LiteralPath $p)) {
            if ((Get-Item -LiteralPath $p -ErrorAction Stop).Length -le 200MB) { return (Get-FileSha $p) }
            return 'SKIPPED(file over 200 MB)'
        }
    } catch {}
    return 'FILE NOT FOUND'
}

function Get-LocationClass([string]$path) {
    if (-not $path) { return 'unknown' }
    if ($path -match '(?i)^[a-z]:\\windows\\(temp|tasks|debug|tracing|system32\\(spool\\drivers|tasks|config\\systemprofile|catroot2)|syswow64\\tasks)\\') { return 'user-writable' }
    if ($path -match '(?i)^[a-z]:\\windows\\system32\\driverstore\\filerepository\\') { return 'driverstore' }
    if ($path -match '(?i)^[a-z]:\\windows\\') { return 'windows' }
    if ($path -match '(?i)^[a-z]:\\program files( \(x86\))?\\windowsapps\\') { return 'windowsapps' }
    if ($path -match '(?i)^[a-z]:\\program files( \(x86\))?\\') { return 'programfiles' }
    if (Test-UserWritablePath $path) { return 'user-writable' }
    if ($path -match '(?i)^[a-z]:\\programdata\\') { return 'programdata' }
    return 'other'
}

function Test-UserWritablePath([string]$path) {
    if (-not $path) { return $false }
    return ($path -match '(?i)^[a-z]:\\users\\[^\\]+\\(downloads|desktop|documents|appdata\\local\\temp|appdata\\roaming|onedrive[^\\]*)\\|^[a-z]:\\users\\public\\|\\temp\\|\\\$recycle\.bin\\')
}

function Test-ProtectedLocation([string]$loc) { return ($loc -in @('windows', 'programfiles', 'windowsapps', 'driverstore')) }

