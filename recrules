function Invoke-AllScans([string]$label = 'SCAN') {
    Add-TL 'SCAN' "Started $label scans"
    [void](Scan-Displays)
    if ($global:FullChecks) {
        $steps = @('Scan-Processes','Scan-RobloxModules','Scan-RobloxMemory','Scan-Startup','Scan-Network','Scan-Tamper','Scan-Hardware')
        foreach ($s in $steps) {
            try { & $s $label } catch { Add-Note "$s failed: $($_.Exception.Message)" }
        }
    }
    Add-TL 'SCAN' "Finished $label scans"
}

