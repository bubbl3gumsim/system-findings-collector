function Get-ToolNameMatch([string]$name, $verdict) {
    $nm = ($name -replace '\.exe$', '')
    if ($nm -match $global:ToolStrongRx) { return 'strong' }
    if ($nm -match $global:ToolWeakRx -and $verdict -and -not $verdict.Verified) { return 'weak' }
    return $null
}

function Get-FileFacts($v) {
    if (-not $v.Path) { return '' }
    $s = "signature=$($v.SigStatus)"
    if ($v.Signer) { $s += "; signer=$($v.Signer)" }
    if (-not $v.Verified -or $v.Location -eq 'user-writable') { $s += "; sha256=" + (Get-ShaIfSmall $v.Path) }
    return $s
}

# =========================================================================
# DETECTION SCANS (run at set-up and after the match - never mid-game)
# Each scan only states facts it measured. Nothing here scores or concludes.
# =========================================================================
function Get-ProcTable {
    $rows = @()
    try {
        $all = @(Get-CimInstance Win32_Process -ErrorAction Stop)
        $names = @{}
        foreach ($p in $all) { $names[[int]$p.ProcessId] = $p.Name }
        foreach ($p in $all) {
            $pn = $null
            if ($names.ContainsKey([int]$p.ParentProcessId)) { $pn = $names[[int]$p.ParentProcessId] }
            $path = Normalize-Path $p.ExecutablePath
            if (-not $path) { $path = Normalize-Path (Get-ImagePathById ([int]$p.ProcessId)) }
            $rows += [PSCustomObject]@{ Name = $p.Name; PID = [int]$p.ProcessId; PPID = [int]$p.ParentProcessId
                ParentName = $pn; Path = $path; Cmd = $p.CommandLine; Created = $p.CreationDate }
        }
    } catch {}
    return $rows
}

# ---- 1. running programs ----
function Scan-Processes([string]$label = 'SCAN') {
    $pre = ($label -eq 'PRE-CLEANUP')
    $unreadable = @()
    foreach ($p in (Get-ProcTable)) {
        if ($p.PID -eq $PID -or $p.PID -le 4) { continue }
        $v = Get-ProcVerdict $p.Name $p.Path $p.PID
        $tag = "{0} (PID {1}) {2}" -f $p.Name, $p.PID, $v.Path
        $nm = ($p.Name -replace '\.exe$', '')
        if ($v.Unreadable -and $v.Class -eq 'Unreadable') { $unreadable += $p.Name }
        if ($v.Mismatch) { Add-Finding 'CHECK' 'Software' 'File name matches a known program but its identity does not' "$tag :: $($v.Reason)" }
        if (-not $v.Verified -and -not $v.Unreadable) {
            $look = Get-LookalikeOf $p.Name
            if ($look) { Add-Finding 'CHECK' 'Software' "File name differs from '$look' by 1-2 characters and has no verified identity" "$tag :: $($v.Reason)" }
        }
        $tm = Get-ToolNameMatch $p.Name $v
        if ($tm) { Add-Finding 'CHECK' 'Software' 'Running program has a name on the cheat/injector/debugger tool-name list' "$tag :: $(Get-FileFacts $v)" }
        elseif ($p.Cmd -and $p.Cmd -match $global:ToolCmdRx -and $nm -notmatch '(?i)^(powershell|pwsh|conhost|cmd)$') {
            Add-Finding 'CHECK' 'Software' 'Command line of a running program contains a tool name from the list' "$tag :: $($p.Cmd)"
        }
        if ($nm -match $global:MacroRx) { Add-Finding 'CHECK' 'Software' 'Hotkey / macro-capable software is running' "$tag :: $(Get-FileFacts $v)" }
        if ($v.Class -eq 'VPN' -and ($nm -notmatch $global:RemoteRx -or $nm -match '^(wireguard|openvpn.*)$')) { Add-TL 'NETWORK' "Allowed VPN software running: $tag :: $(Get-FileFacts $v)" }
        elseif ($nm -match $global:RemoteRx) { Add-Finding 'CHECK' 'Network' 'Remote-control, input-sharing or tunnel software is running' "$tag :: $(Get-FileFacts $v)" }
        if ($nm -match $global:VmProcRx) { Add-Finding 'CHECK' 'System state' 'Virtual-machine host process is running' $tag }
        if ($pre) { continue }
        if (-not $v.Verified -and -not $v.Unreadable -and -not $v.Mismatch) {
            Add-Finding 'CHECK' 'Software' 'Running program has no verified identity' "$tag :: $($v.Reason); $(Get-FileFacts $v)"
        }
        if ($p.Name -match '(?i)^(python|pythonw|node|java|javaw|wscript|cscript|mshta)\.exe$' -and $p.Cmd) {
            Add-Finding 'CHECK' 'Software' 'Script interpreter is running' "$tag :: $($p.Cmd)"
        }
    }
    if ($unreadable.Count -gt 0) {
        Add-Note ("{0} running process(es) had no readable file path and could not be identity-checked: {1}" -f $unreadable.Count, (($unreadable | Select-Object -Unique) -join ', '))
    }
}

# ---- 2. Roblox loaded modules + executable memory ----
function Scan-RobloxModules {
    $rp = @(Get-Process RobloxPlayerBeta -ErrorAction SilentlyContinue)
    if ($rp.Count -eq 0) { Add-Note 'Roblox module list: Roblox was not running during this scan.'; return }
    foreach ($proc in $rp) {
        $mods = $null
        try { $mods = @($proc.Modules) } catch { $mods = $null }
        if (-not $mods) { Add-Note "Roblox module list (PID $($proc.Id)): not readable (access denied by Roblox)."; continue }
        foreach ($m in $mods) {
            $mp = Normalize-Path $m.FileName
            if (-not $mp) { continue }
            if ($mp -match '(?i)\\windows\\(system32|syswow64|winsxs)\\') { continue }
            $sig = Get-SigInfo $mp
            if ($sig.Status -ne 'Valid') {
                Add-Finding 'CHECK' 'Software' 'A module loaded in Roblox has no valid signature' "$mp (status $($sig.Status))"
            } elseif ($mp -notmatch '(?i)\\roblox\\' -and $sig.Publisher -notmatch 'Microsoft|NVIDIA|Advanced Micro|Intel|Realtek|Roblox|OBS|Open Broadcaster|Google|Discord|Valve') {
                Add-Finding 'CHECK' 'Software' 'A module loaded in Roblox is signed by a publisher outside the overlay/driver list' "$mp (signer $($sig.Cn))"
            }
        }
    }
}

function Scan-RobloxMemory {
    $rp = @(Get-Process RobloxPlayerBeta -ErrorAction SilentlyContinue)
    if ($rp.Count -eq 0) { return }
    if (-not $global:NativeOk) { Add-Note 'Roblox memory scan not run: the native helper could not be compiled on this PC.'; return }
    foreach ($proc in $rp) {
        $res = $null
        try { $res = [RecNative]::Scan($proc.Id) } catch { $res = "ERROR:$($_.Exception.Message)" }
        if ($res -like 'OK:*') {
            $parts = $res.Split(':')
            $rwx = [int]$parts[1]; $mb = [math]::Round([double]$parts[2] / 1MB, 2); $rx = [int]$parts[3]
            Add-Note ("Roblox memory (PID {0}): {1} private read-write-execute region(s) ({2} MB), {3} private execute-only region(s)." -f $proc.Id, $rwx, $mb, $rx)
            if ($rwx -gt 0) { Add-Finding 'CHECK' 'Software' 'Roblox process holds private read-write-execute memory regions' "PID $($proc.Id): $rwx region(s), $mb MB" }
        } else {
            Add-Note "Roblox memory scan not possible (PID $($proc.Id)): $res"
        }
    }
}

# ---- 3. startup items, scheduled tasks, hotkeys ----
function Scan-Startup([string]$label = 'SCAN') {
    $runKeys = @('HKCU:\Software\Microsoft\Windows\CurrentVersion\Run','HKCU:\Software\Microsoft\Windows\CurrentVersion\RunOnce',
                 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Run','HKLM:\Software\Microsoft\Windows\CurrentVersion\RunOnce',
                 'HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Run')
    foreach ($k in $runKeys) {
        if (-not (Test-Path $k)) { continue }
        $pr = Get-ItemProperty -Path $k -ErrorAction SilentlyContinue
        foreach ($prop in $pr.PSObject.Properties) {
            if ($prop.Name -like 'PS*') { continue }
            $val = [string]$prop.Value
            Add-TL 'STARTUP' ("Run key {0}: {1} = {2}" -f $k, $prop.Name, $val)
            $exe = $val
            if ($val -match '^\s*"([^"]+)"') { $exe = $matches[1] } elseif ($val -match '^\s*(\S+\.exe)') { $exe = $matches[1] }
            $exeBase = [IO.Path]::GetFileNameWithoutExtension($exe)
            if ($exeBase -match $global:ToolStrongRx) { Add-Finding 'CHECK' 'Startup' 'Startup entry points to a program on the tool-name list' "$($prop.Name) = $val" }
            elseif ($exeBase -match $global:MacroRx) { Add-Finding 'CHECK' 'Startup' 'Startup entry for hotkey/macro-capable software' "$($prop.Name) = $val" }
            elseif (Test-UserWritablePath (Normalize-Path $exe)) { Add-Finding 'CHECK' 'Startup' 'Startup entry points into a Temp/Downloads/Desktop/Documents/Roaming folder' "$($prop.Name) = $val" }
        }
    }
    foreach ($d in @("$env:APPDATA\Microsoft\Windows\Start Menu\Programs\Startup", "$env:ProgramData\Microsoft\Windows\Start Menu\Programs\StartUp")) {
        if (-not (Test-Path $d)) { continue }
        foreach ($f in (Get-ChildItem $d -File -ErrorAction SilentlyContinue)) {
            Add-TL 'STARTUP' "Startup folder item: $($f.FullName) (modified $($f.LastWriteTime))" $f.LastWriteTime
            $b = [IO.Path]::GetFileNameWithoutExtension($f.Name)
            if ($b -match $global:ToolStrongRx) { Add-Finding 'CHECK' 'Startup' 'Startup-folder item has a name on the tool-name list' $f.FullName }
        }
    }
    try {
        foreach ($t in (Get-ScheduledTask -ErrorAction Stop | Where-Object { $_.TaskPath -notmatch '^\\Microsoft\\' -and $_.State -ne 'Disabled' })) {
            foreach ($a in @($t.Actions)) {
                $ex = Normalize-Path ([string]$a.Execute)
                if (-not $ex) { continue }
                $line = "$ex $($a.Arguments)"
                $b = [IO.Path]::GetFileNameWithoutExtension($ex)
                if ($b -match $global:ToolStrongRx -or $line -match $global:ToolCmdRx) { Add-Finding 'CHECK' 'Startup' 'Scheduled task runs a program on the tool-name list' "$($t.TaskPath)$($t.TaskName): $line" }
                elseif (Test-UserWritablePath $ex) { Add-Finding 'CHECK' 'Startup' 'Scheduled task runs a program from a Temp/Downloads/Desktop/Documents/Roaming folder' "$($t.TaskPath)$($t.TaskName): $line" }
            }
        }
    } catch {}
    try {
        $sh = New-Object -ComObject WScript.Shell
        $dirs = @([Environment]::GetFolderPath('Desktop'), [Environment]::GetFolderPath('CommonDesktopDirectory'),
                  "$env:APPDATA\Microsoft\Windows\Start Menu\Programs", "$env:ProgramData\Microsoft\Windows\Start Menu\Programs") | Where-Object { $_ -and (Test-Path $_) }
        foreach ($d in $dirs) {
            foreach ($l in (Get-ChildItem $d -Filter *.lnk -Recurse -File -ErrorAction SilentlyContinue | Select-Object -First 800)) {
                try {
                    $s = $sh.CreateShortcut($l.FullName)
                    if ($s.Hotkey) {
                        Add-TL 'HOTKEY' ("Shortcut hotkey [{0}] on '{1}' launches {2} {3}" -f $s.Hotkey, $l.Name, $s.TargetPath, $s.Arguments)
                        Add-Finding 'CHECK' 'Startup' "A shortcut has a keyboard hotkey assigned ($($s.Hotkey))" "$($l.FullName) -> $($s.TargetPath) $($s.Arguments)"
                    }
                } catch {}
            }
        }
    } catch {}
    $roots = @("$env:USERPROFILE\Desktop", "$env:USERPROFILE\Documents", "$env:USERPROFILE\Downloads", "$env:APPDATA", "$env:LOCALAPPDATA\Temp")
    foreach ($r in $roots) {
        if (-not (Test-Path $r)) { continue }
        foreach ($f in (Get-ChildItem $r -Include *.ahk,*.ahk2 -Recurse -File -Depth 4 -ErrorAction SilentlyContinue | Select-Object -First 40)) {
            Add-Finding 'CHECK' 'Software' 'AutoHotkey script file exists' "$($f.FullName) (modified $($f.LastWriteTime))"
            Add-TL 'HOTKEY' "AutoHotkey script: $($f.FullName)" $f.LastWriteTime
            try {
                foreach ($ln in (Get-Content -LiteralPath $f.FullName -TotalCount 400 -ErrorAction Stop)) {
                    if ($ln -match '^\s*([\^\+!#~\*\$<>]*[A-Za-z0-9_]+|[\^\+!#~\*\$<>]*(F\d+|XButton\d|LButton|RButton|MButton|WheelUp|WheelDown))\s*::') { Add-TL 'HOTKEY' ("  hotkey in {0}: {1}" -f $f.Name, $ln.Trim()) }
                    elseif ($ln -match '^\s*(Run|RunWait)\b') { Add-TL 'HOTKEY' ("  launches in {0}: {1}" -f $f.Name, $ln.Trim()) }
                }
            } catch {}
        }
    }
}

# ---- 4. network ----
function Test-OfficialLaunchLine([string]$line) {
    $rx = '(?i)^\s*(irm|iwr|invoke-restmethod|invoke-webrequest)\s+(-useb(asicparsing)?\s+)?["'']?(https://[^\s"'']+)["'']?\s*\|\s*(iex|invoke-expression)\s*$'
    $m = [regex]::Match($line, $rx)
    if (-not $m.Success) { return $false }
    $url = $m.Groups[4].Value.ToLower()
    return $true
}

function Scan-Network([string]$label = 'SCAN') {
    $procs = @{}
    foreach ($p in (Get-ProcTable)) { $procs[[int]$p.PID] = $p }
    $allowedNet = @('Windows','Roblox','OBS','NVIDIA','AMD','Malwarebytes','Discord','Browser','ScriptTool','VPN')
    try {
        foreach ($c in (Get-NetTCPConnection -State Established -ErrorAction Stop)) {
            $ra = $c.RemoteAddress
            if ($ra -match '^(127\.|::1|0\.|10\.|192\.168\.|169\.254\.|172\.(1[6-9]|2\d|3[01])\.|fe80|fc|fd)') { continue }
            $p = $procs[[int]$c.OwningProcess]
            if (-not $p) { continue }
            $v = Get-ProcVerdict $p.Name $p.Path $p.PID
            Add-TL 'NETWORK' ("{0} (PID {1}) [{2}] -> {3}:{4}" -f $p.Name, $p.PID, $v.Class, $ra, $c.RemotePort)
            if ($v.Class -in $allowedNet -or $v.Unreadable) { continue }
            Add-Finding 'CHECK' 'Network' 'Internet connection from a program outside the Windows/Roblox/recorder/Discord/browser classes' ("{0} (PID {1}) {2} -> {3}:{4} :: {5}" -f $p.Name, $p.PID, $v.Path, $ra, $c.RemotePort, $v.Reason)
        }
        foreach ($c in (Get-NetTCPConnection -State Listen -ErrorAction Stop | Where-Object { $_.LocalAddress -in @('0.0.0.0','::') -and $_.LocalPort -gt 1024 })) {
            $p = $procs[[int]$c.OwningProcess]
            if (-not $p) { continue }
            $v = Get-ProcVerdict $p.Name $p.Path $p.PID
            # An allowed VPN normally listens only on localhost or its tunnel address, so this is worth a line.
            if ($v.Class -eq 'VPN') { Add-Finding 'CHECK' 'Network' 'An allowed VPN program is listening on all interfaces' ("{0} (PID {1}) port {2} {3}" -f $p.Name, $p.PID, $c.LocalPort, $v.Path); continue }
            if ($v.Verified -or $v.Unreadable) { continue }
            Add-Finding 'CHECK' 'Network' 'A program with no verified identity is listening on all interfaces' ("{0} (PID {1}) port {2} {3} :: {4}" -f $p.Name, $p.PID, $c.LocalPort, $v.Path, $v.Reason)
        }
    } catch {}
    try {
        $dns = @(Get-DnsClientCache -ErrorAction Stop | Select-Object -ExpandProperty Entry -Unique)
        foreach ($d in $dns) {
            if ($d -match $global:TunnelDnsRx) { Add-Finding 'CHECK' 'Network' 'DNS cache holds a tunnel / dynamic-DNS host name' $d }
            elseif ($d -match $global:CheatSiteRx) { Add-Finding 'CHECK' 'Network' 'DNS cache holds a host name from the cheat-site list' $d }
        }
        Add-TL 'NETWORK' ("DNS cache held {0} entries at this moment" -f $dns.Count)
    } catch {}
    try {
        $hosts = @(Get-Content "$env:WINDIR\System32\drivers\etc\hosts" -ErrorAction Stop | Where-Object { $_ -match '^\s*[^#\s]' })
        foreach ($h in $hosts) {
            if ($h -notmatch '^\s*(127\.0\.0\.1|::1)\s+localhost\s*$') { Add-Finding 'CHECK' 'Network' 'The hosts file contains an entry' $h.Trim() }
        }
    } catch {}
    try {
        $ie = Get-ItemProperty 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Internet Settings' -ErrorAction Stop
        if ($ie.ProxyEnable -eq 1 -and $ie.ProxyServer) { Add-Finding 'CHECK' 'Network' 'A per-user Windows proxy is switched on' ([string]$ie.ProxyServer) }
        if ($ie.AutoConfigURL) { Add-Finding 'CHECK' 'Network' 'An automatic proxy-configuration script is set' ([string]$ie.AutoConfigURL) }
    } catch {}
    foreach ($scope in @('Machine','User','Process')) {
        foreach ($var in @('HTTP_PROXY','HTTPS_PROXY','ALL_PROXY')) {
            $val = [Environment]::GetEnvironmentVariable($var, $scope)
            if ($val) { Add-Finding 'CHECK' 'Network' "Environment variable $var is set ($scope scope)" $val }
        }
    }
    try {
        $vpnRunning = (@($procs.Values | Where-Object { (Get-ProcVerdict $_.Name $_.Path $_.PID).Class -eq 'VPN' }).Count -gt 0)
        foreach ($a in (Get-NetAdapter -IncludeHidden -ErrorAction Stop | Where-Object { $_.Status -eq 'Up' -and $_.InterfaceDescription -match '(?i)(tap-windows|wireguard|tailscale|zerotier|openvpn|hamachi|wintun|vpn|tunnel)' })) {
            $d = [string]$a.InterfaceDescription
            # Allowed: the adapter names an allowed vendor, or it is a generic tunnel driver while a verified allowed VPN is running.
            if ($d -match "(?i)($global:AllowedVpnVendors)" -or ($vpnRunning -and $d -match '(?i)(tap-windows|wintun|wireguard|openvpn|tunnel|vpn)')) {
                Add-TL 'NETWORK' "Allowed VPN adapter is up: $($a.Name) - $d"
            } else {
                Add-Finding 'CHECK' 'Network' 'A network adapter that identifies as VPN/tunnel is up and no verified allowed VPN is running' "$($a.Name) - $d"
            }
        }
    } catch {}
    try {
        foreach ($c in (Get-ChildItem Cert:\LocalMachine\Root -ErrorAction Stop | Where-Object { $_.Subject -match $global:MitmCertRx -or $_.Issuer -match $global:MitmCertRx })) {
            Add-Finding 'CHECK' 'Network' 'A trusted root certificate belongs to an intercepting-proxy tool' "$($c.Subject) (valid from $($c.NotBefore))"
        }
    } catch {}
    $hist = "$env:APPDATA\Microsoft\Windows\PowerShell\PSReadLine\ConsoleHost_history.txt"
    if (Test-Path $hist) {
        try {
            foreach ($l in @(Get-Content $hist -Tail 300 -ErrorAction Stop)) {
                if ($l -match '(?i)(wevtutil\s+(cl|clear-log)|Clear-EventLog|fsutil\s+usn\s+deletejournal|del(ete)?\s+.*\.pf|Remove-Item.*prefetch|Set-MpPreference|Add-MpPreference|auditpol|bcdedit.*(testsigning|nointegritychecks|debug)|vssadmin\s+delete|sc\s+(stop|config).*(sysmain|eventlog|windefend))') {
                    Add-Finding 'CHECK' 'Tampering evidence' 'PowerShell history contains a clean-up or security-setting command' $l.Trim()
                } elseif ($l -match '(?i)(DownloadString|DownloadFile|Invoke-WebRequest|\biwr\b|\birm\b|curl\s+-|bitsadmin|certutil.*urlcache|Start-BitsTransfer|Invoke-Expression|\biex\b)') {
                    if (-not (Test-OfficialLaunchLine $l)) { Add-Finding 'CHECK' 'Network' 'PowerShell history contains a download or run-from-string command' $l.Trim() }
                }
            }
        } catch {}
    } else { Add-Note 'PowerShell console history file does not exist (nothing to read).' }
}

# ---- 5. system state and tampering evidence ----
function Get-SystemStateLines {
    $out = @()
    try { $os = Get-CimInstance Win32_OperatingSystem -ErrorAction Stop; $out += "Windows           : $($os.Caption) build $($os.BuildNumber); last boot $($os.LastBootUpTime)" } catch {}
    try { $cs = Get-CimInstance Win32_ComputerSystem -ErrorAction Stop; $out += "Computer          : $($cs.Manufacturer) / $($cs.Model); HypervisorPresent=$($cs.HypervisorPresent)" } catch {}
    try { if (Confirm-SecureBootUEFI -ErrorAction Stop) { $out += 'Secure Boot       : ON' } else { $out += 'Secure Boot       : OFF' } } catch { $out += 'Secure Boot       : state unavailable (legacy BIOS or access denied)' }
    try {
        $dg = Get-CimInstance -ClassName Win32_DeviceGuard -Namespace root\Microsoft\Windows\DeviceGuard -ErrorAction Stop
        $out += "VBS               : status $($dg.VirtualizationBasedSecurityStatus) (2 = running)"
        $out += ("Memory Integrity  : {0}" -f $(if (@($dg.SecurityServicesRunning) -contains 2) { 'RUNNING' } else { 'NOT RUNNING' }))
    } catch { $out += 'Memory Integrity  : state unavailable (Device Guard class could not be read)' }
    try {
        $bl = Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\CI\Config' -Name VulnerableDriverBlocklistEnable -ErrorAction Stop
        $out += "Driver blocklist  : registry VulnerableDriverBlocklistEnable = $($bl.VulnerableDriverBlocklistEnable)"
    } catch { $out += 'Driver blocklist  : registry value not present (Windows default applies)' }
    try { $out += "Process auditing  : $global:ProcAuditInfo" } catch {}
    return $out
}

function Test-SecurityRules([string]$when) {
    try {
        $dg = Get-CimInstance -ClassName Win32_DeviceGuard -Namespace root\Microsoft\Windows\DeviceGuard -ErrorAction Stop
        Set-RuleChecked 'MemoryIntegrity'
        if (@($dg.SecurityServicesRunning) -notcontains 2) { Add-Finding 'RULE' 'MemoryIntegrity' "Memory Integrity (HVCI) was not running ($when)" "SecurityServicesRunning = $(@($dg.SecurityServicesRunning) -join ',')" }
    } catch { Add-Note "Memory Integrity state could not be read ($when)." }
    try {
        Set-RuleChecked 'Blocklist'
        $bl = Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\CI\Config' -Name VulnerableDriverBlocklistEnable -ErrorAction Stop
        if ($bl.VulnerableDriverBlocklistEnable -eq 0) { Add-Finding 'RULE' 'Blocklist' "Vulnerable driver blocklist is switched off in the registry ($when)" 'VulnerableDriverBlocklistEnable = 0' }
    } catch {}
}

function Get-TimeChangeFacts([int]$days = 3) {
    $seen = @{}
    try {
        foreach ($e in @(Get-WinEvent -FilterHashtable @{ LogName = 'System'; ProviderName = 'Microsoft-Windows-Kernel-General'; Id = 1; StartTime = (Get-Date).AddDays(-$days) } -ErrorAction Stop)) {
            try {
                $x = [xml]$e.ToXml(); $d = @{}
                foreach ($n in $x.Event.EventData.Data) { $d[$n.Name] = $n.'#text' }
                $new = [datetime]::Parse($d['NewTime'], [Globalization.CultureInfo]::InvariantCulture, [Globalization.DateTimeStyles]::RoundtripKind).ToLocalTime()
                $old = [datetime]::Parse($d['OldTime'], [Globalization.CultureInfo]::InvariantCulture, [Globalization.DateTimeStyles]::RoundtripKind).ToLocalTime()
                $delta = [math]::Round(($new - $old).TotalSeconds)
                if ([math]::Abs($delta) -ge 60) {
                    $k = $new.ToString('yyyyMMddHHmm')
                    if (-not $seen.ContainsKey($k)) { $seen[$k] = $true
                        Add-Finding 'CHECK' 'Tampering evidence' 'System clock moved by 60 seconds or more (Kernel-General event 1)' ("{0}s: from {1} to {2}" -f $delta, $old.ToString('yyyy-MM-dd HH:mm:ss'), $new.ToString('yyyy-MM-dd HH:mm:ss')) $e.TimeCreated }
                }
            } catch {}
        }
    } catch {}
    try {
        foreach ($e in @(Get-WinEvent -FilterHashtable @{ LogName = 'Security'; Id = 4616; StartTime = (Get-Date).AddDays(-$days) } -ErrorAction Stop)) {
            try {
                $x = [xml]$e.ToXml(); $d = @{}
                foreach ($n in $x.Event.EventData.Data) { $d[$n.Name] = $n.'#text' }
                $new = [datetime]::Parse($d['NewTime'], [Globalization.CultureInfo]::InvariantCulture, [Globalization.DateTimeStyles]::RoundtripKind).ToLocalTime()
                $old = [datetime]::Parse($d['PreviousTime'], [Globalization.CultureInfo]::InvariantCulture, [Globalization.DateTimeStyles]::RoundtripKind).ToLocalTime()
                $delta = [math]::Round(($new - $old).TotalSeconds)
                $k = $new.ToString('yyyyMMddHHmm')
                if ([math]::Abs($delta) -ge 60 -and -not $seen.ContainsKey($k)) { $seen[$k] = $true
                    Add-Finding 'CHECK' 'Tampering evidence' 'System clock moved by 60 seconds or more (Security event 4616)' ("{0}s by {1}: from {2} to {3}" -f $delta, $d['ProcessName'], $old.ToString('yyyy-MM-dd HH:mm:ss'), $new.ToString('yyyy-MM-dd HH:mm:ss')) $e.TimeCreated }
            } catch {}
        }
    } catch {}
}

function Get-LogClearFacts([datetime]$since) {
    foreach ($spec in @(@('Security', 1102), @('System', 104))) {
        try {
            foreach ($e in @(Get-WinEvent -FilterHashtable @{ LogName = $spec[0]; Id = $spec[1]; StartTime = $since } -MaxEvents 10 -ErrorAction Stop)) {
                $who = ''; $chan = $spec[0]
                try { $x = [xml]$e.ToXml(); $u = $x.Event.UserData.LogFileCleared; if ($u.SubjectUserName) { $who = " by $($u.SubjectUserName)" }; if ($u.Channel) { $chan = $u.Channel } } catch {}
                Add-Finding 'CHECK' 'Tampering evidence' "Windows event log '$chan' was cleared" ("at {0}{1} (event {2} in the {3} log)" -f $e.TimeCreated, $who, $spec[1], $spec[0]) $e.TimeCreated
            }
        } catch {}
    }
}

function Scan-Tamper([string]$label = 'SCAN') {
    $pfDir = "$env:WINDIR\Prefetch"
    try {
        $en = (Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters' -ErrorAction Stop).EnablePrefetcher
        if ($en -eq 0) { Add-Finding 'CHECK' 'Tampering evidence' 'Prefetch is switched off in the registry' 'EnablePrefetcher = 0' }
    } catch {}
    try {
        $sm = Get-Service SysMain -ErrorAction Stop
        if ($sm.Status -ne 'Running') { Add-Finding 'CHECK' 'Tampering evidence' 'The SysMain (Prefetch) service is not running' "status $($sm.Status), start type $($sm.StartType)" }
    } catch {}
    try {
        $pf = @(Get-ChildItem $pfDir -Filter *.pf -ErrorAction Stop)
        Add-TL 'PREFETCH' ("Prefetch folder holds {0} files at this moment" -f $pf.Count)
        if ($pf.Count -eq 0) { Add-Finding 'CHECK' 'Tampering evidence' 'The Prefetch folder is empty' $pfDir }
        foreach ($f in ($pf | Where-Object { ($_.Name -replace '\.exe-.*$', '') -match $global:ToolStrongRx })) {
            Add-Finding 'CHECK' 'Software' 'Prefetch records a run of a program on the tool-name list' "$($f.Name) last run $($f.LastWriteTime)"
        }
    } catch { Add-Finding 'CHECK' 'Tampering evidence' 'The Prefetch folder could not be read' $pfDir }
    Get-LogClearFacts (Get-Date).AddDays(-14)
    Get-TimeChangeFacts 3
    try {
        $out = (& fsutil usn queryjournal $env:SystemDrive 2>&1 | Out-String)
        if ($out -match '(?i)not active|not found|error') { Add-Finding 'CHECK' 'Tampering evidence' 'The USN change journal is not active or could not be queried' ($out.Trim() -replace '\s+', ' ') }
    } catch {}
    try {
        $bcd = (& bcdedit /enum '{current}' 2>&1 | Out-String)
        if ($bcd -match '(?i)testsigning\s+Yes') { Add-Finding 'CHECK' 'System state' 'A Windows boot option differs from the default' 'bcdedit: testsigning Yes' }
        if ($bcd -match '(?i)nointegritychecks\s+Yes') { Add-Finding 'CHECK' 'System state' 'A Windows boot option differs from the default' 'bcdedit: nointegritychecks Yes' }
        if ($bcd -match '(?im)^\s*debug\s+Yes') { Add-Finding 'CHECK' 'System state' 'A Windows boot option differs from the default' 'bcdedit: debug Yes' }
    } catch {}
    try {
        $mp = Get-MpPreference -ErrorAction Stop
        foreach ($x in @($mp.ExclusionPath) + @($mp.ExclusionProcess) + @($mp.ExclusionExtension)) { if ($x) { Add-Finding 'CHECK' 'Windows Defender' 'A Defender exclusion is configured' $x } }
        if ($mp.DisableRealtimeMonitoring) { Add-Finding 'CHECK' 'Windows Defender' 'Defender real-time protection is off' 'DisableRealtimeMonitoring = True' }
    } catch { Add-Note 'Defender settings could not be read (Get-MpPreference failed).' }
    try {
        $cs = Get-CimInstance Win32_ComputerSystem -ErrorAction Stop
        if ($cs.Model -match '(?i)(virtual|vmware|virtualbox|kvm|qemu|hyper-v)' -or $cs.Manufacturer -match '(?i)(vmware|qemu|xen|innotek|parallels)') {
            Add-Finding 'CHECK' 'System state' 'The computer reports itself as a virtual machine' "$($cs.Manufacturer) / $($cs.Model)"
        }
    } catch {}
    try {
        foreach ($d in (Get-CimInstance Win32_SystemDriver -ErrorAction Stop | Where-Object { $_.State -eq 'Running' })) {
            $p = Normalize-Path $d.PathName
            if ($p -and $p -notmatch '^[a-zA-Z]:\\') { if ($p -match '^(?i)system32\\') { $p = "$env:WINDIR\$p" } }
            $base = [IO.Path]::GetFileNameWithoutExtension([string]$p)
            if ($p -and (Test-Path -LiteralPath $p)) {
                $sig = Get-SigInfo $p
                if ($sig.Status -notin @('Valid')) { Add-Finding 'CHECK' 'Drivers' 'A loaded driver file has no valid signature' "$($d.Name) $p (status $($sig.Status))" }
                if (Test-UserWritablePath $p) { Add-Finding 'CHECK' 'Drivers' 'A loaded driver file is in a user-writable folder' "$($d.Name) $p" }
            }
        }
        foreach ($s in (Get-CimInstance Win32_Service -ErrorAction Stop | Where-Object { $_.PathName -match '(?i)(\\temp\\|\\downloads\\|\\appdata\\|\\users\\public\\)' })) {
            Add-Finding 'CHECK' 'Software' 'A Windows service runs a program from a user/temp folder' "$($s.Name): $($s.PathName)"
        }
    } catch {}
}

# ---- 6. hardware ----
function Get-DeviceVidPid([string]$id) {
    $vid = $null; $pid2 = $null
    if ($id -match 'VID_([0-9A-F]{4})') { $vid = $matches[1] }
    if ($id -match 'PID_([0-9A-F]{4})') { $pid2 = $matches[1] }
    return @($vid, $pid2)
}

function Scan-Hardware([string]$label = 'SCAN') {
    try {
        $present = @(Get-PnpDevice -PresentOnly -ErrorAction Stop)
        foreach ($d in $present) {
            $id = [string]$d.InstanceId; $nm = [string]$d.FriendlyName
            if ($nm -match $global:CaptureRx) { Add-Finding 'CHECK' 'Hardware' 'Video-capture device present' "$nm [$id]" }
            if ($id -match '^(USB|HID)\\') {
                $vp = Get-DeviceVidPid $id
                if (($vp[0] -and $global:UsbMcuVendors.ContainsKey($vp[0])) -or $nm -match $global:McuNameRx) {
                    $vn = ''; if ($vp[0] -and $global:UsbMcuVendors.ContainsKey($vp[0])) { $vn = " vendor $($global:UsbMcuVendors[$vp[0]])" }
                    Add-Finding 'CHECK' 'Hardware' "Microcontroller / USB-serial type device present$vn" "$nm [$id]"
                }
            }
        }
        Add-TL 'HARDWARE' ("{0} PCI devices, {1} USB devices present" -f @($present | Where-Object { $_.InstanceId -like 'PCI\*' }).Count, @($present | Where-Object { $_.InstanceId -like 'USB\*' }).Count)
    } catch { Add-Note 'Hardware list could not be read (Get-PnpDevice failed).' }
    try {
        foreach ($d in (Get-PnpDevice -ErrorAction Stop | Where-Object { $_.Status -eq 'Unknown' })) {
            $id = [string]$d.InstanceId; $nm = [string]$d.FriendlyName
            if ($nm -match $global:CaptureRx -or ($id -match '^(USB|HID)\\' -and (Get-DeviceVidPid $id)[0] -in $global:UsbMcuVendors.Keys)) {
                Add-Finding 'CHECK' 'Hardware' 'A device matching the hardware lists is registered but not connected now' "$nm [$id]"
            }
        }
    } catch {}
    try {
        $gpus = @(Get-CimInstance Win32_VideoController -ErrorAction Stop)
        Add-TL 'HARDWARE' ("Graphics: " + (($gpus | ForEach-Object { $_.Name }) -join ' | '))
        foreach ($g in $gpus) { if ($g.Name -match '(?i)(virtual|indirect|parsec|spacedesk|duet|displaylink|remote display)') { Add-Finding 'CHECK' 'Display' 'A virtual / indirect / remote display adapter is present' $g.Name } }
    } catch {}
}

# =========================================================================
# DISPLAY / DESKTOP STATE (used by set-up checks, snapshots and the guard)
# =========================================================================
function Get-TechName([int]$t) {
    switch ($t) {
        0 { return 'VGA' } 4 { return 'DVI' } 5 { return 'HDMI' } 6 { return 'LVDS' }
        10 { return 'DisplayPort' } 11 { return 'DisplayPort (embedded)' } 15 { return 'Miracast (wireless)' }
        16 { return 'indirect wired' } 17 { return 'indirect virtual' }
        -2147483648 { return 'internal panel' }
        default { return "output type $t" }
    }
}

function Get-MonitorNames {
    $ev = @()
    try {
        foreach ($m in (Get-CimInstance -Namespace root\wmi -ClassName WmiMonitorID -ErrorAction Stop | Where-Object { $_.Active })) {
            $nm = ''; try { $nm = -join ($m.UserFriendlyName | Where-Object { $_ -gt 0 } | ForEach-Object { [char]$_ }) } catch {}
            $ev += ("'{0}' [{1}]" -f $nm, $m.InstanceName)
        }
    } catch {}
    return $ev
}

# Largest of: monitors Windows is driving (display paths), Windows screens, monitors the
# hardware reports. Path count catches mirrored screens that Windows merges into one.
function Get-ActiveDisplayCount {
    $n = 0; $w = 0; $pc = 0
    try { Add-Type -AssemblyName System.Windows.Forms -ErrorAction SilentlyContinue; $n = [System.Windows.Forms.Screen]::AllScreens.Count } catch {}
    try { $w = @(Get-CimInstance -Namespace root\wmi -ClassName WmiMonitorID -ErrorAction Stop | Where-Object { $_.Active }).Count } catch {}
    if ($global:NativeOk) { try { $t = [RecNative]::DisplayPaths(); if ($null -ne $t) { $pc = @($t).Count } } catch {} }
    # The display-path count is what Windows is actually driving, so it decides.
    # A laptop whose own screen is off (lid closed or disabled) plus one external monitor = 1.
    if ($pc -gt 0) { $c = $pc } else { $c = [Math]::Max($n, $w) }
    if ($c -lt 1) { $c = 1 }
    return $c
}

function Get-DisplayDetail {
    $rows = @()
    try {
        Add-Type -AssemblyName System.Windows.Forms -ErrorAction SilentlyContinue
        foreach ($s in [System.Windows.Forms.Screen]::AllScreens) {
            $rows += [PSCustomObject]@{ DeviceName = $s.DeviceName; Primary = $s.Primary; Bounds = "$($s.Bounds.Width)x$($s.Bounds.Height) @ $($s.Bounds.X),$($s.Bounds.Y)" }
        }
    } catch {}
    return $rows
}

function Get-VirtualDesktopCount {
    try {
        $sid = [System.Diagnostics.Process]::GetCurrentProcess().SessionId
        foreach ($k in @("HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\SessionInfo\$sid\VirtualDesktops", 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\VirtualDesktops')) {
            if (-not (Test-Path $k)) { continue }
            $b = (Get-ItemProperty -Path $k -Name VirtualDesktopIDs -ErrorAction Stop).VirtualDesktopIDs
            if ($b -is [byte[]] -and $b.Length -ge 16) { return [int]($b.Length / 16) }
        }
    } catch {}
    return $null
}

function Scan-Displays {
    $n = Get-ActiveDisplayCount
    $ev = Get-MonitorNames
    $tech = ''
    if ($global:NativeOk) { try { $t = [RecNative]::DisplayPaths(); if ($null -ne $t) { $tech = ' outputs: ' + ((@($t) | ForEach-Object { Get-TechName $_ }) -join ', ') + '.' } } catch {} }
    Add-TL 'DISPLAY' ("Active display count = {0}.{1} {2}" -f $n, $tech, ($ev -join '; '))
    $vd = Get-VirtualDesktopCount
    if ($null -ne $vd) { Add-TL 'DISPLAY' "Virtual desktop count = $vd" }
    return $n
}

# =========================================================================
# PROCESS-CREATION AUDITING (Security event 4688)
# Gives the Windows' own record of every program started, with full path,
# parent and command line - including programs that live for milliseconds.
# The original audit settings are put back when the script finishes.
# =========================================================================
$global:AuditGuid = '{0CCE922B-69AE-11D9-BED3-505054503030}'
$global:AuditSaved = $null
$global:AuditCmdSaved = $null
$global:AuditEnabledByUs = $false

function Enable-ProcessAudit {
    try {
        $raw = (& auditpol /get /subcategory:$global:AuditGuid /r 2>&1 | Out-String)
        $line = ($raw -split "`r?`n" | Where-Object { $_ -match [regex]::Escape($global:AuditGuid) } | Select-Object -First 1)
        $setting = ''
        if ($line) { $setting = ($line.Split(',')[4]) }
        if (-not $line) { $global:ProcAuditInfo = 'could not read the current audit setting, so it was left unchanged'; return }
        $global:AuditSaved = $setting
        $cmdKey = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System\Audit'
        $cur = $null
        try { $cur = (Get-ItemProperty -Path $cmdKey -Name ProcessCreationIncludeCmdLine_Enabled -ErrorAction Stop).ProcessCreationIncludeCmdLine_Enabled } catch {}
        $global:AuditCmdSaved = $cur
        & auditpol /set /subcategory:$global:AuditGuid /success:enable 2>&1 | Out-Null
        if (-not (Test-Path $cmdKey)) { New-Item -Path $cmdKey -Force | Out-Null }
        New-ItemProperty -Path $cmdKey -Name ProcessCreationIncludeCmdLine_Enabled -Value 1 -PropertyType DWord -Force | Out-Null
        $raw2 = (& auditpol /get /subcategory:$global:AuditGuid /r 2>&1 | Out-String)
        $line2 = ($raw2 -split "`r?`n" | Where-Object { $_ -match [regex]::Escape($global:AuditGuid) } | Select-Object -First 1)
        $setting2 = ''; if ($line2) { $setting2 = ([string]$line2.Split(',')[4]).Trim() }
        $global:AuditOnText = $setting2
        if ($raw2 -match '(?i)Success' -or ($setting2 -and $setting2 -ne ([string]$setting).Trim())) { $global:AuditEnabledByUs = $true; $global:ProcAuditInfo = 'enabled for this session (Security event 4688 with command lines)' }
        else { $global:ProcAuditInfo = 'could not be enabled (policy may be enforced by the system)' }
    } catch { $global:ProcAuditInfo = "could not be enabled: $($_.Exception.Message)" }
}

function Restore-ProcessAudit {
    if (-not $global:AuditEnabledByUs) { return }
    try {
        $s = [string]$global:AuditSaved
        $succ = 'disable'; $fail = 'disable'
        if ($s -match '(?i)Success') { $succ = 'enable' }
        if ($s -match '(?i)Failure') { $fail = 'enable' }
        & auditpol /set /subcategory:$global:AuditGuid /success:$succ /failure:$fail 2>&1 | Out-Null
        $cmdKey = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System\Audit'
        if ($null -eq $global:AuditCmdSaved) { Remove-ItemProperty -Path $cmdKey -Name ProcessCreationIncludeCmdLine_Enabled -ErrorAction SilentlyContinue }
        else { New-ItemProperty -Path $cmdKey -Name ProcessCreationIncludeCmdLine_Enabled -Value $global:AuditCmdSaved -PropertyType DWord -Force | Out-Null }
    } catch {}
    $global:AuditEnabledByUs = $false
}

function Get-ProcessAuditEvents([datetime]$from, [datetime]$to) {
    $rows = @()
    if (-not $global:AuditEnabledByUs) { return $rows }
    try {
        foreach ($e in @(Get-WinEvent -FilterHashtable @{ LogName = 'Security'; Id = 4688; StartTime = $from; EndTime = $to } -ErrorAction Stop)) {
            try {
                $x = [xml]$e.ToXml(); $d = @{}
                foreach ($n in $x.Event.EventData.Data) { $d[$n.Name] = $n.'#text' }
                $np = 0; try { $np = [Convert]::ToInt32(([string]$d['NewProcessId']).Replace('0x', ''), 16) } catch {}
                $cp = 0; try { $cp = [Convert]::ToInt32(([string]$d['ProcessId']).Replace('0x', ''), 16) } catch {}
                $rows += [PSCustomObject]@{ Time = $e.TimeCreated; PID = $np; PPID = $cp; Path = (Normalize-Path $d['NewProcessName'])
                    ParentPath = (Normalize-Path $d['ParentProcessName']); Cmd = $d['CommandLine']; User = $d['SubjectUserName'] }
            } catch {}
        }
    } catch { Add-Note 'Process-creation events (4688) could not be read from the Security log.' }
    return @($rows | Sort-Object Time)
}

# =========================================================================
# SESSION GUARD
# One background thread inside this script. It never touches the screen and
# never blocks the prompt, so it keeps working while the script waits for Enter.
# Always on (all tiers): display count every second, virtual desktops, proxy lock.
# Tiers 2/3 also: program starts, device arrivals/removals, visible windows,
# new internet connections.
# =========================================================================
$global:GuardBag = $null
$global:GuardCtl = $null
$global:GuardPS  = $null
$global:GuardRS  = $null
$global:GuardStats = $null

function Start-SessionGuard {
    $global:GuardBag = [System.Collections.ArrayList]::Synchronized((New-Object System.Collections.ArrayList))
    $global:GuardCtl = [hashtable]::Synchronized(@{ Stop = $false; Full = [bool]$global:FullChecks; ProxyLock = $false
        DispAlert = ''; Checks = 0; MaxGapSec = 0; Started = (Get-Date); LastBeat = (Get-Date); ProxyFix = 0; NativeOk = [bool]$global:NativeOk; Audit = [bool]$global:AuditEnabledByUs; AuditGuid = [string]$global:AuditGuid; AuditOnText = [string]$global:AuditOnText; Errors = 0 })
    try {
        $rs = [runspacefactory]::CreateRunspace()
        $rs.Open()
        $rs.SessionStateProxy.SetVariable('bag', $global:GuardBag)
        $rs.SessionStateProxy.SetVariable('ctl', $global:GuardCtl)
        $ps = [powershell]::Create()
        $ps.Runspace = $rs
        $code = {
            function Rec($kind, $name, $procId, $ppid, $path, $detail, $sig, $signer, $sha) {
                [void]$bag.Add([PSCustomObject]@{ Time = (Get-Date); Kind = $kind; Name = $name; PID = $procId; PPID = $ppid; Path = $path; Detail = $detail; Sig = $sig; Signer = $signer; Sha256 = $sha })
            }
            function Count-Displays {
                $pc = $null
                if ($ctl.NativeOk) { try { $t = [RecNative]::DisplayPaths(); if ($null -ne $t) { $pc = @($t) } } catch {} }
                return $pc
            }
            function Count-VDesk {
                try {
                    $sid = [System.Diagnostics.Process]::GetCurrentProcess().SessionId
                    foreach ($k in @("HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\SessionInfo\$sid\VirtualDesktops", 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\VirtualDesktops')) {
                        if (-not (Test-Path $k)) { continue }
                        $b = (Get-ItemProperty -Path $k -Name VirtualDesktopIDs -ErrorAction Stop).VirtualDesktopIDs
                        if ($b -is [byte[]] -and $b.Length -ge 16) { return [int]($b.Length / 16) }
                    }
                } catch {}
                return $null
            }
            try { [System.Threading.Thread]::CurrentThread.Priority = [System.Threading.ThreadPriority]::BelowNormal } catch {}
            $userRx = '(?i)^[a-z]:\\users\\[^\\]+\\(downloads|desktop|documents|appdata\\local\\temp|appdata\\roaming|onedrive[^\\]*)\\|^[a-z]:\\users\\public\\|\\temp\\|\\\$recycle\.bin\\'
            $sysRx  = '(?i)^[a-z]:\\(windows|program files|program files \(x86\))\\'
            $procW = $null; $devW = $null
            if ($ctl.Full) {
                try {
                    $q = New-Object System.Management.WqlEventQuery('SELECT * FROM Win32_ProcessStartTrace')
                    $procW = New-Object System.Management.ManagementEventWatcher($q)
                    Register-ObjectEvent -InputObject $procW -EventName EventArrived -SourceIdentifier 'RecProcStart' | Out-Null
                    $procW.Start()
                } catch { Rec 'INFO' 'guard' 0 0 $null "process-start trace unavailable: $($_.Exception.Message)" $null $null $null; $procW = $null }
                try {
                    $dq = New-Object System.Management.WqlEventQuery('SELECT * FROM Win32_DeviceChangeEvent')
                    $devW = New-Object System.Management.ManagementEventWatcher($dq)
                    Register-ObjectEvent -InputObject $devW -EventName EventArrived -SourceIdentifier 'RecDevChange' | Out-Null
                    $devW.Start()
                } catch { Rec 'INFO' 'guard' 0 0 $null "device-change trace unavailable: $($_.Exception.Message)" $null $null $null; $devW = $null }
            }
            $lastDisp = $null; $lastVd = $null
            $lastCheck = Get-Date; $lastProxy = Get-Date '2000-01-01'; $lastConn = Get-Date '2000-01-01'
            $lastWin = Get-Date '2000-01-01'; $lastBeat = Get-Date '2000-01-01'; $lastWmi = Get-Date '2000-01-01'; $lastAudit = Get-Date
            $knownPnp = $null; $pnpDirty = $null; $knownConn = @{}; $knownWin = @{}; $proxyFails = 0
            $d0 = Count-Displays
            if ($null -ne $d0) { $lastDisp = @($d0).Count }
            $lastVd = Count-VDesk
            while (-not $ctl.Stop) {
              try {
                $now = Get-Date
                # ---- process starts (event driven) ----
                if ($procW) {
                    $evs = @(); try { $evs = @(Get-Event -SourceIdentifier 'RecProcStart' -ErrorAction SilentlyContinue) } catch {}
                    foreach ($ev in $evs) {
                        try {
                            $n = $ev.SourceEventArgs.NewEvent
                            $pidv = [int]$n.ProcessID; $ppidv = [int]$n.ParentProcessID
                            $path = $null
                            if ($ctl.NativeOk) { try { $path = [RecNative]::ImagePath($pidv) } catch {} }
                            if (-not $path) { try { $path = [System.Diagnostics.Process]::GetProcessById($pidv).MainModule.FileName } catch {} }
                            $sig = $null; $signer = $null; $sha = $null; $cmd = $null
                            if ($path -and $path -match $userRx) {
                                try { $s = Get-AuthenticodeSignature -LiteralPath $path -ErrorAction Stop; $sig = [string]$s.Status; if ($s.SignerCertificate) { $signer = $s.SignerCertificate.Subject } } catch {}
                                try { if ((Get-Item -LiteralPath $path).Length -le 200MB) { $sha = (Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash } } catch {}
                            }
                            if (-not $ctl.Audit -and ((-not $path) -or ($path -notmatch $sysRx))) {
                                try { $cmd = (Get-CimInstance Win32_Process -Filter "ProcessId=$pidv" -ErrorAction Stop).CommandLine } catch {}
                            }
                            Rec 'PROC' $n.ProcessName $pidv $ppidv $path $cmd $sig $signer $sha
                        } catch {}
                        try { Remove-Event -EventIdentifier $ev.EventIdentifier -ErrorAction SilentlyContinue } catch {}
                    }
                }
                # ---- device changes (event driven; the device list is read only after a change) ----
                if ($devW) {
                    $evs = @(); try { $evs = @(Get-Event -SourceIdentifier 'RecDevChange' -ErrorAction SilentlyContinue) } catch {}
                    if ($evs.Count -gt 0) {
                        $pnpDirty = $now
                        foreach ($ev in $evs) { try { Remove-Event -EventIdentifier $ev.EventIdentifier -ErrorAction SilentlyContinue } catch {} }
                    }
                    if ($null -eq $knownPnp) {
                        $knownPnp = @{}
                        try { foreach ($d in (Get-PnpDevice -PresentOnly -ErrorAction Stop)) { $knownPnp[[string]$d.InstanceId] = [string]$d.FriendlyName } } catch {}
                    } elseif ($pnpDirty -and (($now - $pnpDirty).TotalSeconds -ge 3)) {
                        $pnpDirty = $null
                        $cur = @{}
                        try { foreach ($d in (Get-PnpDevice -PresentOnly -ErrorAction Stop)) { $cur[[string]$d.InstanceId] = [string]$d.FriendlyName } } catch {}
                        if ($cur.Count -gt 0) {
                            foreach ($k in $cur.Keys) { if (-not $knownPnp.ContainsKey($k)) { Rec 'PNP' $cur[$k] 0 0 $k 'device appeared' $null $null $null } }
                            foreach ($k in @($knownPnp.Keys)) { if (-not $cur.ContainsKey($k)) { Rec 'PNPGONE' $knownPnp[$k] 0 0 $k 'device disappeared' $null $null $null } }
                            $knownPnp = $cur
                        }
                    }
                }
                # ---- display + virtual desktops, every second ----
                if (($now - $lastCheck).TotalSeconds -ge 1) {
                    $gap = ($now - $lastCheck).TotalSeconds
                    if ($gap -gt $ctl.MaxGapSec) { $ctl.MaxGapSec = [math]::Round($gap, 1) }
                    $lastCheck = $now
                    $ctl.Checks = $ctl.Checks + 1
                    $dp = Count-Displays
                    if ($null -ne $dp) {
                        $cnt = @($dp).Count
                        if ($null -eq $lastDisp -or $cnt -ne $lastDisp) {
                            $mon = @()
                            try {
                                foreach ($m in (Get-CimInstance -Namespace root\wmi -ClassName WmiMonitorID -ErrorAction Stop | Where-Object { $_.Active })) {
                                    $nm = ''; try { $nm = -join ($m.UserFriendlyName | Where-Object { $_ -gt 0 } | ForEach-Object { [char]$_ }) } catch {}
                                    $mon += ("'{0}' [{1}]" -f $nm, $m.InstanceName)
                                }
                            } catch {}
                            Rec 'DISPLAY' 'displays' 0 0 $null ("active display paths {0} -> {1}; output types {2}; monitors: {3}" -f $lastDisp, $cnt, ((@($dp) | ForEach-Object { [string]$_ }) -join ','), ($mon -join '; ')) $null $null $null
                            if ($cnt -gt 1) { $ctl.DispAlert = (Get-Date).ToString('HH:mm:ss') }
                            $lastDisp = $cnt
                        }
                    }
                    elseif (-not $ctl.NativeOk -and (($now - $lastWmi).TotalSeconds -ge 5)) {
                        $lastWmi = $now
                        try {
                            $wc = @(Get-CimInstance -Namespace root\wmi -ClassName WmiMonitorID -ErrorAction Stop | Where-Object { $_.Active }).Count
                            if ($null -eq $lastDisp -or $wc -ne $lastDisp) {
                                Rec 'DISPLAY' 'displays' 0 0 $null ("active monitors (WMI) {0} -> {1}" -f $lastDisp, $wc) $null $null $null
                                if ($wc -gt 1) { $ctl.DispAlert = (Get-Date).ToString('HH:mm:ss') }
                                $lastDisp = $wc
                            }
                        } catch {}
                    }
                    $vd = Count-VDesk
                    if ($null -ne $vd -and ($null -eq $lastVd -or $vd -ne $lastVd)) {
                        Rec 'VDESKTOP' 'virtual desktops' 0 0 $null ("virtual desktop count {0} -> {1}" -f $lastVd, $vd) $null $null $null
                        if ($vd -gt 1) { $ctl.DispAlert = (Get-Date).ToString('HH:mm:ss') }
                        $lastVd = $vd
                    }
                }
                # ---- WinHTTP proxy lock: reads the registry; runs netsh only if the value changed ----
                if ($ctl.ProxyLock -and (($now - $lastProxy).TotalSeconds -ge 3)) {
                    $lastProxy = $now
                    $okp = $false
                    try {
                        $b = (Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Internet Settings\Connections' -Name WinHttpSettings -ErrorAction Stop).WinHttpSettings
                        if ([System.Text.Encoding]::ASCII.GetString($b) -match '127\.0\.0\.1:1') { $okp = $true }
                    } catch {}
                    if ($okp) { $proxyFails = 0 }
                    elseif ($proxyFails -lt 3) {
                        $proxyFails++
                        try { & netsh winhttp set proxy 127.0.0.1:1 | Out-Null } catch {}
                        $ctl.ProxyFix = $ctl.ProxyFix + 1
                        Rec 'PROXY' 'winhttp' 0 0 $null 'WinHTTP proxy was not the locked value; it was set again' $null $null $null
                    }
                }
                # ---- process-creation auditing must stay on (turning it off would hide program starts) ----
                if ($ctl.Audit -and $ctl.AuditOnText -and (($now - $lastAudit).TotalSeconds -ge 20)) {
                    $lastAudit = $now
                    try {
                        $ao = (& auditpol /get /subcategory:$($ctl.AuditGuid) /r 2>&1 | Out-String)
                        if ($ao -notmatch [regex]::Escape([string]$ctl.AuditOnText)) {
                            & auditpol /set /subcategory:$($ctl.AuditGuid) /success:enable 2>&1 | Out-Null
                            Rec 'AUDITOFF' 'auditpol' 0 0 $null 'Process-creation auditing was not in the state the script set; it was set again' $null $null $null
                        }
                    } catch {}
                }
                if ($ctl.Full) {
                    # ---- visible windows, every 10 s ----
                    if (($now - $lastWin).TotalSeconds -ge 10) {
                        $lastWin = $now
                        try {
                            foreach ($p in [System.Diagnostics.Process]::GetProcesses()) {
                                try {
                                    if ($p.MainWindowHandle -ne [IntPtr]::Zero -and $p.MainWindowTitle -and $p.MainWindowTitle -ne 'Program Manager') {
                                        $wk = [string]$p.Id
                                        if (-not $knownWin.ContainsKey($wk)) {
                                            $knownWin[$wk] = 1
                                            $title = $p.MainWindowTitle
                                            if ($p.ProcessName -match '(?i)^(chrome|msedge|firefox|brave|opera|vivaldi|discord)$') { $title = '(title not recorded for browsers/Discord)' }
                                            $wp = $null; if ($ctl.NativeOk) { try { $wp = [RecNative]::ImagePath($p.Id) } catch {} }
                                            Rec 'WINDOW' $p.ProcessName $p.Id 0 $wp $title $null $null $null
                                        }
                                    }
                                } catch {}
                            }
                        } catch {}
                    }
                    # ---- new internet connections, every 30 s ----
                    if (($now - $lastConn).TotalSeconds -ge 30) {
                        $lastConn = $now
                        try {
                            foreach ($c in (Get-NetTCPConnection -State Established -ErrorAction Stop)) {
                                $ra = $c.RemoteAddress
                                if ($ra -match '^(127\.|::1|10\.|192\.168\.|169\.254\.|172\.(1[6-9]|2\d|3[01])|fe80|0\.)') { continue }
                                $key = "$($c.OwningProcess)|$ra|$($c.RemotePort)"
                                if (-not $knownConn.ContainsKey($key)) {
                                    $knownConn[$key] = 1
                                    $pn = $null; try { $pn = (Get-Process -Id $c.OwningProcess -ErrorAction Stop).ProcessName } catch {}
                                    $cp = $null; if ($ctl.NativeOk) { try { $cp = [RecNative]::ImagePath([int]$c.OwningProcess) } catch {} }
                                    Rec 'CONN' $pn ([int]$c.OwningProcess) 0 $cp ("{0}:{1}" -f $ra, $c.RemotePort) $null $null $null
                                }
                            }
                        } catch {}
                    }
                }
                if (($now - $lastBeat).TotalSeconds -ge 60) { $lastBeat = $now; $ctl.LastBeat = $now }
                Start-Sleep -Milliseconds 500
              } catch {
                # One failed pass must never stop the guard.
                $ctl.Errors = $ctl.Errors + 1
                Start-Sleep -Milliseconds 300
              }
            }
            try { if ($procW) { $procW.Stop() } } catch {}
            try { if ($devW) { $devW.Stop() } } catch {}
        }
        [void]$ps.AddScript($code.ToString())
        [void]$ps.BeginInvoke()
        $global:GuardPS = $ps
        $global:GuardRS = $rs
        Add-TL 'GUARD' 'Session guard started (display count each second, virtual desktops, proxy lock; Tiers 2/3 also program starts, devices, windows, connections)'
    } catch { Add-Note "Session guard could not start: $($_.Exception.Message)" }
}

function Stop-SessionGuard {
    if (-not $global:GuardCtl) { return }
    $global:GuardCtl.Stop = $true
    Start-Sleep -Milliseconds 1200
    try { $global:GuardLog = @($global:GuardBag.ToArray()) } catch { $global:GuardLog = @() }
    try { if ($global:GuardPS) { $global:GuardPS.Stop(); $global:GuardPS.Dispose() } } catch {}
    try { if ($global:GuardRS) { $global:GuardRS.Close(); $global:GuardRS.Dispose() } } catch {}
    $global:GuardStats = [PSCustomObject]@{ Checks = $global:GuardCtl.Checks; MaxGap = $global:GuardCtl.MaxGapSec; ProxyFix = $global:GuardCtl.ProxyFix; Errors = $global:GuardCtl.Errors }
    # Show staff when the monitoring itself was interrupted (sleep, a suspended window, or internal errors).
    $runSec = ((Get-Date) - $global:GuardCtl.Started).TotalSeconds
    if ($global:GuardCtl.MaxGapSec -ge 20) { Add-Finding 'CHECK' 'Monitoring' 'The display/desktop checks did not run for 20 seconds or more (PC asleep, or this window was paused)' ("longest gap {0} s" -f $global:GuardCtl.MaxGapSec) }
    if ($runSec -ge 60 -and $global:GuardCtl.Checks -lt ($runSec * 0.4)) { Add-Finding 'CHECK' 'Monitoring' 'The display/desktop checks ran far less often than once per second' ("{0} checks in {1} s" -f $global:GuardCtl.Checks, [math]::Round($runSec)) }
    if ($global:GuardCtl.Errors -gt 0) { Add-Finding 'CHECK' 'Monitoring' 'The session guard hit internal errors and carried on' ("{0} error(s)" -f $global:GuardCtl.Errors) }
    Add-TL 'GUARD' ("Session guard stopped. {0} event(s) recorded; {1} display checks, longest gap between checks {2}s." -f @($global:GuardLog).Count, $global:GuardCtl.Checks, $global:GuardCtl.MaxGapSec)
    $global:GuardCtl = $null
}

function Enable-ProxyLock {
    try { & netsh winhttp set proxy 127.0.0.1:1 | Out-Null } catch {}
    if ($global:GuardCtl) { $global:GuardCtl.ProxyLock = $true }
}

function Show-DisplayAlertIfAny {
    if ($global:GuardCtl -and $global:GuardCtl.DispAlert -and $global:DisplayLockedAt) {
        Write-Host ""
        Write-Host "!! A SECOND DISPLAY OR EXTRA VIRTUAL DESKTOP WAS DETECTED AT $($global:GuardCtl.DispAlert) !!" -ForegroundColor Red
        Write-Host "   It was logged with the time and will appear in your findings package." -ForegroundColor Red
        Write-Host ""
        $global:GuardCtl.DispAlert = ''
    }
}

function Assert-SingleDisplay {
    # Waits (polling every 2 s) until one display is active, then records the moment.
    # Everything seen before this moment is set-up; everything after is measured.
    $warned = $false
    while ($true) {
        $count = Get-ActiveDisplayCount
        if ($count -le 1) {
            Write-Host "      Single display confirmed." -ForegroundColor Green
            $global:DisplayLockedAt = Get-Date
            $global:DisplayIdsAtLock = @{}
            try { foreach ($mm in (Get-PnpDevice -Class Monitor -PresentOnly -ErrorAction Stop)) { $global:DisplayIdsAtLock[[string]$mm.InstanceId] = $true } } catch {}
            Add-TL 'DISPLAY' ("Display check passed: one display. Monitor device(s) present at that moment: {0}" -f (($global:DisplayIdsAtLock.Keys | Sort-Object) -join '; '))
            return
        }
        if (-not $warned) {
            Write-Host ""
            Write-Host "      $count displays detected. Only ONE is allowed - unplug the extra display(s) now." -ForegroundColor Red
            Write-Host "      Laptop with an external monitor: switch the LAPTOP screen off (close the lid or use Win+P > Second screen only) so only the monitor is active." -ForegroundColor Yellow
            Get-DisplayDetail | ForEach-Object { Write-Host ("        - {0} {1} {2}" -f $_.DeviceName, $_.Bounds, $(if ($_.Primary) { "(primary)" } else { "" })) -ForegroundColor Red }
            Write-Host "      Waiting for it to be unplugged..." -ForegroundColor Yellow
            Add-TL 'DISPLAY' "Set-up: $count displays were connected; waiting for the player to unplug."
            $warned = $true
        }
        Start-Sleep -Seconds 2
    }
}

# =========================================================================
# SNAPSHOTS (taken at the start and end of the match)
# =========================================================================
function Get-Snapshot([string]$label) {
    $s = @{ Label = $label; Time = Get-Date; Drivers = @{}; Services = @{}; Pnp = @{}; Pf = @{}; Run = @{}; Tasks = @{}; Certs = @{}; Hosts = ''; Displays = 1; VDesk = $null; Procs = @{}; ProcList = @(); Usn = $null; Vpn = @{} }
    try { foreach ($d in (Get-CimInstance Win32_SystemDriver -ErrorAction Stop | Where-Object { $_.State -eq 'Running' })) { $s.Drivers[$d.Name] = (Normalize-Path $d.PathName) } } catch {}
    try { foreach ($d in (Get-CimInstance Win32_Service -ErrorAction Stop)) { $s.Services[$d.Name] = $d.PathName } } catch {}
    try { foreach ($d in (Get-PnpDevice -PresentOnly -ErrorAction Stop)) { $s.Pnp[[string]$d.InstanceId] = [string]$d.FriendlyName } } catch {}
    try { foreach ($f in (Get-ChildItem "$env:WINDIR\Prefetch" -Filter *.pf -ErrorAction Stop)) { $s.Pf[$f.Name] = $f.LastWriteTime } } catch {}
    foreach ($k in @('HKCU:\Software\Microsoft\Windows\CurrentVersion\Run','HKLM:\Software\Microsoft\Windows\CurrentVersion\Run','HKCU:\Software\Microsoft\Windows\CurrentVersion\RunOnce')) {
        if (Test-Path $k) { $pr = Get-ItemProperty $k -ErrorAction SilentlyContinue; foreach ($p in $pr.PSObject.Properties) { if ($p.Name -notlike 'PS*') { $s.Run["$k|$($p.Name)"] = [string]$p.Value } } }
    }
    try { foreach ($t in (Get-ScheduledTask -ErrorAction Stop | Where-Object { $_.TaskPath -notmatch '^\\Microsoft\\' })) { $s.Tasks[$t.TaskPath + $t.TaskName] = [string]$t.State } } catch {}
    try { foreach ($c in (Get-ChildItem Cert:\LocalMachine\Root -ErrorAction Stop)) { $s.Certs[$c.Thumbprint] = $c.Subject } } catch {}
    try { $s.Hosts = (Get-FileHash "$env:WINDIR\System32\drivers\etc\hosts" -Algorithm SHA256 -ErrorAction Stop).Hash } catch {}
    $s.Displays = Get-ActiveDisplayCount
    $s.VDesk = Get-VirtualDesktopCount
    try { foreach ($a in (Get-NetAdapter -IncludeHidden -ErrorAction Stop | Where-Object { $_.Status -eq 'Up' -and $_.InterfaceDescription -match '(?i)(tap-windows|wireguard|tailscale|zerotier|openvpn|hamachi|wintun|vpn|tunnel)' })) { $s.Vpn[[string]$a.Name] = [string]$a.InterfaceDescription } } catch {}
    try { $s.ProcList = @(Get-ProcTable); foreach ($p in $s.ProcList) { $s.Procs[[string]$p.Name + '|' + [string]$p.Path] = $true } } catch {}
    try { $q = (& fsutil usn queryjournal $env:SystemDrive 2>&1 | Out-String); if ($q -match 'Next Usn\s*:\s*(0x[0-9a-fA-F]+|\d+)') { $s.Usn = $matches[1] } } catch {}
    return $s
}

function Compare-Snapshots($a, $b) {
    $out = @()
    if (-not $a -or -not $b) { return @('Snapshot comparison not available.') }
    $out += ("Start snapshot: {0}    End snapshot: {1}" -f $a.Time, $b.Time)
    foreach ($k in $b.Drivers.Keys) {
        if (-not $a.Drivers.ContainsKey($k)) {
            $p = $b.Drivers[$k]; $sig = Get-SigInfo $p
            $out += "DRIVER RUNNING AT END, NOT AT START: $k  $p"
            Add-Finding 'CHECK' 'Drivers' 'A driver is running at the end that was not running at the start' ("{0} {1} (signature {2}{3}; sha256 {4})" -f $k, $p, $sig.Status, $(if ($sig.Cn) { ", signer $($sig.Cn)" } else { '' }), (Get-ShaIfSmall $p))
        }
    }
    foreach ($k in $a.Drivers.Keys) { if (-not $b.Drivers.ContainsKey($k)) { $out += "DRIVER RUNNING AT START, NOT AT END: $k  $($a.Drivers[$k])" } }
    foreach ($k in $b.Services.Keys) { if (-not $a.Services.ContainsKey($k)) { $out += "NEW SERVICE: $k  $($b.Services[$k])"; Add-Finding 'CHECK' 'Software' 'A Windows service exists at the end that did not exist at the start' "$k $($b.Services[$k])" } }
    foreach ($k in $b.Pnp.Keys) { if (-not $a.Pnp.ContainsKey($k)) { $out += "DEVICE PRESENT AT END, NOT AT START: $($b.Pnp[$k]) [$k]"; if ($k -match '^(USB|HID|PCI|DISPLAY|BTH)') { Add-Finding 'CHECK' 'Hardware' 'A device is present at the end that was not present at the start' "$($b.Pnp[$k]) [$k]" } } }
    foreach ($k in $a.Pnp.Keys) { if (-not $b.Pnp.ContainsKey($k)) { $out += "DEVICE PRESENT AT START, NOT AT END: $($a.Pnp[$k]) [$k]"; if ($k -match '^(USB|HID|PCI|DISPLAY|BTH)') { Add-Finding 'CHECK' 'Hardware' 'A device was present at the start but is gone at the end' "$($a.Pnp[$k]) [$k]" } } }
    $gone = @(); foreach ($k in $a.Pf.Keys) { if (-not $b.Pf.ContainsKey($k)) { $gone += $k } }
    foreach ($k in $gone) { $out += "PREFETCH FILE MISSING AT END: $k" }
    if ($gone.Count -gt 0) { Add-Finding 'CHECK' 'Tampering evidence' 'Prefetch file(s) present at the start are missing at the end' ("{0} file(s); folder held {1} at start and {2} at end; first: {3}" -f $gone.Count, $a.Pf.Count, $b.Pf.Count, (($gone | Select-Object -First 8) -join ', ')) }
    foreach ($k in $b.Pf.Keys) { if (-not $a.Pf.ContainsKey($k)) { $out += "PREFETCH NEW: $k ($($b.Pf[$k]))" } elseif ($a.Pf[$k] -ne $b.Pf[$k]) { $out += "PREFETCH UPDATED: $k ($($a.Pf[$k]) -> $($b.Pf[$k]))" } }
    foreach ($k in $b.Run.Keys) { if (-not $a.Run.ContainsKey($k)) { $out += "NEW STARTUP ENTRY: $k = $($b.Run[$k])"; Add-Finding 'CHECK' 'Startup' 'A startup entry exists at the end that did not exist at the start' "$k = $($b.Run[$k])" } }
    foreach ($k in $b.Tasks.Keys) { if (-not $a.Tasks.ContainsKey($k)) { $out += "NEW SCHEDULED TASK: $k"; Add-Finding 'CHECK' 'Startup' 'A non-Microsoft scheduled task exists at the end that did not exist at the start' $k } }
    foreach ($k in $b.Certs.Keys) { if (-not $a.Certs.ContainsKey($k)) { $out += "NEW ROOT CERTIFICATE: $($b.Certs[$k])"; Add-Finding 'CHECK' 'Network' 'A trusted root certificate exists at the end that did not exist at the start' $b.Certs[$k] } }
    if ($a.Hosts -ne $b.Hosts) { $out += 'HOSTS FILE CHANGED'; Add-Finding 'CHECK' 'Network' 'The hosts file content changed between start and end' '' }
    $out += "DISPLAYS: start $($a.Displays), end $($b.Displays); VIRTUAL DESKTOPS: start $($a.VDesk), end $($b.VDesk)"
    # A VPN connecting or disconnecting is normal, so it is listed here for staff but is not a finding.
    foreach ($k in $b.Vpn.Keys) { if (-not $a.Vpn.ContainsKey($k)) { $out += "VPN/TUNNEL ADAPTER UP AT END, NOT AT START: $k - $($b.Vpn[$k])" } }
    foreach ($k in $a.Vpn.Keys) { if (-not $b.Vpn.ContainsKey($k)) { $out += "VPN/TUNNEL ADAPTER UP AT START, NOT AT END: $k - $($a.Vpn[$k])" } }
    foreach ($k in $b.Procs.Keys) {
        if (-not $a.Procs.ContainsKey($k)) {
            $parts = $k.Split('|', 2)
            $v = Get-ProcVerdict $parts[0] $parts[1]
            $out += "PROGRAM RUNNING AT END, NOT AT START: $($parts[0])  $($parts[1])  [$($v.Class)]"
        }
    }
    return $out
}

# =========================================================================
# END-OF-SESSION EVIDENCE FROM WINDOWS' OWN RECORDS
# =========================================================================
function Test-DeviceHistory {
    # Windows stores the last arrival and last removal time of every device, even
    # ones unplugged since. This catches a monitor (or any device) that was plugged
    # in or out during the session even if it is gone again when the script checks.
    $locked = $global:DisplayLockedAt
    try {
        $all = @(Get-PnpDevice -ErrorAction Stop | Where-Object { $_.InstanceId -match '^(DISPLAY|USB|HID|PCI|BTH|BTHENUM|BTHLE|USBSTOR|SCSI|NVME|THUNDERBOLT)\\' })
        $present = @{}; foreach ($d in @(Get-PnpDevice -PresentOnly -ErrorAction SilentlyContinue)) { $present[[string]$d.InstanceId] = $true }
        foreach ($d in $all) {
            $id = [string]$d.InstanceId
            $arr = $null; $rem = $null
            try {
                $pp = @(Get-PnpDeviceProperty -InstanceId $id -KeyName 'DEVPKEY_Device_LastArrivalDate','DEVPKEY_Device_LastRemovalDate' -ErrorAction Stop)
                foreach ($p in $pp) {
                    if ($p.KeyName -match 'LastArrivalDate' -and $p.Data) { $arr = [datetime]$p.Data }
                    if ($p.KeyName -match 'LastRemovalDate' -and $p.Data) { $rem = [datetime]$p.Data }
                }
            } catch { continue }
            $inSession = (($arr -and $arr -ge $global:SessionStart) -or ($rem -and $rem -ge $global:SessionStart))
            if (-not $inSession) { continue }
            $fact = "{0} [{1}]: last arrival {2}; last removal {3}; present now: {4}" -f $d.FriendlyName, $id, $(if ($arr) { $arr.ToString('yyyy-MM-dd HH:mm:ss') } else { 'n/a' }), $(if ($rem) { $rem.ToString('yyyy-MM-dd HH:mm:ss') } else { 'n/a' }), $(if ($present.ContainsKey($id)) { 'yes' } else { 'no' })
            if ($id -match '^DISPLAY\\') {
                $after = $false
                $endT = $global:MatchEnd; if (-not $endT) { $endT = Get-Date }
                if ($locked) { if ($arr -and $arr -gt $locked -and $arr -le $endT) { $after = $true } }
                if ($after -and $global:DisplayIdsAtLock.Count -gt 0 -and $global:DisplayIdsAtLock.ContainsKey($id)) {
                    Add-Finding 'CHECK' 'Display' 'A monitor that was already connected at the display check was detected again afterwards (reconnected, woke from sleep or driver reset)' $fact $arr
                }
                elseif ($after) { Add-Finding 'RULE' 'Display' 'Windows recorded a monitor arriving after the single-display check passed' $fact $arr }
                else { Add-TL 'DISPLAY' "Monitor device changed during set-up: $fact" }
            } else {
                Add-Finding 'CHECK' 'Hardware' 'Windows recorded a device arrival or removal during the session' $fact $(if ($arr -and $arr -ge $global:SessionStart) { $arr } else { $rem })
            }
        }
    } catch { Add-Note 'Device arrival/removal history could not be read.' }
}

function Get-SessionEventFacts {
    $since = $global:SessionStart
    Get-LogClearFacts $since
    try {
        foreach ($e in @(Get-WinEvent -FilterHashtable @{ LogName = 'System'; ProviderName = 'Service Control Manager'; Id = 7045; StartTime = $since } -ErrorAction Stop)) {
            $d = @(); try { $d = @($e.Properties | ForEach-Object { [string]$_.Value }) } catch {}
            Add-Finding 'CHECK' 'Drivers' 'A service or driver was installed (System event 7045)' ("name {0}; image {1}; type {2}; start {3}" -f $d[0], $d[1], $d[2], $d[3]) $e.TimeCreated
        }
    } catch {}
    try {
        foreach ($e in @(Get-WinEvent -FilterHashtable @{ LogName = 'Microsoft-Windows-CodeIntegrity/Operational'; StartTime = $since; Level = 1,2,3 } -MaxEvents 40 -ErrorAction Stop)) {
            $m = ($e.Message -split "`r?`n")[0]; if ($m.Length -gt 220) { $m = $m.Substring(0, 220) }
            Add-Finding 'CHECK' 'Drivers' "Code Integrity logged a warning/error (event $($e.Id))" $m $e.TimeCreated
        }
    } catch {}
    try {
        foreach ($e in @(Get-WinEvent -FilterHashtable @{ LogName = 'Microsoft-Windows-Windows Defender/Operational'; Id = 5001,5007,5004; StartTime = $since } -MaxEvents 20 -ErrorAction Stop)) {
            $m = ($e.Message -split "`r?`n" | Select-Object -First 3) -join ' '; if ($m.Length -gt 260) { $m = $m.Substring(0, 260) }
            Add-Finding 'CHECK' 'Windows Defender' "Defender logged event $($e.Id) (configuration or real-time protection change)" $m $e.TimeCreated
        }
    } catch {}
    Get-TimeChangeFacts 3
}

# =========================================================================
# GUARD LOG -> TIMELINE + FINDINGS (done after the match)
# =========================================================================
function Convert-GuardLog {
    $log = @($global:GuardLog | Sort-Object Time)
    $ms = $global:MatchStart; $me = $global:MatchEnd
    $from = $global:SessionStart.AddSeconds(-5); $to = Get-Date
    $audit = @(Get-ProcessAuditEvents $from $to)
    $global:ProcAuditRows = $audit

    # ----- own process tree (this script and everything it started) -----
    $own = @{}; $own[[int]$PID] = $true
    $recs = @()
    foreach ($a in $audit) { $recs += [PSCustomObject]@{ Time = $a.Time; PID = $a.PID; PPID = $a.PPID; Name = [IO.Path]::GetFileName([string]$a.Path); Path = $a.Path; ParentPath = $a.ParentPath; Cmd = $a.Cmd; Sig = $null; Signer = $null; Sha = $null; Src = '4688' } }
    foreach ($g in ($log | Where-Object { $_.Kind -eq 'PROC' })) {
        $dup = $false
        foreach ($r in $recs) { if ($r.PID -eq [int]$g.PID -and [math]::Abs(($r.Time - $g.Time).TotalSeconds) -le 6) { $dup = $true; if ($g.Sig) { $r.Sig = $g.Sig; $r.Signer = $g.Signer; $r.Sha = $g.Sha256 }; break } }
        if (-not $dup) { $recs += [PSCustomObject]@{ Time = $g.Time; PID = [int]$g.PID; PPID = [int]$g.PPID; Name = [string]$g.Name; Path = (Normalize-Path $g.Path); ParentPath = $null; Cmd = $g.Detail; Sig = $g.Sig; Signer = $g.Signer; Sha = $g.Sha256; Src = 'trace' } }
    }
    $recs = @($recs | Sort-Object Time)
    foreach ($r in $recs) { if ($own.ContainsKey([int]$r.PPID)) { $own[[int]$r.PID] = $true } }

    # names of parents (time-aware: latest record for that PID before the child)
    $startProcs = @{}
    if ($global:SnapStart) { foreach ($p in $global:SnapStart.ProcList) { $startProcs[[int]$p.PID] = $p.Name } }
    function Local-ParentName($r, $recsAll) {
        if ($r.ParentPath) { return [IO.Path]::GetFileName([string]$r.ParentPath) }
        $best = $null
        foreach ($x in $recsAll) { if ($x.PID -eq $r.PPID -and $x.Time -le $r.Time) { $best = $x } }
        if ($best) { return $best.Name }
        if ($startProcs.ContainsKey([int]$r.PPID)) { return $startProcs[[int]$r.PPID] }
        return $null
    }

    $allowedClasses = @('Roblox','OBS','NVIDIA','AMD','Malwarebytes','Discord','VPN')
    if ($tier -eq '2') { $allowedClasses += 'Browser' }
    $userParents = '(?i)^(explorer|cmd|powershell|pwsh|windowsterminal|wt|openconsole|taskmgr)(\.exe)?$'
    $allowedPid = @{}
    $ownSkipped = 0
    foreach ($r in $recs) {
        $path = $r.Path
        if ($r.Sig -and $path) { $global:SigCache[$path.ToLower()] = [PSCustomObject]@{ Status = $r.Sig; Publisher = $r.Signer; Cn = $(if ($r.Signer -match 'CN="?([^",]+)') { $matches[1] } else { $null }) } }
        $v = Get-ProcVerdict $r.Name $path
        # A start-up counts as this script's own only if the file is also a verified file in a protected folder.
        # A parent-process ID alone can be faked, and process IDs get reused.
        if ($own.ContainsKey([int]$r.PID) -and (($v.Verified -and (Test-ProtectedLocation $v.Location)) -or ($v.Unreadable -and $r.Name -match '(?i)^(netsh|auditpol|fsutil|bcdedit|conhost|wevtutil)(\.exe)?$'))) { $ownSkipped++; continue }
        $pn = Local-ParentName $r $recs
        $ph = Get-PhaseFor $r.Time
        $tag = "{0} (PID {1}) {2} | parent {3} | {4}" -f $r.Name, $r.PID, $(if ($path) { $path } else { '(path not available)' }), $(if ($pn) { $pn } else { 'unknown' }), $(if ($r.Cmd) { "cmd: $($r.Cmd)" } else { 'no command line recorded' })
        Add-TL 'PROC START' ("{0} [{1}; source {2}]" -f $tag, $v.Class, $r.Src) $r.Time
        $global:FindingTimeOverride = $r.Time
        $nm = ($r.Name -replace '\.exe$', '')
        if ($v.Mismatch) { Add-Finding 'CHECK' 'Software' "A program was started whose file name matches a known program but whose identity does not ($ph)" "$tag :: $($v.Reason)" }
        $tm = Get-ToolNameMatch $r.Name $v
        if ($tm) { Add-Finding 'CHECK' 'Software' "A program on the cheat/injector/debugger tool-name list was started ($ph)" "$tag :: $(Get-FileFacts $v)" }
        elseif ($r.Cmd -and $r.Cmd -match $global:ToolCmdRx -and $nm -notmatch '(?i)^(powershell|pwsh|conhost|cmd)$') { Add-Finding 'CHECK' 'Software' "A started program has a tool name from the list in its command line ($ph)" $tag }
        if ($nm -match $global:MacroRx) { Add-Finding 'CHECK' 'Software' "Hotkey / macro-capable software was started ($ph)" $tag }
        if ($v.Class -eq 'VPN' -and ($nm -notmatch $global:RemoteRx -or $nm -match '^(wireguard|openvpn.*)$')) { Add-TL 'NETWORK' "Allowed VPN software started ($ph): $tag :: $(Get-FileFacts $v)" $r.Time }
        elseif ($nm -match $global:RemoteRx) { Add-Finding 'CHECK' 'Network' "Remote-control, input-sharing or tunnel software was started ($ph)" $tag }
        if (-not (Test-RuleWindow $r.Time)) { continue }

        # Task Manager itself is allowed (only if it is the real file); a program it starts ("Run new task") is not.
        # Other allowed programs may start verified helper files in protected folders, nothing else.
        $isTaskMgr = ($v.Class -eq 'Windows' -and $nm -ieq 'taskmgr')
        $childOfAllowed = ($allowedPid.ContainsKey([int]$r.PPID) -and $pn -notmatch '(?i)^taskmgr' -and $v.Verified -and (Test-ProtectedLocation $v.Location))
        $isAllowed = ($v.Class -in $allowedClasses) -or $isTaskMgr -or $childOfAllowed
        if ($isAllowed -and -not $childOfAllowed) { $allowedPid[[int]$r.PID] = $true }
        $userLaunched = ($pn -and $pn -match $userParents)
        # Windows background components (search host, broker, console host...) are not apps the player opened.
        $sysBackground = ($v.Class -eq 'Windows' -and $nm -notmatch '(?i)^(regedit|mmc|cmd|powershell|pwsh|windowsterminal|openconsole|systemsettings|gamebar|widgets|phoneexperiencehost)$')
        if ($userLaunched -and -not $isAllowed -and -not $sysBackground) {
            Add-Finding 'RULE' 'AllowedPrograms' 'A program outside the allowed list was started from the desktop session during the match' "$tag :: $(Get-FileFacts $v)"
        } elseif (-not $isAllowed) {
            if (-not $v.Verified -and -not $v.Unreadable) { Add-Finding 'CHECK' 'Software' 'A program with no verified identity was started during the match' "$tag :: $($v.Reason); $(Get-FileFacts $v)" }
            elseif ($v.Unreadable -and $r.Src -eq 'trace') { Add-Finding 'CHECK' 'Software' 'A program was started during the match and exited before its file could be identified' $tag }
            elseif ($v.Verified -and -not (Test-ProtectedLocation $v.Location)) { Add-Finding 'CHECK' 'Software' 'A program outside the Windows/Program Files folders was started during the match' "$tag :: $(Get-FileFacts $v)" }
            elseif ($nm -match $global:ShellProcRx) { Add-Finding 'CHECK' 'Software' 'A command interpreter was started during the match by a non-desktop parent' $tag }
        }
    }
    $global:FindingTimeOverride = $null
    if ($ownSkipped -gt 0) { Add-TL 'PROC START' ("({0} start-ups by this script and its own helper programs were left out)" -f $ownSkipped) }

    # ----- other guard events -----
    $ownWin = $own
    foreach ($e in $log) {
        $global:FindingTimeOverride = $e.Time
        $ph = Get-PhaseFor $e.Time
        $locked = $global:DisplayLockedAt
        switch ($e.Kind) {
            'DISPLAY' {
                Add-TL 'DISPLAY' $e.Detail $e.Time
                if ($locked -and $e.Time -gt $locked -and $ph -ne 'AFTER' -and $e.Detail -match '-> (\d+)(;|$)' -and [int]$matches[1] -gt 1) {
                    Add-Finding 'RULE' 'Display' 'More than one display was active after the single-display check passed' $e.Detail $e.Time
                }
            }
            'VDESKTOP' {
                Add-TL 'DISPLAY' $e.Detail $e.Time
                if ($locked -and $e.Time -gt $locked -and $ph -ne 'AFTER' -and $e.Detail -match '-> (\d+)$' -and [int]$matches[1] -gt 1) {
                    Add-Finding 'RULE' 'Desktop' 'More than one virtual desktop existed after the display check passed' $e.Detail $e.Time
                }
            }
            'PROXY' { Add-TL 'NETWORK' $e.Detail $e.Time; Add-Finding 'CHECK' 'Network' 'The locked WinHTTP proxy setting was changed by something while the lock was on' $e.Detail $e.Time }
            'PNP' {
                Add-TL 'DEVICE' ("appeared: {0} [{1}]" -f $e.Name, $e.Path) $e.Time
                if ($e.Path -match '^(USB|HID|PCI|DISPLAY|BTH)') { Add-Finding 'CHECK' 'Hardware' "A device appeared ($ph)" ("{0} [{1}]" -f $e.Name, $e.Path) $e.Time }
            }
            'PNPGONE' {
                Add-TL 'DEVICE' ("disappeared: {0} [{1}]" -f $e.Name, $e.Path) $e.Time
                if ($e.Path -match '^(USB|HID|PCI|DISPLAY|BTH)') { Add-Finding 'CHECK' 'Hardware' "A device disappeared ($ph)" ("{0} [{1}]" -f $e.Name, $e.Path) $e.Time }
            }
            'WINDOW' {
                Add-TL 'WINDOW' ("{0} (PID {1}) window: {2}" -f $e.Name, $e.PID, $e.Detail) $e.Time
                if ((Test-RuleWindow $e.Time) -and -not $ownWin.ContainsKey([int]$e.PID)) {
                    $v = Get-ProcVerdict $e.Name $e.Path ([int]$e.PID)
                    # Judged by verified identity (name + folder + signature), never by file name alone.
                    $okw = ($v.Class -in $allowedClasses) -or ($v.Class -eq 'Windows') -or $allowedPid.ContainsKey([int]$e.PID)
                    if (-not $okw) { Add-Finding 'RULE' 'AllowedPrograms' 'A window of a program outside the allowed list was open during the match' ("{0} (PID {1}) {2} | window title: {3} | {4}" -f $e.Name, $e.PID, $v.Path, $e.Detail, $v.Reason) $e.Time }
                }
            }
            'CONN' {
                Add-TL 'NETWORK' ("{0} (PID {1}) connected to {2}" -f $e.Name, $e.PID, $e.Detail) $e.Time
                if ((Test-RuleWindow $e.Time) -and $e.Name) {
                    $v = Get-ProcVerdict $e.Name $e.Path ([int]$e.PID)
                    if ($v.Class -notin (@('Windows') + $allowedClasses) -and -not $v.Unreadable) {
                        Add-Finding 'CHECK' 'Network' 'Internet connection during the match from a program outside the Windows/Roblox/recorder/Discord/allowed-browser classes' ("{0} (PID {1}) {2} -> {3} :: {4}" -f $e.Name, $e.PID, $v.Path, $e.Detail, $v.Reason) $e.Time
                    }
                }
            }
            'AUDITOFF' { Add-TL 'GUARD' $e.Detail $e.Time; Add-Finding 'CHECK' 'Tampering evidence' 'Process-creation auditing was found switched off during the session (the script switched it back on)' $e.Detail $e.Time }
            'INFO' { Add-Note ("Guard: {0}" -f $e.Detail) }
        }
    }
    $global:FindingTimeOverride = $null
}

