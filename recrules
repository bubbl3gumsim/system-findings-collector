using System.Runtime.InteropServices;
using System.Text;
using System.Threading;

// Read-only forensic helpers. Nothing here writes to another process or changes system state.
//   HandleScan : which OTHER processes hold a handle to a target process that allows reading/writing its memory
//   DeepScan   : PE image hiding in private memory, image-not-file-backed, in-memory image header vs file on disk
//   Overlays   : visible click-through / layered top-level windows (external ESP overlay signature)
//   DeviceMap  : drive letter -> \Device\HarddiskVolumeN (to turn BAM paths into normal paths)
public static class RecForensic
{
    [StructLayout(LayoutKind.Sequential)]
    public struct MBI64
    {
        public IntPtr BaseAddress; public IntPtr AllocationBase; public uint AllocationProtect; public uint Alignment1;
        public IntPtr RegionSize; public uint State; public uint Protect; public uint Type; public uint Alignment2;
    }
    [StructLayout(LayoutKind.Sequential)]
    public struct RECT { public int Left; public int Top; public int Right; public int Bottom; }

    [DllImport("ntdll.dll")] static extern int NtQuerySystemInformation(int cls, IntPtr buf, int len, out int ret);
    [DllImport("ntdll.dll")] static extern int NtQueryInformationProcess(IntPtr h, int cls, IntPtr info, int len, out int ret);
    [DllImport("kernel32.dll", SetLastError = true)] static extern IntPtr OpenProcess(uint access, bool inherit, int pid);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool CloseHandle(IntPtr h);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool ReadProcessMemory(IntPtr h, IntPtr addr, byte[] buf, IntPtr size, out IntPtr read);
    [DllImport("kernel32.dll", SetLastError = true)] static extern UIntPtr VirtualQueryEx(IntPtr h, IntPtr addr, out MBI64 mbi, UIntPtr len);
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)] static extern uint QueryDosDevice(string dev, StringBuilder buf, uint max);

    delegate bool EnumProc(IntPtr hWnd, IntPtr lParam);
    [DllImport("user32.dll")] static extern bool EnumWindows(EnumProc cb, IntPtr lParam);
    [DllImport("user32.dll")] static extern bool IsWindowVisible(IntPtr h);
    [DllImport("user32.dll", EntryPoint = "GetWindowLongW")] static extern int GetWindowLong(IntPtr h, int idx);
    [DllImport("user32.dll")] static extern uint GetWindowThreadProcessId(IntPtr h, out uint pid);
    [DllImport("user32.dll")] static extern bool GetWindowRect(IntPtr h, out RECT r);
    [DllImport("user32.dll", CharSet = CharSet.Unicode)] static extern int GetClassName(IntPtr h, StringBuilder sb, int max);
    [DllImport("user32.dll", CharSet = CharSet.Unicode)] static extern int GetWindowText(IntPtr h, StringBuilder sb, int max);
    [DllImport("user32.dll")] static extern bool GetLayeredWindowAttributes(IntPtr h, out uint key, out byte alpha, out uint flags);
    [DllImport("user32.dll")] static extern int GetSystemMetrics(int idx);
    [DllImport("dwmapi.dll")] static extern int DwmGetWindowAttribute(IntPtr h, int attr, out int val, int size);

    // ------------------------------------------------------------------
    // Drive letters -> device names
    // ------------------------------------------------------------------
    public static string[] DeviceMap()
    {
        List<string> l = new List<string>();
        for (char c = 'A'; c <= 'Z'; c++)
        {
            StringBuilder sb = new StringBuilder(512);
            if (QueryDosDevice(c + ":", sb, 512) != 0) l.Add(c + ":|" + sb.ToString());
        }
        return l.ToArray();
    }

    // ------------------------------------------------------------------
    // Who holds a memory-capable handle to the target process(es)?
    // Returns lines "H|ownerPid|targetPid|0xAccess" or "ERR|reason".
    // Method: our own handle to each target shows up in the system handle table with the kernel
    // object address of that process; any other handle with the same address is a handle to it.
    // ------------------------------------------------------------------
    public static string[] HandleScan(int[] targets)
    {
        List<string> res = new List<string>();
        if (IntPtr.Size != 8) { res.Add("ERR|32-bit host"); return res.ToArray(); }
        if (targets == null || targets.Length == 0) return res.ToArray();
        int selfPid = System.Diagnostics.Process.GetCurrentProcess().Id;
        IntPtr selfH = OpenProcess(0x1000, false, selfPid);
        Dictionary<long, int> probeToTarget = new Dictionary<long, int>();
        List<IntPtr> opened = new List<IntPtr>();
        IntPtr buf = IntPtr.Zero;
        try
        {
            foreach (int t in targets)
            {
                IntPtr th = OpenProcess(0x1000, false, t);
                if (th == IntPtr.Zero) { res.Add("ERR|cannot open target PID " + t + " (error " + Marshal.GetLastWin32Error() + ")"); continue; }
                opened.Add(th);
                probeToTarget[th.ToInt64()] = t;
            }
            if (probeToTarget.Count == 0) return res.ToArray();
            if (selfH == IntPtr.Zero) { res.Add("ERR|cannot open own process"); return res.ToArray(); }

            int len = 0x800000; int ret = 0; int status = 0;
            while (true)
            {
                buf = Marshal.AllocHGlobal(len);
                status = NtQuerySystemInformation(64, buf, len, out ret);   // SystemExtendedHandleInformation
                if (status == unchecked((int)0xC0000004))                      // STATUS_INFO_LENGTH_MISMATCH
                {
                    Marshal.FreeHGlobal(buf); buf = IntPtr.Zero;
                    int want = ret + 0x200000;
                    len = Math.Max(len * 2, want);
                    if (len > 0x30000000) { res.Add("ERR|handle table too large"); return res.ToArray(); }
                    continue;
                }
                break;
            }
            if (status != 0) { res.Add("ERR|NtQuerySystemInformation 0x" + status.ToString("X8")); return res.ToArray(); }

            long count = Marshal.ReadInt64(buf, 0);
            long maxCount = (len - 16) / 40;
            if (count > maxCount) count = maxCount;

            int procType = -1;
            Dictionary<long, int> objToTarget = new Dictionary<long, int>();
            for (long i = 0; i < count; i++)
            {
                int off = 16 + (int)(i * 40);
                long owner = Marshal.ReadInt64(buf, off + 8);
                if (owner != selfPid) continue;
                long hv = Marshal.ReadInt64(buf, off + 16);
                if (hv == selfH.ToInt64()) procType = (ushort)Marshal.ReadInt16(buf, off + 30);
                int tp;
                if (probeToTarget.TryGetValue(hv, out tp))
                {
                    long obj = Marshal.ReadInt64(buf, off);
                    if (obj != 0) objToTarget[obj] = tp;
                }
            }
            if (procType < 0) { res.Add("ERR|process handle type not found"); return res.ToArray(); }
            if (objToTarget.Count == 0) { res.Add("ERR|kernel object addresses are hidden from this process"); return res.ToArray(); }

            HashSet<string> seen = new HashSet<string>();
            for (long i = 0; i < count; i++)
            {
                int off = 16 + (int)(i * 40);
                int ty = (ushort)Marshal.ReadInt16(buf, off + 30);
                if (ty != procType) continue;
                long obj = Marshal.ReadInt64(buf, off);
                int tp;
                if (!objToTarget.TryGetValue(obj, out tp)) continue;
                long owner = Marshal.ReadInt64(buf, off + 8);
                if (owner == selfPid || owner == tp || owner == 0 || owner == 4) continue;
                uint access = (uint)Marshal.ReadInt32(buf, off + 24);
                if ((access & 0x3A) == 0) continue;      // CREATE_THREAD 0x2, VM_OPERATION 0x8, VM_READ 0x10, VM_WRITE 0x20
                string key = owner + "|" + tp + "|0x" + access.ToString("X");
                if (seen.Add(key)) res.Add("H|" + key);
            }
        }
        catch (Exception ex) { res.Add("ERR|" + ex.Message); }
        finally
        {
            if (buf != IntPtr.Zero) Marshal.FreeHGlobal(buf);
            foreach (IntPtr h in opened) CloseHandle(h);
            if (selfH != IntPtr.Zero) CloseHandle(selfH);
        }
        return res.ToArray();
    }

    // ------------------------------------------------------------------
    // PE header helper: returns timestamp and SizeOfImage from a header page, or false.
    // ------------------------------------------------------------------
    static bool ParsePe(byte[] b, int n, out uint stamp, out uint sizeOfImage)
    {
        stamp = 0; sizeOfImage = 0;
        if (n < 0x100 || b[0] != 0x4D || b[1] != 0x5A) return false;
        int lfa = BitConverter.ToInt32(b, 0x3C);
        if (lfa < 0x40 || lfa + 0x60 > n) return false;
        if (b[lfa] != 0x50 || b[lfa + 1] != 0x45 || b[lfa + 2] != 0 || b[lfa + 3] != 0) return false;
        stamp = BitConverter.ToUInt32(b, lfa + 8);
        sizeOfImage = BitConverter.ToUInt32(b, lfa + 0x50);
        return true;
    }

    static bool LooksLikePe(byte[] b, int n)
    {
        uint s, z;
        return ParsePe(b, n, out s, out z);
    }

    // ------------------------------------------------------------------
    // Returns "OK|privRwx|privRwxMB|mzPrivate|mzAddresses|imageState|diskCompare" or "BLOCKED|code".
    //   mzPrivate  : private (not file-backed) regions that START with a full PE header
    //   imageState : IMAGE / NOT_IMAGE(type) / UNKNOWN  (is the main program image file-backed?)
    //   diskCompare: MATCH / MISMATCH(...) / NA        (PE timestamp + size in memory vs the file on disk)
    // ------------------------------------------------------------------
    public static string DeepScan(int pid, string exePath)
    {
        if (IntPtr.Size != 8) return "UNSUPPORTED|32-bit host";
        IntPtr h = OpenProcess(0x0400 | 0x0010, false, pid);
        if (h == IntPtr.Zero) return "BLOCKED|" + Marshal.GetLastWin32Error();
        try
        {
            long imgBase = 0;
            IntPtr pbi = Marshal.AllocHGlobal(48);
            try
            {
                int ret;
                int st = NtQueryInformationProcess(h, 0, pbi, 48, out ret);
                if (st == 0)
                {
                    long peb = Marshal.ReadInt64(pbi, 8);
                    byte[] b8 = new byte[8]; IntPtr rd;
                    if (peb != 0 && ReadProcessMemory(h, (IntPtr)(peb + 0x10), b8, (IntPtr)8, out rd)) imgBase = BitConverter.ToInt64(b8, 0);
                }
            }
            finally { Marshal.FreeHGlobal(pbi); }

            string imageState = "UNKNOWN"; string diskCmp = "NA";
            UIntPtr msz = (UIntPtr)Marshal.SizeOf(typeof(MBI64));
            if (imgBase != 0)
            {
                MBI64 im;
                if (VirtualQueryEx(h, (IntPtr)imgBase, out im, msz) != UIntPtr.Zero)
                {
                    if (im.Type == 0x1000000) imageState = "IMAGE";
                    else imageState = "NOT_IMAGE(type 0x" + im.Type.ToString("X") + ")";
                }
                byte[] mem = new byte[0x1000]; IntPtr got;
                uint mStamp, mSize;
                if (ReadProcessMemory(h, (IntPtr)imgBase, mem, (IntPtr)mem.Length, out got) && ParsePe(mem, (int)got.ToInt64(), out mStamp, out mSize))
                {
                    if (!string.IsNullOrEmpty(exePath) && File.Exists(exePath))
                    {
                        try
                        {
                            byte[] dk = new byte[0x1000]; int dn;
                            using (FileStream fs = new FileStream(exePath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete)) { dn = fs.Read(dk, 0, dk.Length); }
                            uint dStamp, dSize;
                            if (ParsePe(dk, dn, out dStamp, out dSize))
                            {
                                if (dStamp == mStamp && dSize == mSize) diskCmp = "MATCH";
                                else diskCmp = "MISMATCH(memory stamp 0x" + mStamp.ToString("X") + " size 0x" + mSize.ToString("X") + "; file stamp 0x" + dStamp.ToString("X") + " size 0x" + dSize.ToString("X") + ")";
                            }
                        }
                        catch (Exception) { diskCmp = "NA"; }
                    }
                }
                else if (imageState == "IMAGE") { imageState = "IMAGE(header not readable)"; }
                else { imageState = imageState + ",no PE header at image base"; }
            }

            long addr = 0; int rwx = 0; long rwxBytes = 0; int mz = 0;
            List<string> mzAddr = new List<string>();
            MBI64 mbi;
            byte[] page = new byte[0x1000];
            while (addr < 0x7FFFFFFEFFFFL)
            {
                if (VirtualQueryEx(h, (IntPtr)addr, out mbi, msz) == UIntPtr.Zero) break;
                long size = mbi.RegionSize.ToInt64();
                if (mbi.State == 0x1000 && mbi.Type == 0x20000)           // committed, MEM_PRIVATE
                {
                    if (mbi.Protect == 0x40) { rwx++; rwxBytes += size; }
                    if (mbi.BaseAddress == mbi.AllocationBase && size >= 0x1000 && (mbi.Protect & 0x101) == 0)   // not NOACCESS / GUARD
                    {
                        IntPtr rd2;
                        if (ReadProcessMemory(h, mbi.BaseAddress, page, (IntPtr)page.Length, out rd2) && LooksLikePe(page, (int)rd2.ToInt64()))
                        {
                            mz++;
                            if (mzAddr.Count < 4) mzAddr.Add("0x" + mbi.BaseAddress.ToInt64().ToString("X"));
                        }
                    }
                }
                long next = addr + size;
                if (next <= addr) break;
                addr = next;
            }
            return "OK|" + rwx + "|" + Math.Round(rwxBytes / 1048576.0, 2).ToString(System.Globalization.CultureInfo.InvariantCulture) + "|" + mz + "|" + string.Join(",", mzAddr.ToArray()) + "|" + imageState + "|" + diskCmp;
        }
        catch (Exception ex) { return "ERR|" + ex.Message; }
        finally { CloseHandle(h); }
    }

    // ------------------------------------------------------------------
    // Visible layered / click-through windows. Line format:
    // pid|hwnd|exStyle(hex)|class|title|l,t,r,b|coveragePercent|alpha
    // ------------------------------------------------------------------
    public static string[] Overlays()
    {
        List<string> res = new List<string>();
        int sw = GetSystemMetrics(0); int sh = GetSystemMetrics(1);
        double screenArea = (double)Math.Max(1, sw) * Math.Max(1, sh);
        EnumProc cb = delegate(IntPtr hWnd, IntPtr lp)
        {
            try
            {
                if (!IsWindowVisible(hWnd)) return true;
                int ex = GetWindowLong(hWnd, -20);
                bool layered = (ex & 0x80000) != 0;
                bool transparent = (ex & 0x20) != 0;
                bool topmost = (ex & 0x8) != 0;
                if (!(layered && (transparent || topmost))) return true;
                int cloaked = 0;
                try { DwmGetWindowAttribute(hWnd, 14, out cloaked, 4); } catch (Exception) { cloaked = 0; }
                if (cloaked != 0) return true;
                RECT r;
                if (!GetWindowRect(hWnd, out r)) return true;
                long w = Math.Max(0, r.Right - r.Left); long hgt = Math.Max(0, r.Bottom - r.Top);
                if (w < 40 || hgt < 40) return true;
                uint pid; GetWindowThreadProcessId(hWnd, out pid);
                StringBuilder cn = new StringBuilder(128); GetClassName(hWnd, cn, 128);
                StringBuilder tt = new StringBuilder(128); GetWindowText(hWnd, tt, 128);
                uint key; byte alpha = 255; uint fl;
                try { if (!GetLayeredWindowAttributes(hWnd, out key, out alpha, out fl)) alpha = 255; } catch (Exception) { alpha = 255; }
                int cover = (int)Math.Min(100.0, Math.Round(100.0 * (double)w * (double)hgt / screenArea));
                string title = tt.ToString().Replace("|", "/");
                res.Add(pid + "|" + hWnd.ToInt64() + "|0x" + ex.ToString("X") + "|" + cn.ToString().Replace("|", "/") + "|" + title + "|" + r.Left + "," + r.Top + "," + r.Right + "," + r.Bottom + "|" + cover + "|" + alpha + "|" + (transparent ? "click-through" : "topmost"));
            }
            catch (Exception) { }
            return true;
        };
        EnumWindows(cb, IntPtr.Zero);
        GC.KeepAlive(cb);
        return res.ToArray();
    }
}

// ----------------------------------------------------------------------
// Detects mouse input that was injected by software (SendInput and similar) instead of a mouse.
// Uses the standard low-level mouse hook flag LLMHF_INJECTED. It stores no coordinates and no
// window titles: only counts per foreground program and a few time stamps.
// ----------------------------------------------------------------------
public static class RecMouse
{
    delegate IntPtr HookProc(int code, IntPtr wParam, IntPtr lParam);
    [StructLayout(LayoutKind.Sequential)]
    struct MSG { public IntPtr hwnd; public uint message; public IntPtr wParam; public IntPtr lParam; public uint time; public int ptx; public int pty; }

    [DllImport("user32.dll", SetLastError = true)] static extern IntPtr SetWindowsHookEx(int id, HookProc fn, IntPtr mod, uint thread);
    [DllImport("user32.dll")] static extern bool UnhookWindowsHookEx(IntPtr h);
    [DllImport("user32.dll")] static extern IntPtr CallNextHookEx(IntPtr h, int code, IntPtr w, IntPtr l);
    [DllImport("user32.dll")] static extern int GetMessage(out MSG m, IntPtr hwnd, uint min, uint max);
    [DllImport("user32.dll")] static extern bool PostThreadMessage(uint thread, uint msg, IntPtr w, IntPtr l);
    [DllImport("user32.dll")] static extern IntPtr GetForegroundWindow();
    [DllImport("user32.dll")] static extern uint GetWindowThreadProcessId(IntPtr h, out uint pid);
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode)] static extern IntPtr GetModuleHandle(string name);
    [DllImport("kernel32.dll")] static extern uint GetCurrentThreadId();

    static HookProc proc;
    static IntPtr hook = IntPtr.Zero;
    static Thread th;
    static uint tid;
    static readonly object lk = new object();
    static long allCount;
    static long injCount;
    static Dictionary<int, long> byFg = new Dictionary<int, long>();
    static List<string> samples = new List<string>();
    static DateTime firstInj = DateTime.MinValue;
    static DateTime lastInj = DateTime.MinValue;
    static DateTime started = DateTime.MinValue;
    static int cachedFgPid;
    static int cachedFgTick;
    static string startResult = "";
    static bool running;

    static IntPtr Callback(int code, IntPtr w, IntPtr l)
    {
        if (code >= 0)
        {
            allCount++;
            int flags = Marshal.ReadInt32(l, 12);
            if ((flags & 3) != 0) Record(flags);
        }
        return CallNextHookEx(IntPtr.Zero, code, w, l);
    }

    static void Record(int flags)
    {
        int now = Environment.TickCount;
        if (now - cachedFgTick > 150 || cachedFgTick == 0)
        {
            uint pid = 0;
            IntPtr fg = GetForegroundWindow();
            if (fg != IntPtr.Zero) GetWindowThreadProcessId(fg, out pid);
            cachedFgPid = (int)pid; cachedFgTick = now;
        }
        lock (lk)
        {
            injCount++;
            DateTime t = DateTime.Now;
            if (firstInj == DateTime.MinValue) firstInj = t;
            lastInj = t;
            long c;
            byFg.TryGetValue(cachedFgPid, out c);
            byFg[cachedFgPid] = c + 1;
            if (samples.Count < 40 && (injCount <= 10 || injCount % 25 == 0))
                samples.Add(t.ToString("yyyy-MM-dd HH:mm:ss.fff") + "|fg " + cachedFgPid + "|flags " + flags);
        }
    }

    static void Run()
    {
        try
        {
            tid = GetCurrentThreadId();
            proc = new HookProc(Callback);
            IntPtr mod = GetModuleHandle(null);
            hook = SetWindowsHookEx(14, proc, mod, 0);
            if (hook == IntPtr.Zero) { startResult = "ERR|SetWindowsHookEx failed (" + Marshal.GetLastWin32Error() + ")"; return; }
            startResult = "OK";
            MSG m;
            while (GetMessage(out m, IntPtr.Zero, 0, 0) > 0) { }
        }
        catch (Exception ex) { startResult = "ERR|" + ex.Message; }
        finally
        {
            if (hook != IntPtr.Zero) { UnhookWindowsHookEx(hook); hook = IntPtr.Zero; }
            running = false;
        }
    }

    public static string Start()
    {
        if (running) return "OK";
        lock (lk) { allCount = 0; injCount = 0; byFg.Clear(); samples.Clear(); firstInj = DateTime.MinValue; lastInj = DateTime.MinValue; }
        startResult = "";
        started = DateTime.Now;
        running = true;
        th = new Thread(Run);
        th.IsBackground = true;
        th.Priority = ThreadPriority.Highest;
        th.Start();
        for (int i = 0; i < 40 && startResult == ""; i++) Thread.Sleep(50);
        if (startResult == "") { running = false; return "ERR|hook thread did not start"; }
        if (startResult != "OK") running = false;
        return startResult;
    }

    // Lines: "S|seconds|allMouseEvents|injectedEvents|firstInjected|lastInjected", "FG|pid|count", "E|sample"
    public static string[] Stop()
    {
        List<string> res = new List<string>();
        if (running)
        {
            try { PostThreadMessage(tid, 0x12, IntPtr.Zero, IntPtr.Zero); } catch (Exception) { }
            if (th != null) th.Join(2000);
        }
        double secs = started == DateTime.MinValue ? 0 : (DateTime.Now - started).TotalSeconds;
        lock (lk)
        {
            res.Add("S|" + Math.Round(secs) + "|" + allCount + "|" + injCount + "|" + (firstInj == DateTime.MinValue ? "" : firstInj.ToString("yyyy-MM-dd HH:mm:ss")) + "|" + (lastInj == DateTime.MinValue ? "" : lastInj.ToString("yyyy-MM-dd HH:mm:ss")));
            foreach (KeyValuePair<int, long> kv in byFg) res.Add("FG|" + kv.Key + "|" + kv.Value);
            foreach (string s in samples) res.Add("E|" + s);
        }
        return res.ToArray();
    }
}

