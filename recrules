# ---- 13. connections to other devices on the local network ----
function FScanLanFeed {
    $conns = @(); try { $conns = @(Get-NetTCPConnection -State Established -ErrorAction Stop) } catch { return }
    $priv = '^(10\.|192\.168\.|172\.(1[6-9]|2\d|3[01])\.)'
    $seen = @{}
    foreach ($c in $conns) {
        if ([string]$c.RemoteAddress -notmatch $priv) { continue }
        if ($c.RemotePort -lt 1024 -and $c.RemotePort -ne 3389) { continue }
        $p = $null; try { $p = Get-Process -Id $c.OwningProcess -ErrorAction Stop } catch { continue }
        $path = ''; try { $path = [string]$p.Path } catch {}
        if ($path -match '(?i)^[a-z]:\\windows\\') { continue }
        if ($path) { $sig = FSig $path; if ($sig.Status -eq 'Valid' -and $sig.Subject -match $global:FTrustedSignerRx) { continue } }
        $k = "$($p.Name)|$($c.RemoteAddress)|$($c.RemotePort)"; if ($seen.ContainsKey($k)) { continue }; $seen[$k] = 1
        FCheckU 'Network' 'A program has a connection to another device on the local network (possible second-PC or phone feed)' ("{0} (PID {1}) {2} -> {3}:{4}" -f $p.Name, $p.Id, $path, $c.RemoteAddress, $c.RemotePort)
    }
}

# ---- 14. virtual machine / sandbox / WSL running ----
function FScanVirtualization {
    $rx = '(?i)^(vmwp|vmmem.*|windowssandbox.*|vmware-vmx|virtualboxvm|vboxheadless|qemu-system.*|wsl|wslhost)$'
    $n = @(Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.Name -match $rx } | ForEach-Object { $_.Name } | Select-Object -Unique)
    if ($n.Count -gt 0) { FCheckU 'System state' 'A virtual machine, sandbox or WSL process is running (a second operating system could host other software)' ($n -join ', ') }
}

# ---- 15. Defender protection switched off or changed since the script started ----
function FScanDefenderChanges {
    $ss = $global:FCtx.SessionStart; if (-not $ss) { return }
    $ev = @(); try { $ev = @(Get-WinEvent -FilterHashtable @{ LogName = 'Microsoft-Windows-Windows Defender/Operational'; Id = 5001, 5004, 5007, 5010, 5012, 5013; StartTime = $ss } -MaxEvents 80 -ErrorAction Stop) } catch {}
    foreach ($e in $ev) {
        $msg = (([string]$e.Message -split "`r?`n") | Select-Object -First 4) -join ' / '
        if ($e.Id -in 5001, 5010, 5012, 5013) { FCheckU 'Windows Defender' 'A Defender protection was switched off since the script started' ("event {0}: {1}" -f $e.Id, $msg) $e.TimeCreated }
        elseif ($msg -match '(?i)(exclusion|DisableRealtime|DisableAntiSpyware|Tamper|ControlledFolder|PUAProtection|SpynetReporting|DisableBehavior|DisableIOAV|DisableScan)') { FCheckU 'Windows Defender' 'A Defender protection setting changed since the script started' ("event {0}: {1}" -f $e.Id, $msg) $e.TimeCreated }
    }
}

# ---- 11 / 12. clock changes, sleep and resume recorded by Windows since the script started ----
function FScanClockPower {
    $ss = $global:FCtx.SessionStart; if (-not $ss) { return }
    try { foreach ($e in @(Get-WinEvent -FilterHashtable @{ LogName = 'System'; ProviderName = 'Microsoft-Windows-Kernel-General'; Id = 1; StartTime = $ss } -MaxEvents 20 -ErrorAction Stop)) { FCheckU 'Tampering evidence' 'Windows recorded a system clock change since the script started' (([string]$e.Message -split "`r?`n")[0]) $e.TimeCreated } } catch {}
    try { foreach ($e in @(Get-WinEvent -FilterHashtable @{ LogName = 'System'; ProviderName = 'Microsoft-Windows-Power-Troubleshooter'; Id = 1; StartTime = $ss } -MaxEvents 10 -ErrorAction Stop)) { FCheckU 'Monitoring' 'The PC went to sleep and resumed since the script started (monitoring was interrupted)' (([string]$e.Message -split "`r?`n") | Select-Object -First 2) -join ' ' $e.TimeCreated } } catch {}
    try { $b = (Get-CimInstance Win32_OperatingSystem -ErrorAction Stop).LastBootUpTime; $mins = [int]($ss - $b).TotalMinutes; FNote ("Uptime: the PC had been running {0} minute(s) when the script started (boot {1})." -f $mins, $b.ToString('yyyy-MM-dd HH:mm')); if ($mins -lt 15) { FCheckU 'System state' 'The PC was restarted within 15 minutes before the script started (memory and some traces are cleared by a restart)' ("boot {0}" -f $b.ToString('yyyy-MM-dd HH:mm')) $b } } catch {}
}

# ---- state of protections, compared over time ----
function FProtState {
    $o = [ordered]@{}
    try { $o['Memory integrity (HVCI) setting'] = [string](Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\DeviceGuard\Scenarios\HypervisorEnforcedCodeIntegrity' -ErrorAction Stop).Enabled } catch { $o['Memory integrity (HVCI) setting'] = 'n/a' }
    try { $o['Device Guard services running'] = ((Get-CimInstance -Namespace 'root\Microsoft\Windows\DeviceGuard' -ClassName Win32_DeviceGuard -ErrorAction Stop).SecurityServicesRunning -join ',') } catch { $o['Device Guard services running'] = 'n/a' }
    try { $mp = Get-MpComputerStatus -ErrorAction Stop; $o['Defender real-time protection'] = [string]$mp.RealTimeProtectionEnabled; $o['Defender tamper protection'] = [string]$mp.IsTamperProtected } catch {}
    try { $pr = Get-MpPreference -ErrorAction Stop; $o['Defender exclusions (paths/extensions/processes)'] = ("{0}/{1}/{2}" -f @($pr.ExclusionPath).Count, @($pr.ExclusionExtension).Count, @($pr.ExclusionProcess).Count) } catch {}
    return $o
}

function FGpuSample {
    $r = @{}
    try {
        $cs = Get-Counter -Counter '\GPU Engine(*)\Utilization Percentage' -ErrorAction Stop
        foreach ($s in $cs.CounterSamples) {
            if ($s.CookedValue -le 0) { continue }
            if ($s.InstanceName -match 'pid_(\d+)_.*engtype_(.+)$') { $k = "$($matches[1])|$($matches[2])"; $r[$k] = [double]$r[$k] + [double]$s.CookedValue }
        }
    } catch {}
    return $r
}

# Removable drive letters (card readers, USB sticks, and USB disks when Windows reports them)
function FRemovableLetters {
    $l = @{}
    try { foreach ($d in @(Get-CimInstance Win32_LogicalDisk -Filter 'DriveType=2' -ErrorAction Stop)) { if ($d.DeviceID) { $l[[string]$d.DeviceID.Substring(0, 1).ToUpper()] = [string]$d.VolumeName } } } catch {}
    return $l
}
function FUsbDiskLetters {
    $l = @{}
    try { foreach ($dk in @(Get-Disk -ErrorAction Stop | Where-Object { [string]$_.BusType -eq 'USB' })) { foreach ($pt in @(Get-Partition -DiskNumber $dk.Number -ErrorAction SilentlyContinue)) { if ($pt.DriveLetter) { $l[[string]$pt.DriveLetter] = [string]$dk.FriendlyName } } } } catch {}
    return $l
}

function FEvSpecs { @(
    @{ L = 'Security'; Ids = @(1102, 4688); Tag = 'sec' },
    @{ L = 'System'; Ids = @(104, 7045, 1, 12, 13, 20001, 6008, 41); Tag = 'sys' },
    @{ L = 'Microsoft-Windows-Windows Defender/Operational'; Ids = @(1116, 1117, 1118, 1119, 5001, 5004, 5007, 5010, 5012); Tag = 'def' },
    @{ L = 'Microsoft-Windows-DriverFrameworks-UserMode/Operational'; Ids = @(2003, 2100, 2102, 2105); Tag = 'usb' },
    @{ L = 'Microsoft-Windows-CodeIntegrity/Operational'; Ids = @(3033, 3034, 3076, 3077); Tag = 'ci' }
) }

# ---- the live sampler: runs at low priority from script start until the match ends ----
function FRunSampler {
    $sync = $global:FCtx.Sync; $tick = 10
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $info = @{}; $last = @{}; $total = @{}; $rates = @{}; $gpu = @{}
    $removable = $sync.Removable; $remNow = @{}; $remEver = @{}; $startRem = $null
    $capture = New-Object System.Collections.ArrayList; $evLast = Get-Date
    $logCount = @{}; $protBase = $null; $bamBase = $null; $tzBase = $null
    $lastWall = [DateTime]::UtcNow; $lastMono = 0.0; $lastTick = 0.0
    $heavyDue = 30.0; $matchSeen = $null; $lastGpu = -99.0; $lastProt = -99.0; $lastEv = -99.0; $lastX = -99.0; $ticks = 0
    $cores = [Environment]::ProcessorCount; $allMask = [int64]([math]::Pow(2, [math]::Min($cores, 62)) - 1)
    $heavy = @('FScanUsbVendors', 'FScanVersionInfo', 'FScanImports', 'FScanSideload', 'FScanCertQuality', 'FScanRemoteTools', 'FScanLanFeed', 'FScanVirtualization', 'FScanDefenderChanges')
    try { [TimeZoneInfo]::ClearCachedData(); $tzBase = [TimeZoneInfo]::Local.Id } catch {}
    try { $map = @([RecForensic]::DeviceMap()); $bamBase = @{}; foreach ($r in @(FReadBam $map)) { if ($r.Path -match $global:FUserRx) { $bamBase[$r.Path.ToLower()] = $r.Path } } } catch { $bamBase = $null }

    while (-not $sync.Stop -and $sw.Elapsed.TotalSeconds -lt 21600) {
        $now = $sw.Elapsed.TotalSeconds; $dt = [math]::Max(0.5, $now - $lastTick); $lastTick = $now; $ticks++
        $active = ($null -ne $sync.MatchStart)
        if ($active -and -not $matchSeen) { $matchSeen = $now; $heavyDue = $now + 45 }

        # clock steadiness and sleep (11, 12)
        $wall = [DateTime]::UtcNow; $dw = ($wall - $lastWall).TotalSeconds; $dm = $now - $lastMono
        if ($dm -gt 60) { FCheckU 'Monitoring' 'The live sampler was paused or the PC slept for a while' ("{0:N0} s gap at {1}" -f $dm, (Get-Date).ToString('HH:mm:ss')) }
        elseif ([math]::Abs($dw - $dm) -gt 3) { FCheckU 'Tampering evidence' 'The system clock jumped relative to a steady timer (possible time tampering)' ("clock moved {0:N1} s while a steady timer measured {1:N1} s, at {2}" -f $dw, $dm, (Get-Date).ToString('HH:mm:ss')) }
        $lastWall = $wall; $lastMono = $now
        try { [TimeZoneInfo]::ClearCachedData(); if ($tzBase -and [TimeZoneInfo]::Local.Id -ne $tzBase) { FCheckU 'Tampering evidence' 'The Windows time zone changed during the session' ("{0} -> {1}" -f $tzBase, [TimeZoneInfo]::Local.Id); $tzBase = [TimeZoneInfo]::Local.Id } } catch {}

        # removable drives (3)
        $cur = FRemovableLetters
        if ($ticks % 3 -eq 1) { $u = FUsbDiskLetters; foreach ($k in $u.Keys) { $cur[$k] = $u[$k] } }
        if ($null -eq $startRem) { $startRem = @{}; foreach ($k in $cur.Keys) { $startRem[$k] = 1 } }
        foreach ($k in $cur.Keys) {
            if (-not $remNow.ContainsKey($k)) {
                $when = Get-Date; $remEver[$k] = $when; $removable[$k] = @{ First = $when; Label = $cur[$k] }
                if (-not $startRem.ContainsKey($k)) { FAdd 'TL' 'USB' ("Removable drive {0}: ({1}) appeared" -f $k, $cur[$k]) '' $when }
            }
        }
        foreach ($k in @($remNow.Keys)) {
            if (-not $cur.ContainsKey($k)) { FCheckU 'Hardware' 'A removable drive was removed while the script was running (a program can run from a USB drive and leave little behind)' ("drive {0}: ({1}) removed at {2}; first seen {3}" -f $k, $remNow[$k], (Get-Date).ToString('HH:mm:ss'), $remEver[$k].ToString('HH:mm:ss')) (Get-Date) }
        }
        $remNow = $cur

        # per-process CPU, identity, priority (16, 19, 20) and programs running from removable drives
        $procs = @(Get-Process -ErrorAction SilentlyContinue)
        $ids = @{}
        foreach ($p in $procs) {
            $id = [int]$p.Id; if ($id -le 4) { continue }; $ids[$id] = 1
            $cpu = $null; try { $cpu = $p.TotalProcessorTime.TotalSeconds } catch {}
            if (-not $info.ContainsKey($id) -or $info[$id].Name -ne $p.Name) {
                $path = ''; try { $path = [string]$p.Path } catch {}
                $prio = ''; try { $prio = [string]$p.PriorityClass } catch {}
                $aff = 0L; try { $aff = [int64]$p.ProcessorAffinity } catch {}
                $info[$id] = @{ Name = [string]$p.Name; Path = $path; Prio = $prio; Aff = $aff; Born = $active }
                $last.Remove($id); $total[$id] = 0.0; $rates[$id] = New-Object System.Collections.ArrayList
                if ($path -match '^([A-Za-z]):\\' -and $remEver.ContainsKey($matches[1].ToUpper()) -and $remNow.ContainsKey($matches[1].ToUpper())) { FCheckU 'Software' 'A program is running from a removable drive' ("{0} (PID {1}) {2}" -f $p.Name, $id, $path) }
            }
            if ($null -eq $cpu) { continue }
            if (-not $last.ContainsKey($id)) { $last[$id] = $(if ($active -and $info[$id].Born) { 0.0 } else { $cpu }) }
            $d = [math]::Max(0.0, $cpu - $last[$id]); $last[$id] = $cpu
            if ($active) { $total[$id] += $d; if ($rates[$id].Count -lt 400) { [void]$rates[$id].Add($d / $dt) } }
        }

        # GPU per process (17)
        if ($active -and ($now - $lastGpu) -ge 25) {
            $lastGpu = $now
            foreach ($kv in (FGpuSample).GetEnumerator()) { $e = $gpu[$kv.Key]; if (-not $e) { $e = @(0.0, 0) }; $gpu[$kv.Key] = @(($e[0] + $kv.Value), ($e[1] + 1)) }
        }

        # protections over time (15)
        if (($now - $lastProt) -ge 60) {
            $lastProt = $now; $ps = FProtState
            if ($null -eq $protBase) { $protBase = $ps }
            else { foreach ($k in $ps.Keys) { if ($protBase.Contains($k) -and $protBase[$k] -ne $ps[$k]) { FCheckU 'Windows Defender' 'A protection setting changed during the session' ("{0}: {1} -> {2} (seen at {3})" -f $k, $protBase[$k], $ps[$k], (Get-Date).ToString('HH:mm:ss')) } } }
        }

        # live event capture and event-log health (1, 2)
        if (($now - $lastEv) -ge 60) {
            $lastEv = $now; $since = $evLast; $evLast = Get-Date
            foreach ($sp in (FEvSpecs)) {
                $evs = @(); try { $evs = @(Get-WinEvent -FilterHashtable @{ LogName = $sp.L; Id = $sp.Ids; StartTime = $since } -MaxEvents 300 -ErrorAction Stop) } catch {}
                foreach ($e in $evs) {
                    $txt = ([string]$e.Message -split "`r?`n")[0]
                    if ($e.Id -eq 4688) { $m4 = [regex]::Match([string]$e.Message, 'New Process Name:\s+(.+)'); if ($m4.Success) { $txt = $m4.Groups[1].Value.Trim() } else { continue }; if ($txt -match '(?i)^[a-z]:\\windows\\') { continue } }
                    if ($capture.Count -lt 3000) { [void]$capture.Add([PSCustomObject]@{ Time = $e.TimeCreated.ToString('yyyy-MM-dd HH:mm:ss'); Log = $sp.Tag; Id = $e.Id; Provider = [string]$e.ProviderName; Text = $(if ($txt.Length -gt 220) { $txt.Substring(0, 220) } else { $txt }) }) }
                    if ($e.Id -in 1102, 104) { FCheckU 'Tampering evidence' 'An event log was cleared (captured live, so the evidence survives the wipe)' ("{0} log, event {1} at {2}: {3}" -f $sp.Tag, $e.Id, $e.TimeCreated.ToString('HH:mm:ss'), $txt) $e.TimeCreated }
                }
                try {
                    $ll = Get-WinEvent -ListLog $sp.L -ErrorAction Stop; $cnt = [int64]$ll.RecordCount
                    if ($logCount.ContainsKey($sp.L) -and $logCount[$sp.L] -gt 200 -and $cnt -lt ($logCount[$sp.L] * 0.5)) { FCheckU 'Tampering evidence' 'An event log lost most of its records during the session (cleared or deleted)' ("{0}: {1} records earlier, {2} now (at {3})" -f $sp.L, $logCount[$sp.L], $cnt, (Get-Date).ToString('HH:mm:ss')) }
                    $logCount[$sp.L] = $cnt
                } catch {}
            }
        }

        # cross-view: network endpoints or WMI processes missing from the process list (18)
        if (($now - $lastX) -ge 60) {
            $lastX = $now
            $sus = @{}
            try { foreach ($c in @(Get-NetTCPConnection -ErrorAction Stop)) { $o = [int]$c.OwningProcess; if ($o -gt 4 -and -not $ids.ContainsKey($o)) { $sus[$o] = 'owns a TCP endpoint' } } } catch {}
            try { foreach ($c in @(Get-NetUDPEndpoint -ErrorAction Stop)) { $o = [int]$c.OwningProcess; if ($o -gt 4 -and -not $ids.ContainsKey($o)) { $sus[$o] = 'owns a UDP endpoint' } } } catch {}
            try { foreach ($c in @(Get-CimInstance Win32_Process -ErrorAction Stop)) { $o = [int]$c.ProcessId; if ($o -gt 4 -and -not $ids.ContainsKey($o)) { $sus[$o] = "is listed by WMI as {0}" -f $c.Name } } } catch {}
            if ($sus.Count -gt 0) {
                Start-Sleep -Milliseconds 1500
                $again = @{}; foreach ($p in @(Get-Process -ErrorAction SilentlyContinue)) { $again[[int]$p.Id] = 1 }
                foreach ($o in $sus.Keys) { if (-not $again.ContainsKey($o)) { try { $chk = Get-CimInstance Win32_Process -Filter ("ProcessId={0}" -f $o) -ErrorAction Stop } catch { $chk = $null }; if ($chk -or $sus[$o] -like '*endpoint') { FCheckU 'Software' 'A process ID appears in network or WMI listings but is missing from the normal process list (hidden-process indicator)' ("PID {0} {1}{2}" -f $o, $sus[$o], $(if ($chk) { "; WMI name " + $chk.Name } else { '' })) } } }
            }
        }

        # heavier checks: once early, once shortly after the match starts, then every 5 minutes
        if ($now -ge $heavyDue) {
            $heavyDue = $now + 300
            foreach ($h in $heavy) { if ($sync.Stop) { break }; try { & $h } catch { FAdd 'COVER' '' ("{0} failed: {1}" -f $h, $_.Exception.Message) } }
        }
        for ($i = 0; $i -lt $tick -and -not $sync.Stop; $i++) { Start-Sleep -Seconds 1 }
    }

    # ---- wrap-up ----
    foreach ($k in $remEver.Keys) { $sync.Removable[$k] = @{ First = $remEver[$k]; Label = '' } }
    try { FScanDefenderChanges; FScanClockPower } catch {}
    try {
        if ($bamBase) { $map = @([RecForensic]::DeviceMap()); $now2 = @{}; foreach ($r in @(FReadBam $map)) { $now2[$r.Path.ToLower()] = 1 }; $gone = @($bamBase.Keys | Where-Object { -not $now2.ContainsKey($_) }); if ($gone.Count -gt 0) { FCheckU 'Tampering evidence' 'Execution-history (BAM) entries for programs in user folders that existed when the script started are gone' ("{0} entr(ies) removed; first: {1}" -f $gone.Count, (($gone | Select-Object -First 5 | ForEach-Object { $bamBase[$_] }) -join ' | ')) } }
    } catch {}
    # CPU table, unsigned CPU users, steady pattern, priority
    $rows = @()
    foreach ($id in $total.Keys) {
        $i = $info[$id]; if (-not $i) { continue }
        $r = $rates[$id]; $mean = 0.0; $cv = 9.0; $nz = 0
        if ($r.Count -ge 20) { $mean = ($r | Measure-Object -Average).Average; $nz = @($r | Where-Object { $_ -gt 0.0005 }).Count; if ($mean -gt 0) { $var = 0.0; foreach ($x in $r) { $var += [math]::Pow($x - $mean, 2) }; $cv = [math]::Sqrt($var / $r.Count) / $mean } }
        $rows += [PSCustomObject]@{ Id = $id; Name = $i.Name; Path = $i.Path; Cpu = [math]::Round($total[$id], 1); Mean = $mean; Cv = $cv; Frac = $(if ($r.Count) { $nz / $r.Count } else { 0 }); N = $r.Count; Prio = $i.Prio; Aff = $i.Aff }
    }
    $thirdParty = @($rows | Where-Object { $_.Path -and $_.Path -notmatch '(?i)^[a-z]:\\windows\\' })
    $out = @()
    foreach ($t in @($rows | Sort-Object Cpu -Descending | Select-Object -First 40)) { $s = FSig $t.Path; $out += [PSCustomObject]@{ Program = $t.Name; PID = $t.Id; Path = $t.Path; CpuSecondsDuringMatch = $t.Cpu; Signature = $s.Status; Signer = $s.Cn; Priority = $t.Prio } }
    if ($out.Count -gt 0) { FAdd 'DATA' '31_cpu_time_by_process' '' '' $null $out }
    foreach ($t in @($thirdParty | Sort-Object Cpu -Descending | Select-Object -First 40)) {
        $s = FSig $t.Path
        if ($t.Cpu -ge 20 -and $s.Status -ne 'Valid') { FCheckU 'Software' 'An unsigned or unreadable-signature program used notable CPU time during the match (informational)' ("{0} (PID {1}) {2}; {3} s of CPU; signature {4}" -f $t.Name, $t.Id, $t.Path, $t.Cpu, $s.Status) }
        if ($t.N -ge 30 -and $t.Frac -ge 0.9 -and $t.Mean -ge 0.002 -and $t.Mean -le 0.5 -and $t.Cv -lt 0.12 -and $t.Name -notmatch '(?i)^(roblox|obs)') {
            $unsig = ($s.Status -ne 'Valid')
            FCheckU 'Software' $(if ($unsig) { 'An unsigned program used a steady, regular amount of CPU every few seconds (pattern match, low confidence)' } else { 'A program used a steady, regular amount of CPU every few seconds (pattern match, low confidence)' }) ("{0} (PID {1}) {2}; average {3:P1} of one core, variation {4:P0}, active in {5:P0} of {6} samples" -f $t.Name, $t.Id, $t.Path, $t.Mean, $t.Cv, $t.Frac, $t.N)
        }
        if ($t.Prio -in 'High', 'RealTime' -and $s.Status -ne 'Valid' -and $t.Name -notmatch '(?i)^roblox') { FCheckU 'Software' 'An unsigned program runs at High or Realtime priority (informational)' ("{0} (PID {1}) {2}; priority {3}" -f $t.Name, $t.Id, $t.Path, $t.Prio) }
        if ($t.Aff -gt 0 -and $t.Aff -ne $allMask -and $s.Status -ne 'Valid' -and $t.Name -notmatch '(?i)^roblox') { FCheckU 'Software' 'An unsigned program is pinned to specific CPU cores (informational)' ("{0} (PID {1}) {2}; affinity mask {3} of {4} cores" -f $t.Name, $t.Id, $t.Path, $t.Aff, $cores) }
    }
    # GPU table
    $grows = @(); $byPid = @{}
    foreach ($k in $gpu.Keys) { $pp = $k.Split('|'); $avg = $gpu[$k][0] / [math]::Max(1, $gpu[$k][1]); $inf = $info[[int]$pp[0]]; $grows += [PSCustomObject]@{ PID = [int]$pp[0]; Program = $(if ($inf) { $inf.Name } else { 'exited' }); Path = $(if ($inf) { $inf.Path } else { '' }); Engine = $pp[1]; AvgPercent = [math]::Round($avg, 2); Samples = $gpu[$k][1] } }
    if ($grows.Count -gt 0) { FAdd 'DATA' '32_gpu_use_by_process' '' '' $null @($grows | Sort-Object AvgPercent -Descending | Select-Object -First 60) }
    foreach ($g in @($grows | Where-Object { $_.Path -and $_.Path -notmatch '(?i)^[a-z]:\\windows\\' -and $_.AvgPercent -ge 1 -and $_.Engine -match '(?i)(3D|Compute|Video|Copy)' } | Sort-Object AvgPercent -Descending | Select-Object -First 12)) {
        $s = FSig $g.Path
        if ($s.Status -ne 'Valid') { FCheckU 'Software' 'An unsigned program used the GPU during the match (3D, compute, video or copy engine)' ("{0} (PID {1}) {2}; {3} engine averaged {4}% over {5} samples" -f $g.Program, $g.PID, $g.Path, $g.Engine, $g.AvgPercent, $g.Samples) }
    }
    if ($capture.Count -gt 0) { FAdd 'DATA' '33_live_event_capture' '' '' $null @($capture) }
    FNote ("Live sampler: {0} samples over {1:N0} minutes (processes, CPU, GPU, drives, clock, event logs, protections). A cheat that matches normal CPU use is not caught by CPU alone, which is why handles, memory, overlays, GPU and signatures are checked too." -f $ticks, ($sw.Elapsed.TotalMinutes))
}

function FRun([string]$which) {
    try { [System.Threading.Thread]::CurrentThread.Priority = 'BelowNormal' } catch {}
    if ($global:FCtx.ExtraVuln) { $global:FVulnDrivers = @($global:FVulnDrivers) + @($global:FCtx.ExtraVuln | ForEach-Object { ([string]$_).ToLower() }) }
    $steps = @()
    if ($which -eq 'artifacts') { $steps = @('FScanPosture', 'FScanDefender', 'FScanMalwarebytes', 'FScanExecHistory', 'FScanKnownHashes', 'FScanDrivers', 'FScanPersistence', 'FScanCerts', 'FScanDma', 'FScanProcessMemory') }
    elseif ($which -eq 'roblox') { $steps = @('FScanRobloxInstall') }
    elseif ($which -eq 'sampler') { $steps = @('FRunSampler') }
    foreach ($s in $steps) {
        $sw = [System.Diagnostics.Stopwatch]::StartNew()
        try { & $s; FAdd 'COVER' '' ("{0}: finished in {1:N1} s" -f $s.Substring(1), $sw.Elapsed.TotalSeconds) }
        catch { FAdd 'COVER' '' ("{0}: FAILED after {1:N1} s - {2}" -f $s.Substring(1), $sw.Elapsed.TotalSeconds, $_.Exception.Message) }
    }
    FAdd 'COVER' '' "background job '$which' completed"
}

'@

# =========================================================================
# FORENSIC ENGINE (added). Slow history/artifact checks run in a background, low-priority
# window while the player does the manual steps, so they add no waiting time. Live checks
# (handles, memory, localhost, overlays) take about a second and run with the normal scans.
# Staff switches:
#   $global:EnableForensics  = $false   switches off ALL added checks
#   $global:EnableMouseCheck = $false   switches off only the injected-mouse monitor
# =========================================================================
$global:BgJobs = @()
$global:Posture = @()
$global:ForensicData = @{}
$global:ForensicCover = New-Object System.Collections.ArrayList
$global:MouseWatchOn = $false

# =========================================================================
# ROBLOX LOG CHECK - reads only the tail of the newest logs. Wording differs between Roblox versions,
# so every hit is a pattern match for staff to read, not a conclusion.
# =========================================================================
function Scan-RobloxLogs([string]$label) {
    $dir = "$env:LOCALAPPDATA\Roblox\logs"
    if (-not (Test-Path $dir)) { Add-Note 'Roblox logs folder not found; log check skipped.'; return }
    $pats = @(
        @{ Name = 'a client settings override file'; Rx = '(?i)ClientAppSettings|ClientSettings\\' },
        @{ Name = 'an injection / tamper word';       Rx = '(?i)\b(inject(ed|ion)?|tamper(ed|ing)?|hooked|debugger attached)\b' },
        @{ Name = 'an anti-cheat violation word';     Rx = '(?i)(hyperion|byfron|anti-?cheat).{0,60}(violation|detected|blocked|fail)' },
        @{ Name = 'a fast-flag override';             Rx = '(?i)(FFlag|DFFlag|FInt|DFInt)[A-Za-z0-9_]+\s*(=|:)\s*\S+.{0,40}(override|user|manual)' }
    )
    $logs = @(Get-ChildItem $dir -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 3)
    $seen = @{}
    foreach ($lf in $logs) {
        $txt = ''
        try {
            $fs = New-Object System.IO.FileStream($lf.FullName, 'Open', 'Read', 'ReadWrite')
            try {
                $len = [int][math]::Min($fs.Length, 4MB); [void]$fs.Seek(-$len, 'End'); $buf = New-Object byte[] $len
                $got = $fs.Read($buf, 0, $len); $txt = [System.Text.Encoding]::UTF8.GetString($buf, 0, $got)
            } finally { $fs.Dispose() }
        } catch { continue }
        if (-not $global:RobloxUserId) {
            $m = [regex]::Match($txt, '(?i)user_?id["\s:=]+(\d{5,12})')
            if ($m.Success) { $global:RobloxUserId = $m.Groups[1].Value; Add-TL 'ROBLOX' ("Roblox user id seen in log {0}: {1}" -f $lf.Name, $global:RobloxUserId) }
        }
        foreach ($p in $pats) {
            $lines = @(($txt -split "`n") | Where-Object { $_ -match $p.Rx } | Select-Object -Unique -First 6)
            foreach ($ln in $lines) {
                $t = $ln.Trim(); if ($t.Length -gt 220) { $t = $t.Substring(0, 220) }
                $k = $p.Name + '|' + $t; if ($seen[$k]) { continue }; $seen[$k] = $true
                Add-Finding 'CHECK' 'Roblox log' ("A Roblox log line contains {0} (pattern match)" -f $p.Name) ("{0}: {1}" -f $lf.Name, $t) $lf.LastWriteTime
            }
        }
    }
    Add-Note ("Roblox log check: {0} log file(s) read (last 4 MB of each).{1}" -f $logs.Count, $(if ($global:RobloxUserId) { " User id from log: $($global:RobloxUserId)." } else { ' No user id found in the logs.' }))
}

# =========================================================================
# PROCESS TRACE (ETW) - a kernel trace written to its own file. Clearing event logs does not touch it.
# =========================================================================
function Start-EtwTrace {
    if (-not $global:FullChecks) { return }
    try {
        $global:EtwFile = Join-Path $env:TEMP ("recetw_{0}.etl" -f (Get-Date -Format 'yyyyMMdd_HHmmss'))
        & logman stop RecEtw -ets 2>&1 | Out-Null
        $o = (& logman create trace RecEtw -p 'Microsoft-Windows-Kernel-Process' 0x10 0xff -o $global:EtwFile -ets -max 32 -f bincirc 2>&1 | Out-String)
        if ($LASTEXITCODE -ne 0) { $global:EtwFile = $null; Add-Note ("Process trace (ETW) could not start: " + $o.Trim()) }
        else { Add-TL 'ETW' 'Kernel process trace started (separate file; event-log clearing cannot remove it)' }
    } catch { $global:EtwFile = $null; Add-Note "Process trace (ETW) could not start: $($_.Exception.Message)" }
}

function Stop-EtwTrace([string]$destDir) {
    if (-not $global:EtwFile) { return }
    try {
        & logman stop RecEtw -ets 2>&1 | Out-Null
        if (-not (Test-Path $global:EtwFile)) { Add-Note 'Process trace file was not found at the end.'; return }
        Copy-Item $global:EtwFile (Join-Path $destDir 'process_trace.etl') -Force -ErrorAction SilentlyContinue
        $csv = Join-Path $env:TEMP 'recetw_dump.csv'
        Remove-Item $csv -Force -ErrorAction SilentlyContinue
        & tracerpt $global:EtwFile -o $csv -of CSV -y -summary (Join-Path $env:TEMP 'recetw_sum.txt') 2>&1 | Out-Null
        $imgs = @{}
        if (Test-Path $csv) {
            Copy-Item $csv (Join-Path $destDir 'process_trace_events.csv') -Force -ErrorAction SilentlyContinue
            foreach ($ln in [System.IO.File]::ReadLines($csv)) {
                if ($ln -notmatch '(?i)process_?start|ProcessStart') { continue }
                $m = [regex]::Match($ln, '(?i)((?:\\Device\\HarddiskVolume\d+|[A-Za-z]:)\\[^,"\r\n]+?\.exe)')
                if ($m.Success) { $imgs[$m.Groups[1].Value.ToLower()] = $m.Groups[1].Value }
            }
        }
        $global:EtwImages = @($imgs.Values)
        Add-Note ("Process trace (ETW): {0} distinct program image(s) seen starting (the parse of the trace text is best effort); raw trace and text export are in the package." -f $global:EtwImages.Count)
        Remove-Item $global:EtwFile, $csv, (Join-Path $env:TEMP 'recetw_sum.txt') -Force -ErrorAction SilentlyContinue
    } catch { Add-Note "Process trace (ETW) could not be read: $($_.Exception.Message)" }
}

# Compares the trace with what the live guard recorded: short-lived programs the guard missed.
function Test-EtwAgainstGuard {
    if (-not $global:EtwImages -or @($global:EtwImages).Count -eq 0) { return }
    $names = @{}
    foreach ($g in @($global:GuardLog)) { if ($g.Name) { $names[([string]$g.Name).ToLower()] = 1 }; if ($g.Path) { $names[(Split-Path ([string]$g.Path) -Leaf).ToLower()] = 1 } }
    $miss = @()
    foreach ($img in $global:EtwImages) {
        if ($img -match '(?i)\\windows\\|\\program files') { continue }
        $leaf = ($img -split '\\')[-1].ToLower()
        if (-not $names.ContainsKey($leaf)) { $miss += $img }
    }
    if ($miss.Count -gt 0) { Add-Finding 'CHECK' 'Software' 'The process trace shows programs starting that the live guard did not record (short-lived programs; text parse is best effort)' ("{0} program(s); first: {1}" -f $miss.Count, (($miss | Select-Object -First 8) -join ' | ')) }
}

# A drive that was seen as removable during the session, and programs the guard saw running from it.
function Test-RemovableRuns {
    $rem = $global:SamplerCtx.Removable
    if (-not $rem -or $rem.Count -eq 0) { return }
    $seen = @{}
    foreach ($g in @($global:GuardLog)) {
        $p = [string]$g.Path
        if ($p -match '^([A-Za-z]):\\') {
            $l = $matches[1].ToUpper()
            if ($rem.ContainsKey($l) -and -not $seen.ContainsKey($p)) { $seen[$p] = 1; Add-Finding 'CHECK' 'Software' 'A program ran from a drive that was seen as removable (recorded by the live guard)' ("{0} (PID {1}) {2} on drive {3}:" -f $g.Name, $g.PID, $p, $l) $g.Time }
        }
    }
}

function Start-BgForensic([string]$name, [string]$entry) {
    if (-not $global:EnableForensics -or -not $global:FullChecks) { return }
    try {
        $bag = [System.Collections.ArrayList]::Synchronized((New-Object System.Collections.ArrayList))
        $rs = [runspacefactory]::CreateRunspace(); $rs.Open()
        $ctx = @{ ToolStrongRx = $global:ToolStrongRx; ToolWeakRx = $global:ToolWeakRx; SessionStart = $global:SessionStart; KnownBadHashes = $global:KnownBadHashes; ExtraVuln = @($global:ExtraVuln); Sync = $global:SamplerCtx }
        $rs.SessionStateProxy.SetVariable('FBag', $bag)
        $rs.SessionStateProxy.SetVariable('FCtx', $ctx)
        $ps = [powershell]::Create(); $ps.Runspace = $rs
        [void]$ps.AddScript($global:ForensicLib + "`r`nFRun '" + $entry + "'")
        $async = $ps.BeginInvoke()
        $global:BgJobs += [PSCustomObject]@{ Name = $name; PS = $ps; RS = $rs; Async = $async; Bag = $bag; Next = 0; Done = $false }
        Add-TL 'FORENSIC' "Background scan '$name' started"
    } catch { Add-Note "Background scan '$name' could not start: $($_.Exception.Message)" }
}

# Pulls finished results into the findings. -Wait gives running jobs up to TimeoutSec to finish.
function Merge-ForensicResults([switch]$Wait, [int]$TimeoutSec = 120) {
    foreach ($j in @($global:BgJobs)) {
        if ($j.Done) { continue }
        if ($Wait -and -not $j.Async.IsCompleted) {
            $t0 = Get-Date
            while (-not $j.Async.IsCompleted -and ((Get-Date) - $t0).TotalSeconds -lt $TimeoutSec) { Start-Sleep -Milliseconds 300 }
        }
        $n = $j.Bag.Count
        for ($i = $j.Next; $i -lt $n; $i++) {
            $it = $j.Bag[$i]
            switch ($it.Kind) {
                'CHECK'   { Add-Finding 'CHECK' $it.Area $it.Title $it.Detail $it.When }
                'NOTE'    { Add-Note $it.Title }
                'TL'      { Add-TL $it.Area $it.Title $it.When }
                'COVER'   { [void]$global:ForensicCover.Add($it.Title) }
                'DATA'    { $global:ForensicData[$it.Area] = $it.Extra }
                'POSTURE' { $global:Posture += [PSCustomObject]@{ Name = $it.Area; Value = $it.Title; Note = $it.Detail; Status = $it.Extra } }
            }
        }
        $j.Next = $n
        if ($j.Async.IsCompleted) {
            $j.Done = $true
            try { [void]$j.PS.EndInvoke($j.Async) } catch { Add-Note "Background scan '$($j.Name)' ended with an error: $($_.Exception.Message)" }
            try { $j.PS.Dispose(); $j.RS.Close(); $j.RS.Dispose() } catch {}
        } elseif ($Wait) { Add-Note "Background scan '$($j.Name)' had not finished after $TimeoutSec s; partial results were used." }
    }
}

# ---------- reporting of live observations (shared by the scans and the guard log) ----------
$global:LiveOkClasses = @('Windows', 'MicrosoftOther', 'Roblox', 'OBS', 'NVIDIA', 'AMD', 'Malwarebytes')

function Get-AccessText([string]$hex) {
    $a = 0; try { $a = [Convert]::ToUInt32($hex.Substring(2), 16) } catch {}
    $t = @(); if ($a -band 0x10) { $t += 'read memory' }; if ($a -band 0x20) { $t += 'write memory' }; if ($a -band 0x8) { $t += 'VM operation' }; if ($a -band 0x2) { $t += 'create thread' }
    return (($t -join ', ') + " ($hex)")
}

function Report-HandleHit([int]$ownerPid, [int]$targetPid, [string]$hex, [string]$ownerName, [string]$ownerPath, $when = $null) {
    $v = $null
    if ($ownerName -or $ownerPath) { $v = Get-ProcVerdict $ownerName $ownerPath $ownerPid }
    $acc = Get-AccessText $hex
    if ($v -and $v.Class -in $global:LiveOkClasses) { Add-TL 'MEMORY' ("{0} (PID {1}) [{2}] holds a handle to Roblox PID {3}: {4}" -f $ownerName, $ownerPid, $v.Class, $targetPid, $acc) $when; return }
    $who = if ($ownerName) { "$ownerName (PID $ownerPid) $ownerPath" } else { "PID $ownerPid (already exited)" }
    $why = if ($v) { "identity: $($v.Class); $($v.Reason)" } else { 'identity unknown' }
    Add-Finding 'CHECK' 'Memory' 'A program outside the Windows/Roblox/recorder classes holds a handle to Roblox that allows reading or writing its memory' ("{0} -> Roblox PID {1}; rights: {2}; {3}" -f $who, $targetPid, $acc, $why) $when
}

function Report-OverlayLine([string]$line, [string]$ownerName, [string]$ownerPath, $when = $null) {
    $f = $line.Split('|'); if ($f.Count -lt 9) { return }
    $opid = [int]$f[0]
    $v = Get-ProcVerdict $ownerName $ownerPath $opid
    $okOv = @($global:LiveOkClasses) + @('Discord', 'VPN', 'Package', 'Browser')
    $title = $f[4]; if ($v.Class -in @('Discord', 'Browser')) { $title = '(not recorded)' }
    $d = "{0} (PID {1}) {2} | {3} window, class '{4}', title '{5}', covers {6}% of the screen, alpha {7} | identity: {8}; {9}" -f $ownerName, $opid, $ownerPath, $f[8], $f[3], $title, $f[6], $f[7], $v.Class, $v.Reason
    Add-TL 'OVERLAY' $d $when
    if ($v.Class -in $okOv -and $v.Verified) { return }
    if ($v.Verified -or $v.Class -eq 'Signed' -or $v.Class -eq 'ScriptTool') { Add-Finding 'CHECK' 'Overlay' 'A click-through / topmost transparent overlay window from a signed third-party program is on screen' $d $when }
    else { Add-Finding 'CHECK' 'Overlay' 'A click-through / topmost transparent overlay window from a program with no verified identity is on screen (typical of external ESP overlays)' $d $when }
}

function Report-ListenEntry([string]$addr, [int]$port, [int]$lpid, [string]$name, [string]$path, $when = $null) {
    $v = Get-ProcVerdict $name $path $lpid
    if ($v.Class -in @('Windows', 'MicrosoftOther', 'Roblox', 'OBS', 'NVIDIA', 'AMD', 'Malwarebytes', 'Discord', 'VPN', 'Package', 'Browser')) { return }
    $isScript = ($name -match '(?i)^(python|pythonw|node|java|javaw|dotnet|go|ruby|php|deno|bun)(\.exe)?$')
    $d = "{0}:{1} <- {2} (PID {3}) {4} | identity: {5}; {6}" -f $addr, $port, $name, $lpid, $path, $v.Class, $v.Reason
    if ($v.Verified -and -not $isScript) { Add-Finding 'CHECK' 'Localhost' 'A signed third-party program is listening on a localhost port' $d $when; return }
    $probe = Test-LocalPortHttp $port
    if ($probe) { $d += " | HTTP answer: $probe" }
    Add-Finding 'CHECK' 'Localhost' 'A program with no verified identity (or a script interpreter) is listening on a localhost port (typical of web radars and local cheat servers)' $d $when
}

function Test-LocalPortHttp([int]$port) {
    try {
        $c = New-Object System.Net.Sockets.TcpClient
        $iar = $c.BeginConnect('127.0.0.1', $port, $null, $null)
        if (-not $iar.AsyncWaitHandle.WaitOne(700)) { $c.Close(); return $null }
        $c.EndConnect($iar)
        $s = $c.GetStream(); $s.ReadTimeout = 800; $s.WriteTimeout = 800
        $req = [Text.Encoding]::ASCII.GetBytes("GET / HTTP/1.0`r`nHost: localhost`r`n`r`n")
        $s.Write($req, 0, $req.Length)
        $buf = New-Object byte[] 600; $n = 0
        try { $n = $s.Read($buf, 0, $buf.Length) } catch {}
        $c.Close()
        if ($n -le 0) { return 'connected, no answer' }
        $txt = [Text.Encoding]::ASCII.GetString($buf, 0, $n)
        $first = ($txt -split "`r?`n")[0]
        $title = ''; if ($txt -match '(?i)<title>([^<]{1,80})') { $title = " title '$($matches[1])'" }
        if ($first -match '^HTTP/') { return ($first.Trim() + $title) }
        return 'connected, not HTTP'
    } catch { return $null }
}

# ---------- live scans (added to Invoke-AllScans) ----------
function Scan-RobloxAccess([string]$label = 'SCAN') {
    if (-not $global:EnableForensics -or -not $global:ForensicNativeOk) { return }
    $rp = @(Get-Process RobloxPlayerBeta -ErrorAction SilentlyContinue)
    if ($rp.Count -eq 0) { Add-Note "Roblox access scan ($label): Roblox was not running."; return }
    $pt = @{}; foreach ($p in (Get-ProcTable)) { $pt[[int]$p.PID] = $p }
    $lines = @(); try { $lines = @([RecForensic]::HandleScan([int[]]@($rp | ForEach-Object { $_.Id }))) } catch { Add-Note "Roblox handle scan failed: $($_.Exception.Message)"; return }
    $hits = 0
    foreach ($ln in $lines) {
        if ($ln -like 'ERR|*') { Add-Note ("Roblox handle scan ($label): " + $ln.Substring(4)); continue }
        $f = $ln.Split('|'); if ($f[0] -ne 'H') { continue }
        $hits++
        $o = $pt[[int]$f[1]]
        Report-HandleHit ([int]$f[1]) ([int]$f[2]) $f[3] $(if ($o) { $o.Name } else { '' }) $(if ($o) { $o.Path } else { '' })
    }
    Add-Note "Roblox handle scan ($label): $hits memory-capable handle(s) to Roblox from other processes were examined."
    foreach ($proc in $rp) {
        $path = ''; try { $path = [string]$proc.Path } catch {}
        $res = $null; try { $res = [RecForensic]::DeepScan($proc.Id, $path) } catch { $res = "ERR|$($_.Exception.Message)" }
        if ($res -notlike 'OK|*') { Add-Note "Roblox deep memory scan ($label, PID $($proc.Id)): $res"; continue }
        $f = $res.Split('|')
        Add-Note ("Roblox deep memory scan ({0}, PID {1}): image {2}; file compare {3}; {4} private PE header region(s)." -f $label, $proc.Id, $f[5], $f[6], $f[3])
        $tag = "RobloxPlayerBeta (PID $($proc.Id)) $path"
        if ([int]$f[3] -gt 0) { Add-Finding 'CHECK' 'Memory' 'Roblox holds a Windows executable (PE) image in private memory that was not loaded from a file (manual-mapped or reflectively loaded module)' ("$tag; {0} region(s) at {1}" -f $f[3], $f[4]) }
        if ($f[5] -like 'NOT_IMAGE*') { Add-Finding 'CHECK' 'Memory' 'The main program image of Roblox is not file-backed memory (process hollowing indicator)' "$tag; $($f[5])" }
        if ($f[6] -like 'MISMATCH*') { Add-Finding 'CHECK' 'Memory' 'The Roblox program image in memory differs from its file on disk (process hollowing indicator)' "$tag; $($f[6])" }
    }
}

function Scan-Localhost([string]$label = 'SCAN') {
    if (-not $global:EnableForensics) { return }
    try {
        $pm = @{}; foreach ($p in (Get-ProcTable)) { $pm[[int]$p.PID] = $p }
        foreach ($c in (Get-NetTCPConnection -State Listen -ErrorAction Stop | Where-Object { $_.LocalAddress -in @('127.0.0.1', '::1') })) {
            $p = $pm[[int]$c.OwningProcess]
            if (-not $p) { Add-Finding 'CHECK' 'Localhost' 'A localhost port is listening but its owning process cannot be found (process hidden or just exited)' ("{0}:{1} owner PID {2}" -f $c.LocalAddress, $c.LocalPort, $c.OwningProcess); continue }
            Report-ListenEntry $c.LocalAddress ([int]$c.LocalPort) ([int]$p.PID) $p.Name $p.Path
        }
    } catch { Add-Note "Localhost listener scan ($label) failed: $($_.Exception.Message)" }
}

function Scan-Overlays([string]$label = 'SCAN') {
    if (-not $global:EnableForensics -or -not $global:ForensicNativeOk) { return }
    try {
        foreach ($ln in @([RecForensic]::Overlays())) {
            $f = $ln.Split('|'); if ($f.Count -lt 9) { continue }
            $name = ''; $path = ''
            try { $pr = Get-Process -Id ([int]$f[0]) -ErrorAction Stop; $name = $pr.ProcessName + '.exe'; $path = [string]$pr.Path } catch {}
            if (-not $path -and $global:NativeOk) { try { $path = [RecNative]::ImagePath([int]$f[0]) } catch {} }
            Report-OverlayLine $ln $name $path
        }
    } catch { Add-Note "Overlay window scan ($label) failed: $($_.Exception.Message)" }
}

function Start-MouseWatch {
    if (-not $global:EnableForensics -or -not $global:EnableMouseCheck -or -not $global:ForensicNativeOk) { return }
    try { $r = [RecMouse]::Start(); if ($r -eq 'OK') { $global:MouseWatchOn = $true; Add-TL 'INPUT' 'Injected-mouse monitor started' } else { Add-Note "Injected-mouse monitor did not start: $r" } }
    catch { Add-Note "Injected-mouse monitor did not start: $($_.Exception.Message)" }
}

function Stop-MouseWatch {
    if (-not $global:MouseWatchOn) { return }
    $global:MouseWatchOn = $false
    try {
        $lines = @([RecMouse]::Stop())
        $s = ($lines | Where-Object { $_ -like 'S|*' } | Select-Object -First 1)
        if (-not $s) { return }
        $f = $s.Split('|'); $secs = [int]$f[1]; $all = [long]$f[2]; $inj = [long]$f[3]
        Add-Note ("Injected-mouse monitor ran {0} s and saw {1} mouse events, {2} flagged by Windows as software-injected." -f $secs, $all, $inj)
        if ($inj -le 0) { return }
        $pt = @{}; foreach ($p in (Get-ProcTable)) { $pt[[int]$p.PID] = $p }
        $rb = @(Get-Process RobloxPlayerBeta -ErrorAction SilentlyContinue | ForEach-Object { $_.Id })
        $samples = @($lines | Where-Object { $_ -like 'E|*' } | ForEach-Object { $_.Substring(2) } | Select-Object -First 6) -join ' ;; '
        foreach ($l in ($lines | Where-Object { $_ -like 'FG|*' })) {
            $g = $l.Split('|'); $fpid = [int]$g[1]; $cnt = [long]$g[2]
            $nm = if ($pt.ContainsKey($fpid)) { $pt[$fpid].Name } elseif ($fpid -le 0) { '(no foreground window)' } else { "PID $fpid (exited)" }
            $isRb = ($nm -match '(?i)^RobloxPlayerBeta')
            $d = "{0} injected mouse event(s) of {1} total while '{2}' was the active window; first {3}, last {4}; samples: {5}" -f $cnt, $all, $nm, $f[4], $f[5], $samples
            if ($isRb) { Add-Finding 'CHECK' 'Input' 'Software-injected mouse input was recorded while Roblox was the active window (software moved or clicked the mouse)' $d }
            else { Add-Finding 'CHECK' 'Input' 'Software-injected mouse input was recorded while another program was the active window (also caused by remote-desktop, accessibility and some mouse software)' $d }
        }
    } catch { Add-Note "Injected-mouse monitor result could not be read: $($_.Exception.Message)" }
}

# =========================================================================
# DISPLAY / DESKTOP STATE (used by set-up checks, snapshots and the guard)
# =========================================================================
function Get-TechName([int]$t) {
    switch ($t) {
        0 { return 'VGA' } 4 { return 'DVI' } 5 { return 'HDMI' } 6 { return 'LVDS' }
        10 { return 'DisplayPort' } 11 { return 'DisplayPort (embedded)' } 15 { return 'Miracast (wireless)' }
        16 { return 'indirect wired' } 17 { return 'indirect virtual' }
        -2147483648 { return 'internal panel' }
        default { return "output type $t" }
    }
}

function Get-MonitorNames {
    $ev = @()
    try {
        foreach ($m in (Get-CimInstance -Namespace root\wmi -ClassName WmiMonitorID -ErrorAction Stop | Where-Object { $_.Active })) {
            $nm = ''; try { $nm = -join ($m.UserFriendlyName | Where-Object { $_ -gt 0 } | ForEach-Object { [char]$_ }) } catch {}
            $ev += ("'{0}' [{1}]" -f $nm, $m.InstanceName)
        }
    } catch {}
    return $ev
}

# Largest of: monitors Windows is driving (display paths), Windows screens, monitors the
# hardware reports. Path count catches mirrored screens that Windows merges into one.
function Get-ActiveDisplayCount {
    $n = 0; $w = 0; $pc = 0
    try { Add-Type -AssemblyName System.Windows.Forms -ErrorAction SilentlyContinue; $n = [System.Windows.Forms.Screen]::AllScreens.Count } catch {}
    try { $w = @(Get-CimInstance -Namespace root\wmi -ClassName WmiMonitorID -ErrorAction Stop | Where-Object { $_.Active }).Count } catch {}
    if ($global:NativeOk) { try { $t = [RecNative]::DisplayPaths(); if ($null -ne $t) { $pc = @($t).Count } } catch {} }
    # The display-path count is what Windows is actually driving, so it decides.
    # A laptop whose own screen is off (lid closed or disabled) plus one external monitor = 1.
    if ($pc -gt 0) { $c = $pc } else { $c = [Math]::Max($n, $w) }
    if ($c -lt 1) { $c = 1 }
    return $c
}

function Get-DisplayDetail {
    $rows = @()
    try {
        Add-Type -AssemblyName System.Windows.Forms -ErrorAction SilentlyContinue
        foreach ($s in [System.Windows.Forms.Screen]::AllScreens) {
            $rows += [PSCustomObject]@{ DeviceName = $s.DeviceName; Primary = $s.Primary; Bounds = "$($s.Bounds.Width)x$($s.Bounds.Height) @ $($s.Bounds.X),$($s.Bounds.Y)" }
        }
    } catch {}
    return $rows
}

function Get-VirtualDesktopCount {
    try {
        $sid = [System.Diagnostics.Process]::GetCurrentProcess().SessionId
        foreach ($k in @("HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\SessionInfo\$sid\VirtualDesktops", 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\VirtualDesktops')) {
            if (-not (Test-Path $k)) { continue }
            $b = (Get-ItemProperty -Path $k -Name VirtualDesktopIDs -ErrorAction Stop).VirtualDesktopIDs
            if ($b -is [byte[]] -and $b.Length -ge 16) { return [int]($b.Length / 16) }
        }
    } catch {}
    return $null
}

function Scan-Displays {
    $n = Get-ActiveDisplayCount
    $ev = Get-MonitorNames
    $tech = ''
    if ($global:NativeOk) { try { $t = [RecNative]::DisplayPaths(); if ($null -ne $t) { $tech = ' outputs: ' + ((@($t) | ForEach-Object { Get-TechName $_ }) -join ', ') + '.' } } catch {} }
    Add-TL 'DISPLAY' ("Active display count = {0}.{1} {2}" -f $n, $tech, ($ev -join '; '))
    $vd = Get-VirtualDesktopCount
    if ($null -ne $vd) { Add-TL 'DISPLAY' "Virtual desktop count = $vd" }
    return $n
}

# =========================================================================
# PROCESS-CREATION AUDITING (Security event 4688)
# Gives the Windows' own record of every program started, with full path,
# parent and command line - including programs that live for milliseconds.
# The original audit settings are put back when the script finishes.
# =========================================================================
$global:AuditGuid = '{0CCE922B-69AE-11D9-BED3-505054503030}'
$global:AuditSaved = $null
$global:AuditCmdSaved = $null
$global:AuditEnabledByUs = $false

function Enable-ProcessAudit {
    try {
        $raw = (& auditpol /get /subcategory:$global:AuditGuid /r 2>&1 | Out-String)
        $line = ($raw -split "`r?`n" | Where-Object { $_ -match [regex]::Escape($global:AuditGuid) } | Select-Object -First 1)
        $setting = ''
        if ($line) { $setting = ($line.Split(',')[4]) }
        if (-not $line) { $global:ProcAuditInfo = 'could not read the current audit setting, so it was left unchanged'; return }
        $global:AuditSaved = $setting
        $cmdKey = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System\Audit'
        $cur = $null
        try { $cur = (Get-ItemProperty -Path $cmdKey -Name ProcessCreationIncludeCmdLine_Enabled -ErrorAction Stop).ProcessCreationIncludeCmdLine_Enabled } catch {}
        $global:AuditCmdSaved = $cur
        & auditpol /set /subcategory:$global:AuditGuid /success:enable 2>&1 | Out-Null
        if (-not (Test-Path $cmdKey)) { New-Item -Path $cmdKey -Force | Out-Null }
        New-ItemProperty -Path $cmdKey -Name ProcessCreationIncludeCmdLine_Enabled -Value 1 -PropertyType DWord -Force | Out-Null
        $raw2 = (& auditpol /get /subcategory:$global:AuditGuid /r 2>&1 | Out-String)
        $line2 = ($raw2 -split "`r?`n" | Where-Object { $_ -match [regex]::Escape($global:AuditGuid) } | Select-Object -First 1)
        $setting2 = ''; if ($line2) { $setting2 = ([string]$line2.Split(',')[4]).Trim() }
        $global:AuditOnText = $setting2
        if ($raw2 -match '(?i)Success' -or ($setting2 -and $setting2 -ne ([string]$setting).Trim())) { $global:AuditEnabledByUs = $true; $global:ProcAuditInfo = 'enabled for this session (Security event 4688 with command lines)' }
        else { $global:ProcAuditInfo = 'could not be enabled (policy may be enforced by the system)' }
    } catch { $global:ProcAuditInfo = "could not be enabled: $($_.Exception.Message)" }
}

function Restore-ProcessAudit {
    if (-not $global:AuditEnabledByUs) { return }
    try {
        $s = [string]$global:AuditSaved
        $succ = 'disable'; $fail = 'disable'
        if ($s -match '(?i)Success') { $succ = 'enable' }
        if ($s -match '(?i)Failure') { $fail = 'enable' }
        & auditpol /set /subcategory:$global:AuditGuid /success:$succ /failure:$fail 2>&1 | Out-Null
        $cmdKey = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System\Audit'
        if ($null -eq $global:AuditCmdSaved) { Remove-ItemProperty -Path $cmdKey -Name ProcessCreationIncludeCmdLine_Enabled -ErrorAction SilentlyContinue }
        else { New-ItemProperty -Path $cmdKey -Name ProcessCreationIncludeCmdLine_Enabled -Value $global:AuditCmdSaved -PropertyType DWord -Force | Out-Null }
    } catch {}
    $global:AuditEnabledByUs = $false
}

function Get-ProcessAuditEvents([datetime]$from, [datetime]$to) {
    $rows = @()
    if (-not $global:AuditEnabledByUs) { return $rows }
    try {
        foreach ($e in @(Get-WinEvent -FilterHashtable @{ LogName = 'Security'; Id = 4688; StartTime = $from; EndTime = $to } -ErrorAction Stop)) {
            try {
                $x = [xml]$e.ToXml(); $d = @{}
                foreach ($n in $x.Event.EventData.Data) { $d[$n.Name] = $n.'#text' }
                $np = 0; try { $np = [Convert]::ToInt32(([string]$d['NewProcessId']).Replace('0x', ''), 16) } catch {}
                $cp = 0; try { $cp = [Convert]::ToInt32(([string]$d['ProcessId']).Replace('0x', ''), 16) } catch {}
                $rows += [PSCustomObject]@{ Time = $e.TimeCreated; PID = $np; PPID = $cp; Path = (Normalize-Path $d['NewProcessName'])
                    ParentPath = (Normalize-Path $d['ParentProcessName']); Cmd = $d['CommandLine']; User = $d['SubjectUserName'] }
            } catch {}
        }
    } catch { Add-Note 'Process-creation events (4688) could not be read from the Security log.' }
    return @($rows | Sort-Object Time)
}

# =========================================================================
# SESSION GUARD
# One background thread inside this script. It never touches the screen and
# never blocks the prompt, so it keeps working while the script waits for Enter.
# Always on (all tiers): display count every second, virtual desktops, proxy lock.
# Tiers 2/3 also: program starts, device arrivals/removals, visible windows,
# new internet connections.
# =========================================================================
$global:GuardBag = $null
$global:GuardCtl = $null
$global:GuardPS  = $null
$global:GuardRS  = $null
$global:GuardStats = $null

function Start-SessionGuard {
    $global:GuardBag = [System.Collections.ArrayList]::Synchronized((New-Object System.Collections.ArrayList))
    $global:GuardCtl = [hashtable]::Synchronized(@{ Stop = $false; Full = [bool]$global:FullChecks; ProxyLock = $false
        DispAlert = ''; Checks = 0; MaxGapSec = 0; Started = (Get-Date); LastBeat = (Get-Date); ProxyFix = 0; NativeOk = [bool]$global:NativeOk; Audit = [bool]$global:AuditEnabledByUs; AuditGuid = [string]$global:AuditGuid; AuditOnText = [string]$global:AuditOnText; Errors = 0; ForensicF = [bool]($global:EnableForensics -and $global:ForensicNativeOk) })
    try {
        $rs = [runspacefactory]::CreateRunspace()
        $rs.Open()
        $rs.SessionStateProxy.SetVariable('bag', $global:GuardBag)
        $rs.SessionStateProxy.SetVariable('ctl', $global:GuardCtl)
        $ps = [powershell]::Create()
        $ps.Runspace = $rs
        $code = {
            function Rec($kind, $name, $procId, $ppid, $path, $detail, $sig, $signer, $sha) {
                [void]$bag.Add([PSCustomObject]@{ Time = (Get-Date); Kind = $kind; Name = $name; PID = $procId; PPID = $ppid; Path = $path; Detail = $detail; Sig = $sig; Signer = $signer; Sha256 = $sha })
            }
            function Count-Displays {
                $pc = $null
                if ($ctl.NativeOk) { try { $t = [RecNative]::DisplayPaths(); if ($null -ne $t) { $pc = @($t) } } catch {} }
                return $pc
            }
            function Count-VDesk {
                try {
                    $sid = [System.Diagnostics.Process]::GetCurrentProcess().SessionId
                    foreach ($k in @("HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\SessionInfo\$sid\VirtualDesktops", 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\VirtualDesktops')) {
                        if (-not (Test-Path $k)) { continue }
                        $b = (Get-ItemProperty -Path $k -Name VirtualDesktopIDs -ErrorAction Stop).VirtualDesktopIDs
                        if ($b -is [byte[]] -and $b.Length -ge 16) { return [int]($b.Length / 16) }
                    }
                } catch {}
                return $null
            }
            try { [System.Threading.Thread]::CurrentThread.Priority = [System.Threading.ThreadPriority]::BelowNormal } catch {}
            $userRx = '(?i)^[a-z]:\\users\\[^\\]+\\(downloads|desktop|documents|appdata\\local\\temp|appdata\\roaming|onedrive[^\\]*)\\|^[a-z]:\\users\\public\\|\\temp\\|\\\$recycle\.bin\\'
            $sysRx  = '(?i)^[a-z]:\\(windows|program files|program files \(x86\))\\'
            $procW = $null; $devW = $null
            if ($ctl.Full) {
                try {
                    $q = New-Object System.Management.WqlEventQuery('SELECT * FROM Win32_ProcessStartTrace')
                    $procW = New-Object System.Management.ManagementEventWatcher($q)
                    Register-ObjectEvent -InputObject $procW -EventName EventArrived -SourceIdentifier 'RecProcStart' | Out-Null
                    $procW.Start()
                } catch { Rec 'INFO' 'guard' 0 0 $null "process-start trace unavailable: $($_.Exception.Message)" $null $null $null; $procW = $null }
                try {
                    $dq = New-Object System.Management.WqlEventQuery('SELECT * FROM Win32_DeviceChangeEvent')
                    $devW = New-Object System.Management.ManagementEventWatcher($dq)
                    Register-ObjectEvent -InputObject $devW -EventName EventArrived -SourceIdentifier 'RecDevChange' | Out-Null
                    $devW.Start()
                } catch { Rec 'INFO' 'guard' 0 0 $null "device-change trace unavailable: $($_.Exception.Message)" $null $null $null; $devW = $null }
            }
            $lastDisp = $null; $lastVd = $null
            $lastCheck = Get-Date; $lastProxy = Get-Date '2000-01-01'; $lastConn = Get-Date '2000-01-01'
            $lastWin = Get-Date '2000-01-01'; $lastBeat = Get-Date '2000-01-01'; $lastWmi = Get-Date '2000-01-01'; $lastAudit = Get-Date
            $knownPnp = $null; $pnpDirty = $null; $knownConn = @{}; $knownWin = @{}; $proxyFails = 0
            $d0 = Count-Displays
            if ($null -ne $d0) { $lastDisp = @($d0).Count }
            $lastVd = Count-VDesk
            while (-not $ctl.Stop) {
              try {
                $now = Get-Date
                # ---- process starts (event driven) ----
                if ($procW) {
                    $evs = @(); try { $evs = @(Get-Event -SourceIdentifier 'RecProcStart' -ErrorAction SilentlyContinue) } catch {}
                    foreach ($ev in $evs) {
                        try {
                            $n = $ev.SourceEventArgs.NewEvent
                            $pidv = [int]$n.ProcessID; $ppidv = [int]$n.ParentProcessID
                            $path = $null
                            if ($ctl.NativeOk) { try { $path = [RecNative]::ImagePath($pidv) } catch {} }
                            if (-not $path) { try { $path = [System.Diagnostics.Process]::GetProcessById($pidv).MainModule.FileName } catch {} }
                            $sig = $null; $signer = $null; $sha = $null; $cmd = $null
                            if ($path -and $path -match $userRx) {
                                try { $s = Get-AuthenticodeSignature -LiteralPath $path -ErrorAction Stop; $sig = [string]$s.Status; if ($s.SignerCertificate) { $signer = $s.SignerCertificate.Subject } } catch {}
                                try { if ((Get-Item -LiteralPath $path).Length -le 200MB) { $sha = (Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash } } catch {}
                            }
                            if (-not $ctl.Audit -and ((-not $path) -or ($path -notmatch $sysRx))) {
                                try { $cmd = (Get-CimInstance Win32_Process -Filter "ProcessId=$pidv" -ErrorAction Stop).CommandLine } catch {}
                            }
                            Rec 'PROC' $n.ProcessName $pidv $ppidv $path $cmd $sig $signer $sha
                        } catch {}
                        try { Remove-Event -EventIdentifier $ev.EventIdentifier -ErrorAction SilentlyContinue } catch {}
                    }
                }
                # ---- device changes (event driven; the device list is read only after a change) ----
                if ($devW) {
                    $evs = @(); try { $evs = @(Get-Event -SourceIdentifier 'RecDevChange' -ErrorAction SilentlyContinue) } catch {}
                    if ($evs.Count -gt 0) {
                        $pnpDirty = $now
                        foreach ($ev in $evs) { try { Remove-Event -EventIdentifier $ev.EventIdentifier -ErrorAction SilentlyContinue } catch {} }
                    }
                    if ($null -eq $knownPnp) {
                        $knownPnp = @{}
                        try { foreach ($d in (Get-PnpDevice -PresentOnly -ErrorAction Stop)) { $knownPnp[[string]$d.InstanceId] = [string]$d.FriendlyName } } catch {}
                    } elseif ($pnpDirty -and (($now - $pnpDirty).TotalSeconds -ge 3)) {
                        $pnpDirty = $null
                        $cur = @{}
                        try { foreach ($d in (Get-PnpDevice -PresentOnly -ErrorAction Stop)) { $cur[[string]$d.InstanceId] = [string]$d.FriendlyName } } catch {}
                        if ($cur.Count -gt 0) {
                            foreach ($k in $cur.Keys) { if (-not $knownPnp.ContainsKey($k)) { Rec 'PNP' $cur[$k] 0 0 $k 'device appeared' $null $null $null } }
                            foreach ($k in @($knownPnp.Keys)) { if (-not $cur.ContainsKey($k)) { Rec 'PNPGONE' $knownPnp[$k] 0 0 $k 'device disappeared' $null $null $null } }
                            $knownPnp = $cur
                        }
                    }
                }
                # ---- display + virtual desktops, every second ----
                if (($now - $lastCheck).TotalSeconds -ge 1) {
                    $gap = ($now - $lastCheck).TotalSeconds
                    if ($gap -gt $ctl.MaxGapSec) { $ctl.MaxGapSec = [math]::Round($gap, 1) }
                    $lastCheck = $now
                    $ctl.Checks = $ctl.Checks + 1
                    $dp = Count-Displays
                    if ($null -ne $dp) {
                        $cnt = @($dp).Count
                        if ($null -eq $lastDisp -or $cnt -ne $lastDisp) {
                            $mon = @()
                            try {
                                foreach ($m in (Get-CimInstance -Namespace root\wmi -ClassName WmiMonitorID -ErrorAction Stop | Where-Object { $_.Active })) {
                                    $nm = ''; try { $nm = -join ($m.UserFriendlyName | Where-Object { $_ -gt 0 } | ForEach-Object { [char]$_ }) } catch {}
                                    $mon += ("'{0}' [{1}]" -f $nm, $m.InstanceName)
                                }
                            } catch {}
                            Rec 'DISPLAY' 'displays' 0 0 $null ("active display paths {0} -> {1}; output types {2}; monitors: {3}" -f $lastDisp, $cnt, ((@($dp) | ForEach-Object { [string]$_ }) -join ','), ($mon -join '; ')) $null $null $null
                            if ($cnt -gt 1) { $ctl.DispAlert = (Get-Date).ToString('HH:mm:ss') }
                            $lastDisp = $cnt
                        }
                    }
                    elseif (-not $ctl.NativeOk -and (($now - $lastWmi).TotalSeconds -ge 5)) {
                        $lastWmi = $now
                        try {
                            $wc = @(Get-CimInstance -Namespace root\wmi -ClassName WmiMonitorID -ErrorAction Stop | Where-Object { $_.Active }).Count
                            if ($null -eq $lastDisp -or $wc -ne $lastDisp) {
                                Rec 'DISPLAY' 'displays' 0 0 $null ("active monitors (WMI) {0} -> {1}" -f $lastDisp, $wc) $null $null $null
                                if ($wc -gt 1) { $ctl.DispAlert = (Get-Date).ToString('HH:mm:ss') }
                                $lastDisp = $wc
                            }
                        } catch {}
                    }
                    $vd = Count-VDesk
                    if ($null -ne $vd -and ($null -eq $lastVd -or $vd -ne $lastVd)) {
                        Rec 'VDESKTOP' 'virtual desktops' 0 0 $null ("virtual desktop count {0} -> {1}" -f $lastVd, $vd) $null $null $null
                        if ($vd -gt 1) { $ctl.DispAlert = (Get-Date).ToString('HH:mm:ss') }
                        $lastVd = $vd
                    }
                }
                # ---- WinHTTP proxy lock: reads the registry; runs netsh only if the value changed ----
                if ($ctl.ProxyLock -and (($now - $lastProxy).TotalSeconds -ge 3)) {
                    $lastProxy = $now
                    $okp = $false
                    try {
                        $b = (Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Internet Settings\Connections' -Name WinHttpSettings -ErrorAction Stop).WinHttpSettings
                        if ([System.Text.Encoding]::ASCII.GetString($b) -match '127\.0\.0\.1:1') { $okp = $true }
                    } catch {}
                    if ($okp) { $proxyFails = 0 }
                    elseif ($proxyFails -lt 3) {
                        $proxyFails++
                        try { & netsh winhttp set proxy 127.0.0.1:1 | Out-Null } catch {}
                        $ctl.ProxyFix = $ctl.ProxyFix + 1
                        Rec 'PROXY' 'winhttp' 0 0 $null 'WinHTTP proxy was not the locked value; it was set again' $null $null $null
                    }
                }
                # ---- process-creation auditing must stay on (turning it off would hide program starts) ----
                if ($ctl.Audit -and $ctl.AuditOnText -and (($now - $lastAudit).TotalSeconds -ge 20)) {
                    $lastAudit = $now
                    try {
                        $ao = (& auditpol /get /subcategory:$($ctl.AuditGuid) /r 2>&1 | Out-String)
                        if ($ao -notmatch [regex]::Escape([string]$ctl.AuditOnText)) {
                            & auditpol /set /subcategory:$($ctl.AuditGuid) /success:enable 2>&1 | Out-Null
                            Rec 'AUDITOFF' 'auditpol' 0 0 $null 'Process-creation auditing was not in the state the script set; it was set again' $null $null $null
                        }
                    } catch {}
                }
                if ($ctl.Full) {
                    # ---- visible windows, every 10 s ----
                    if (($now - $lastWin).TotalSeconds -ge 10) {
                        $lastWin = $now
                        try {
                            foreach ($p in [System.Diagnostics.Process]::GetProcesses()) {
                                try {
                                    if ($p.MainWindowHandle -ne [IntPtr]::Zero -and $p.MainWindowTitle -and $p.MainWindowTitle -ne 'Program Manager') {
                                        $wk = [string]$p.Id
                                        if (-not $knownWin.ContainsKey($wk)) {
                                            $knownWin[$wk] = 1
                                            $title = $p.MainWindowTitle
                                            if ($p.ProcessName -match '(?i)^(chrome|msedge|firefox|brave|opera|vivaldi|discord)$') { $title = '(title not recorded for browsers/Discord)' }
                                            $wp = $null; if ($ctl.NativeOk) { try { $wp = [RecNative]::ImagePath($p.Id) } catch {} }
                                            Rec 'WINDOW' $p.ProcessName $p.Id 0 $wp $title $null $null $null
                                        }
                                    }
                                } catch {}
                            }
                        } catch {}
                    }
                    # ---- new internet connections, every 30 s ----
                    if (($now - $lastConn).TotalSeconds -ge 30) {
                        $lastConn = $now
                        try {
                            foreach ($c in (Get-NetTCPConnection -State Established -ErrorAction Stop)) {
                                $ra = $c.RemoteAddress
                                if ($ra -match '^(127\.|::1|10\.|192\.168\.|169\.254\.|172\.(1[6-9]|2\d|3[01])|fe80|0\.)') { continue }
                                $key = "$($c.OwningProcess)|$ra|$($c.RemotePort)"
                                if (-not $knownConn.ContainsKey($key)) {
                                    $knownConn[$key] = 1
                                    $pn = $null; try { $pn = (Get-Process -Id $c.OwningProcess -ErrorAction Stop).ProcessName } catch {}
                                    $cp = $null; if ($ctl.NativeOk) { try { $cp = [RecNative]::ImagePath([int]$c.OwningProcess) } catch {} }
                                    Rec 'CONN' $pn ([int]$c.OwningProcess) 0 $cp ("{0}:{1}" -f $ra, $c.RemotePort) $null $null $null
                                }
                            }
                        } catch {}
                    }
                }
                # ---- added forensic checks (overlay windows 15 s, memory handles to Roblox 60 s, localhost listeners 30 s) ----
                if ($ctl.Full -and $ctl.ForensicF) {
                    if (-not $knownOvl) { $knownOvl = @{}; $knownHnd = @{}; $knownLis = @{}; $lastOvl = $now; $lastHnd = $now; $lastLis = $now }
                    if (($now - $lastOvl).TotalSeconds -ge 15) {
                        $lastOvl = $now
                        try {
                            foreach ($ln in @([RecForensic]::Overlays())) {
                                $pp = $ln.Split('|'); if ($pp.Count -lt 9) { continue }
                                $key = $pp[0] + '|' + $pp[3]
                                if ($knownOvl.ContainsKey($key)) { continue }
                                $knownOvl[$key] = 1
                                $op = $null; if ($ctl.NativeOk) { try { $op = [RecNative]::ImagePath([int]$pp[0]) } catch {} }
                                $on = $null; try { $on = (Get-Process -Id ([int]$pp[0]) -ErrorAction Stop).ProcessName + '.exe' } catch {}
                                Rec 'OVERLAY' $on ([int]$pp[0]) 0 $op $ln $null $null $null
                            }
                        } catch {}
                    }
                    if (($now - $lastHnd).TotalSeconds -ge 60) {
                        $lastHnd = $now
                        try {
                            $rbp = @(Get-Process RobloxPlayerBeta -ErrorAction SilentlyContinue | ForEach-Object { $_.Id })
                            if ($rbp.Count -gt 0) {
                                foreach ($ln in @([RecForensic]::HandleScan([int[]]$rbp))) {
                                    $pp = $ln.Split('|'); if ($pp[0] -ne 'H') { continue }
                                    $key = $pp[1] + '|' + $pp[2] + '|' + $pp[3]
                                    if ($knownHnd.ContainsKey($key)) { continue }
                                    $knownHnd[$key] = 1
                                    $op = $null; if ($ctl.NativeOk) { try { $op = [RecNative]::ImagePath([int]$pp[1]) } catch {} }
                                    $on = $null; try { $on = (Get-Process -Id ([int]$pp[1]) -ErrorAction Stop).ProcessName + '.exe' } catch {}
                                    Rec 'HANDLE' $on ([int]$pp[1]) 0 $op ($pp[2] + '|' + $pp[3]) $null $null $null
                                }
                            }
                        } catch {}
                    }
                    if (($now - $lastLis).TotalSeconds -ge 30) {
                        $lastLis = $now
                        try {
                            foreach ($c in (Get-NetTCPConnection -State Listen -ErrorAction Stop | Where-Object { $_.LocalAddress -in @('127.0.0.1', '::1') })) {
                                $key = "$($c.OwningProcess)|$($c.LocalPort)"
                                if ($knownLis.ContainsKey($key)) { continue }
                                $knownLis[$key] = 1
                                $on = $null; try { $on = (Get-Process -Id $c.OwningProcess -ErrorAction Stop).ProcessName + '.exe' } catch {}
                                $op = $null; if ($ctl.NativeOk) { try { $op = [RecNative]::ImagePath([int]$c.OwningProcess) } catch {} }
                                Rec 'LISTEN' $on ([int]$c.OwningProcess) 0 $op ("{0}|{1}" -f $c.LocalAddress, $c.LocalPort) $null $null $null
                            }
                        } catch {}
                    }
                }
                if (($now - $lastBeat).TotalSeconds -ge 60) { $lastBeat = $now; $ctl.LastBeat = $now }
                Start-Sleep -Milliseconds 500
              } catch {
                # One failed pass must never stop the guard.
                $ctl.Errors = $ctl.Errors + 1
                Start-Sleep -Milliseconds 300
              }
            }
            try { if ($procW) { $procW.Stop() } } catch {}
            try { if ($devW) { $devW.Stop() } } catch {}
        }
        [void]$ps.AddScript($code.ToString())
        [void]$ps.BeginInvoke()
        $global:GuardPS = $ps
        $global:GuardRS = $rs
        Add-TL 'GUARD' 'Session guard started (display count each second, virtual desktops, proxy lock; Tiers 2/3 also program starts, devices, windows, connections)'
    } catch { Add-Note "Session guard could not start: $($_.Exception.Message)" }
}

function Stop-SessionGuard {
    if (-not $global:GuardCtl) { return }
    $global:GuardCtl.Stop = $true
    Start-Sleep -Milliseconds 1200
    try { $global:GuardLog = @($global:GuardBag.ToArray()) } catch { $global:GuardLog = @() }
    try { if ($global:GuardPS) { $global:GuardPS.Stop(); $global:GuardPS.Dispose() } } catch {}
    try { if ($global:GuardRS) { $global:GuardRS.Close(); $global:GuardRS.Dispose() } } catch {}
    $global:GuardStats = [PSCustomObject]@{ Checks = $global:GuardCtl.Checks; MaxGap = $global:GuardCtl.MaxGapSec; ProxyFix = $global:GuardCtl.ProxyFix; Errors = $global:GuardCtl.Errors }
    # Show staff when the monitoring itself was interrupted (sleep, a suspended window, or internal errors).
    $runSec = ((Get-Date) - $global:GuardCtl.Started).TotalSeconds
    if ($global:GuardCtl.MaxGapSec -ge 20) { Add-Finding 'CHECK' 'Monitoring' 'The display/desktop checks did not run for 20 seconds or more (PC asleep, or this window was paused)' ("longest gap {0} s" -f $global:GuardCtl.MaxGapSec) }
    if ($runSec -ge 60 -and $global:GuardCtl.Checks -lt ($runSec * 0.4)) { Add-Finding 'CHECK' 'Monitoring' 'The display/desktop checks ran far less often than once per second' ("{0} checks in {1} s" -f $global:GuardCtl.Checks, [math]::Round($runSec)) }
    if ($global:GuardCtl.Errors -gt 0) { Add-Finding 'CHECK' 'Monitoring' 'The session guard hit internal errors and carried on' ("{0} error(s)" -f $global:GuardCtl.Errors) }
    Add-TL 'GUARD' ("Session guard stopped. {0} event(s) recorded; {1} display checks, longest gap between checks {2}s." -f @($global:GuardLog).Count, $global:GuardCtl.Checks, $global:GuardCtl.MaxGapSec)
    $global:GuardCtl = $null
}

function Enable-ProxyLock {
    try { & netsh winhttp set proxy 127.0.0.1:1 | Out-Null } catch {}
    if ($global:GuardCtl) { $global:GuardCtl.ProxyLock = $true }
}

function Show-DisplayAlertIfAny {
    if ($global:GuardCtl -and $global:GuardCtl.DispAlert -and $global:DisplayLockedAt) {
        Write-Host ""
        Write-Host "!! A SECOND DISPLAY OR EXTRA VIRTUAL DESKTOP WAS DETECTED AT $($global:GuardCtl.DispAlert) !!" -ForegroundColor Red
        Write-Host "   It was logged with the time and will appear in your findings package." -ForegroundColor Red
        Write-Host ""
        $global:GuardCtl.DispAlert = ''
    }
}

function Assert-SingleDisplay {
    # Waits (polling every 2 s) until one display is active, then records the moment.
    # Everything seen before this moment is set-up; everything after is measured.
    $warned = $false
    while ($true) {
        $count = Get-ActiveDisplayCount
        if ($count -le 1) {
            Write-Host "      Single display confirmed." -ForegroundColor Green
            $global:DisplayLockedAt = Get-Date
            $global:DisplayIdsAtLock = @{}
            try { foreach ($mm in (Get-PnpDevice -Class Monitor -PresentOnly -ErrorAction Stop)) { $global:DisplayIdsAtLock[[string]$mm.InstanceId] = $true } } catch {}
            Add-TL 'DISPLAY' ("Display check passed: one display. Monitor device(s) present at that moment: {0}" -f (($global:DisplayIdsAtLock.Keys | Sort-Object) -join '; '))
            return
        }
        if (-not $warned) {
            Write-Host ""
            Write-Host "      $count displays detected. Only ONE is allowed - unplug the extra display(s) now." -ForegroundColor Red
            Write-Host "      Laptop with an external monitor: switch the LAPTOP screen off (close the lid or use Win+P > Second screen only) so only the monitor is active." -ForegroundColor Yellow
            Get-DisplayDetail | ForEach-Object { Write-Host ("        - {0} {1} {2}" -f $_.DeviceName, $_.Bounds, $(if ($_.Primary) { "(primary)" } else { "" })) -ForegroundColor Red }
            Write-Host "      Waiting for it to be unplugged..." -ForegroundColor Yellow
            Add-TL 'DISPLAY' "Set-up: $count displays were connected; waiting for the player to unplug."
            $warned = $true
        }
        Start-Sleep -Seconds 2
    }
}

# =========================================================================
# SNAPSHOTS (taken at the start and end of the match)
# =========================================================================
function Get-Snapshot([string]$label) {
    $s = @{ Label = $label; Time = Get-Date; Drivers = @{}; Services = @{}; Pnp = @{}; Pf = @{}; Run = @{}; Tasks = @{}; Certs = @{}; Hosts = ''; Displays = 1; VDesk = $null; Procs = @{}; ProcList = @(); Usn = $null; Vpn = @{} }
    try { foreach ($d in (Get-CimInstance Win32_SystemDriver -ErrorAction Stop | Where-Object { $_.State -eq 'Running' })) { $s.Drivers[$d.Name] = (Normalize-Path $d.PathName) } } catch {}
    try { foreach ($d in (Get-CimInstance Win32_Service -ErrorAction Stop)) { $s.Services[$d.Name] = $d.PathName } } catch {}
    try { foreach ($d in (Get-PnpDevice -PresentOnly -ErrorAction Stop)) { $s.Pnp[[string]$d.InstanceId] = [string]$d.FriendlyName } } catch {}
    try { foreach ($f in (Get-ChildItem "$env:WINDIR\Prefetch" -Filter *.pf -ErrorAction Stop)) { $s.Pf[$f.Name] = $f.LastWriteTime } } catch {}
    foreach ($k in @('HKCU:\Software\Microsoft\Windows\CurrentVersion\Run','HKLM:\Software\Microsoft\Windows\CurrentVersion\Run','HKCU:\Software\Microsoft\Windows\CurrentVersion\RunOnce')) {
        if (Test-Path $k) { $pr = Get-ItemProperty $k -ErrorAction SilentlyContinue; foreach ($p in $pr.PSObject.Properties) { if ($p.Name -notlike 'PS*') { $s.Run["$k|$($p.Name)"] = [string]$p.Value } } }
    }
    try { foreach ($t in (Get-ScheduledTask -ErrorAction Stop | Where-Object { $_.TaskPath -notmatch '^\\Microsoft\\' })) { $s.Tasks[$t.TaskPath + $t.TaskName] = [string]$t.State } } catch {}
    try { foreach ($c in (Get-ChildItem Cert:\LocalMachine\Root -ErrorAction Stop)) { $s.Certs[$c.Thumbprint] = $c.Subject } } catch {}
    try { $s.Hosts = (Get-FileHash "$env:WINDIR\System32\drivers\etc\hosts" -Algorithm SHA256 -ErrorAction Stop).Hash } catch {}
    $s.Displays = Get-ActiveDisplayCount
    $s.VDesk = Get-VirtualDesktopCount
    try { foreach ($a in (Get-NetAdapter -IncludeHidden -ErrorAction Stop | Where-Object { $_.Status -eq 'Up' -and $_.InterfaceDescription -match '(?i)(tap-windows|wireguard|tailscale|zerotier|openvpn|hamachi|wintun|vpn|tunnel)' })) { $s.Vpn[[string]$a.Name] = [string]$a.InterfaceDescription } } catch {}
    try { $s.ProcList = @(Get-ProcTable); foreach ($p in $s.ProcList) { $s.Procs[[string]$p.Name + '|' + [string]$p.Path] = $true } } catch {}
    try { $q = (& fsutil usn queryjournal $env:SystemDrive 2>&1 | Out-String); if ($q -match 'Next Usn\s*:\s*(0x[0-9a-fA-F]+|\d+)') { $s.Usn = $matches[1] } } catch {}
    return $s
}

function Compare-Snapshots($a, $b) {
    $out = @()
    if (-not $a -or -not $b) { return @('Snapshot comparison not available.') }
    $out += ("Start snapshot: {0}    End snapshot: {1}" -f $a.Time, $b.Time)
    foreach ($k in $b.Drivers.Keys) {
        if (-not $a.Drivers.ContainsKey($k)) {
            $p = $b.Drivers[$k]; $sig = Get-SigInfo $p
            $out += "DRIVER RUNNING AT END, NOT AT START: $k  $p"
            Add-Finding 'CHECK' 'Drivers' 'A driver is running at the end that was not running at the start' ("{0} {1} (signature {2}{3}; sha256 {4})" -f $k, $p, $sig.Status, $(if ($sig.Cn) { ", signer $($sig.Cn)" } else { '' }), (Get-ShaIfSmall $p))
        }
    }
    foreach ($k in $a.Drivers.Keys) { if (-not $b.Drivers.ContainsKey($k)) { $out += "DRIVER RUNNING AT START, NOT AT END: $k  $($a.Drivers[$k])" } }
    foreach ($k in $b.Services.Keys) { if (-not $a.Services.ContainsKey($k)) { $out += "NEW SERVICE: $k  $($b.Services[$k])"; Add-Finding 'CHECK' 'Software' 'A Windows service exists at the end that did not exist at the start' "$k $($b.Services[$k])" } }
    foreach ($k in $b.Pnp.Keys) { if (-not $a.Pnp.ContainsKey($k)) { $out += "DEVICE PRESENT AT END, NOT AT START: $($b.Pnp[$k]) [$k]"; if ($k -match '^(USB|HID|PCI|DISPLAY|BTH)') { Add-Finding 'CHECK' 'Hardware' 'A device is present at the end that was not present at the start' "$($b.Pnp[$k]) [$k]" } } }
    foreach ($k in $a.Pnp.Keys) { if (-not $b.Pnp.ContainsKey($k)) { $out += "DEVICE PRESENT AT START, NOT AT END: $($a.Pnp[$k]) [$k]"; if ($k -match '^(USB|HID|PCI|DISPLAY|BTH)') { Add-Finding 'CHECK' 'Hardware' 'A device was present at the start but is gone at the end' "$($a.Pnp[$k]) [$k]" } } }
    $gone = @(); foreach ($k in $a.Pf.Keys) { if (-not $b.Pf.ContainsKey($k)) { $gone += $k } }
    foreach ($k in $gone) { $out += "PREFETCH FILE MISSING AT END: $k" }
    if ($gone.Count -gt 0) { Add-Finding 'CHECK' 'Tampering evidence' 'Prefetch file(s) present at the start are missing at the end' ("{0} file(s); folder held {1} at start and {2} at end; first: {3}" -f $gone.Count, $a.Pf.Count, $b.Pf.Count, (($gone | Select-Object -First 8) -join ', ')) }
    foreach ($k in $b.Pf.Keys) { if (-not $a.Pf.ContainsKey($k)) { $out += "PREFETCH NEW: $k ($($b.Pf[$k]))" } elseif ($a.Pf[$k] -ne $b.Pf[$k]) { $out += "PREFETCH UPDATED: $k ($($a.Pf[$k]) -> $($b.Pf[$k]))" } }
    foreach ($k in $b.Run.Keys) { if (-not $a.Run.ContainsKey($k)) { $out += "NEW STARTUP ENTRY: $k = $($b.Run[$k])"; Add-Finding 'CHECK' 'Startup' 'A startup entry exists at the end that did not exist at the start' "$k = $($b.Run[$k])" } }
    foreach ($k in $b.Tasks.Keys) { if (-not $a.Tasks.ContainsKey($k)) { $out += "NEW SCHEDULED TASK: $k"; Add-Finding 'CHECK' 'Startup' 'A non-Microsoft scheduled task exists at the end that did not exist at the start' $k } }
    foreach ($k in $b.Certs.Keys) { if (-not $a.Certs.ContainsKey($k)) { $out += "NEW ROOT CERTIFICATE: $($b.Certs[$k])"; Add-Finding 'CHECK' 'Network' 'A trusted root certificate exists at the end that did not exist at the start' $b.Certs[$k] } }
    if ($a.Hosts -ne $b.Hosts) { $out += 'HOSTS FILE CHANGED'; Add-Finding 'CHECK' 'Network' 'The hosts file content changed between start and end' '' }
    $out += "DISPLAYS: start $($a.Displays), end $($b.Displays); VIRTUAL DESKTOPS: start $($a.VDesk), end $($b.VDesk)"
    # A VPN connecting or disconnecting is normal, so it is listed here for staff but is not a finding.
    foreach ($k in $b.Vpn.Keys) { if (-not $a.Vpn.ContainsKey($k)) { $out += "VPN/TUNNEL ADAPTER UP AT END, NOT AT START: $k - $($b.Vpn[$k])" } }
    foreach ($k in $a.Vpn.Keys) { if (-not $b.Vpn.ContainsKey($k)) { $out += "VPN/TUNNEL ADAPTER UP AT START, NOT AT END: $k - $($a.Vpn[$k])" } }
    foreach ($k in $b.Procs.Keys) {
        if (-not $a.Procs.ContainsKey($k)) {
            $parts = $k.Split('|', 2)
            $v = Get-ProcVerdict $parts[0] $parts[1]
            $out += "PROGRAM RUNNING AT END, NOT AT START: $($parts[0])  $($parts[1])  [$($v.Class)]"
        }
    }
    return $out
}

# =========================================================================
# END-OF-SESSION EVIDENCE FROM WINDOWS' OWN RECORDS
# =========================================================================
function Test-DeviceHistory {
    # Windows stores the last arrival and last removal time of every device, even
    # ones unplugged since. This catches a monitor (or any device) that was plugged
    # in or out during the session even if it is gone again when the script checks.
    $locked = $global:DisplayLockedAt
    try {
        $all = @(Get-PnpDevice -ErrorAction Stop | Where-Object { $_.InstanceId -match '^(DISPLAY|USB|HID|PCI|BTH|BTHENUM|BTHLE|USBSTOR|SCSI|NVME|THUNDERBOLT)\\' })
        $present = @{}; foreach ($d in @(Get-PnpDevice -PresentOnly -ErrorAction SilentlyContinue)) { $present[[string]$d.InstanceId] = $true }
        foreach ($d in $all) {
            $id = [string]$d.InstanceId
            $arr = $null; $rem = $null
            try {
                $pp = @(Get-PnpDeviceProperty -InstanceId $id -KeyName 'DEVPKEY_Device_LastArrivalDate','DEVPKEY_Device_LastRemovalDate' -ErrorAction Stop)
                foreach ($p in $pp) {
                    if ($p.KeyName -match 'LastArrivalDate' -and $p.Data) { $arr = [datetime]$p.Data }
                    if ($p.KeyName -match 'LastRemovalDate' -and $p.Data) { $rem = [datetime]$p.Data }
                }
            } catch { continue }
            $inSession = (($arr -and $arr -ge $global:SessionStart) -or ($rem -and $rem -ge $global:SessionStart))
            if (-not $inSession) { continue }
            $fact = "{0} [{1}]: last arrival {2}; last removal {3}; present now: {4}" -f $d.FriendlyName, $id, $(if ($arr) { $arr.ToString('yyyy-MM-dd HH:mm:ss') } else { 'n/a' }), $(if ($rem) { $rem.ToString('yyyy-MM-dd HH:mm:ss') } else { 'n/a' }), $(if ($present.ContainsKey($id)) { 'yes' } else { 'no' })
            if ($id -match '^DISPLAY\\') {
                $after = $false
                $endT = $global:MatchEnd; if (-not $endT) { $endT = Get-Date }
                if ($locked) { if ($arr -and $arr -gt $locked -and $arr -le $endT) { $after = $true } }
                if ($after -and $global:DisplayIdsAtLock.Count -gt 0 -and $global:DisplayIdsAtLock.ContainsKey($id)) {
                    Add-Finding 'CHECK' 'Display' 'A monitor that was already connected at the display check was detected again afterwards (reconnected, woke from sleep or driver reset)' $fact $arr
                }
                elseif ($after) { Add-Finding 'RULE' 'Display' 'Windows recorded a monitor arriving after the single-display check passed' $fact $arr }
                else { Add-TL 'DISPLAY' "Monitor device changed during set-up: $fact" }
            } else {
                Add-Finding 'CHECK' 'Hardware' 'Windows recorded a device arrival or removal during the session' $fact $(if ($arr -and $arr -ge $global:SessionStart) { $arr } else { $rem })
            }
        }
    } catch { Add-Note 'Device arrival/removal history could not be read.' }
}

function Get-SessionEventFacts {
    $since = $global:SessionStart
    Get-LogClearFacts $since
    try {
        foreach ($e in @(Get-WinEvent -FilterHashtable @{ LogName = 'System'; ProviderName = 'Service Control Manager'; Id = 7045; StartTime = $since } -ErrorAction Stop)) {
            $d = @(); try { $d = @($e.Properties | ForEach-Object { [string]$_.Value }) } catch {}
            Add-Finding 'CHECK' 'Drivers' 'A service or driver was installed (System event 7045)' ("name {0}; image {1}; type {2}; start {3}" -f $d[0], $d[1], $d[2], $d[3]) $e.TimeCreated
        }
    } catch {}
    try {
        foreach ($e in @(Get-WinEvent -FilterHashtable @{ LogName = 'Microsoft-Windows-CodeIntegrity/Operational'; StartTime = $since; Level = 1,2,3 } -MaxEvents 40 -ErrorAction Stop)) {
            $m = ($e.Message -split "`r?`n")[0]; if ($m.Length -gt 220) { $m = $m.Substring(0, 220) }
            Add-Finding 'CHECK' 'Drivers' "Code Integrity logged a warning/error (event $($e.Id))" $m $e.TimeCreated
        }
    } catch {}
    try {
        foreach ($e in @(Get-WinEvent -FilterHashtable @{ LogName = 'Microsoft-Windows-Windows Defender/Operational'; Id = 5001,5007,5004; StartTime = $since } -MaxEvents 20 -ErrorAction Stop)) {
            $m = ($e.Message -split "`r?`n" | Select-Object -First 3) -join ' '; if ($m.Length -gt 260) { $m = $m.Substring(0, 260) }
            Add-Finding 'CHECK' 'Windows Defender' "Defender logged event $($e.Id) (configuration or real-time protection change)" $m $e.TimeCreated
        }
    } catch {}
    Get-TimeChangeFacts 3
}

# =========================================================================
# GUARD LOG -> TIMELINE + FINDINGS (done after the match)
# =========================================================================
function Convert-GuardLog {
    $log = @($global:GuardLog | Sort-Object Time)
    $ms = $global:MatchStart; $me = $global:MatchEnd
    $from = $global:SessionStart.AddSeconds(-5); $to = Get-Date
    $audit = @(Get-ProcessAuditEvents $from $to)
    $global:ProcAuditRows = $audit

    # ----- own process tree (this script and everything it started) -----
    $own = @{}; $own[[int]$PID] = $true
    $recs = @()
    foreach ($a in $audit) { $recs += [PSCustomObject]@{ Time = $a.Time; PID = $a.PID; PPID = $a.PPID; Name = [IO.Path]::GetFileName([string]$a.Path); Path = $a.Path; ParentPath = $a.ParentPath; Cmd = $a.Cmd; Sig = $null; Signer = $null; Sha = $null; Src = '4688' } }
    foreach ($g in ($log | Where-Object { $_.Kind -eq 'PROC' })) {
        $dup = $false
        foreach ($r in $recs) { if ($r.PID -eq [int]$g.PID -and [math]::Abs(($r.Time - $g.Time).TotalSeconds) -le 6) { $dup = $true; if ($g.Sig) { $r.Sig = $g.Sig; $r.Signer = $g.Signer; $r.Sha = $g.Sha256 }; break } }
        if (-not $dup) { $recs += [PSCustomObject]@{ Time = $g.Time; PID = [int]$g.PID; PPID = [int]$g.PPID; Name = [string]$g.Name; Path = (Normalize-Path $g.Path); ParentPath = $null; Cmd = $g.Detail; Sig = $g.Sig; Signer = $g.Signer; Sha = $g.Sha256; Src = 'trace' } }
    }
    $recs = @($recs | Sort-Object Time)
    foreach ($r in $recs) { if ($own.ContainsKey([int]$r.PPID)) { $own[[int]$r.PID] = $true } }

    # names of parents (time-aware: latest record for that PID before the child)
    $startProcs = @{}
    if ($global:SnapStart) { foreach ($p in $global:SnapStart.ProcList) { $startProcs[[int]$p.PID] = $p.Name } }
    function Local-ParentName($r, $recsAll) {
        if ($r.ParentPath) { return [IO.Path]::GetFileName([string]$r.ParentPath) }
        $best = $null
        foreach ($x in $recsAll) { if ($x.PID -eq $r.PPID -and $x.Time -le $r.Time) { $best = $x } }
        if ($best) { return $best.Name }
        if ($startProcs.ContainsKey([int]$r.PPID)) { return $startProcs[[int]$r.PPID] }
        return $null
    }

    $allowedClasses = @('Roblox','OBS','NVIDIA','AMD','Malwarebytes','Discord','VPN')
    if ($tier -eq '2') { $allowedClasses += 'Browser' }
    $userParents = '(?i)^(explorer|cmd|powershell|pwsh|windowsterminal|wt|openconsole|taskmgr)(\.exe)?$'
    $allowedPid = @{}
    $ownSkipped = 0
    foreach ($r in $recs) {
        $path = $r.Path
        if ($r.Sig -and $path) { $global:SigCache[$path.ToLower()] = [PSCustomObject]@{ Status = $r.Sig; Publisher = $r.Signer; Cn = $(if ($r.Signer -match 'CN="?([^",]+)') { $matches[1] } else { $null }) } }
        $v = Get-ProcVerdict $r.Name $path
        # A start-up counts as this script's own only if the file is also a verified file in a protected folder.
        # A parent-process ID alone can be faked, and process IDs get reused.
        if ($own.ContainsKey([int]$r.PID) -and (($v.Verified -and (Test-ProtectedLocation $v.Location)) -or ($v.Unreadable -and $r.Name -match '(?i)^(netsh|auditpol|fsutil|bcdedit|conhost|wevtutil)(\.exe)?$'))) { $ownSkipped++; continue }
        $pn = Local-ParentName $r $recs
        $ph = Get-PhaseFor $r.Time
        $tag = "{0} (PID {1}) {2} | parent {3} | {4}" -f $r.Name, $r.PID, $(if ($path) { $path } else { '(path not available)' }), $(if ($pn) { $pn } else { 'unknown' }), $(if ($r.Cmd) { "cmd: $($r.Cmd)" } else { 'no command line recorded' })
        Add-TL 'PROC START' ("{0} [{1}; source {2}]" -f $tag, $v.Class, $r.Src) $r.Time
        $global:FindingTimeOverride = $r.Time
        $nm = ($r.Name -replace '\.exe$', '')
        if ($v.Mismatch) { Add-Finding 'CHECK' 'Software' "A program was started whose file name matches a known program but whose identity does not ($ph)" "$tag :: $($v.Reason)" }
        $tm = Get-ToolNameMatch $r.Name $v
        if ($tm) { Add-Finding 'CHECK' 'Software' "A program on the cheat/injector/debugger tool-name list was started ($ph)" "$tag :: $(Get-FileFacts $v)" }
        elseif ($r.Cmd -and $r.Cmd -match $global:ToolCmdRx -and $nm -notmatch '(?i)^(powershell|pwsh|conhost|cmd)$') { Add-Finding 'CHECK' 'Software' "A started program has a tool name from the list in its command line ($ph)" $tag }
        if ($nm -match $global:MacroRx) { Add-Finding 'CHECK' 'Software' "Hotkey / macro-capable software was started ($ph)" $tag }
        if ($v.Class -eq 'VPN' -and ($nm -notmatch $global:RemoteRx -or $nm -match '^(wireguard|openvpn.*)$')) { Add-TL 'NETWORK' "Allowed VPN software started ($ph): $tag :: $(Get-FileFacts $v)" $r.Time }
        elseif ($nm -match $global:RemoteRx) { Add-Finding 'CHECK' 'Network' "Remote-control, input-sharing or tunnel software was started ($ph)" $tag }
        if (-not (Test-RuleWindow $r.Time)) { continue }

        # Task Manager itself is allowed (only if it is the real file); a program it starts ("Run new task") is not.
        # Other allowed programs may start verified helper files in protected folders, nothing else.
        $isTaskMgr = ($v.Class -eq 'Windows' -and $nm -ieq 'taskmgr')
        $childOfAllowed = ($allowedPid.ContainsKey([int]$r.PPID) -and $pn -notmatch '(?i)^taskmgr' -and $v.Verified -and (Test-ProtectedLocation $v.Location))
        $isAllowed = ($v.Class -in $allowedClasses) -or $isTaskMgr -or $childOfAllowed
        if ($isAllowed -and -not $childOfAllowed) { $allowedPid[[int]$r.PID] = $true }
        $userLaunched = ($pn -and $pn -match $userParents)
        # Windows background components (search host, broker, console host...) are not apps the player opened.
        $sysBackground = ($v.Class -eq 'Windows' -and $nm -notmatch '(?i)^(regedit|mmc|cmd|powershell|pwsh|windowsterminal|openconsole|systemsettings|gamebar|widgets|phoneexperiencehost)$')
        if ($userLaunched -and -not $isAllowed -and -not $sysBackground) {
            Add-Finding 'RULE' 'AllowedPrograms' 'A program outside the allowed list was started from the desktop session during the match' "$tag :: $(Get-FileFacts $v)"
        } elseif (-not $isAllowed) {
            if (-not $v.Verified -and -not $v.Unreadable) { Add-Finding 'CHECK' 'Software' 'A program with no verified identity was started during the match' "$tag :: $($v.Reason); $(Get-FileFacts $v)" }
            elseif ($v.Unreadable -and $r.Src -eq 'trace') { Add-Finding 'CHECK' 'Software' 'A program was started during the match and exited before its file could be identified' $tag }
            elseif ($v.Verified -and -not (Test-ProtectedLocation $v.Location)) { Add-Finding 'CHECK' 'Software' 'A program outside the Windows/Program Files folders was started during the match' "$tag :: $(Get-FileFacts $v)" }
            elseif ($nm -match $global:ShellProcRx) { Add-Finding 'CHECK' 'Software' 'A command interpreter was started during the match by a non-desktop parent' $tag }
        }
    }
    $global:FindingTimeOverride = $null
    if ($ownSkipped -gt 0) { Add-TL 'PROC START' ("({0} start-ups by this script and its own helper programs were left out)" -f $ownSkipped) }

    # ----- other guard events -----
    $ownWin = $own
    foreach ($e in $log) {
        $global:FindingTimeOverride = $e.Time
        $ph = Get-PhaseFor $e.Time
        $locked = $global:DisplayLockedAt
        switch ($e.Kind) {
            'DISPLAY' {
                Add-TL 'DISPLAY' $e.Detail $e.Time
                if ($locked -and $e.Time -gt $locked -and $ph -ne 'AFTER' -and $e.Detail -match '-> (\d+)(;|$)' -and [int]$matches[1] -gt 1) {
                    Add-Finding 'RULE' 'Display' 'More than one display was active after the single-display check passed' $e.Detail $e.Time
                }
            }
            'VDESKTOP' {
                Add-TL 'DISPLAY' $e.Detail $e.Time
                if ($locked -and $e.Time -gt $locked -and $ph -ne 'AFTER' -and $e.Detail -match '-> (\d+)$' -and [int]$matches[1] -gt 1) {
                    Add-Finding 'RULE' 'Desktop' 'More than one virtual desktop existed after the display check passed' $e.Detail $e.Time
                }
            }
            'PROXY' { Add-TL 'NETWORK' $e.Detail $e.Time; Add-Finding 'CHECK' 'Network' 'The locked WinHTTP proxy setting was changed by something while the lock was on' $e.Detail $e.Time }
            'PNP' {
                Add-TL 'DEVICE' ("appeared: {0} [{1}]" -f $e.Name, $e.Path) $e.Time
                if ($e.Path -match '^(USB|HID|PCI|DISPLAY|BTH)') { Add-Finding 'CHECK' 'Hardware' "A device appeared ($ph)" ("{0} [{1}]" -f $e.Name, $e.Path) $e.Time }
            }
            'PNPGONE' {
                Add-TL 'DEVICE' ("disappeared: {0} [{1}]" -f $e.Name, $e.Path) $e.Time
                if ($e.Path -match '^(USB|HID|PCI|DISPLAY|BTH)') { Add-Finding 'CHECK' 'Hardware' "A device disappeared ($ph)" ("{0} [{1}]" -f $e.Name, $e.Path) $e.Time }
            }
            'WINDOW' {
                Add-TL 'WINDOW' ("{0} (PID {1}) window: {2}" -f $e.Name, $e.PID, $e.Detail) $e.Time
                if ((Test-RuleWindow $e.Time) -and -not $ownWin.ContainsKey([int]$e.PID)) {
                    $v = Get-ProcVerdict $e.Name $e.Path ([int]$e.PID)
                    # Judged by verified identity (name + folder + signature), never by file name alone.
                    $okw = ($v.Class -in $allowedClasses) -or ($v.Class -eq 'Windows') -or $allowedPid.ContainsKey([int]$e.PID)
                    if (-not $okw) { Add-Finding 'RULE' 'AllowedPrograms' 'A window of a program outside the allowed list was open during the match' ("{0} (PID {1}) {2} | window title: {3} | {4}" -f $e.Name, $e.PID, $v.Path, $e.Detail, $v.Reason) $e.Time }
                }
            }
            'CONN' {
                Add-TL 'NETWORK' ("{0} (PID {1}) connected to {2}" -f $e.Name, $e.PID, $e.Detail) $e.Time
                if ((Test-RuleWindow $e.Time) -and $e.Name) {
                    $v = Get-ProcVerdict $e.Name $e.Path ([int]$e.PID)
                    if ($v.Class -notin (@('Windows') + $allowedClasses) -and -not $v.Unreadable) {
                        Add-Finding 'CHECK' 'Network' 'Internet connection during the match from a program outside the Windows/Roblox/recorder/Discord/allowed-browser classes' ("{0} (PID {1}) {2} -> {3} :: {4}" -f $e.Name, $e.PID, $v.Path, $e.Detail, $v.Reason) $e.Time
                    }
                }
            }
            'OVERLAY' { Report-OverlayLine ([string]$e.Detail) ([string]$e.Name) ([string]$e.Path) $e.Time }
            'HANDLE'  { $hp = ([string]$e.Detail).Split('|'); Report-HandleHit ([int]$e.PID) ([int]$hp[0]) $hp[1] ([string]$e.Name) ([string]$e.Path) $e.Time }
            'LISTEN'  { $lp = ([string]$e.Detail).Split('|'); Report-ListenEntry $lp[0] ([int]$lp[1]) ([int]$e.PID) ([string]$e.Name) ([string]$e.Path) $e.Time }
            'AUDITOFF' { Add-TL 'GUARD' $e.Detail $e.Time; Add-Finding 'CHECK' 'Tampering evidence' 'Process-creation auditing was found switched off during the session (the script switched it back on)' $e.Detail $e.Time }
            'INFO' { Add-Note ("Guard: {0}" -f $e.Detail) }
        }
    }
    $global:FindingTimeOverride = $null
}

# =========================================================================
# REPORT
# Plain statements only. No score, no percentage, no likelihood.
# =========================================================================
$global:RuleDefs = [ordered]@{
    'Display'         = 'Only one display was active from the display check until the end of the match'
    'Desktop'         = 'Only one virtual desktop existed from the display check until the end of the match'
    'MemoryIntegrity' = 'Memory Integrity (HVCI) was running'
    'Blocklist'       = 'The Microsoft vulnerable-driver blocklist was not switched off'
    'AllowedPrograms' = 'Only allowed programs were opened during the match (Discord, Task Manager, a verified allowed-vendor VPN, and a browser in Tier 2)'
}

# =========================================================================
# PLAIN-ENGLISH CATALOG
# Priority is a READING ORDER chosen from the kind of evidence (never a score or a likelihood):
#   1 = REVIEW FIRST  (direct evidence of tampering, cheat tooling or memory access, or a changed security setting)
#   2 = REVIEW        (needs a look at the video / a quick question to the player)
#   3 = NOTE          (usually harmless; listed so nothing is hidden)
# First matching entry wins. Rx is matched against "Area | Title | Detail".
# =========================================================================
$global:FindingCatalog = @(
    @{ Rx = 'Tampering evidence \|.*(event log was cleared|lost most|clock jumped|clock change|time zone|BAM\))'; Cat = 'Evidence tampering'; Pri = 1; Meaning = 'Something that proves what happened (event logs, execution history or the system clock) was cleared or changed while the script was running. The live sampler captured it before it could be wiped.'; Look = 'Compare the time with the video; ask what the player did at that moment.' }
    @{ Rx = 'Software \|.*(removable drive|seen as removable)'; Cat = 'USB / removable drives'; Pri = 1; Meaning = 'A program ran from a USB or removable drive, or a drive was plugged in and removed during the session. A cheat can run from a USB stick and leave little behind.'; Look = 'Check the program path and the time the drive appeared and was removed.' }
    @{ Rx = 'Hardware \|.*removable drive was removed'; Cat = 'USB / removable drives'; Pri = 2; Meaning = 'A removable drive was removed while the script was running.'; Look = 'Check whether a program ran from it (see other USB items) and compare the time with the video.' }
    @{ Rx = 'Software \|.*(renamed|claims a well-known publisher)'; Cat = 'Disguised program'; Pri = 1; Meaning = 'A program''s built-in name or publisher does not match its file name or its signature. Cheats are renamed or dressed up as trusted software this way.'; Look = 'Compare the file name, the built-in name and the signer in the detail line.' }
    @{ Rx = 'Software \|.*REVOKED certificate'; Cat = 'Disguised program'; Pri = 1; Meaning = 'A running program is signed with a certificate that the issuer has withdrawn (often stolen or abused).'; Look = 'Check the program and the signer.' }
    @{ Rx = 'Software \|.*(unsigned DLL from a user-writable)'; Cat = 'Disguised program'; Pri = 2; Meaning = 'A validly signed program loaded an unsigned DLL from a folder anyone can write to. Cheats hide inside trusted programs this way, but several normal apps also do it.'; Look = 'Check the DLL path and whether the program normally ships that DLL.' }
    @{ Rx = 'Software \|.*(imports functions that read or write another program).*no valid signature|Software \|.*with no valid signature imports'; Cat = 'Cheat capability'; Pri = 1; Meaning = 'An unsigned program contains the Windows functions needed to read or write another program''s memory. This shows capability, not use.'; Look = 'Check the program and compare with the memory-access items.' }
    @{ Rx = 'Software \|.*imports functions that read or write another program'; Cat = 'Cheat capability'; Pri = 2; Meaning = 'A signed third-party program contains functions for reading or writing another program''s memory. Debuggers, anti-cheat, overlays and some game tools do this legitimately.'; Look = 'Only relevant if the program is not one the player is allowed to run.' }
    @{ Rx = 'Software \|.*(recently issued certificate)'; Cat = 'Disguised program'; Pri = 3; Meaning = 'A running program is signed with a certificate issued in the last 30 days. Normal for updated software; also true for freshly made fake publishers.'; Look = 'Only if the program is unfamiliar.' }
    @{ Rx = 'Software \|.*(used the GPU during the match)'; Cat = 'GPU use'; Pri = 2; Meaning = 'An unsigned program used the graphics card during the match. Overlays, screen capture and GPU-based cheats use the GPU even when CPU use looks normal.'; Look = 'See 32_gpu_use_by_process.csv and compare with the video.' }
    @{ Rx = 'Software \|.*(steady, regular amount of CPU)'; Cat = 'CPU pattern'; Pri = 3; Meaning = 'A program used almost exactly the same small amount of CPU every few seconds, like a timed loop. Many normal background apps do this too, so this is low confidence.'; Look = 'Only worth a look if the program is unfamiliar or unsigned.' }
    @{ Rx = 'Software \|.*(notable CPU time|High or Realtime priority|pinned to specific CPU)'; Cat = 'CPU pattern'; Pri = 3; Meaning = 'Informational: an unsigned program used CPU, ran at raised priority or was pinned to cores.'; Look = 'See 31_cpu_time_by_process.csv.' }
    @{ Rx = 'Software \|.*(missing from the normal process list)'; Cat = 'Hidden process'; Pri = 1; Meaning = 'A network endpoint or WMI entry belongs to a process ID that the normal process list does not show. Rootkit-style cheats hide their process like this.'; Look = 'Re-check the PID in the detail line against the process lists in the package.' }
    @{ Rx = 'Software \|.*process trace shows programs starting'; Cat = 'Process trace'; Pri = 3; Meaning = 'The kernel process trace saw programs start that the live guard did not log. The guard may skip well-known programs, so this is mostly informational.'; Look = 'Read the names in the detail line and process_trace_events.csv.' }
    @{ Rx = 'Network \|.*(local network|Remote-control)'; Cat = 'Second PC / remote control'; Pri = 2; Meaning = 'Remote-control software is running, or a program is talking to another device on the home network. A second PC or a phone could be receiving game data or sending input.'; Look = 'Check the program and ask what it was for.' }
    @{ Rx = 'System state \|.*(virtual machine|restarted within)'; Cat = 'System state'; Pri = 2; Meaning = 'A virtual machine, sandbox or WSL was running, or the PC was restarted just before the script started (a restart clears memory and some traces).'; Look = 'Read the detail line.' }
    @{ Rx = 'Windows Defender \|.*(switched off since|setting changed since|setting changed during)'; Cat = 'Windows Defender'; Pri = 1; Meaning = 'Windows Defender or a related protection was switched off or changed while the script was running.'; Look = 'Read the setting and time; compare with the video.' }
    @{ Rx = 'Monitoring \|.*(went to sleep|sampler was paused)'; Cat = 'Script health'; Pri = 2; Meaning = 'The PC slept or the live monitoring stalled, so there is a gap in what was watched.'; Look = 'Check whether the gap overlaps the match window.' }
    @{ Rx = 'Software \|.*known-cheat SHA-256';             Cat = 'Known cheat file'; Pri = 1; Meaning = 'A file on this PC has exactly the same SHA-256 hash as a file staff listed as a known cheat. A hash match means identical file content.'; Look = 'Read the path and staff label in the detail line; confirm the hash in your own list.' }
    @{ Rx = 'Malwarebytes \|';                              Cat = 'Malwarebytes'; Pri = 1; Meaning = 'A Malwarebytes scan-result file in the last 30 days contains detection-like fields. The file format is not documented, so names may be incomplete.'; Look = 'Open the copied ScanResults file in the package and read the threat names and paths.' }
    @{ Rx = 'Roblox log \|';                                Cat = 'Roblox log'; Pri = 2; Meaning = 'A line in a recent Roblox log matched a word pattern linked to settings overrides, injection or anti-cheat messages. Wording differs between Roblox versions, so this is only a pointer.'; Look = 'Read the quoted line; many normal lines mention settings files.' }
    @{ Rx = 'Memory \|.*holds a handle to Roblox';        Cat = 'Game memory access'; Pri = 1; Meaning = 'Another program has an open handle to Roblox that allows reading or writing the game''s memory. Memory-reading cheats and ESP tools work this way.'; Look = 'Is the named program one the player was allowed to run? Check its signature and path in the detail line.' }
    @{ Rx = 'Memory \|.*(hollowing|private memory)';       Cat = 'Game memory access'; Pri = 1; Meaning = 'A program contains code that is not backed by a file on disk, or its running image differs from its file. This is how injected or manual-mapped cheat code hides.'; Look = 'Note the process and whether it was running during the match. Some .NET programs also do this legitimately.' }
    @{ Rx = 'read-write-execute memory';                   Cat = 'Game memory access'; Pri = 3; Meaning = 'Roblox has memory that is both writable and executable. Roblox''s own protection often does this, so on its own it proves little.'; Look = 'Only relevant together with other Game memory access items.' }
    @{ Rx = 'Overlay \|.*no verified identity';            Cat = 'Screen overlay / ESP'; Pri = 1; Meaning = 'A see-through window from an unidentified program is drawn on top of the screen. External ESP overlays are built this way.'; Look = 'Scrub the video for boxes, lines or text drawn over the game; check the program in the detail line.' }
    @{ Rx = 'Overlay \|';                                  Cat = 'Screen overlay / ESP'; Pri = 2; Meaning = 'A signed third-party program has a see-through window on screen (for example a game-store or hardware overlay).'; Look = 'Usually harmless; confirm it is a known overlay.' }
    @{ Rx = 'Localhost \|.*no verified identity';          Cat = 'Local servers / web radar'; Pri = 1; Meaning = 'An unidentified program (or a script interpreter) is running a server only reachable from this PC. Web radars and cheat helper servers do this.'; Look = 'Check the HTTP answer in the detail line and whether the player opened a browser tab to it.' }
    @{ Rx = 'Localhost \|.*cannot be found';               Cat = 'Local servers / web radar'; Pri = 1; Meaning = 'A local port is open but the program that owns it cannot be seen, which can mean a hidden process.'; Look = 'Compare with the process lists in the package.' }
    @{ Rx = 'Localhost \|';                                Cat = 'Local servers / web radar'; Pri = 3; Meaning = 'A signed program listens on a local port. Many normal apps do (launchers, hardware software).'; Look = 'Only if the program is not one you expect.' }
    @{ Rx = 'Input \|.*Roblox was the active';             Cat = 'Automated input'; Pri = 2; Meaning = 'Windows marked mouse movement or clicks as sent by software rather than a physical mouse, while Roblox was in front.'; Look = 'Compare the sample times with the video. Remote-desktop and some accessibility tools also cause this.' }
    @{ Rx = 'Input \|';                                    Cat = 'Automated input'; Pri = 3; Meaning = 'Software-sent mouse input happened while another program was active.'; Look = 'Usually remote-desktop, accessibility or mouse software.' }
    @{ Rx = 'Windows Defender \|.*(detected a threat|took action|1118|restored|Controlled Folder Access blocked)'; Cat = 'Windows Defender'; Pri = 1; Meaning = 'Windows Defender flagged a file as malicious or restored one from quarantine. Cheats are often detected as malware.'; Look = 'Read the threat name and path; ask whether the file is related to the game.' }
    @{ Rx = 'Windows Defender \|.*(threat-detection history)'; Cat = 'Windows Defender'; Pri = 1; Meaning = 'Defender''s own history lists a detection.'; Look = 'Read the threat name and path.' }
    @{ Rx = 'Windows Defender \|.*real-time protection is off'; Cat = 'Windows Defender'; Pri = 1; Meaning = 'Defender''s live protection was off, so nothing was scanning files.'; Look = 'Was another antivirus responsible (Malwarebytes)?' }
    @{ Rx = 'Windows Defender \|.*(exclusion).*(?i)(\\temp|\\tmp|downloads|desktop|appdata|roblox|^.*\| [A-Za-z]:\\?$|\*\.exe|\.dll|\.exe)'; Cat = 'Windows Defender'; Pri = 1; Meaning = 'Defender was told to ignore a risky location or file type (temp/Downloads/Desktop, a whole drive, Roblox, or programs). Cheat users do this so Defender does not delete their tools.'; Look = 'Read the excluded path. Anything in Temp/Downloads/Desktop or covering whole drives needs an explanation.' }
    @{ Rx = 'Windows Defender \|.*(exclusion|Controlled Folder)'; Cat = 'Windows Defender'; Pri = 2; Meaning = 'Defender has an exclusion or an allowed app in Controlled Folder Access.'; Look = 'Check the path is a normal program location.' }
    @{ Rx = 'Windows Defender \|';                         Cat = 'Windows Defender'; Pri = 2; Meaning = 'A Defender setting or protection event changed.'; Look = 'See the detail line.' }
    @{ Rx = 'Boot security \|';                            Cat = 'Boot and kernel security'; Pri = 2; Meaning = 'A Windows protection that stops unsigned code from loading very early (or in the kernel) is not active.'; Look = 'Compare with the Security posture table.' }
    @{ Rx = 'Drivers \|.*(vulnerable/abused-driver|self-signed|no valid signature|user-writable)'; Cat = 'Drivers'; Pri = 1; Meaning = 'A kernel driver is on a list of drivers abused by cheats, is signed with a self-made certificate, or is unsigned. Kernel drivers let cheat code bypass normal protections.'; Look = 'Some are legitimate (MSI Afterburner, CPU-Z, hardware monitors); check which tool installed it.' }
    @{ Rx = 'Drivers \|';                                  Cat = 'Drivers'; Pri = 2; Meaning = 'A driver was installed, changed or blocked by Windows.'; Look = 'Check the name and time against what the player installed.' }
    @{ Rx = 'Certificates \|';                             Cat = 'Certificates'; Pri = 2; Meaning = 'A certificate that is self-made or newly added was found. Self-made certificates are used to make unsigned cheat drivers or tools look trusted.'; Look = 'Check the subject name and date.' }
    @{ Rx = 'Hardware \|.*FPGA';                           Cat = 'Hardware (DMA)'; Pri = 1; Meaning = 'A device from an FPGA chip vendor is or was registered. Hardware cheats that read game memory over PCIe (DMA) use such cards. Capture cards and lab hardware also use them.'; Look = 'Check the device name; ask the player what it is.' }
    @{ Rx = 'Hardware \|.*(no driver and an unknown class)'; Cat = 'Hardware (DMA)'; Pri = 2; Meaning = 'A PCI device is present that Windows cannot identify.'; Look = 'Ask the player what it is.' }
    @{ Rx = 'Hardware \|.*(Microcontroller|Video-capture)'; Cat = 'Hardware'; Pri = 2; Meaning = 'A device type often used for input automation or screen relay is present.'; Look = 'Check against the video / the player''s setup.' }
    @{ Rx = 'Hardware \|';                                 Cat = 'Hardware'; Pri = 3; Meaning = 'A device was plugged in or removed.'; Look = 'Relevant if it happened during the match.' }
    @{ Rx = 'Display \|';                                  Cat = 'Display'; Pri = 2; Meaning = 'A display change or a virtual/remote display adapter was seen.'; Look = 'Compare with the display rules.' }
    @{ Rx = 'Tampering evidence \|';                       Cat = 'Evidence tampering'; Pri = 1; Meaning = 'Something that records or proves what happened was cleared, switched off or changed (event logs, Prefetch, clock, auditing, history).'; Look = 'Check the time of the event against the session.' }
    @{ Rx = 'Software \|.*(tool-name list|lookalike|identity does not|has a tool name)'; Cat = 'Cheat or tool software'; Pri = 1; Meaning = 'A program name, file record or command line matches known cheat, injector or debugging tools, or a program is imitating a normal program name.'; Look = 'Check the file path, signature and whether it ran during the match.' }
    @{ Rx = 'Software \|.*(no longer exist|no valid signature)'; Cat = 'Cheat or tool software'; Pri = 2; Meaning = 'Windows records show programs that ran from user folders and are now deleted, or that have no valid signature. Deleting a program after use hides it.'; Look = 'Look at the names and times; compare with the video.' }
    @{ Rx = 'Software \|.*(no verified identity|could not be closed|exited before)'; Cat = 'Unidentified software'; Pri = 2; Meaning = 'A program could not be matched to a verified publisher/location.'; Look = 'Check path and signature in the detail line.' }
    @{ Rx = 'Software \|.*(Programs recently run|created and deleted)'; Cat = 'Execution history'; Pri = 2; Meaning = 'Windows execution records list programs run from Downloads/Desktop/Temp, or files created and deleted during the session.'; Look = 'Scan the list for anything not normal software.' }
    @{ Rx = 'Software \|';                                 Cat = 'Software'; Pri = 2; Meaning = 'A program-related observation (running software, scripts, macros, services).'; Look = 'See the detail line.' }
    @{ Rx = 'Roblox files \|';                             Cat = 'Roblox files'; Pri = 1; Meaning = 'Roblox program files were changed or are not signed by Roblox, or a settings file that overrides game behaviour exists.'; Look = 'Read the listed files.' }
    @{ Rx = 'Startup \|.*(IFEO|Image File Execution|AppInit|logon|Userinit|BootExecute|WMI)'; Cat = 'Persistence'; Pri = 1; Meaning = 'A Windows hook that runs or replaces programs automatically is set to a non-default value.'; Look = 'Read the value.' }
    @{ Rx = 'Startup \|';                                  Cat = 'Persistence'; Pri = 2; Meaning = 'Something is set to start automatically (startup entry, task, hotkey or service).'; Look = 'Check whether the target is normal software.' }
    @{ Rx = 'Network \|.*(listening on all|intercepting|tunnel|cheat-site|proxy|Remote-control|run-from-string|VPN/tunnel)'; Cat = 'Network'; Pri = 2; Meaning = 'A network setting or connection that can hide, relay or intercept traffic.'; Look = 'See the detail line.' }
    @{ Rx = 'Network \|';                                  Cat = 'Network'; Pri = 3; Meaning = 'A network-related observation.'; Look = 'Usually harmless on its own.' }
    @{ Rx = 'System state \|';                             Cat = 'System state'; Pri = 2; Meaning = 'A Windows boot option or virtual-machine sign differs from a normal PC.'; Look = 'See the detail line.' }
    @{ Rx = 'Monitoring \|';                               Cat = 'Script health'; Pri = 2; Meaning = 'The script''s own checks were interrupted or ran less often than planned (sleep, paused window).'; Look = 'Gaps are where nothing was measured.' }
    @{ Rx = 'Set-up \|';                                   Cat = 'Set-up'; Pri = 3; Meaning = 'Something was found and cleaned during set-up.'; Look = 'See the detail line.' }
)

function Get-FindingInfo($f) {
    if ($f.Kind -eq 'RULE') { return [PSCustomObject]@{ Cat = 'League rule'; Pri = 1; Meaning = $global:RuleDefs[$f.Area]; Look = 'This is a measured rule break; compare the time with the video.' } }
    $s = "{0} | {1} | {2}" -f $f.Area, $f.Title, $f.Detail
    foreach ($c in $global:FindingCatalog) { if ($s -match $c.Rx) { return [PSCustomObject]@{ Cat = $c.Cat; Pri = $c.Pri; Meaning = $c.Meaning; Look = $c.Look } } }
    return [PSCustomObject]@{ Cat = $f.Area; Pri = 2; Meaning = 'An observation with no plain-language entry yet.'; Look = 'See the detail line.' }
}

function Get-PriLabel([int]$p) { switch ($p) { 1 { 'REVIEW FIRST' } 2 { 'REVIEW' } default { 'NOTE' } } }

# Findings with their catalog info attached, in reading order.
function Get-ReportItems {
    $items = @()
    foreach ($f in @($global:Findings | Where-Object { $_.Kind -eq 'CHECK' })) {
        $i = Get-FindingInfo $f
        $items += [PSCustomObject]@{ Time = $f.Time; Phase = $f.Phase; Area = $f.Area; Title = $f.Title; Detail = $f.Detail; Cat = $i.Cat; Pri = $i.Pri; Meaning = $i.Meaning; Look = $i.Look }
    }
    return $items
}

# Same title -> one block with several evidence lines.
function Get-ReportBlocks($items) {
    $blocks = @()
    foreach ($g in ($items | Group-Object Title, Pri)) {
        $first = $g.Group | Sort-Object Time | Select-Object -First 1
        $blocks += [PSCustomObject]@{ Pri = $first.Pri; Cat = $first.Cat; Title = $first.Title; Meaning = $first.Meaning; Look = $first.Look; Count = $g.Count; Evidence = @($g.Group | Sort-Object Time) }
    }
    return @($blocks | Sort-Object Pri, Cat, Title)
}

function Write-TextBlock($sb, $b, [string]$indent, [int]$max) {
    [void]$sb.AppendLine(("{0}[{1}] {2}{3}" -f $indent, (Get-PriLabel $b.Pri), $b.Title, $(if ($b.Count -gt 1) { "  (x$($b.Count))" } else { '' })))
    [void]$sb.AppendLine("$indent    What it means : $($b.Meaning)")
    [void]$sb.AppendLine("$indent    Look at       : $($b.Look)")
    $n = 0
    foreach ($e in $b.Evidence) {
        if ($n -ge $max) { break }
        [void]$sb.AppendLine(("{0}    - [{1} {2}] {3}" -f $indent, $e.Time.ToString('HH:mm:ss'), $e.Phase, $e.Detail)); $n++
    }
    if ($b.Count -gt $max) { [void]$sb.AppendLine(("{0}    ... {1} more in 00_ALL_FLAGS.csv" -f $indent, ($b.Count - $max))) }
    [void]$sb.AppendLine('')
}

function Get-RuleResults {
    $rules = @($global:Findings | Where-Object { $_.Kind -eq 'RULE' })
    $out = @()
    foreach ($id in $global:RuleDefs.Keys) {
        $hits = @($rules | Where-Object { $_.Area -eq $id })
        if ($hits.Count -gt 0) { $res = 'FAIL' } elseif ($global:RuleChecked[$id]) { $res = 'PASS' } else { $res = 'NOT CHECKED' }
        $out += [PSCustomObject]@{ Id = $id; Result = $res; Text = $global:RuleDefs[$id]; Hits = @($hits | Sort-Object Time) }
    }
    return $out
}

function Build-FlagsText {
    $sb = New-Object System.Text.StringBuilder
    $line = '====================================================================='
    $items = @(Get-ReportItems); $blocks = @(Get-ReportBlocks $items)
    $c1 = @($items | Where-Object { $_.Pri -eq 1 }).Count; $c2 = @($items | Where-Object { $_.Pri -eq 2 }).Count; $c3 = @($items | Where-Object { $_.Pri -eq 3 }).Count
    $rr = @(Get-RuleResults)
    [void]$sb.AppendLine($line)
    [void]$sb.AppendLine(' RECORDING RULES - FINDINGS REPORT')
    [void]$sb.AppendLine(' Everything below is something the script measured. Nothing is scored.')
    [void]$sb.AppendLine(' "REVIEW FIRST / REVIEW / NOTE" is only a reading order based on the type of')
    [void]$sb.AppendLine(' evidence. It is NOT a verdict and NOT a probability. Staff decide.')
    [void]$sb.AppendLine($line)
    [void]$sb.AppendLine((' Computer / user : {0} / {1}' -f $env:COMPUTERNAME, $env:USERNAME))
    if ($global:RobloxUserId) { [void]$sb.AppendLine((' Roblox profile  : https://www.roblox.com/users/{0}/profile   (id read from the Roblox log; verify it is the right player)' -f $global:RobloxUserId)) }
    [void]$sb.AppendLine((' Tier            : {0}' -f $tier))
    [void]$sb.AppendLine((' Script started  : {0}' -f $global:SessionStart.ToString('yyyy-MM-dd HH:mm:ss')))
    if ($global:MatchStart) { [void]$sb.AppendLine((' Match window    : {0}  to  {1}' -f $global:MatchStart.ToString('yyyy-MM-dd HH:mm:ss'), $(if ($global:MatchEnd) { $global:MatchEnd.ToString('yyyy-MM-dd HH:mm:ss') } else { '(not finished)' }))) }
    if ($global:DisplayLockedAt) { [void]$sb.AppendLine((' Display check   : passed (one display) at {0}' -f $global:DisplayLockedAt.ToString('HH:mm:ss'))) }
    [void]$sb.AppendLine((' Run method      : {0}' -f $global:RunMethod))
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine(' AT A GLANCE')
    [void]$sb.AppendLine(('   League rules : {0} PASS, {1} FAIL, {2} not checked' -f @($rr | Where-Object Result -eq 'PASS').Count, @($rr | Where-Object Result -eq 'FAIL').Count, @($rr | Where-Object Result -eq 'NOT CHECKED').Count))
    [void]$sb.AppendLine(('   Observations : {0} REVIEW FIRST, {1} REVIEW, {2} NOTE' -f $c1, $c2, $c3))
    $warn = @($global:Posture | Where-Object { $_.Status -eq 'WARN' })
    if ($warn.Count -gt 0) { [void]$sb.AppendLine(('   Security posture warnings: ' + (($warn | ForEach-Object { "$($_.Name) = $($_.Value)" }) -join '; '))) }
    foreach ($b in ($blocks | Where-Object { $_.Pri -eq 1 } | Select-Object -First 8)) { [void]$sb.AppendLine(('   * {0}{1}' -f $b.Title, $(if ($b.Count -gt 1) { " (x$($b.Count))" } else { '' }))) }
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine($line); [void]$sb.AppendLine(' 1. LEAGUE RULE CHECKS'); [void]$sb.AppendLine($line)
    foreach ($r in $rr) {
        [void]$sb.AppendLine(('   [{0,-11}] {1}' -f $r.Result, $r.Text))
        foreach ($h in ($r.Hits | Select-Object -First 25)) { [void]$sb.AppendLine(('                   - [{0} {1}] {2}: {3}' -f $h.Time.ToString('HH:mm:ss'), $h.Phase, $h.Title, $h.Detail)) }
        if ($r.Hits.Count -gt 25) { [void]$sb.AppendLine(('                   ... {0} more in 00_ALL_FLAGS.csv' -f ($r.Hits.Count - 25))) }
    }
    [void]$sb.AppendLine('')
    foreach ($pri in 1, 2) {
        [void]$sb.AppendLine($line)
        [void]$sb.AppendLine((' {0}. {1}' -f ($pri + 1), $(if ($pri -eq 1) { 'REVIEW FIRST - direct evidence of tampering, cheat tooling, memory access or changed security settings' } else { 'REVIEW - needs a look at the video or a question to the player' })))
        [void]$sb.AppendLine($line)
        $sel = @($blocks | Where-Object { $_.Pri -eq $pri })
        if ($sel.Count -eq 0) { [void]$sb.AppendLine('   (none)'); [void]$sb.AppendLine('') }
        $lastCat = ''
        foreach ($b in $sel) {
            if ($b.Cat -ne $lastCat) { [void]$sb.AppendLine(("  --- {0} ---" -f $b.Cat)); $lastCat = $b.Cat }
            Write-TextBlock $sb $b '   ' 8
        }
    }
    [void]$sb.AppendLine($line); [void]$sb.AppendLine(' 4. NOTES - usually harmless, listed so nothing is hidden'); [void]$sb.AppendLine($line)
    $nb = @($blocks | Where-Object { $_.Pri -eq 3 })
    if ($nb.Count -eq 0) { [void]$sb.AppendLine('   (none)') }
    foreach ($b in $nb) { Write-TextBlock $sb $b '   ' 3 }
    [void]$sb.AppendLine($line); [void]$sb.AppendLine(' 5. SECURITY POSTURE (state of the PC protections)'); [void]$sb.AppendLine($line)
    $post = @($global:Posture)
    if ($post.Count -eq 0) { foreach ($l in (Get-SystemStateLines)) { [void]$sb.AppendLine("   $l") } }
    foreach ($p in $post) { [void]$sb.AppendLine(('   [{0,-4}] {1,-38} {2}{3}' -f $p.Status, $p.Name, $p.Value, $(if ($p.Note) { "   ($($p.Note))" } else { '' }))) }
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine($line); [void]$sb.AppendLine(' 6. WHAT WAS AND WAS NOT MEASURED'); [void]$sb.AppendLine($line)
    if ($global:GuardStats) {
        [void]$sb.AppendLine(("   - Display and virtual-desktop checks: {0} checks, longest gap between two checks {1} s." -f $global:GuardStats.Checks, $global:GuardStats.MaxGap))
        [void]$sb.AppendLine(("   - Proxy lock re-applied {0} time(s)." -f $global:GuardStats.ProxyFix))
    }
    [void]$sb.AppendLine(("   - Process-creation auditing (Security event 4688): {0}." -f $global:ProcAuditInfo))
    [void]$sb.AppendLine(("   - Native helpers (protected-process paths, monitor paths, Roblox memory): {0}; forensic helpers (handles, hidden code, overlays, injected mouse): {1}." -f $(if ($global:NativeOk) { 'available' } else { 'NOT available; slower methods used' }), $(if ($global:ForensicNativeOk) { 'available' } else { 'NOT available' })))
