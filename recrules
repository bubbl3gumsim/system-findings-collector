            }
        }
    }
    if ($bad.Count -gt 0) { FCheck 'Roblox files' 'Roblox program files with no valid Roblox/Microsoft signature' ("{0} of {1} file(s): {2}" -f $bad.Count, $n, (($bad | Select-Object -First 15) -join ' ;; ')) }
    FNote ("Roblox install check: {0} program file(s) signature-checked." -f $n)
}


# ---------- staff-supplied known-bad file hashes (empty unless staff add some) ----------
function FScanKnownHashes {
    $kb = $global:FCtx.KnownBadHashes
    if (-not $kb -or $kb.Count -eq 0) { FNote 'Known-hash check: no hashes were supplied by staff, so nothing was compared.'; return }
    $files = @{}
    foreach ($r in @("$env:USERPROFILE\Downloads", "$env:USERPROFILE\Desktop", "$env:USERPROFILE\Documents", "$env:LOCALAPPDATA\Temp", 'C:\Users\Public')) {
        if (-not (Test-Path $r)) { continue }
        foreach ($f in @(Get-ChildItem $r -Recurse -Depth 3 -File -Include *.exe, *.dll, *.sys, *.scr, *.zip, *.rar, *.7z -ErrorAction SilentlyContinue | Where-Object { $_.Length -lt 150MB } | Sort-Object LastWriteTime -Descending | Select-Object -First 300)) { $files[$f.FullName.ToLower()] = $f.FullName }
    }
    try { foreach ($p in @(Get-CimInstance Win32_Process -ErrorAction Stop)) { if ($p.ExecutablePath -and $p.ExecutablePath -notmatch '(?i)^[A-Za-z]:\\Windows\\') { $files[$p.ExecutablePath.ToLower()] = $p.ExecutablePath } } } catch {}
    $n = 0
    foreach ($f in $files.Values) {
        $n++
        $h = $null; try { $h = (Get-FileHash -LiteralPath $f -Algorithm SHA256 -ErrorAction Stop).Hash.ToUpper() } catch { continue }
        if ($kb.ContainsKey($h)) { FCheck 'Software' 'A file matches a staff-supplied known-cheat SHA-256 hash' ("{0}; sha256 {1}; staff label: {2}" -f $f, $h, $kb[$h]) }
    }
    FNote ("Known-hash check: {0} file(s) hashed against {1} staff-supplied hash(es)." -f $n, $kb.Count)
}

# ---------- Malwarebytes detections (best effort: the JSON layout is not documented, so raw files are also copied into the package) ----------
function FScanMalwarebytes {
    $dir = "$env:ProgramData\Malwarebytes\MBAMService\ScanResults"
    if (-not (Test-Path $dir)) { FNote 'Malwarebytes scan results folder not found; nothing read.'; return }
    $since = (Get-Date).AddDays(-30); $nf = 0; $hits = 0
    foreach ($f in @(Get-ChildItem $dir -File -Filter *.json -ErrorAction SilentlyContinue | Where-Object { $_.LastWriteTime -ge $since } | Sort-Object LastWriteTime -Descending | Select-Object -First 15)) {
        $nf++
