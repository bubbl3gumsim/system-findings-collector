function Write-BoxLine($text, $color, $width = 66) {
    $pad = $width - $text.Length
    $left = [math]::Floor($pad / 2)
    $right = $pad - $left
    Write-Host ("  |" + (" " * $left) + $text + (" " * $right) + "|") -ForegroundColor $color
}

