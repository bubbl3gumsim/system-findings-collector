function Section($title) {
    Write-Host ""
    Write-Host ("=" * 70) -ForegroundColor $theme.Border
    Write-Host " $title" -ForegroundColor $theme.Header
    Write-Host ("=" * 70) -ForegroundColor $theme.Border
}

function Pause-ForCamera($msg, $prompt = "Press Enter once this is shown on your recording") {
    Write-Host $msg -ForegroundColor $theme.Accent
    Read-Host $prompt
    Show-DisplayAlertIfAny
}

function Confirm-MultiStep($items) {
    foreach ($i in $items) { Write-Host "  - $i" -ForegroundColor $theme.Accent }
    Read-Host "Press Enter once ALL of the above are shown on your recording"
    Show-DisplayAlertIfAny
}

function Find-Exe($names, $searchDirs) {
    foreach ($dir in $searchDirs) {
        if (-not $dir -or -not (Test-Path $dir)) { continue }
        foreach ($n in $names) {
            $hit = Get-ChildItem -Path $dir -Filter $n -Recurse -ErrorAction SilentlyContinue -File | Select-Object -First 1
            if ($hit) { return $hit.FullName }
        }
    }
    return $null
}

function Get-SizeMB($path) {
    try {
        if ($path -and (Test-Path -LiteralPath $path)) {
            return [math]::Round((Get-Item -LiteralPath $path -ErrorAction Stop).Length / 1MB, 3)
        }
    } catch {}
    return $null
}

function Write-Typewriter($text, $color, $delayMs = 6) {
    foreach ($ch in $text.ToCharArray()) {
        Write-Host -NoNewline $ch -ForegroundColor $color
        Start-Sleep -Milliseconds $delayMs
    }
    Write-Host ""
}

function Show-LoadingBar($label, $color, $steps = 24, $delayMs = 20) {
    Write-Host -NoNewline "$label " -ForegroundColor $color
    Write-Host -NoNewline "[" -ForegroundColor DarkGray
    for ($i = 0; $i -lt $steps; $i++) {
        Start-Sleep -Milliseconds $delayMs
        Write-Host -NoNewline "#" -ForegroundColor $color
    }
    Write-Host "] READY" -ForegroundColor $color
}

# =========================================================================
# SESSION CLEAN-UP: remove anything the player's PowerShell window defined
# earlier that could replace a command this script relies on (user aliases
# and functions win over real commands). Removed items are reported later.
# =========================================================================
$global:ShadowRemoved = [System.Collections.ArrayList]::new()
$global:NativePreexisting = $false
try {
    foreach ($a in @(Microsoft.PowerShell.Utility\Get-Alias -ErrorAction SilentlyContinue)) {
        if (-not $a.ModuleName -and -not $a.Source) {
            [void]$global:ShadowRemoved.Add("alias $($a.Name) -> $($a.Definition)")
            Microsoft.PowerShell.Management\Remove-Item -LiteralPath "Alias:\$($a.Name)" -Force -ErrorAction SilentlyContinue
        }
    }
    foreach ($n in @('Get-CimInstance','Get-Process','Get-PnpDevice','Get-PnpDeviceProperty','Get-WinEvent','Get-NetTCPConnection','Get-AuthenticodeSignature','Get-ItemProperty','Get-FileHash','Get-ChildItem','Get-ScheduledTask','Get-Date','Start-Sleep','Stop-Process','Get-Service','Get-Content','Test-Path','Get-DnsClientCache','Get-MpPreference','Get-Item','Get-Event','Remove-Event','Register-ObjectEvent','Export-Csv','Set-Content','Out-String','Select-Object','Where-Object','ForEach-Object','Sort-Object','Group-Object','Write-Host','Read-Host','Get-NetAdapter','Add-Type','Get-Command','Get-Alias')) {
        foreach ($c in @(Microsoft.PowerShell.Core\Get-Command -Name $n -CommandType Function -All -ErrorAction SilentlyContinue)) {
            if (-not $c.ModuleName) {
                [void]$global:ShadowRemoved.Add("function $($c.Name)")
                Microsoft.PowerShell.Management\Remove-Item -LiteralPath "Function:\$($c.Name)" -Force -ErrorAction SilentlyContinue
            }
        }
    }
} catch {}

# =========================================================================
# NATIVE HELPERS (compiled once). If this fails the script falls back to
# slower PowerShell/WMI methods and says so in the coverage notes.
#   ImagePath     : full path of ANY process, including protected ones
#                   (Get-Process.Path and Win32_Process.ExecutablePath
#                   return nothing for those)
#   DisplayPaths  : the monitors Windows is actually driving right now
#                   (cloned/mirrored monitors count separately)
#   Scan          : private executable memory regions of a process
# =========================================================================
$global:NativeOk = $false
try {
    Add-Type -TypeDefinition @'
using System;
using System.Text;
using System.Runtime.InteropServices;
public static class RecNative {
    [StructLayout(LayoutKind.Sequential)]
    public struct MBI { public IntPtr BaseAddress; public IntPtr AllocationBase; public uint AllocationProtect; public ushort PartitionId; public IntPtr RegionSize; public uint State; public uint Protect; public uint Type; }
    [DllImport("kernel32.dll", SetLastError=true)] static extern IntPtr OpenProcess(uint access, bool inherit, int pid);
    [DllImport("kernel32.dll", SetLastError=true)] static extern bool CloseHandle(IntPtr h);
    [DllImport("kernel32.dll", SetLastError=true)] static extern UIntPtr VirtualQueryEx(IntPtr h, IntPtr addr, out MBI mbi, UIntPtr len);
    [DllImport("kernel32.dll", SetLastError=true, CharSet=CharSet.Unicode)] static extern bool QueryFullProcessImageName(IntPtr h, uint flags, StringBuilder sb, ref uint size);
    [DllImport("user32.dll")] static extern int GetDisplayConfigBufferSizes(uint flags, out uint numPaths, out uint numModes);
    [DllImport("user32.dll")] static extern int QueryDisplayConfig(uint flags, ref uint numPaths, IntPtr paths, ref uint numModes, IntPtr modes, IntPtr topologyId);

    public static string ImagePath(int pid) {
        IntPtr h = OpenProcess(0x1000, false, pid);
        if (h == IntPtr.Zero) return null;
        try {
            StringBuilder sb = new StringBuilder(2048);
            uint size = 2048;
            if (QueryFullProcessImageName(h, 0, sb, ref size)) return sb.ToString();
            return null;
        } finally { CloseHandle(h); }
    }

    public static int[] DisplayPaths() {
        uint np; uint nm;
        if (GetDisplayConfigBufferSizes(2, out np, out nm) != 0) return null;
        if (np == 0) return new int[0];
        IntPtr paths = Marshal.AllocHGlobal((int)np * 128);
        IntPtr modes = Marshal.AllocHGlobal((int)(nm == 0 ? 1 : nm) * 128);
        try {
            if (QueryDisplayConfig(2, ref np, paths, ref nm, modes, IntPtr.Zero) != 0) return null;
            int[] tech = new int[np];
            for (int i = 0; i < np; i++) { tech[i] = Marshal.ReadInt32(paths, i * 72 + 36); }
            return tech;
        } finally { Marshal.FreeHGlobal(paths); Marshal.FreeHGlobal(modes); }
    }

    public static string Scan(int pid) {
        IntPtr h = OpenProcess(0x0400 | 0x0010, false, pid);
        if (h == IntPtr.Zero) return "BLOCKED:" + Marshal.GetLastWin32Error();
        long addr = 0; int rwx = 0; int rx = 0; long rwxBytes = 0;
        MBI mbi = new MBI();
        UIntPtr sz = (UIntPtr)Marshal.SizeOf(typeof(MBI));
        while (addr < 0x7FFFFFFEFFFFL) {
            UIntPtr r = VirtualQueryEx(h, (IntPtr)addr, out mbi, sz);
            if (r == UIntPtr.Zero) break;
            long size = mbi.RegionSize.ToInt64();
            if (mbi.State == 0x1000 && mbi.Type == 0x20000) {
                if (mbi.Protect == 0x40) { rwx++; rwxBytes += size; }
                else if (mbi.Protect == 0x20) { rx++; }
            }
            long next = addr + size;
            if (next <= addr) break;
            addr = next;
        }
        CloseHandle(h);
        return "OK:" + rwx + ":" + rwxBytes + ":" + rx;
    }
}
'@ -ErrorAction Stop
    $global:NativeOk = $true
} catch {
    $global:NativeOk = $false
    # A type with this name that this script did not compile could return fake answers; it is never used.
    if ('RecNative' -as [type]) { $global:NativePreexisting = $true }
}

function Get-ImagePathById([int]$procId) {
    if (-not $global:NativeOk -or $procId -le 0) { return $null }
    try { return [RecNative]::ImagePath($procId) } catch { return $null }
}

