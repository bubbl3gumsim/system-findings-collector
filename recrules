function FRot13([string]$s) {
    $sb = New-Object System.Text.StringBuilder
    foreach ($c in $s.ToCharArray()) {
        $n = [int]$c
        if ($n -ge 97 -and $n -le 122) { [void]$sb.Append([char]((($n - 97 + 13) % 26) + 97)) }
        elseif ($n -ge 65 -and $n -le 90) { [void]$sb.Append([char]((($n - 65 + 13) % 26) + 65)) }
        else { [void]$sb.Append($c) }
    }
    return $sb.ToString()
}

function FFileTime([byte[]]$b, [int]$off) {
    try {
        if ($null -eq $b -or $b.Length -lt ($off + 8)) { return $null }
        $ft = [BitConverter]::ToInt64($b, $off)
        if ($ft -le 0 -or $ft -gt 2650467743999999999) { return $null }
        return [datetime]::FromFileTime($ft)
    } catch { return $null }
}

function FDosPath([string]$p, $map) {
    if (-not $p) { return $p }
    if ($p -match '^\\Device\\HarddiskVolume\d+\\') {
        foreach ($m in @($map)) {
            $parts = ([string]$m).Split('|')
            if ($parts.Count -lt 2) { continue }
            if ($p.StartsWith($parts[1] + '\', [StringComparison]::OrdinalIgnoreCase)) { return $parts[0] + $p.Substring($parts[1].Length) }
        }
    }
    return $p
}

function FUaPath([string]$n) {
    if ($n -match '^(\{[0-9A-Fa-f-]{36}\})\\(.*)$') {
