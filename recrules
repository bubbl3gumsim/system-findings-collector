        $g = $groups[$k]
        if ($g.Sources -notcontains $r.Source) { $g.Sources += $r.Source }
        if ($r.Time -and (-not $g.Latest -or $r.Time -gt $g.Latest)) { $g.Latest = $r.Time }
        if ($r.Detail -and $g.Details.Count -lt 3) { $g.Details += $r.Detail }
    }
    $rows = @(); $gone = @(); $unsigned = @(); $userRecent = @(); $sigChecks = 0; $hashes = 0
    foreach ($g in $groups.Values) {
        $p = $g.Path; $base = FBase $p
        $exists = FExists $p
        $isUser = ($p -match $global:FUserRx)
        $recent = ($g.Latest -and $g.Latest -ge $cut)
        $ranSource = (@($g.Sources) -contains 'BAM' -or @($g.Sources) -contains 'UserAssist')
        $when = $g.Latest
        $src = ($g.Sources -join ', ')
        $tm = ''
        if ($base -match $strong) { $tm = 'strong' } elseif ($base -match $weak -and ($isUser -or -not $exists)) { $tm = 'weak' }
        $sig = $null
        if ($exists -and ($isUser -or $tm) -and $sigChecks -lt 150 -and $p -match '(?i)\.(exe|dll|sys|scr)$') { $sig = FSig $p; $sigChecks++ }
        $sigTxt = if ($sig) { $sig.Status } elseif ($exists) { 'not checked' } else { 'n/a (file missing)' }
        $rows += [PSCustomObject]@{ Path = $p; Sources = $src; LatestTime = $when; ExistsNow = $exists; UserFolder = $isUser; Signature = $sigTxt; Detail = ($g.Details -join '; ') }
        $facts = "{0} | seen in {1} | {2} | file exists now: {3}" -f $p, $src, $(if ($when) { 'time ' + $when.ToString('yyyy-MM-dd HH:mm:ss') } else { 'no time recorded' }), $(if ($exists) { 'yes' } else { 'no' })
        if ($tm -eq 'strong') { FCheck 'Software' 'Execution history names a program on the cheat/injector/debugger tool-name list' $facts $when }
        elseif ($tm -eq 'weak') { FCheck 'Software' 'Execution history names a program matching a common cheat-tool word (file is missing or in a user folder)' $facts $when }
        if ($ranSource -and -not $exists -and $isUser -and -not (FIsInstallerNoise $p) -and ($recent -or -not $when) -and $p -match '(?i)\.(exe|bat|cmd|ps1|vbs|scr|jar)$') { $gone += [PSCustomObject]@{ Time = $when; Text = $facts } }
        if ($exists -and $isUser -and $recent -and $p -match '(?i)\.(exe|scr)$' -and -not (FIsInstallerNoise $p)) {
            $userRecent += [PSCustomObject]@{ Time = $when; Text = $facts + ' | signature: ' + $sigTxt }
            if ($sig -and ($sig.Status -ne 'Valid' -or $sig.Self)) { $unsigned += [PSCustomObject]@{ Time = $when; Path = $p; Sig = $sig; Facts = $facts } }
        }
    }
    foreach ($u in @($unsigned | Sort-Object Time -Descending | Select-Object -First 15)) {
        $sha = if ($hashes -lt 15) { $hashes++; FSha $u.Path } else { 'not hashed' }
        FCheck 'Software' 'A program recently run from a user folder has no valid signature' ("{0} | signature {1}{2} | sha256 {3}" -f $u.Facts, $u.Sig.Status, $(if ($u.Sig.Self) { ' (self-signed certificate)' } else { '' }), $sha) $u.Time
    }
    if ($gone.Count -gt 0) {
        $top = @($gone | Sort-Object Time -Descending | Select-Object -First 20)
        FCheck 'Software' 'Programs recorded as run from a user folder no longer exist on disk' ("{0} program(s). Newest: {1}" -f $gone.Count, (($top | ForEach-Object { $_.Text }) -join ' ;; ')) $top[0].Time
    }
    if ($userRecent.Count -gt 0) {
        $top = @($userRecent | Sort-Object Time -Descending | Select-Object -First 20)
        FAdd 'CHECK' 'Software' 'Programs recently run from Downloads/Desktop/Documents/Temp (execution history)' ("{0} program(s). Newest: {1}" -f $userRecent.Count, (($top | ForEach-Object { $_.Text }) -join ' ;; ')) $top[0].Time
    }
    FAdd 'DATA' '30_execution_history' '' '' $null $rows
    return $rows.Count
}

function FScanExecHistory {
    $map = @(); try { $map = @([RecForensic]::DeviceMap()) } catch {}
    $all = @()
    foreach ($s in @('FReadBam', 'FReadUserAssist', 'FReadShim', 'FReadMui', 'FReadJumpLists')) {
        try {
            if ($s -eq 'FReadBam') { $r = @(FReadBam $map) } else { $r = @(& $s) }
            $all += $r
            FNote ("Execution history source {0}: {1} record(s) read." -f $s.Substring(5), $r.Count)
        } catch { FNote ("Execution history source {0} failed: {1}" -f $s.Substring(5), $_.Exception.Message) }
    }
    $ss = $global:FCtx.SessionStart
    foreach ($r in @($all | Where-Object { $_.Source -in @('BAM', 'UserAssist') -and $_.Time -and $ss -and $_.Time -ge $ss })) { FTl 'EXEC HISTORY' ("{0} records a run of {1} ({2})" -f $r.Source, $r.Path, $r.Detail) $r.Time }
    FNote 'ShimCache is only written to the registry at shutdown/restart, so it lacks the newest programs; BAM keeps about 7 days; UserAssist keeps run counts only for programs started from the shell.'
    [void](FAnalyzeExec $all 14)
}

# ---------- Windows Defender ----------
function FParseDefenderMsg([string]$msg) {
    $n = ''; $p = ''; $sev = ''
    if ($msg -match '(?m)^\s*Name:\s*(.+?)\s*$') { $n = $matches[1] }
    if ($msg -match '(?m)^\s*Path:\s*(.+?)\s*$') { $p = $matches[1] -replace '^(file|containerfile|webfile):_?', '' }
    if ($msg -match '(?m)^\s*Severity:\s*(.+?)\s*$') { $sev = $matches[1] }
    return [PSCustomObject]@{ Name = $n; Path = $p; Severity = $sev }
}

function FScanDefender {
    $mp = $null; try { $mp = Get-MpPreference -ErrorAction Stop } catch {}
    $reg = @{}
    foreach ($sub in @('Paths', 'Processes', 'Extensions', 'IpAddresses')) {
        foreach ($root in @('HKLM:\SOFTWARE\Microsoft\Windows Defender\Exclusions', 'HKLM:\SOFTWARE\Policies\Microsoft\Windows Defender\Exclusions')) {
            $k = "$root\$sub"
            if (Test-Path $k) { $pr = Get-ItemProperty -Path $k -ErrorAction SilentlyContinue; if ($pr) { foreach ($p in $pr.PSObject.Properties) { if ($p.Name -notlike 'PS*') { $reg["$sub|$($p.Name)"] = $true } } } }
        }
    }
    $api = @{}
    if ($mp) {
        foreach ($x in @($mp.ExclusionPath)) { if ($x) { $api["Paths|$x"] = $true } }
        foreach ($x in @($mp.ExclusionProcess)) { if ($x) { $api["Processes|$x"] = $true } }
        foreach ($x in @($mp.ExclusionExtension)) { if ($x) { $api["Extensions|$x"] = $true } }
    }
    foreach ($k in $reg.Keys) {
        if (-not $api.ContainsKey($k)) { $pp = $k.Split('|', 2); FCheck 'Windows Defender' 'A Defender exclusion exists in the registry that Get-MpPreference did not list' ("{0}: {1}" -f $pp[0], $pp[1]) }
    }
    if ($mp) {
        foreach ($a in @($mp.ControlledFolderAccessAllowedApplications)) { if ($a) { FCheck 'Windows Defender' 'Controlled Folder Access has an allowed application' ([string]$a) } }
        if ($mp.EnableControlledFolderAccess -in 1, 2) { FTl 'DEFENDER' "Controlled Folder Access is on (mode $($mp.EnableControlledFolderAccess))" }
        foreach ($asr in @($mp.AttackSurfaceReductionRules_Actions)) { }
    }
    $since = (Get-Date).AddDays(-30)
    try {
        foreach ($e in @(Get-WinEvent -FilterHashtable @{ LogName = 'Microsoft-Windows-Windows Defender/Operational'; Id = 1116, 1117, 1118, 1119, 1009, 1123, 1124; StartTime = $since } -MaxEvents 80 -ErrorAction Stop)) {
            $m = FParseDefenderMsg ([string]$e.Message)
            $d = "{0}; {1}{2}" -f $(if ($m.Name) { $m.Name } else { '(name not parsed)' }), $(if ($m.Path) { $m.Path } else { '(path not parsed)' }), $(if ($m.Severity) { '; severity ' + $m.Severity } else { '' })
            switch ($e.Id) {
                1116 { FCheck 'Windows Defender' 'Windows Defender detected a threat (event 1116)' $d $e.TimeCreated }
                1117 { FCheck 'Windows Defender' 'Windows Defender took action on a threat (event 1117)' $d $e.TimeCreated }
                1118 { FCheck 'Windows Defender' 'Windows Defender action on a threat is in progress or failed (event 1118/1119)' $d $e.TimeCreated }
                1119 { FCheck 'Windows Defender' 'Windows Defender action on a threat is in progress or failed (event 1118/1119)' $d $e.TimeCreated }
                1009 { FCheck 'Windows Defender' 'A quarantined threat was restored (event 1009)' $d $e.TimeCreated }
                default { FCheck 'Windows Defender' "Controlled Folder Access blocked or audited a program (event $($e.Id))" $d $e.TimeCreated }
            }
        }
    } catch { }
    try {
        foreach ($t in @(Get-MpThreatDetection -ErrorAction Stop | Where-Object { $_.InitialDetectionTime -ge $since })) {
            FCheck 'Windows Defender' 'Windows Defender threat-detection history entry' ("{0}; {1}; process {2}" -f $t.ThreatID, (@($t.Resources) -join ' | '), $t.ProcessName) $t.InitialDetectionTime
        }
    } catch { }
}

# ---------- security posture (also used for the report table) ----------
function FPosture {
    $rows = @()
    function PR($n, $v, $s, $note) { $script:__r += [PSCustomObject]@{ Name = $n; Value = $v; Status = $s; Note = $note } }
    $script:__r = @()
    try { if (Confirm-SecureBootUEFI -ErrorAction Stop) { PR 'Secure Boot' 'ON' 'OK' '' } else { PR 'Secure Boot' 'OFF' 'WARN' 'Unsigned boot components could load' } } catch { PR 'Secure Boot' 'not available' 'INFO' 'Legacy BIOS, or the state could not be read' }
    $dg = $null; try { $dg = Get-CimInstance -ClassName Win32_DeviceGuard -Namespace root\Microsoft\Windows\DeviceGuard -ErrorAction Stop } catch {}
    if ($dg) {
        $vbs = [int]$dg.VirtualizationBasedSecurityStatus
        PR 'Virtualization-based security (VBS)' $(switch ($vbs) { 2 { 'running' } 1 { 'enabled, not running' } default { 'off' } }) $(if ($vbs -eq 2) { 'OK' } else { 'WARN' }) ''
        $sr = @($dg.SecurityServicesRunning)
        PR 'Memory Integrity (HVCI)' $(if ($sr -contains 2) { 'running' } else { 'not running' }) $(if ($sr -contains 2) { 'OK' } else { 'WARN' }) 'League rule'
        PR 'Credential Guard' $(if ($sr -contains 1) { 'running' } else { 'not running' }) 'INFO' ''
        $av = @($dg.AvailableSecurityProperties)
        PR 'Kernel DMA protection' $(if ($av -contains 3) { 'available' } else { 'not reported by Windows' }) $(if ($av -contains 3) { 'OK' } else { 'INFO' }) 'Blocks many external DMA attacks'
    } else { PR 'VBS / Memory Integrity / DMA protection' 'state unavailable' 'INFO' 'Device Guard class could not be read' }
    try { $bl = (Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\CI\Config' -Name VulnerableDriverBlocklistEnable -ErrorAction Stop).VulnerableDriverBlocklistEnable; PR 'Vulnerable-driver blocklist' $(if ($bl -eq 0) { 'switched OFF' } else { 'on' }) $(if ($bl -eq 0) { 'WARN' } else { 'OK' }) 'League rule' } catch { PR 'Vulnerable-driver blocklist' 'Windows default (on)' 'OK' '' }
    try {
        $bcd = (& bcdedit /enum '{current}' 2>&1 | Out-String)
        $odd = @(); if ($bcd -match '(?i)testsigning\s+Yes') { $odd += 'testsigning' }; if ($bcd -match '(?i)nointegritychecks\s+Yes') { $odd += 'nointegritychecks' }; if ($bcd -match '(?im)^\s*debug\s+Yes') { $odd += 'debug' }
        PR 'Boot options (test signing / debug)' $(if ($odd.Count) { $odd -join ', ' } else { 'default' }) $(if ($odd.Count) { 'WARN' } else { 'OK' }) ''
    } catch {}
    try { $st = Get-MpComputerStatus -ErrorAction Stop; PR 'Defender real-time protection' $(if ($st.RealTimeProtectionEnabled) { 'on' } else { 'OFF' }) $(if ($st.RealTimeProtectionEnabled) { 'OK' } else { 'WARN' }) ''; PR 'Defender tamper protection' $(if ($st.IsTamperProtected) { 'on' } else { 'off' }) 'INFO' ''; PR 'Defender signatures' ([string]$st.AntivirusSignatureLastUpdated) 'INFO' '' } catch { PR 'Defender status' 'could not be read' 'INFO' 'Another antivirus may be the active product' }
    try { $pol = Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction Stop; PR 'UAC' ("EnableLUA={0}; ConsentPromptBehaviorAdmin={1}; PromptOnSecureDesktop={2}" -f $pol.EnableLUA, $pol.ConsentPromptBehaviorAdmin, $pol.PromptOnSecureDesktop) 'INFO' 'League step uses the second-lowest slider position' } catch {}
    try { $cs = Get-CimInstance Win32_ComputerSystem -ErrorAction Stop; PR 'Hypervisor present' ([string]$cs.HypervisorPresent) 'INFO' 'True is normal when VBS is on' } catch {}
    $r = $script:__r; $script:__r = @()
    return $r
}
function FScanPosture {
    $rows = @(FPosture)
    foreach ($r in $rows) { FAdd 'POSTURE' $r.Name $r.Value $r.Note $null $r.Status }
    foreach ($r in @($rows | Where-Object { $_.Status -eq 'WARN' -and $_.Name -match 'Secure Boot|VBS|Virtualization|Boot options|real-time' })) {
        FCheck 'Boot security' ("{0}: {1}" -f $r.Name, $r.Value) $r.Note
    }
}

# ---------- drivers, boot, certificates ----------
function FDriverBase([string]$s) { $b = FBase $s; return $b.ToLower() }

function FScanDrivers {
    $names = @{}
    $svcRoot = 'HKLM:\SYSTEM\CurrentControlSet\Services'
    $n = 0
    foreach ($k in @(Get-ChildItem $svcRoot -ErrorAction SilentlyContinue)) {
        $p = Get-ItemProperty -Path $k.PSPath -ErrorAction SilentlyContinue
        if (-not $p -or $p.Type -ne 1) { continue }
        $n++
        $img = [string]$p.ImagePath
        $svc = ($k.Name -split '\\')[-1]
        $leaf = FDriverBase $img; if (-not $leaf) { $leaf = $svc.ToLower() }
        $win = $img -replace '^\\\?\?\\', '' -replace '^\\SystemRoot\\', "$env:WINDIR\" -replace '^(?i)system32\\', "$env:WINDIR\system32\"
        if ($global:FVulnDrivers -contains $leaf -or $global:FVulnDrivers -contains $svc.ToLower()) {
            $ex = if ($win -and (FExists $win)) { 'file exists' } else { 'file not on disk now' }
            FCheck 'Drivers' 'A kernel driver service matches the vulnerable/abused-driver name list' ("service {0}; image {1}; start type {2}; {3}. (Some are also used by legitimate hardware tools.)" -f $svc, $img, $p.Start, $ex)
        }
        if ($win -match '^[A-Za-z]:\\' -and $win -notmatch '(?i)^[A-Za-z]:\\Windows\\' ) {
            $inUser = ($win -match $global:FUserRx)
            if ($inUser -or $win -notmatch '(?i)\\(Program Files|Program Files \(x86\)|ProgramData)\\') {
                FCheck 'Drivers' 'A kernel driver service points to a file outside the Windows and Program Files folders' ("service {0}; image {1}; start type {2}; file exists: {3}" -f $svc, $img, $p.Start, $(if (FExists $win) { 'yes' } else { 'no' }))
            }
        }
    }
    FNote "Driver services read from the registry: $n kernel-driver entries."
    $since = (Get-Date).AddDays(-14)
    try {
        foreach ($e in @(Get-WinEvent -FilterHashtable @{ LogName = 'System'; ProviderName = 'Service Control Manager'; Id = 7045; StartTime = $since } -MaxEvents 80 -ErrorAction Stop)) {
            $d = @(); try { $d = @($e.Properties | ForEach-Object { [string]$_.Value }) } catch {}
            if ($d.Count -ge 3 -and ($d[2] -match '(?i)kernel' -or $d[1] -match '(?i)\.sys')) { FCheck 'Drivers' 'A kernel driver service was installed in the last 14 days (System event 7045)' ("name {0}; image {1}; type {2}; start {3}" -f $d[0], $d[1], $d[2], $d[3]) $e.TimeCreated }
        }
    } catch {}
    try {
        foreach ($e in @(Get-WinEvent -FilterHashtable @{ LogName = 'Microsoft-Windows-CodeIntegrity/Operational'; Id = 3033, 3034, 3076, 3077; StartTime = $since } -MaxEvents 40 -ErrorAction Stop)) {
            $m = (([string]$e.Message) -split "`r?`n")[0]; if ($m.Length -gt 240) { $m = $m.Substring(0, 240) }
            FCheck 'Drivers' ("Code Integrity blocked, or would block, a file from loading (event $($e.Id))") $m $e.TimeCreated
        }
    } catch {}
    try {
        $drv = @(Get-CimInstance Win32_SystemDriver -ErrorAction Stop | Where-Object { $_.State -eq 'Running' })
        $c = 0
        foreach ($d in $drv) {
            $p = [string]$d.PathName; $p = $p -replace '^\\\?\?\\', '' -replace '^\\SystemRoot\\', "$env:WINDIR\"
            if ($p -match '^(?i)system32\\') { $p = "$env:WINDIR\$p" }
            if ($p -notmatch '^[A-Za-z]:\\' -or $c -ge 250) { continue }
            $c++
            $s = FSig $p
            if ($s.Self) { FCheck 'Drivers' 'A loaded driver is signed with a self-signed certificate' ("{0} {1}; signer {2}; thumbprint {3}; status {4}" -f $d.Name, $p, $s.Cn, $s.Thumb, $s.Status) }
        }
    } catch {}
}

function FScanCerts {
    $cut = (Get-Date).AddDays(-120)
    foreach ($spec in @(@('Cert:\LocalMachine\Root', 'Machine root'), @('Cert:\CurrentUser\Root', 'User root'))) {
        try {
            foreach ($c in @(Get-ChildItem $spec[0] -ErrorAction Stop)) {
                $self = ($c.Subject -eq $c.Issuer)
                if ($c.Subject -match $global:FTestCertRx -or ($self -and $c.NotBefore -gt $cut)) {
                    FCheck 'Certificates' ("A {0} certificate looks self-made or was created in the last 120 days" -f $spec[1]) ("{0}; valid from {1} to {2}; thumbprint {3}" -f $c.Subject, $c.NotBefore.ToString('yyyy-MM-dd'), $c.NotAfter.ToString('yyyy-MM-dd'), $c.Thumbprint)
                }
            }
        } catch {}
    }
    foreach ($spec in @(@('Cert:\LocalMachine\TrustedPublisher', 'Machine'), @('Cert:\CurrentUser\TrustedPublisher', 'User'))) {
        try {
            foreach ($c in @(Get-ChildItem $spec[0] -ErrorAction Stop)) {
                if ($c.Subject -eq $c.Issuer -or $c.Subject -match $global:FTestCertRx) {
                    FCheck 'Certificates' ("A self-signed certificate is in the {0} Trusted Publishers store" -f $spec[1]) ("{0}; valid from {1}; thumbprint {2}" -f $c.Subject, $c.NotBefore.ToString('yyyy-MM-dd'), $c.Thumbprint)
                }
            }
        } catch {}
    }
}

function FScanPersistence {
    $ifeo = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options'
    foreach ($k in @(Get-ChildItem $ifeo -ErrorAction SilentlyContinue)) {
        $p = Get-ItemProperty -Path $k.PSPath -ErrorAction SilentlyContinue
        if ($p -and $p.Debugger) { FCheck 'Startup' 'An Image File Execution Options debugger is set (it replaces what starts)' ("{0} -> {1}" -f ($k.Name -split '\\')[-1], $p.Debugger) }
    }
    foreach ($w in @('HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Windows', 'HKLM:\SOFTWARE\Wow6432Node\Microsoft\Windows NT\CurrentVersion\Windows')) {
        $p = Get-ItemProperty -Path $w -ErrorAction SilentlyContinue
        if ($p -and $p.AppInit_DLLs -and ([string]$p.AppInit_DLLs).Trim() -and $p.LoadAppInit_DLLs -eq 1) { FCheck 'Startup' 'AppInit_DLLs is enabled and lists a DLL (it is loaded into programs)' ([string]$p.AppInit_DLLs) }
    }
    $wl = Get-ItemProperty -Path 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon' -ErrorAction SilentlyContinue
    if ($wl) {
        if ($wl.Shell -and ([string]$wl.Shell).Trim() -ne 'explorer.exe') { FCheck 'Startup' 'The Windows logon shell is not the default' ([string]$wl.Shell) }
        if ($wl.Userinit -and ([string]$wl.Userinit).Trim().TrimEnd(',') -notmatch '(?i)^[A-Za-z]:\\Windows\\system32\\userinit\.exe$') { FCheck 'Startup' 'The Windows logon Userinit value is not the default' ([string]$wl.Userinit) }
    }
    $sm = Get-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager' -ErrorAction SilentlyContinue
    if ($sm -and $sm.BootExecute) { $be = (@($sm.BootExecute) -join ' ').Trim(); if ($be -notmatch '^(?i)autocheck autochk \*$') { FCheck 'Startup' 'BootExecute is not the default' $be } }
    foreach ($k in @('HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer\Run', 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer\Run', 'HKCU:\Software\Microsoft\Windows NT\CurrentVersion\Windows')) {
        if (-not (Test-Path $k)) { continue }
        $p = Get-ItemProperty -Path $k -ErrorAction SilentlyContinue
        if (-not $p) { continue }
        foreach ($pp in $p.PSObject.Properties) { if ($pp.Name -notlike 'PS*' -and ($k -match 'Policies' -or $pp.Name -in @('Load', 'Run')) -and $pp.Value) { FCheck 'Startup' 'A less common autorun location has an entry' ("{0}: {1} = {2}" -f $k, $pp.Name, $pp.Value) } }
    }
    try {
        foreach ($ns in @('__EventFilter', 'CommandLineEventConsumer', 'ActiveScriptEventConsumer')) {
            foreach ($o in @(Get-CimInstance -Namespace root\subscription -ClassName $ns -ErrorAction Stop)) {
                if ($o.Name -eq 'SCM Event Log Filter' -or $o.Name -eq 'SCM Event Log Consumer') { continue }
                FCheck 'Startup' "A permanent WMI event subscription exists ($ns)" ("{0}{1}" -f $o.Name, $(if ($o.CommandLineTemplate) { ' -> ' + $o.CommandLineTemplate } elseif ($o.ScriptText) { ' (script)' } else { '' }))
            }
        }
    } catch {}
    # signatures of autorun targets
    $targets = @{}
    foreach ($k in @('HKCU:\Software\Microsoft\Windows\CurrentVersion\Run', 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Run', 'HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Run')) {
        if (-not (Test-Path $k)) { continue }
        $p = Get-ItemProperty -Path $k -ErrorAction SilentlyContinue
        if (-not $p) { continue }
        foreach ($pp in $p.PSObject.Properties) { if ($pp.Name -like 'PS*') { continue }; $v = [string]$pp.Value; $exe = $v; if ($v -match '^\s*"([^"]+)"') { $exe = $matches[1] } elseif ($v -match '^\s*(\S+\.exe)') { $exe = $matches[1] }; $exe = [Environment]::ExpandEnvironmentVariables($exe); if ($exe -match '^[A-Za-z]:\\') { $targets[$exe.ToLower()] = "Run key $($pp.Name)" } }
    }
    try {
        foreach ($s in @(Get-CimInstance Win32_Service -ErrorAction Stop | Where-Object { $_.StartMode -eq 'Auto' -and $_.PathName })) {
            $exe = ''; if ($s.PathName -match '^"([^"]+)"') { $exe = $matches[1] } elseif ($s.PathName -match '^(\S+\.exe)') { $exe = $matches[1] }
            if ($exe -match '^[A-Za-z]:\\' -and $exe -notmatch '(?i)^[A-Za-z]:\\Windows\\') { $targets[$exe.ToLower()] = "auto-start service $($s.Name)" }
        }
    } catch {}
    $c = 0
    foreach ($t in $targets.Keys) {
        if ($c -ge 120) { break }
        $c++
        $s = FSig $t
        if ($s.Status -eq 'Missing') { continue }
        if ($s.Status -ne 'Valid' -or $s.Self) { FCheck 'Startup' 'An autorun or auto-start service target has no valid signature' ("{0} ({1}); signature {2}{3}" -f $t, $targets[$t], $s.Status, $(if ($s.Self) { ', self-signed certificate' } else { '' })) }
    }
}

function FScanDma {
    $present = @{}
    try { foreach ($d in @(Get-PnpDevice -PresentOnly -ErrorAction Stop)) { $present[[string]$d.InstanceId] = $d } } catch {}
    $hits = @{}
    foreach ($id in $present.Keys) {
        if ($id -match '^PCI\\VEN_([0-9A-F]{4})&DEV_([0-9A-F]{4})') {
            if ($global:FFpgaVendors.ContainsKey($matches[1])) { $hits[$id] = ("present now: {0} [{1}] ({2})" -f $present[$id].FriendlyName, $id, $global:FFpgaVendors[$matches[1]]) }
        }
        elseif ($id -match '^USB\\VID_0403&PID_(601F|601E)') { $hits[$id] = ("present now: {0} [{1}] (FTDI FT60x USB3 FIFO chip)" -f $present[$id].FriendlyName, $id) }
    }
    foreach ($v in $global:FFpgaVendors.Keys) {
        $root = "HKLM:\SYSTEM\CurrentControlSet\Enum\PCI"
        foreach ($k in @(Get-ChildItem $root -ErrorAction SilentlyContinue | Where-Object { $_.PSChildName -match "^VEN_$v&" })) {
            foreach ($inst in @(Get-ChildItem $k.PSPath -ErrorAction SilentlyContinue)) {
                $id = ("PCI\{0}\{1}" -f $k.PSChildName, $inst.PSChildName)
                if (-not $hits.ContainsKey($id) -and -not $present.ContainsKey($id)) { $hits[$id] = ("registered earlier, not present now: [{0}] ({1})" -f $id, $global:FFpgaVendors[$v]) }
            }
        }
    }
    foreach ($h in $hits.Values) { FCheck 'Hardware' 'A PCI/USB device from an FPGA vendor or FPGA USB-FIFO chip is or was registered (found in DMA cards; also in legitimate FPGA and capture hardware)' $h }
    try {
        foreach ($d in $present.Values) {
            if ([string]$d.InstanceId -like 'PCI\*' -and $d.Class -in @('Unknown', $null, '') -and $d.Status -eq 'Error') { FCheck 'Hardware' 'A PCI device is present with no driver and an unknown class' ("{0} [{1}]" -f $d.FriendlyName, $d.InstanceId) }
        }
    } catch {}
}

function FScanProcessMemory {
    $self = $PID
    $procs = @(Get-CimInstance Win32_Process -ErrorAction Stop | Where-Object { $_.ProcessId -gt 4 -and $_.ProcessId -ne $self })
    $done = 0; $blocked = 0; $t0 = Get-Date
    foreach ($p in $procs) {
        if (((Get-Date) - $t0).TotalSeconds -gt 150) { FNote 'Process-memory sweep stopped after 150 seconds.'; break }
        $path = [string]$p.ExecutablePath
        if (-not $path) { try { $path = [RecNative]::ImagePath([int]$p.ProcessId) } catch {} }
        $res = $null; try { $res = [RecForensic]::DeepScan([int]$p.ProcessId, $path) } catch { $res = "ERR|$($_.Exception.Message)" }
        if (-not $res -or $res -notlike 'OK|*') { $blocked++; continue }
        $done++
        $f = $res.Split('|')
        $tag = "{0} (PID {1}) {2}" -f $p.Name, $p.ProcessId, $path
        if ([int]$f[3] -gt 0) { FCheck 'Memory' 'A process holds a Windows executable (PE) image in private memory that was not loaded from a file (manual-mapped or reflectively loaded module)' ("$tag; {0} region(s) at {1}" -f $f[3], $f[4]) }
        if ($f[5] -like 'NOT_IMAGE*') { FCheck 'Memory' 'The main program image of a process is not file-backed memory (process hollowing indicator)' ("$tag; {0}" -f $f[5]) }
        if ($f[6] -like 'MISMATCH*') { FCheck 'Memory' 'The program image in memory differs from its file on disk (process hollowing indicator)' ("$tag; {0}" -f $f[6]) }
    }
    FNote ("Process-memory sweep: {0} process(es) inspected, {1} not readable (protected or exited)." -f $done, $blocked)
}

function FScanRobloxInstall {
    $roots = @("$env:LOCALAPPDATA\Roblox\Versions")
    $bad = @(); $n = 0
    foreach ($r in $roots) {
        if (-not (Test-Path $r)) { FNote 'Roblox install check: no Roblox Versions folder found.'; return }
        foreach ($f in @(Get-ChildItem $r -Recurse -File -Include *.exe, *.dll -ErrorAction SilentlyContinue | Select-Object -First 400)) {
            $n++
            $s = FSig $f.FullName
            if ($s.Status -ne 'Valid') { $bad += ("{0} (signature {1}; modified {2})" -f $f.FullName, $s.Status, $f.LastWriteTime.ToString('yyyy-MM-dd HH:mm')) }
            elseif ($s.Cn -and $s.Cn -notmatch '(?i)Roblox|Microsoft') { $bad += ("{0} (signed by {1})" -f $f.FullName, $s.Cn) }
        }
        foreach ($cs in @(Get-ChildItem $r -Recurse -Directory -Filter ClientSettings -ErrorAction SilentlyContinue)) {
            foreach ($j in @(Get-ChildItem $cs.FullName -File -ErrorAction SilentlyContinue)) {
