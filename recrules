$global:WatchCtl = $null
$global:WatchPS  = $null
$global:WatchRS  = $null

function Start-MatchWatcher {
    if (-not $global:FullChecks) { return }
    $global:WatchBag = [System.Collections.ArrayList]::Synchronized((New-Object System.Collections.ArrayList))
    $global:WatchCtl = [hashtable]::Synchronized(@{ Stop = $false })
    try {
        $rs = [runspacefactory]::CreateRunspace()
        $rs.Open()
        $rs.SessionStateProxy.SetVariable('bag', $global:WatchBag)
        $rs.SessionStateProxy.SetVariable('ctl', $global:WatchCtl)
        $ps = [powershell]::Create()
        $ps.Runspace = $rs
        $code = {
            function Rec($kind, $name, $procId, $ppid, $path, $detail) {
                [void]$bag.Add([PSCustomObject]@{ Time = (Get-Date); Kind = $kind; Name = $name; PID = $procId; PPID = $ppid; Path = $path; Detail = $detail })
            }
            $started = Get-Date
            try { [System.Threading.Thread]::CurrentThread.Priority = [System.Threading.ThreadPriority]::BelowNormal } catch {}
            $w = $null
            try {
                $q = New-Object System.Management.WqlEventQuery('SELECT * FROM Win32_ProcessStartTrace')
                $w = New-Object System.Management.ManagementEventWatcher($q)
                Register-ObjectEvent -InputObject $w -EventName EventArrived -SourceIdentifier 'RecProcStart' | Out-Null
                $w.Start()
            } catch { Rec 'INFO' 'watcher' 0 0 $null "process-start trace unavailable: $($_.Exception.Message)"; $w = $null }

            $knownDrv = @{}; $knownSvc = @{}; $knownPnp = @{}; $knownConn = @{}; $knownPf = @{}
            $first = $true
            $lastSlow = Get-Date '2000-01-01'
            $lastProcPoll = Get-Date '2000-01-01'
            $seenPid = @{}
            while (-not $ctl.Stop) {
                # --- instant process-start events ---
                if ($w) {
                    $evs = @()
                    try { $evs = @(Get-Event -SourceIdentifier 'RecProcStart' -ErrorAction SilentlyContinue) } catch {}
                    foreach ($ev in $evs) {
                        try {
                            $n = $ev.SourceEventArgs.NewEvent
                            $pidv = [int]$n.ProcessID; $ppidv = [int]$n.ParentProcessID
                            $path = $null
                            try { $path = [System.Diagnostics.Process]::GetProcessById($pidv).MainModule.FileName } catch {}
                            if (-not $path) { try { $path = (Get-CimInstance Win32_Process -Filter "ProcessId=$pidv" -ErrorAction Stop).ExecutablePath } catch {} }
                            $cmd = $null
                            try { $cmd = (Get-CimInstance Win32_Process -Filter "ProcessId=$pidv" -ErrorAction Stop).CommandLine } catch {}
                            $seenPid[$pidv] = $true
                            Rec 'PROC' $n.ProcessName $pidv $ppidv $path $cmd
                        } catch {}
                        try { Remove-Event -EventIdentifier $ev.EventIdentifier -ErrorAction SilentlyContinue } catch {}
                    }
                }
                # --- backup poll (every 4s) so nothing is missed if the trace is blocked ---
                if (((Get-Date) - $lastProcPoll).TotalSeconds -ge 4) {
                    $lastProcPoll = Get-Date
                    try {
                        foreach ($p in (Get-CimInstance Win32_Process -ErrorAction Stop)) {
                            $k = [int]$p.ProcessId
                            if (-not $seenPid.ContainsKey($k)) {
                                $seenPid[$k] = $true
                                if (-not $first) { Rec 'PROC' $p.Name $k ([int]$p.ParentProcessId) $p.ExecutablePath $p.CommandLine }
                            }
                        }
                    } catch {}
                }
                # --- slower checks every 12s ---
                if (((Get-Date) - $lastSlow).TotalSeconds -ge 20) {
                    $lastSlow = Get-Date
                    try { foreach ($d in (Get-CimInstance Win32_SystemDriver -ErrorAction Stop | Where-Object { $_.State -eq 'Running' })) {
                        if (-not $knownDrv.ContainsKey($d.Name)) { $knownDrv[$d.Name] = 1; if (-not $first) { Rec 'DRIVER' $d.Name 0 0 $d.PathName 'driver started' } } } } catch {}
                    try { foreach ($s in (Get-CimInstance Win32_Service -ErrorAction Stop)) {
                        $key = $s.Name
                        if (-not $knownSvc.ContainsKey($key)) { $knownSvc[$key] = 1; if (-not $first) { Rec 'SERVICE' $s.Name 0 0 $s.PathName ("new service, state " + $s.State) } } } } catch {}
                    try { foreach ($d in (Get-PnpDevice -PresentOnly -ErrorAction Stop)) {
                        $key = $d.InstanceId
                        if (-not $knownPnp.ContainsKey($key)) { $knownPnp[$key] = 1; if (-not $first) { Rec 'PNP' $d.FriendlyName 0 0 $key 'device appeared' } } } } catch {}
                    try { foreach ($c in (Get-NetTCPConnection -State Established -ErrorAction Stop)) {
                        $ra = $c.RemoteAddress
                        if ($ra -match '^(127\.|::1|10\.|192\.168\.|169\.254\.|172\.(1[6-9]|2\d|3[01])|fe80|0\.)') { continue }
                        $key = "$($c.OwningProcess)|$ra|$($c.RemotePort)"
                        if (-not $knownConn.ContainsKey($key)) { $knownConn[$key] = 1; $pn = $null; try { $pn = (Get-Process -Id $c.OwningProcess -ErrorAction Stop).ProcessName } catch {}
                            Rec 'CONN' $pn ([int]$c.OwningProcess) 0 $null ("{0}:{1}" -f $ra, $c.RemotePort) } } } catch {}
                    try {
                        $cur = @{}
                        foreach ($f in (Get-ChildItem "$env:WINDIR\Prefetch" -Filter *.pf -ErrorAction Stop)) { $cur[$f.Name] = $f.LastWriteTime }
                        foreach ($k in @($knownPf.Keys)) { if (-not $cur.ContainsKey($k)) { Rec 'PFDEL' $k 0 0 $null 'Prefetch file disappeared'; $knownPf.Remove($k) } }
                        foreach ($k in $cur.Keys) {
                            if (-not $knownPf.ContainsKey($k)) { if (-not $first) { Rec 'PFNEW' $k 0 0 $null ("Prefetch file created " + $cur[$k]) } }
                            elseif ($knownPf[$k] -ne $cur[$k]) { Rec 'PFRUN' $k 0 0 $null ("Prefetch file updated " + $cur[$k]) }
                            $knownPf[$k] = $cur[$k]
                        }
                    } catch {}
                    try { foreach ($e in (Get-WinEvent -FilterHashtable @{ LogName = 'Security'; Id = 1102; StartTime = $started } -MaxEvents 3 -ErrorAction Stop)) { Rec 'LOGCLEAR' 'Security' 0 0 $null ("log cleared at " + $e.TimeCreated) } } catch {}
                    try { foreach ($e in (Get-WinEvent -FilterHashtable @{ LogName = 'System'; Id = 104; StartTime = $started } -MaxEvents 3 -ErrorAction Stop)) { Rec 'LOGCLEAR' 'System' 0 0 $null ("log cleared at " + $e.TimeCreated) } } catch {}
                    $first = $false
                }
                Start-Sleep -Milliseconds 400
            }
            try { if ($w) { $w.Stop() } } catch {}
        }
        [void]$ps.AddScript($code.ToString())
        [void]$ps.BeginInvoke()
        $global:WatchPS = $ps
        $global:WatchRS = $rs
        Add-TL 'WATCHER' 'Silent match watcher started (logs new programs, drivers, devices, connections, Prefetch changes)'
    } catch { Add-Note "Match watcher could not start: $($_.Exception.Message)" }
}

function Stop-MatchWatcher {
    if (-not $global:WatchCtl) { return }
    $global:WatchCtl.Stop = $true
    Start-Sleep -Milliseconds 900
    try { $global:WatchLog = @($global:WatchBag.ToArray()) } catch { $global:WatchLog = @() }
    try { if ($global:WatchPS) { $global:WatchPS.Stop(); $global:WatchPS.Dispose() } } catch {}
    try { if ($global:WatchRS) { $global:WatchRS.Close(); $global:WatchRS.Dispose() } } catch {}
    Add-TL 'WATCHER' ("Watcher stopped. {0} events recorded." -f @($global:WatchLog).Count)
}

# Turn the raw watcher log into timeline lines and flags (done after the match, on the checker's side)
function Convert-WatchLog {
    $log = @($global:WatchLog | Sort-Object Time)
    if ($log.Count -eq 0) { return }
    # which processes belong to this script itself (its own helper jobs, tools it opened)?
    $own = @{}; $own[[int]$PID] = $true
    foreach ($e in $log) { if ($e.Kind -eq 'PROC' -and $own.ContainsKey([int]$e.PPID)) { $own[[int]$e.PID] = $true } }
    $shell = '^(powershell|pwsh|cmd|windowsterminal|openconsole|regedit|mmc|wscript|cscript|mshta|wmic|reg|sc|net|net1|bcdedit|wevtutil|fsutil|taskkill|schtasks|certutil|bitsadmin|msiexec|installutil|regsvr32|rundll32)$'
    $scriptTools = '^(autoruns|autoruns64|sbecmd|devmgmt|mmc|regedit|explorer|systemsettings|useraccountcontrolsettings|taskmgr|control)$'
    $ownSpam = 0
    $winTools = '^(notepad|mspaint|calc|calculator|snippingtool|wordpad|osk|magnify|charmap|msinfo32|perfmon|resmon|eventvwr|compmgmt|diskmgmt|control|dxdiag|winver|write|snippingtool|screenclippinghost)$'
    foreach ($e in $log) {
        $global:FlagTimeOverride = $e.Time
        $ph = Get-PhaseFor $e.Time
        switch ($e.Kind) {
            'PROC' {
                $nm = ($e.Name -replace '\.exe$', '')
                if ($own.ContainsKey([int]$e.PID)) { $ownSpam++; continue }
                $v = Get-ProcVerdict $e.Name $e.Path
                $short = if (-not $e.Path) { ' (exited before path could be read)' } else { '' }
                Add-TL 'PROC START' ("{0} (PID {1}, parent PID {2}) {3} [{4}]{5}" -f $e.Name, $e.PID, $e.PPID, $e.Path, $v.Class, $short) $e.Time
                if ($v.Impersonation) { Add-Flag 'Fake or renamed programs' 60 "Program pretending to be a trusted one was started ($ph)" ("{0} {1} :: {2}" -f $e.Name, $e.Path, $v.Reason); continue }
                $look = Get-LookalikeOf $e.Name
                if ($look) { Add-Flag 'Fake or renamed programs' 40 "Look-alike program name started ($ph)" "$($e.Name) ~ $look" }
                if ($nm -match $global:CheatRx -or ($e.Detail -and $e.Detail -match $global:CheatRx -and $nm -notmatch '(?i)^(powershell|pwsh|conhost|cmd)')) {
                    Add-Flag 'Cheat tools and macros' 60 "Cheat-matching program started ($ph)" ("{0} {1} :: {2}" -f $e.Name, $e.Path, $e.Detail)
                }
                if ($nm -match $global:MacroRx) { Add-Flag 'Cheat tools and macros' 25 "Macro / hotkey software started ($ph)" "$($e.Name) $($e.Path)" }
                if ($nm -match $global:RemoteRx) { Add-Flag 'Private cheat indicators' 35 "Remote-control / tunnel software started ($ph)" "$($e.Name) $($e.Path)" }
                if ($ph -eq 'BEFORE') { continue }
                # during or after the match: only the allowed apps may open
                $allowed = $false
                if ($v.Class -in @('Windows','MicrosoftOther','Roblox','OBS','NVIDIA','AMD','Malwarebytes','Discord')) { $allowed = $true }
                if ($v.Class -eq 'MicrosoftOther' -and $nm -match $winTools -and $ph -eq 'DURING') {
                    Add-Flag 'Activity during match' 15 'Windows tool opened during the match' ("{0} (PID {1})" -f $e.Name, $e.PID)
                }
                if ($v.Class -eq 'Browser' -and $tier -eq '2') { $allowed = $true }
                if ($v.Class -eq 'ScriptTool' -and $ph -eq 'AFTER') { $allowed = $true }
                if ($v.Class -eq 'Windows' -and $nm -match $shell -and $ph -eq 'DURING') {
                    Add-Flag 'Activity during match' 30 'Command shell / system tool opened during the match' ("{0} (PID {1}) {2}" -f $e.Name, $e.PID, $e.Detail)
                }
                if (-not $allowed) {
                    $pts = if ($v.Trusted) { 30 } else { 50 }
                    Add-Flag 'Activity during match' $pts "Program that is not allowed was opened ($ph)" ("{0} (PID {1}) {2} [{3}]" -f $e.Name, $e.PID, $e.Path, $v.Reason)
                }
            }
            'DRIVER'  { Add-TL 'DRIVER' ("{0} started: {1}" -f $e.Name, $e.Path) $e.Time
                        if ($ph -ne 'BEFORE') { Add-Flag 'Activity during match' 45 "New driver started ($ph)" ("{0} {1}" -f $e.Name, $e.Path) }
                        if ($e.Name -match $global:ByovdRx) { Add-Flag 'Unsigned or injected code' 55 'Known abused/vulnerable driver started' ("{0} {1}" -f $e.Name, $e.Path) } }
            'SERVICE' { Add-TL 'SERVICE' ("{0} created/seen: {1}" -f $e.Name, $e.Path) $e.Time
                        if ($ph -ne 'BEFORE') { Add-Flag 'Activity during match' 30 "New Windows service appeared ($ph)" ("{0} {1}" -f $e.Name, $e.Path) } }
            'PNP'     { Add-TL 'DEVICE' ("{0} [{1}]" -f $e.Name, $e.Path) $e.Time
                        if ($ph -ne 'BEFORE') { Add-Flag 'Activity during match' 30 "Hardware device plugged in ($ph)" ("{0} [{1}]" -f $e.Name, $e.Path) }
                        if (($e.Name -match $global:DmaNameRx) -or ($e.Path -match $global:FpgaVenRx) -or ($e.Name -match $global:CaptureRx) -or ($e.Path -match $global:MicroVidRx)) {
                            Add-Flag 'Hardware and DMA' 40 "Suspicious hardware appeared ($ph)" ("{0} [{1}]" -f $e.Name, $e.Path) } }
            'CONN'    { Add-TL 'NETWORK' ("{0} (PID {1}) connected to {2}" -f $e.Name, $e.PID, $e.Detail) $e.Time
                        if ($ph -ne 'BEFORE' -and $e.Name -and $e.Name -notmatch '(?i)^(robloxplayerbeta|discord|chrome|msedge|firefox|svchost|obs64|nvcontainer|mbamservice|system|brave|opera)$') {
                            Add-Flag 'Private cheat indicators' 25 "Unexpected program made an internet connection ($ph)" ("{0} -> {1}" -f $e.Name, $e.Detail) } }
            'PFNEW'   { Add-TL 'PREFETCH' ("{0} :: {1}" -f $e.Name, $e.Detail) $e.Time
                        if ($e.Name -match $global:CheatRx) { Add-Flag 'Cheat tools and macros' 55 "Prefetch shows a cheat-named program ran ($ph)" $e.Name } }
            'PFRUN'   { Add-TL 'PREFETCH' ("{0} :: {1}" -f $e.Name, $e.Detail) $e.Time
                        if ($e.Name -match $global:CheatRx) { Add-Flag 'Cheat tools and macros' 55 "Prefetch shows a cheat-named program ran ($ph)" $e.Name } }
            'PFDEL'   { Add-TL 'PREFETCH' ("DELETED: {0}" -f $e.Name) $e.Time
                        Add-Flag 'Tampering and cleanup' 70 'A Prefetch file was DELETED while the script was running' ("{0} ({1})" -f $e.Name, $ph) }
            'LOGCLEAR'{ Add-Flag 'Tampering and cleanup' 70 "A Windows event log was CLEARED while the script was running ($ph)" ("{0}: {1}" -f $e.Name, $e.Detail) }
            default   { Add-Note ("Watcher: {0}" -f $e.Detail) }
        }
    }
    $global:FlagTimeOverride = $null
    if ($ownSpam -gt 0) { Add-TL 'PROC START' ("({0} start-ups by this script's own helper jobs were left out)" -f $ownSpam) }
}

# =========================================================================
# BEFORE / AFTER SNAPSHOTS
# =========================================================================
function Get-Snapshot([string]$label) {
    $s = @{ Label = $label; Time = Get-Date; Drivers = @{}; Services = @{}; Pnp = @{}; Pf = @{}; Run = @{}; Tasks = @{}; Certs = @{}; Hosts = ''; Displays = 1; Procs = @{} }
    try { foreach ($d in (Get-CimInstance Win32_SystemDriver -ErrorAction Stop | Where-Object { $_.State -eq 'Running' })) { $s.Drivers[$d.Name] = $d.PathName } } catch {}
    try { foreach ($d in (Get-CimInstance Win32_Service -ErrorAction Stop)) { $s.Services[$d.Name] = $d.PathName } } catch {}
    try { foreach ($d in (Get-PnpDevice -PresentOnly -ErrorAction Stop)) { $s.Pnp[[string]$d.InstanceId] = [string]$d.FriendlyName } } catch {}
    try { foreach ($f in (Get-ChildItem "$env:WINDIR\Prefetch" -Filter *.pf -ErrorAction Stop)) { $s.Pf[$f.Name] = $f.LastWriteTime } } catch {}
    foreach ($k in @('HKCU:\Software\Microsoft\Windows\CurrentVersion\Run','HKLM:\Software\Microsoft\Windows\CurrentVersion\Run','HKCU:\Software\Microsoft\Windows\CurrentVersion\RunOnce')) {
        if (Test-Path $k) { $pr = Get-ItemProperty $k -ErrorAction SilentlyContinue; foreach ($p in $pr.PSObject.Properties) { if ($p.Name -notlike 'PS*') { $s.Run["$k|$($p.Name)"] = [string]$p.Value } } }
    }
    try { foreach ($t in (Get-ScheduledTask -ErrorAction Stop | Where-Object { $_.TaskPath -notmatch '^\\Microsoft\\' })) { $s.Tasks[$t.TaskPath + $t.TaskName] = [string]$t.State } } catch {}
    try { foreach ($c in (Get-ChildItem Cert:\LocalMachine\Root -ErrorAction Stop)) { $s.Certs[$c.Thumbprint] = $c.Subject } } catch {}
    try { $s.Hosts = (Get-FileHash "$env:WINDIR\System32\drivers\etc\hosts" -Algorithm SHA256 -ErrorAction Stop).Hash } catch {}
    $s.Displays = Get-ActiveDisplayCount
    try { foreach ($p in (Get-ProcTable)) { $s.Procs[[string]$p.Name + '|' + [string]$p.Path] = $true } } catch {}
    return $s
}

function Compare-Snapshots($a, $b) {
    $out = @()
    if (-not $a -or -not $b) { return @('Snapshot comparison not available.') }
    $out += ("Start snapshot: {0}    End snapshot: {1}" -f $a.Time, $b.Time)
    foreach ($k in $b.Drivers.Keys) { if (-not $a.Drivers.ContainsKey($k)) { $out += "NEW DRIVER: $k  $($b.Drivers[$k])"; Add-Flag 'Activity during match' 45 'Driver loaded between the start and end snapshots' "$k $($b.Drivers[$k])" } }
    foreach ($k in $a.Drivers.Keys) { if (-not $b.Drivers.ContainsKey($k)) { $out += "DRIVER GONE: $k  $($a.Drivers[$k])"; Add-Flag 'Activity during match' 25 'Driver was unloaded between the start and end snapshots' $k } }
    foreach ($k in $b.Services.Keys) { if (-not $a.Services.ContainsKey($k)) { $out += "NEW SERVICE: $k  $($b.Services[$k])"; Add-Flag 'Activity during match' 30 'Service added between the start and end snapshots' "$k $($b.Services[$k])" } }
    foreach ($k in $b.Pnp.Keys) { if (-not $a.Pnp.ContainsKey($k)) { $out += "NEW DEVICE: $($b.Pnp[$k]) [$k]"; Add-Flag 'Activity during match' 30 'Device appeared between the start and end snapshots' "$($b.Pnp[$k]) [$k]" } }
    foreach ($k in $a.Pnp.Keys) { if (-not $b.Pnp.ContainsKey($k)) { $out += "DEVICE REMOVED: $($a.Pnp[$k]) [$k]"; Add-Flag 'Activity during match' 25 'Device was unplugged between the start and end snapshots' "$($a.Pnp[$k]) [$k]" } }
    foreach ($k in $a.Pf.Keys) { if (-not $b.Pf.ContainsKey($k)) { $out += "PREFETCH DELETED: $k"; Add-Flag 'Tampering and cleanup' 70 'Prefetch file missing at the end that existed at the start' $k } }
    foreach ($k in $b.Pf.Keys) {
        if (-not $a.Pf.ContainsKey($k)) { $out += "PREFETCH NEW: $k  ($($b.Pf[$k]))" }
        elseif ($a.Pf[$k] -ne $b.Pf[$k]) { $out += "PREFETCH RAN AGAIN: $k  ($($a.Pf[$k]) -> $($b.Pf[$k]))" }
        if (($k -match $global:CheatRx -or $k -match $global:MacroRx -or $k -match $global:RemoteRx) -and (-not $a.Pf.ContainsKey($k) -or $a.Pf[$k] -ne $b.Pf[$k])) {
            Add-Flag 'Cheat tools and macros' 55 'Prefetch shows a cheat/macro/remote tool ran during the match' $k
        }
    }
    if ($b.Pf.Count -lt ($a.Pf.Count - 3)) { Add-Flag 'Tampering and cleanup' 40 'Prefetch folder shrank during the match' "$($a.Pf.Count) -> $($b.Pf.Count) files" }
    foreach ($k in $b.Run.Keys) { if (-not $a.Run.ContainsKey($k)) { $out += "NEW STARTUP ENTRY: $k = $($b.Run[$k])"; Add-Flag 'Activity during match' 35 'Startup entry added during the match' "$k = $($b.Run[$k])" } }
    foreach ($k in $b.Tasks.Keys) { if (-not $a.Tasks.ContainsKey($k)) { $out += "NEW SCHEDULED TASK: $k"; Add-Flag 'Activity during match' 30 'Scheduled task added during the match' $k } }
    foreach ($k in $b.Certs.Keys) { if (-not $a.Certs.ContainsKey($k)) { $out += "NEW ROOT CERTIFICATE: $($b.Certs[$k])"; Add-Flag 'Activity during match' 40 'Root certificate added during the match' $b.Certs[$k] } }
    if ($a.Hosts -ne $b.Hosts) { $out += 'HOSTS FILE CHANGED'; Add-Flag 'Activity during match' 60 'The hosts file changed during the match' '' }
    if ($b.Displays -gt $a.Displays) { $out += "SCREENS: $($a.Displays) -> $($b.Displays)"; Add-Flag 'Extra screens' 100 'Screen count went UP during the match' "$($a.Displays) -> $($b.Displays)" }
    foreach ($k in $b.Procs.Keys) {
        if (-not $a.Procs.ContainsKey($k)) {
            $parts = $k.Split('|', 2)
            $v = Get-ProcVerdict $parts[0] $parts[1]
            $out += "PROGRAM RUNNING AT END BUT NOT AT START: $($parts[0])  $($parts[1])  [$($v.Class)]"
        }
    }
    return $out
}

# =========================================================================
# REPORT + SEAL
# =========================================================================
function Get-Bar([int]$pct) { $n = [int][Math]::Round($pct / 5.0); return ('[' + ('#' * $n) + ('.' * (20 - $n)) + ']') }

function Build-FlagsText {
    $sb = New-Object System.Text.StringBuilder
    $overall = Get-OverallScore
    [void]$sb.AppendLine('=====================================================================')
    [void]$sb.AppendLine(' FLAGS / CONCERN SUMMARY  (read this first)')
    [void]$sb.AppendLine('=====================================================================')
    [void]$sb.AppendLine((' Made by    : {0} on {1} (user {2})' -f 'recrules', $env:COMPUTERNAME, $env:USERNAME))
    [void]$sb.AppendLine((' Tier       : {0}' -f $tier))
    [void]$sb.AppendLine((' Script run : {0}' -f $global:SessionStart.ToString('yyyy-MM-dd HH:mm:ss')))
    if ($global:MatchStart) { [void]$sb.AppendLine((' Match      : {0}  to  {1}' -f $global:MatchStart.ToString('yyyy-MM-dd HH:mm:ss'), $(if ($global:MatchEnd) { $global:MatchEnd.ToString('yyyy-MM-dd HH:mm:ss') } else { '(not finished)' }))) }
    try { [void]$sb.AppendLine((' Windows    : {0}' -f (Get-CimInstance Win32_OperatingSystem).Caption)) } catch {}
    [void]$sb.AppendLine('')
    $auto = @($global:Flags | Where-Object { $_.Category -eq 'Extra screens' -or $_.Points -ge 70 })
    if ($auto.Count -gt 0) {
        [void]$sb.AppendLine('!!! AUTO-FLAGS (strongest findings, look at these first) !!!')
        foreach ($f in ($auto | Sort-Object Points -Descending)) { [void]$sb.AppendLine(('  * [{0}] {1} - {2}' -f $f.Category.ToUpper(), $f.Title, $f.Detail)) }
        [void]$sb.AppendLine('')
    }
    [void]$sb.AppendLine((' OVERALL CONCERN SCORE : {0}%   {1}' -f $overall, (Get-Bar $overall)))
    [void]$sb.AppendLine((' Reading            : {0}' -f (Get-ScoreBand $overall)))
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine(' What the % means (a heuristic, NOT a proven probability):')
    [void]$sb.AppendLine('   0-29%  low concern. Under 30% is a good result to accept.')
    [void]$sb.AppendLine('   30-59% medium. A person should read the bullets below before accepting.')
    [void]$sb.AppendLine('   60%+   high. Manager decision; look at the evidence and the video.')
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine(' SCORE PER CATEGORY')
    foreach ($c in $global:FlagCategories.Keys) {
        $sc = Get-CategoryScore $c
        [void]$sb.AppendLine(('   {0,-28} {1,3}%  {2}' -f $c, $sc, (Get-Bar $sc)))
    }
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine(' ROUGH LIKELIHOOD ESTIMATES (heuristic guesses built from the flags above)')
    $priv = Get-CategoryScore 'Private cheat indicators'
    $dma  = Get-CategoryScore 'Hardware and DMA'
    $byp  = [int][Math]::Min(100, (Get-CategoryScore 'Tampering and cleanup') + [Math]::Round((Get-CategoryScore 'Fake or renamed programs') / 2))
    $cheat= Get-CategoryScore 'Cheat tools and macros'
    [void]$sb.AppendLine(('   Privately hosted cheat in use   : ~{0}%' -f $priv))
    [void]$sb.AppendLine(('   DMA / hardware cheat in use     : ~{0}%  (software can only see hints of DMA, a low number does not prove there is none)' -f $dma))
    [void]$sb.AppendLine(('   Rec-rules bypass / cover-up     : ~{0}%' -f $byp))
    [void]$sb.AppendLine(('   Cheat or macro tool used        : ~{0}%' -f $cheat))
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine('=====================================================================')
    [void]$sb.AppendLine(' WHAT WAS NOTICED (bullet points, newest category first by score)')
    [void]$sb.AppendLine('=====================================================================')
    foreach ($c in ($global:FlagCategories.Keys | Sort-Object { - (Get-CategoryScore $_) })) {
        $fl = @($global:Flags | Where-Object { $_.Category -eq $c } | Sort-Object Points -Descending)
        [void]$sb.AppendLine('')
        [void]$sb.AppendLine(('{0}  -  {1}%   ({2})' -f $c.ToUpper(), (Get-CategoryScore $c), $global:FlagCategories[$c]))
        if ($fl.Count -eq 0) { [void]$sb.AppendLine('   - nothing noticed'); continue }
        foreach ($f in $fl) {
            [void]$sb.AppendLine(('   - [{0} {1}] {2}  (+{3})' -f $f.Time.ToString('HH:mm:ss'), $f.Phase, $f.Title, $f.Points))
            if ($f.Detail) { [void]$sb.AppendLine(('       {0}' -f $f.Detail)) }
        }
    }
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine('=====================================================================')
    [void]$sb.AppendLine(' LIMITS - things a script on the player PC cannot prove')
    [void]$sb.AppendLine('=====================================================================')
    [void]$sb.AppendLine('   - A good DMA card can look like normal hardware. Only hints are shown above.')
    [void]$sb.AppendLine('   - A cheat that runs inside the Windows kernel can hide from any script like this one.')
    [void]$sb.AppendLine('   - A flag means "look closer", not "guilty". Some real software is unsigned.')
    [void]$sb.AppendLine('   - Roblox protects its own memory, so memory/module scans can be blocked (noted below).')
    if (-not $global:FullChecks) { [void]$sb.AppendLine('   - Tier 1 is camera-only: only the screen check and the file seal run automatically.') }
    if ($global:ScanNotes.Count -gt 0) {
        [void]$sb.AppendLine('')
        [void]$sb.AppendLine(' SCAN NOTES')
        foreach ($n in $global:ScanNotes) { [void]$sb.AppendLine("   - $n") }
    }
    return $sb.ToString()
}

function Build-TimelineText {
    $sb = New-Object System.Text.StringBuilder
    [void]$sb.AppendLine('TIMELINE - everything the script saw, oldest first')
    [void]$sb.AppendLine('Format:  date time | BEFORE/DURING/AFTER the match | source | what happened')
    [void]$sb.AppendLine(('Match window: {0}  ->  {1}' -f $(if ($global:MatchStart) { $global:MatchStart.ToString('yyyy-MM-dd HH:mm:ss') } else { 'n/a' }), $(if ($global:MatchEnd) { $global:MatchEnd.ToString('yyyy-MM-dd HH:mm:ss') } else { 'n/a' })))
    [void]$sb.AppendLine('')
    foreach ($t in ($global:Timeline | Sort-Object Time)) {
        [void]$sb.AppendLine(('{0} | {1,-6} | {2,-10} | {3}' -f $t.Time.ToString('yyyy-MM-dd HH:mm:ss'), $t.Phase, $t.Source, $t.Detail))
    }
    return $sb.ToString()
}

function Get-FileSha([string]$p) { try { return (Get-FileHash -LiteralPath $p -Algorithm SHA256 -ErrorAction Stop).Hash } catch { return 'UNREADABLE' } }

function Save-FinalPackage {
    # Writes the reports, adds them to the findings ZIP (or makes one for Tier 1) and seals it.
    $stamp = Get-Date -Format 'yyyy-MM-dd_HH-mm-ss'
    $acFolder = Join-Path ([Environment]::GetFolderPath('Desktop')) 'AC-FINDINGS'
    New-Item -ItemType Directory -Path $acFolder -Force | Out-Null
    $work = Join-Path $env:TEMP "recrep_$stamp"
    New-Item -ItemType Directory -Path $work -Force | Out-Null

    $flagsTxt = Build-FlagsText
    Set-Content -Path (Join-Path $work '00_FLAGS_SUMMARY.txt') -Value $flagsTxt -Encoding UTF8
    Set-Content -Path (Join-Path $work '00_TIMELINE.txt') -Value (Build-TimelineText) -Encoding UTF8
    $diff = @(Compare-Snapshots $global:SnapStart $global:SnapEnd)
    if (-not $global:FullChecks) { $diff = @('Tier 1: snapshot comparison is not used.') }
    Set-Content -Path (Join-Path $work '00_START_vs_END_CHANGES.txt') -Value (@('Everything that changed between the start-of-match and end-of-match snapshots:', '') + $diff) -Encoding UTF8
    try { @($global:WatchLog | Select-Object Time, Kind, Name, PID, PPID, Path, Detail) | Export-Csv -Path (Join-Path $work '00_WATCHER_LOG.csv') -NoTypeInformation -Encoding UTF8 } catch {}
    try { @($global:Flags | Select-Object Time, Phase, Category, Points, Title, Detail) | Export-Csv -Path (Join-Path $work '00_ALL_FLAGS.csv') -NoTypeInformation -Encoding UTF8 } catch {}

    Add-Type -AssemblyName System.IO.Compression
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    $zipPath = $global:FindingsZip
    if (-not $zipPath -or -not (Test-Path $zipPath)) { $zipPath = Join-Path $acFolder "FINDINGS-$stamp.zip" }
    if (-not (Test-Path $zipPath)) { $z0 = [System.IO.Compression.ZipFile]::Open($zipPath, 'Create'); $z0.Dispose() }
    $zip = [System.IO.Compression.ZipFile]::Open($zipPath, 'Update')
    try {
        foreach ($f in (Get-ChildItem $work -File)) {
            $old = $zip.GetEntry($f.Name); if ($old) { $old.Delete() }
            [void][System.IO.Compression.ZipFileExtensions]::CreateEntryFromFile($zip, $f.FullName, $f.Name)
        }
        # seal = SHA256 of every entry as stored in the zip
        $lines = @('SEAL - SHA256 of every file inside this package (taken when the player finished).',
                   ('Sealed at: {0}' -f (Get-Date).ToString('yyyy-MM-dd HH:mm:ss')),
                   'To check: unzip, then compare each file hash (Get-FileHash <file>) with the list below.',
                   'Any file that was edited after the script finished will show a different hash.', '')
        foreach ($e in ($zip.Entries | Where-Object { $_.FullName -ne 'SEAL.txt' } | Sort-Object FullName)) {
            $st = $e.Open(); $sha = [System.Security.Cryptography.SHA256]::Create()
            try { $h = ([BitConverter]::ToString($sha.ComputeHash($st))).Replace('-', '') } finally { $st.Dispose(); $sha.Dispose() }
            $lines += ('{0}  {1}' -f $h, $e.FullName)
        }
        $oldSeal = $zip.GetEntry('SEAL.txt'); if ($oldSeal) { $oldSeal.Delete() }
        $se = $zip.CreateEntry('SEAL.txt')
        $w = New-Object System.IO.StreamWriter($se.Open(), (New-Object System.Text.UTF8Encoding($false)))
        try { foreach ($l in $lines) { $w.WriteLine($l) } } finally { $w.Dispose() }
    } finally { $zip.Dispose() }

    # loose copies next to the zip so a reviewer can open the summary without unzipping
    $summaryCopy = Join-Path $acFolder "FLAGS-SUMMARY-$stamp.txt"
    Copy-Item (Join-Path $work '00_FLAGS_SUMMARY.txt') $summaryCopy -Force
    Remove-Item $work -Recurse -Force -ErrorAction SilentlyContinue

    $global:FindingsZip = $zipPath
    $global:FlagsCopy = $summaryCopy
    # the seal text hash (shown on camera) is the hash of SEAL.txt as stored
    $tmpSeal = Join-Path $env:TEMP "seal_$stamp.txt"
    $z2 = [System.IO.Compression.ZipFile]::OpenRead($zipPath)
    try { $en = $z2.GetEntry('SEAL.txt'); [System.IO.Compression.ZipFileExtensions]::ExtractToFile($en, $tmpSeal, $true) } finally { $z2.Dispose() }
    $global:SealHash = Get-FileSha $tmpSeal
    Remove-Item $tmpSeal -Force -ErrorAction SilentlyContinue
    $global:ZipHash = Get-FileSha $zipPath
    $global:FinalOverall = Get-OverallScore
}

