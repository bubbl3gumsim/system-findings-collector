function Invoke-FpsUncap {
    Section "FPS Uncap"
    $settingsPath = Join-Path $env:LOCALAPPDATA "Roblox\GlobalBasicSettings_13.xml"

    $ans = $null
    while ($ans -notmatch '^[YyNn]$') { $ans = Read-Host "Uncap your FPS above 240? (Y/N)" }
    if ($ans -match '^[Nn]$') { Write-Host "Skipped - FPS cap left at the Roblox default." -ForegroundColor Gray; return }

    # Roblox rewrites this file on exit, so it must be closed while we edit.
    Get-Process RobloxPlayerBeta, RobloxPlayerLauncher, RobloxCrashHandler -ErrorAction SilentlyContinue |
        Stop-Process -Force -ErrorAction SilentlyContinue
    Start-Sleep -Seconds 1

    $fps = $null
    while ($null -eq $fps) {
        $raw = (Read-Host "Enter your FPS cap (whole number above 240), or just press Enter to edit it yourself in Notepad").Trim()
        if (-not $raw) { break }
        if ($raw -match '^\d{3,5}$' -and [int]$raw -gt 240) { $fps = [int]$raw }
        else { Write-Host "  Enter a whole number above 240 (e.g. 360), or leave blank for Notepad." -ForegroundColor Yellow }
    }

    # A clean reinstall may not have generated the file yet - create it from the default template.
    $utf8 = New-Object System.Text.UTF8Encoding($false)
    if (-not (Test-Path -LiteralPath $settingsPath)) {
        try {
            New-Item -ItemType Directory -Path (Split-Path $settingsPath) -Force | Out-Null
            [System.IO.File]::WriteAllText($settingsPath, ($RobloxSettingsTemplate -replace "`r?`n", "`r`n"), $utf8)
            Write-Host "Settings file didn't exist yet - created it from the default template." -ForegroundColor DarkYellow
        } catch {
            Write-Host "Could not create $settingsPath : $($_.Exception.Message)" -ForegroundColor Red
            return
        }
    }

    if ($null -ne $fps) {
        $ok = $false
        try {
            $xml = [System.IO.File]::ReadAllText($settingsPath)
            $pattern = '(<int name="FramerateCap">)-?\d+(</int>)'
            if ($xml -match $pattern) {
                $new = [regex]::Replace($xml, $pattern, ('${1}' + $fps + '${2}'))
                [System.IO.File]::WriteAllText($settingsPath, $new, $utf8)
                $check = [System.IO.File]::ReadAllText($settingsPath)
                if ($check -match ('<int name="FramerateCap">' + $fps + '</int>')) { $ok = $true }
            }
        } catch {}
        if ($ok) {
            Write-Host "FramerateCap set to $fps in GlobalBasicSettings_13.xml." -ForegroundColor Green
            return
        }
        Write-Host "Couldn't edit the file automatically - opening it in Notepad instead." -ForegroundColor Yellow
    }

    Write-Host "Change  <int name=`"FramerateCap`">-1</int>  to your value, save, then close Notepad." -ForegroundColor $theme.Accent
    Start-Process notepad.exe -ArgumentList ('"' + $settingsPath + '"') -Wait
}

