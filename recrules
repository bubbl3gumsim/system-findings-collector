# =========================================================================
# SETTINGS STAFF MAY EDIT
# -------------------------------------------------------------------------
# VPN vendors that are allowed. A VPN counts as legitimate only when its files are validly
# signed AND sit inside an install folder (Program Files / ProgramData) whose name contains
# one of these vendor words. Add or remove words, separated by |
$global:AllowedVpnVendors = 'nordvpn|nordsec|nordlynx|protonvpn|proton ?vpn|expressvpn|mullvad|surfshark|private ?internet ?access|cyberghost|windscribe|ipvanish|tunnelbear|hotspot ?shield|hide\.me'
# Certificate signer names of the same VPN vendors. A file validly signed by one of these and installed
# anywhere in Program Files / ProgramData is also accepted, so an unusual install folder name cannot
# break the allow-list again. Add or remove names, separated by |
$global:AllowedVpnSigners = 'Proton AG|Proton Technologies|Nord Security|NordVPN|Tefincom|ExpressVPN|Express VPN|Kape Technologies|Amagicom|Mullvad|Surfshark|Private Internet Access|CyberGhost|Windscribe|IPVanish|TunnelBear|AnchorFree|eVenture'
# Keep Discord running during the cleanup stage ($true) or close it like any other program ($false).
# Only a VERIFIED Discord (file name + install folder + Discord signature all match) is ever kept.
$global:SpareDiscord = $true
# -------------------------------------------------------------------------
# =========================================================================

# A VPN file is accepted when it sits in Program Files / ProgramData under a vendor folder.
# Vendors often nest their folders (Proton installs to C:\Program Files\Proton\VPN\v4.x\...), so the
# first TWO folder levels are joined with a space ("Proton VPN") before matching the vendor words.
function Test-AllowedVpnPath([string]$path) {
    if (-not $path) { return $false }
    if ($path -match '(?i)^[a-z]:\\(?:program files(?: \(x86\))?|programdata)\\([^\\]+)(?:\\([^\\]+))?') {
        $flat = ($matches[1] + ' ' + $matches[2]).Trim()
        return ($flat -match "(?i)($global:AllowedVpnVendors)")
    }
    return $false
}

