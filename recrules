function Invoke-RecorderSetup { $global:RecorderFamily = 'OBS + NVIDIA + AMD (all excluded)' }

# =========================================================================
# FINDINGS COLLECTION
#   START: quick (a few seconds), runs BEFORE the player is told to play, so it
#          cannot cause lag during the match.
#   END  : heavier checks, run after the player types DONE (no game running).
# =========================================================================
function Show-ReopenWarning {
    # From this moment the "only allowed programs" rule is judged (not only from the match start).
    $global:RuleStart = Get-Date
    Add-TL 'MATCH' 'Everything was closed; the allowed-programs rule applies from here'
    Write-Host ""
    Write-Host ("!" * 70) -ForegroundColor Red
    Write-Host " EVERYTHING IS NOW CLOSED. Until you finish playing you may ONLY open:" -ForegroundColor Red
    Write-Host "   (a VPN from an allowed vendor may stay running$(if ($global:SpareDiscord) { ', and so may a verified Discord' }))" -ForegroundColor Gray
    if ($tier -eq '2') {
        Write-Host "     - DISCORD APP" -ForegroundColor White
        Write-Host "     - BROWSER" -ForegroundColor White
        Write-Host "     - TASK MANAGER" -ForegroundColor White
    } else {
        Write-Host "     - DISCORD APP" -ForegroundColor White
        Write-Host "     - TASK MANAGER" -ForegroundColor White
        Write-Host "   Nothing else. Not even a browser." -ForegroundColor Red
    }
    # What is already running, so an allowed app is not launched a second time by mistake.
    $st = $global:AppStateAfter
    if (-not $st) { try { $st = Get-AllowedAppState } catch { $st = $null } }
    if ($st) {
        Write-Host ""
        if ($st.Discord -gt 0) { Write-Host "   Discord is ALREADY RUNNING - do not open a second copy." -ForegroundColor Green }
        else { Write-Host "   Discord is not running - open it only if you need it." -ForegroundColor Gray }
        if (@($st.Vpn).Count -gt 0) { Write-Host ("   VPN already running: " + (@($st.Vpn) -join ', ') + " - leave it as it is.") -ForegroundColor Green }
        else { Write-Host "   No VPN is running." -ForegroundColor Gray }
        Write-Host ""
    }
    Write-Host " Opening ANYTHING else before you finish playing = AUTOMATIC FAIL." -ForegroundColor Red
    Write-Host ("!" * 70) -ForegroundColor Red
    Write-Host ""
}

function Save-Text([string]$dir, [string]$name, [scriptblock]$sb) {
    $path = Join-Path $dir "$name.txt"
    try { (& $sb) | Out-String -Width 500 | Set-Content -Path $path -Encoding UTF8 }
    catch { "ERROR: $_" | Set-Content -Path $path -Encoding UTF8 }
}
function Save-Csv([string]$dir, [string]$name, $data) {
    $path = Join-Path $dir "$name.csv"
    try { if ($data) { $data | Export-Csv -Path $path -NoTypeInformation -Encoding UTF8 } else { 'no rows' | Set-Content -Path $path -Encoding UTF8 } }
    catch { "ERROR: $_" | Set-Content -Path $path -Encoding UTF8 }
}
function Copy-ArtifactDir([string]$label, [string]$source, [string]$dest) {
    try {
        if (Test-Path $source) {
            New-Item -ItemType Directory -Path $dest -Force | Out-Null
            Copy-Item -Path (Join-Path $source '*') -Destination $dest -Recurse -Force -ErrorAction SilentlyContinue
            $copied = @(Get-ChildItem $dest -Recurse -File -ErrorAction SilentlyContinue)
            $sum = ($copied | Measure-Object Length -Sum).Sum
            $sizeMB = if ($null -eq $sum) { 0 } else { [math]::Round($sum / 1MB, 2) }
            return "OK   [$label] $($copied.Count) files, $sizeMB MB copied from '$source'"
        }
        return "SKIP [$label] source not found: $source"
    } catch { return "FAIL [$label] error copying from '$source': $_" }
}

function Invoke-StartCollection {
    Section "Findings Collection (start of match)"
    Write-Host "  Collecting the start-of-match state. This takes a few seconds - DO NOT start playing yet." -ForegroundColor Red
    $stamp = Get-Date -Format 'yyyy-MM-dd_HH-mm-ss'
    $dir = Join-Path $env:TEMP "findings_$stamp"
    New-Item -ItemType Directory -Path $dir -Force | Out-Null
    Merge-ForensicResults
    function SizeMB($p) { return (Get-SizeMB $p) }

    Save-Text $dir '01_process_parentage' { Get-ProcTable | Select-Object Name, PID, PPID, ParentName, @{n='SizeMB';e={ SizeMB $_.Path }}, Path, Cmd }
    Save-Text $dir '02_process_details' {
        Get-CimInstance Win32_Process | ForEach-Object {
            $pp = Normalize-Path $_.ExecutablePath; if (-not $pp) { $pp = Normalize-Path (Get-ImagePathById ([int]$_.ProcessId)) }
            [PSCustomObject]@{ ProcessId = $_.ProcessId; Name = $_.Name; ExecutablePath = $pp; SizeMB = SizeMB $pp; WorkingSetMB = [math]::Round($_.WorkingSetSize / 1MB, 2); CommandLine = $_.CommandLine }
        } | Format-List
    }
    Save-Text $dir '03_system_state' { Get-SystemStateLines }
    Save-Text $dir '04_scheduled_tasks' { Get-ScheduledTask | Select-Object TaskPath, TaskName, State, Author }
    Save-Text $dir '05_tasklist' { tasklist /v }
    Save-Text $dir '06_process_starttimes' {
        Get-Process | ForEach-Object {
            $p = $null; try { $p = $_.Path } catch {}; if (-not $p) { $p = Get-ImagePathById $_.Id }
            $st = $null; try { $st = $_.StartTime } catch {}
            [PSCustomObject]@{ Name = $_.Name; PID = $_.Id; StartTime = $st; SizeMB = SizeMB $p; Path = $p }
        } | Sort-Object StartTime -Descending
    }
    Save-Text $dir '07_services_all' {
        Get-CimInstance Win32_Service | ForEach-Object {
            $bin = $_.PathName; $exe = $null
            if ($bin) { if ($bin -match '^"([^"]+)"') { $exe = $matches[1] } elseif ($bin -match '^(\S+\.exe)') { $exe = $matches[1] } }
            [PSCustomObject]@{ Name = $_.Name; DisplayName = $_.DisplayName; State = $_.State; StartMode = $_.StartMode; ProcessId = $_.ProcessId; SizeMB = SizeMB $exe; PathName = $bin }
        } | Sort-Object State, Name
    }
    Save-Text $dir '08_background_services' { Get-Service | Where-Object { $_.Status -eq 'Running' } | Select-Object Name, DisplayName, Status }
    Save-Text $dir '09_duplicate_processes' {
        if (-not $global:DuplicateReport -or @($global:DuplicateReport).Count -eq 0) { 'No process had more than one running instance at cleanup time.' }
        else { $global:DuplicateReport | Sort-Object Name, PID | Format-Table -AutoSize Name, InstanceCount, PID, SizeMB, StartTime, Whitelisted, Path }
    }
    Save-Csv $dir '09_duplicate_processes' $global:DuplicateReport
    Save-Text $dir '10_excluded_from_closing' {
        'Processes deliberately NOT closed, with the reason each was spared.'
        "Recorder family in use: $($global:RecorderFamily)"
        ''
        $global:ExcludedReport | Sort-Object Reason, Name | Format-Table -AutoSize Name, PID, SizeMB, Signature, Reason, Path
    }
    Save-Csv $dir '10_excluded_from_closing' $global:ExcludedReport
    $failed = @($global:CloseLog | Where-Object { $_.Status -notlike 'Closed*' })
    Save-Text $dir '11_failed_to_close' {
        if ($failed.Count -eq 0) { 'Every non-excluded process was closed successfully.' }
        else { 'These processes survived the cleanup stage and were still running.'; ''; $failed | Format-Table -AutoSize Name, PID, SizeMB, Signed, Status, Path }
    }
    Save-Csv $dir '11_failed_to_close' $failed
    Save-Csv $dir '12_closed_processes' $global:CloseLog
    Save-Text $dir '13_network_connections' {
        $pm = @{}; foreach ($p in (Get-ProcTable)) { $pm[[int]$p.PID] = $p }
        Get-NetTCPConnection -ErrorAction SilentlyContinue | Where-Object { $_.State -in @('Listen', 'Established') } | ForEach-Object {
            $pr = $pm[[int]$_.OwningProcess]
            [PSCustomObject]@{ State = $_.State; Local = "$($_.LocalAddress):$($_.LocalPort)"; Remote = "$($_.RemoteAddress):$($_.RemotePort)"; PID = $_.OwningProcess; Process = $(if ($pr) { $pr.Name } else { $null }); Path = $(if ($pr) { $pr.Path } else { $null }) }
        } | Sort-Object State, Process | Format-Table -AutoSize
        'UDP endpoints:'
        Get-NetUDPEndpoint -ErrorAction SilentlyContinue | ForEach-Object { $pr = $pm[[int]$_.OwningProcess]; [PSCustomObject]@{ Local = "$($_.LocalAddress):$($_.LocalPort)"; PID = $_.OwningProcess; Process = $(if ($pr) { $pr.Name } else { $null }) } } | Format-Table -AutoSize
    }
    Save-Text $dir '16_root_certificates' { Get-ChildItem Cert:\LocalMachine\Root | Select-Object Subject, Thumbprint, NotBefore, NotAfter | Sort-Object NotBefore -Descending }
    Save-Text $dir '17_prefetch_files' {
        Get-ChildItem "$env:WINDIR\Prefetch" -Filter *.pf -ErrorAction SilentlyContinue |
            Select-Object Name, @{n='SizeKB';e={[math]::Round($_.Length / 1KB, 2)}}, CreationTime, LastWriteTime, LastAccessTime | Sort-Object LastWriteTime -Descending
    }
    Save-Text $dir '18_recent_items' {
        Get-ChildItem "$env:APPDATA\Microsoft\Windows\Recent" -ErrorAction SilentlyContinue |
            Select-Object Name, @{n='SizeKB';e={[math]::Round($_.Length / 1KB, 2)}}, CreationTime, LastWriteTime | Sort-Object LastWriteTime -Descending
    }
    Save-Text $dir '19_recent_items_targets' {
        $sh = New-Object -ComObject WScript.Shell
        Get-ChildItem "$env:APPDATA\Microsoft\Windows\Recent" -Filter *.lnk -ErrorAction SilentlyContinue | ForEach-Object {
            try { $lnk = $sh.CreateShortcut($_.FullName); [PSCustomObject]@{ Name = $_.Name; Target = $lnk.TargetPath; Arguments = $lnk.Arguments; LastWriteTime = $_.LastWriteTime } }
            catch { [PSCustomObject]@{ Name = $_.Name; Target = 'ERROR'; Arguments = ''; LastWriteTime = $_.LastWriteTime } }
        }
    }
    Save-Text $dir '20_mui_cache' {
        $k = 'HKCU:\Software\Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache'
        if (Test-Path $k) {
            (Get-ItemProperty -Path $k).PSObject.Properties | Where-Object { $_.Name -notlike 'PS*' } | ForEach-Object {
                $exe = ($_.Name -split '\.(FriendlyAppName|ApplicationCompany)$')[0]
                [PSCustomObject]@{ Entry = $_.Name; Value = $_.Value; SizeMB = SizeMB $exe }
            } | Sort-Object Entry
        } else { 'MuiCache key not present.' }
    }
    Save-Text $dir '21_bam_summary' {
        $bam = 'HKLM:\SYSTEM\CurrentControlSet\Services\bam\State\UserSettings'
        if (Test-Path $bam) {
            Get-ChildItem $bam -ErrorAction SilentlyContinue | ForEach-Object {
                "path: $($_.Name)"
                (Get-ItemProperty -Path $_.PSPath).PSObject.Properties | Where-Object { $_.Name -notlike 'PS*' -and $_.Value -is [byte[]] -and $_.Value.Length -ge 8 } | ForEach-Object {
                    $ft = [BitConverter]::ToInt64($_.Value, 0); $when = ''; try { $when = [datetime]::FromFileTime($ft).ToString('yyyy-MM-dd HH:mm:ss') } catch {}
                    "  {0}  last run {1}" -f $_.Name, $when
                }
                ''
            }
        } else { 'BAM key not present.' }
    }
    Save-Text $dir '23_security_summary' {
        Get-SystemStateLines
        ''
        '--- registered antivirus products ---'
        try { Get-CimInstance -Namespace root\SecurityCenter2 -ClassName AntiVirusProduct -ErrorAction Stop | ForEach-Object { "  {0}  (exe: {1})" -f $_.displayName, $_.pathToSignedProductExe } } catch { '  could not query SecurityCenter2' }
        ''
        '--- Malwarebytes verification result ---'
        "  recorder family in use: $($global:RecorderFamily)"
        foreach ($m in @($global:MalwarebytesVerified | Where-Object { $_ })) { "  verified: {0} (PID {1}) path {2}; signer {3}; knownBuild={4}; sha256 {5}" -f $m.Name, $m.PID, $m.Path, $m.Publisher, $m.KnownBuild, $m.SHA256 }
        foreach ($m in @($global:MalwarebytesRejected | Where-Object { $_ })) { "  NOT verified: {0} (PID {1}) path {2}; reasons: {3}" -f $m.Name, $m.PID, $m.Path, ($m.Reason -join '; ') }
        ''
        Get-Service -Name 'MBAMService','MBAMProtection','mbamchameleon','MBVpnTunnelService' -ErrorAction SilentlyContinue | ForEach-Object { "  {0}: {1}" -f $_.Name, $_.Status }
    }
    Save-Text $dir '24_powershell_check' {
        "version $($PSVersionTable.PSVersion), edition $($PSVersionTable.PSEdition)"
        "language mode: $($ExecutionContext.SessionState.LanguageMode)"
        "host: $($Host.Name), pid: $PID"
        "run method: $($global:RunMethod)"
    }
    Save-Text $dir '25_display_state' {
        "Active display count: $(Get-ActiveDisplayCount)"
        Get-DisplayDetail | Format-Table -AutoSize
        Get-MonitorNames
        "Virtual desktop count: $(Get-VirtualDesktopCount)"
    }
    $copyLog = @()
    $copyLog += Copy-ArtifactDir 'Prefetch (start)' "$env:WINDIR\Prefetch" (Join-Path $dir 'artifacts\start\Prefetch')
    $copyLog += Copy-ArtifactDir 'Recent items (start)' "$env:APPDATA\Microsoft\Windows\Recent" (Join-Path $dir 'artifacts\start\Recent')
    $copyLog | Set-Content -Path (Join-Path $dir '27_raw_artifact_copy_log_start.txt') -Encoding UTF8

    $acFolder = Get-AcFolder
    $zipPath = Join-Path $acFolder "FINDINGS-$stamp.zip"
    Add-FilesToZip $zipPath $dir (Get-ChildItem $dir -Recurse -File)
    Remove-Item $dir -Recurse -Force -ErrorAction SilentlyContinue
    $global:FindingsZip = $zipPath
    $global:StartSealHash = New-ZipSeal $zipPath 'START_SEAL.txt' 'START SEAL - SHA256 of every file collected at the start of the match.'
    Write-Host ""
    Write-Host "  SHOW THIS ON CAMERA NOW (it proves the start-of-match files cannot be changed during the match):" -ForegroundColor Yellow
    Write-Host "    START SEAL SHA256 : $global:StartSealHash" -ForegroundColor White
    Write-Host ""
    Read-Host "  Press Enter once the value above is shown on your recording"
    Write-Host ""
    Write-Host "  >>> START-OF-MATCH FILES SAVED - YOU MAY NOW START PLAYING <<<" -ForegroundColor Green
    Write-Host "  Leave this window open until the match is over." -ForegroundColor Red
    Write-Host "  Reminder: only reopen $(if ($tier -eq '2') { 'DISCORD APP, BROWSER and TASK MANAGER' } else { 'DISCORD APP and TASK MANAGER' }) - anything else = automatic fail." -ForegroundColor Red
    Write-Host ""
