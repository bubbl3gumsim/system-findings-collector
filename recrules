function FParseShim([byte[]]$b) {
    $out = @()
    if ($null -eq $b -or $b.Length -lt 64) { return $out }
    $n = $b.Length; $i = 0
    while ($i -lt ($n - 24)) {
        $j = [Array]::IndexOf($b, [byte]0x31, $i)
        if ($j -lt 0 -or $j -ge ($n - 24)) { break }
        if ($b[$j + 1] -eq 0x30 -and $b[$j + 2] -eq 0x74 -and $b[$j + 3] -eq 0x73) {
            $size = [BitConverter]::ToInt32($b, $j + 8)
            $plen = [BitConverter]::ToUInt16($b, $j + 12)
            if ($size -gt 0 -and $size -lt 65536 -and $plen -gt 0 -and $plen -lt 1024 -and ($j + 14 + $plen + 8) -le $n) {
                $path = [Text.Encoding]::Unicode.GetString($b, $j + 14, $plen)
                $out += [PSCustomObject]@{ Source = 'ShimCache'; Path = $path; Time = (FFileTime $b ($j + 14 + $plen)); Detail = 'file last-modified time, not a run time' }
                $i = $j + 12 + $size
                continue
            }
        }
        $i = $j + 1
    }
    return $out
}
