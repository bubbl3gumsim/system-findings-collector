# Kernel pseudo-processes: no file on disk, so no path.
$global:PseudoProcs = @('system','idle','registry','memory compression','secure system','vmmem','vmmemwsl','system idle process')

function Get-ProcVerdict([string]$name, [string]$path, [int]$procId = 0) {
    $n = ($name -replace '\.exe$', '').ToLower()
    $path = Normalize-Path $path
    if (-not $path -and $procId -gt 0) { $path = Normalize-Path (Get-ImagePathById $procId) }
    $v = [PSCustomObject]@{ Class = 'Unverified'; Verified = $false; Spare = $false; Mismatch = $false
        Unreadable = $false; Reason = ''; Path = $path; SigStatus = $null; Signer = $null; Location = 'unknown' }

    if (-not $path) {
        if ($global:PseudoProcs -contains $n) { $v.Class = 'Windows'; $v.Verified = $true; $v.Spare = $true; $v.Reason = 'kernel pseudo-process (no file)'; return $v }
        $v.Unreadable = $true
        if ($n -match $global:CoreWindowsNames) { $v.Class = 'Windows'; $v.Spare = $true; $v.Reason = 'core Windows file name; file path not readable'; return $v }
        $v.Class = 'Unreadable'; $v.Reason = 'file path not readable (protected, or the process had already exited)'
        return $v
    }

    $sig = Get-SigInfo $path
    $loc = Get-LocationClass $path
    $v.SigStatus = $sig.Status; $v.Signer = $sig.Cn; $v.Location = $loc
    $isMs = ($sig.Status -eq 'Valid' -and $sig.Publisher -and ($sig.Publisher -match '(?i)^CN="?Microsoft (?!3rd Party)'))

    foreach ($r in $global:TrustRules) {
        if ($n -notmatch $r.Names) { continue }
        $pathOk = ($path -match $r.Path)
        $sigOk  = ($sig.Status -eq 'Valid' -and $sig.Publisher -and ($sig.Publisher -match $r.Pub))
        # A spared program in a folder the player can write to needs a valid matching signature
        # (core Windows files are never legitimate there, signed or not).
        if ($pathOk -and $r.Spare -and $loc -eq 'user-writable' -and ((-not $sigOk) -or $r.Class -eq 'Windows')) { $pathOk = $false }
        # Unsigned helper files are accepted only inside Program Files, never in a folder the player can write to.
        if (-not $sigOk -and $r.AllowUnsigned -and $sig.Status -eq 'NotSigned' -and $loc -eq 'programfiles') { $sigOk = $true }
        if (-not $sigOk -and $r.CatalogOk -and $loc -eq 'driverstore' -and $isMs) { $sigOk = $true }
        if ($pathOk -and $sigOk) {
            $v.Class = $r.Class; $v.Verified = $true; $v.Spare = [bool]$r.Spare
            $v.Reason = "file name, folder and signature match ($($r.Class))"; return $v
        }
        if ($sig.Status -eq 'Missing') {
            $v.Reason = "file name matches $($r.Class) but the file no longer exists, so its signature could not be checked"
            return $v
        }
        $why = @()
        if (-not $pathOk) { $why += "folder '$(Split-Path $path -Parent)' is not an expected $($r.Class) folder" }
        if (-not $sigOk)  { $why += ("signature status '{0}'{1}" -f $sig.Status, $(if ($sig.Cn) { ", signer '$($sig.Cn)'" } else { '' })) }
        $v.Class = 'Mismatch'; $v.Mismatch = $true
        $v.Reason = "file name matches $($r.Class) program names, but " + ($why -join ' and ')
        return $v
    }

    if ($sig.Status -eq 'Valid' -and $loc -in @('programfiles','programdata')) {
        $byFolder = (Test-AllowedVpnPath $path)
        $bySigner = [bool]($sig.Cn -and ($sig.Cn -match "(?i)($global:AllowedVpnSigners)"))
        if ($byFolder -or $bySigner) {
            $v.Class = 'VPN'; $v.Verified = $true; $v.Spare = $true
            $how = if ($byFolder -and $bySigner) { "install folder and signer both match" } elseif ($byFolder) { "install folder matches" } else { "signer matches" }
            $v.Reason = "validly signed file of an allowed VPN vendor ($how; signer '$($sig.Cn)')"; return $v
        }
    }
    if ($isMs -and ($loc -in @('windows','programfiles','windowsapps','driverstore','programdata'))) {
        $v.Class = 'MicrosoftOther'; $v.Verified = $true; $v.Reason = 'signed by Microsoft, in a protected folder'; return $v
    }
    if ($sig.Status -eq 'Valid') {
        $v.Class = 'Signed'; $v.Verified = $true; $v.Reason = "valid signature, signer '$($sig.Cn)'"; return $v
    }
    if ($loc -eq 'windowsapps' -and $sig.Status -eq 'NotSigned') {
        $v.Class = 'Package'; $v.Verified = $true; $v.Reason = 'file inside a Store/MSIX package folder (these files carry no per-file signature)'; return $v
    }
    $v.Reason = ("signature status '{0}'{1}; folder type: {2}" -f $sig.Status, $(if ($sig.Cn) { ", signer '$($sig.Cn)'" } else { '' }), $loc)
    return $v
}

# Levenshtein distance (two-row version, works in Windows PowerShell 5.1)
function Get-EditDistance([string]$a, [string]$b) {
    $m = $a.Length; $n = $b.Length
    if ($m -eq 0) { return $n }
    if ($n -eq 0) { return $m }
    $prev = New-Object 'int[]' ($n + 1)
    $cur  = New-Object 'int[]' ($n + 1)
    for ($j = 0; $j -le $n; $j++) { $prev[$j] = $j }
    for ($i = 1; $i -le $m; $i++) {
        $cur[0] = $i
        for ($j = 1; $j -le $n; $j++) {
            $cost = 1
            if ($a[$i - 1] -eq $b[$j - 1]) { $cost = 0 }
            $best = $prev[$j] + 1
            $ins = $cur[$j - 1] + 1
            $sub = $prev[$j - 1] + $cost
            if ($ins -lt $best) { $best = $ins }
            if ($sub -lt $best) { $best = $sub }
            $cur[$j] = $best
        }
        $tmp = $prev; $prev = $cur; $cur = $tmp
    }
    return $prev[$n]
}
$global:LookalikeTargets = @('svchost','csrss','lsass','smss','wininit','winlogon','services','explorer','taskhostw','runtimebroker','conhost','dllhost','spoolsv','fontdrvhost','taskmgr','powershell','robloxplayerbeta','robloxplayerlauncher','discord','chrome','msedge','obs64','nvcontainer','mbamservice','audiodg','sihost','ctfmon','searchindexer','wmiprvse','msmpeng')

function Get-LookalikeOf([string]$name) {
    $n = ($name -replace '\.exe$', '').ToLower()
    if ($n.Length -lt 5) { return $null }
    if ($global:LookalikeTargets -contains $n) { return $null }
    foreach ($t in $global:LookalikeTargets) {
        if ([Math]::Abs($t.Length - $n.Length) -gt 1) { continue }
        if ($t.Length -lt 6) { continue }
        $dist = Get-EditDistance $n $t
        if ($dist -le 1) { return $t }
        if ($dist -le 2 -and $t.Length -ge 9) { return $t }
    }
    return $null
}

