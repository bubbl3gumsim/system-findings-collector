# RECORDING SOFTWARE SELECTION (manual - process auto-detection was unreliable)
# =========================================================================
# Only the family you say you're using gets whitelisted from closure - the
# other vendors' processes are still fair game for the cleanup stage.
$gpuNames = @(Get-CimInstance Win32_VideoController -ErrorAction SilentlyContinue | Select-Object -ExpandProperty Name)

$recorderFamilies = @{
    "OBS" = @{
        Whitelist = @("obs64", "obs32", "obs-browser-page", "obs-ffmpeg-mux", "obs-ffmpeg-mux32")
    }
    "NVIDIA" = @{
        Whitelist = @("NVIDIA Share", "nvcontainer", "NVIDIA Overlay", "NVDisplay.Container", "nvsphelper64", "NVIDIA Broadcast", "GFExperienceService", "NVIDIA GeForce Experience")
    }
    "AMD" = @{
        Whitelist = @("RadeonSoftware", "AMDRSServ", "AMDRSSrcExt", "RadeonRelive")
    }
}

# Name lists above are a best-effort guess and WILL miss real process names
# (this is exactly what let NVIDIA's recorder get closed last time). As a
# second, more reliable net: anything running from inside the vendor's own
# install directory is spared too, regardless of what it's called.
function Get-ProcPathSafe($p) {
    # Fast path: one bulk WMI query per cleanup run (built below), which reads
    # the process table directly and isn't subject to the access/architecture
    # issues that break Get-Process.Path.
    if ($global:CimPathMap -and $global:CimPathMap.ContainsKey([int]$p.Id)) {
        $cached = $global:CimPathMap[[int]$p.Id]
        if ($cached) { return $cached }
    }
    try {
        $path = $p.Path
        if ($path) { return $path }
    } catch {}
    try {
        $cim = Get-CimInstance Win32_Process -Filter "ProcessId = $($p.Id)" -ErrorAction Stop
        if ($cim -and $cim.ExecutablePath) { return $cim.ExecutablePath }
    } catch {}
    return $null
}

# Folder-name tokens rather than strict prefixes, so this still matches even
# if NVIDIA/AMD software ends up somewhere other than the default Program
# Files path, and it also covers driver-only installs (no GeForce
# Experience/Adrenalin app) where the overlay component ships inside
# DriverStore\FileRepository instead of Program Files.
$RecorderPathTokens = @(
    "\NVIDIA Corporation\",
    "\AMD\",
    "\ATI Technologies\",
    "\ATI\",
    "\DriverStore\FileRepository\nv_"
) | Where-Object { $_ }

function Test-IsRecorderPath($path) {
    if (-not $path) { return $false }
    foreach ($tok in $RecorderPathTokens) {
        if ($path -like "*$tok*") { return $true }
    }
    # Third net: the file's own signed vendor name, regardless of where it's
    # installed - catches a portable/relocated install the path check missed.
    try {
        if (Test-Path -LiteralPath $path) {
            $company = (Get-Item -LiteralPath $path -ErrorAction Stop).VersionInfo.CompanyName
            if ($company -match 'NVIDIA|Advanced Micro Devices|AMD Inc') { return $true }
        }
    } catch {}
    return $false
}

function Invoke-RecorderSetup {
    $global:RecorderFamily = "OBS + NVIDIA + AMD (all excluded)"
    $global:RecorderWhitelist = @(
