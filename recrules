function Test-GenuineMalwarebytes($proc) {
    $result = [PSCustomObject]@{
        Name        = $proc.ProcessName
        PID         = $proc.Id
        Path        = $null
        SizeMB      = $null
        InOfficialDir = $false
        SignatureOK = $false
        PublisherOK = $false
        Publisher   = $null
        SHA256      = $null
        KnownBuild  = $false
        Genuine     = $false
        Reason      = @()
    }

    try { $result.Path = $proc.Path } catch { $result.Path = $null }
    if (-not $result.Path) { $result.Path = Normalize-Path (Get-ImagePathById $proc.Id) }

    if (-not $result.Path) {
        $result.Reason += "executable path unavailable"
        return $result
    }

    $result.SizeMB = Get-SizeMB $result.Path

    foreach ($dir in $MalwarebytesOfficialDirs) {
        if ($dir -and $result.Path.StartsWith($dir, [StringComparison]::OrdinalIgnoreCase)) {
            $result.InOfficialDir = $true
            break
        }
    }
    if (-not $result.InOfficialDir) { $result.Reason += "not in official Malwarebytes install directory" }

    try {
        $sig = Get-AuthenticodeSignature -FilePath $result.Path -ErrorAction Stop
        $result.SignatureOK = ($sig.Status -eq "Valid")
        if ($sig.SignerCertificate) { $result.Publisher = $sig.SignerCertificate.Subject }
        if (-not $result.SignatureOK) { $result.Reason += "signature status: $($sig.Status)" }
        if ($result.Publisher -and $result.Publisher -match 'Malwarebytes') {
            $result.PublisherOK = $true
        } else {
            $result.Reason += "signing publisher is not Malwarebytes"
        }
    } catch {
        $result.Reason += "signature could not be read"
    }

    try {
        $result.SHA256 = (Get-FileHash -Path $result.Path -Algorithm SHA256 -ErrorAction Stop).Hash
        if ($MalwarebytesKnownHashes.ContainsKey($result.SHA256)) { $result.KnownBuild = $true }
    } catch {}

    $result.Genuine = ($result.InOfficialDir -and $result.SignatureOK -and $result.PublisherOK)
    if ($result.Genuine -and $result.Reason.Count -eq 0) { $result.Reason += "verified genuine" }
    return $result
}

function Invoke-MalwarebytesVerification {
    Section "Malwarebytes Integrity Verification"

    $candidates = @()
    foreach ($n in $MalwarebytesProcessNames) {
        $candidates += Get-Process -Name $n -ErrorAction SilentlyContinue
    }
    $candidates = $candidates | Sort-Object Id -Unique

    $global:MalwarebytesVerified = @()
    $global:MalwarebytesRejected = @()

    if (-not $candidates) {
        Write-Host "Malwarebytes isn't running - starting it..." -ForegroundColor DarkYellow
        $mbExe = Find-Exe @("MBAM.exe", "Malwarebytes.exe", "mbam.exe") @("$env:ProgramFiles\Malwarebytes\Anti-Malware", "$env:ProgramFiles\Malwarebytes", "${env:ProgramFiles(x86)}\Malwarebytes")
        if ($mbExe) { try { Start-Process $mbExe } catch {} }
        Start-Sleep -Seconds 8
        if (-not (@($MalwarebytesProcessNames | ForEach-Object { Get-Process -Name $_ -ErrorAction SilentlyContinue }))) {
            Write-Host "Couldn't start it automatically - open Malwarebytes yourself." -ForegroundColor Yellow
            Read-Host "Press Enter once Malwarebytes is running"
        }
        foreach ($n in $MalwarebytesProcessNames) {
            $candidates += Get-Process -Name $n -ErrorAction SilentlyContinue
        }
        $candidates = $candidates | Sort-Object Id -Unique
    }

    foreach ($proc in $candidates) {
        $v = Test-GenuineMalwarebytes $proc
        if ($v.Genuine) {
            $global:MalwarebytesVerified += $v
            $tag = if ($v.KnownBuild) { "verified + known build" } else { "verified (build not on file)" }
            Write-Host ("  OK    {0,-24} PID {1,-7} {2} MB  [{3}]" -f $v.Name, $v.PID, $v.SizeMB, $tag) -ForegroundColor Green
        } else {
            $global:MalwarebytesRejected += $v
            Write-Host ("  FAIL  {0,-24} PID {1,-7} {2}" -f $v.Name, $v.PID, ($v.Reason -join "; ")) -ForegroundColor Red
            Write-Host ("        path: {0}" -f $v.Path) -ForegroundColor Red
        }
    }

    # Only verified-genuine process names get spared.
    $global:MalwarebytesWhitelist = @($global:MalwarebytesVerified | ForEach-Object { $_.Name.ToLower() } | Select-Object -Unique)

    Write-Host ""
    if ($global:MalwarebytesRejected.Count -gt 0) {
        Write-Host "WARNING: $($global:MalwarebytesRejected.Count) process(es) named like Malwarebytes failed verification." -ForegroundColor Red
        Write-Host "They will NOT be excluded from closing and are flagged in the report." -ForegroundColor Red
    }
    Write-Host "Verified Malwarebytes components excluded from closing: $($global:MalwarebytesWhitelist.Count)" -ForegroundColor Green
}

# =========================================================================
# STAGE: CLOSE NON-ESSENTIAL PROCESSES (identity-checked - names alone never protect a program)
# =========================================================================
# Verified Discord / allowed-VPN programs that are running right now.
function Get-AllowedAppState {
    $st = [PSCustomObject]@{ Discord = 0; Vpn = @() }
    foreach ($p in (Get-ProcTable)) {
        $v = Get-ProcVerdict $p.Name $p.Path $p.PID
        if (-not $v.Verified) { continue }
        if ($v.Class -eq 'Discord') { $st.Discord = $st.Discord + 1 }
        elseif ($v.Class -eq 'VPN') { $st.Vpn += ($p.Name -replace '\.exe$', '') }
    }
    $st.Vpn = @($st.Vpn | Sort-Object -Unique)
    return $st
}

function Format-AppState($s) {
    $vpn = 'none'
    if (@($s.Vpn).Count -gt 0) { $vpn = (@($s.Vpn) -join ', ') }
    return ("Discord: {0} process(es); VPN: {1}" -f $s.Discord, $vpn)
}

# Compares the allowed apps before and after the cleanup and records both in the timeline.
function Show-AppStateAfterCleanup($before) {
    $after = Get-AllowedAppState
    $global:AppStateBefore = $before; $global:AppStateAfter = $after
    Add-TL 'CLEANUP' ("Allowed apps before cleanup: " + (Format-AppState $before))
    Add-TL 'CLEANUP' ("Allowed apps after cleanup : " + (Format-AppState $after))
    Write-Host ""
    Write-Host ("Allowed apps before: " + (Format-AppState $before)) -ForegroundColor Gray
    Write-Host ("Allowed apps after : " + (Format-AppState $after)) -ForegroundColor Gray
    $lostVpn = @(@($before.Vpn) | Where-Object { @($after.Vpn) -notcontains $_ })
    if ($lostVpn.Count -gt 0) {
        Write-Host ("WARNING: VPN program(s) stopped during cleanup: " + ($lostVpn -join ', ')) -ForegroundColor Yellow
        Add-Note ("VPN program(s) running before the cleanup were not running after it: " + ($lostVpn -join ', '))
    }
    if ($global:SpareDiscord -and $before.Discord -gt 0 -and $after.Discord -eq 0) {
        Write-Host "WARNING: Discord was running before the cleanup and is not running now." -ForegroundColor Yellow
        Add-Note 'Discord was running before the cleanup and was not running after it, although it was meant to be kept.'
    }
}

function Invoke-CloseNonEssential {
    Section "Close Non-Essential Processes"
    Add-TL 'CLEANUP' 'Cleanup stage started'

    # Scan FIRST so a renamed/fake program is recorded before it gets closed.
    Write-Host "Checking running programs (this takes a moment)..." -ForegroundColor Gray
    Invoke-AllScans 'PRE-CLEANUP'
    $appsBefore = Get-AllowedAppState

    $procs = @(Get-ProcTable | Sort-Object Name, PID)
    $selfPid = $PID

    # --- duplicate instances ---
    $global:DuplicateReport = @()
    $dups = $procs | Group-Object Name | Where-Object { $_.Count -gt 1 }
    foreach ($g in $dups) {
        foreach ($p in $g.Group) {
            $global:DuplicateReport += [PSCustomObject]@{ Name = $g.Name; InstanceCount = $g.Count; PID = $p.PID; Path = $p.Path
                SizeMB = Get-SizeMB $p.Path; StartTime = $p.Created; Whitelisted = (Get-ProcVerdict $p.Name $p.Path).Spare }
        }
    }
    if ($dups) {
        Write-Host "Programs running with MULTIPLE instances:" -ForegroundColor Yellow
        foreach ($g in $dups) { Write-Host ("  {0,-28} x{1}" -f $g.Name, $g.Count) -ForegroundColor Yellow }
        Write-Host ""
    }

    $global:ExcludedReport = @()
    $candidates = @()
    # This script's own process and the processes above it (the terminal hosting it) are never closed.
    # Any OTHER command interpreter is closed, even a genuine Windows one, so it cannot keep something running.
    $ancestors = @{}; $ancestors[[int]$selfPid] = $true
    $byPid = @{}; foreach ($pp in $procs) { $byPid[[int]$pp.PID] = $pp }
    $walk = [int]$selfPid; $steps = 0
    while ($byPid.ContainsKey($walk) -and $steps -lt 20) {
        $par = [int]$byPid[$walk].PPID
        if ($par -le 0 -or $ancestors.ContainsKey($par)) { break }
        $ancestors[$par] = $true; $walk = $par; $steps++
    }
    $closableShells = '(?i)^(cmd|powershell|pwsh|wscript|cscript|mshta|bash|wsl)(\.exe)?$'
    foreach ($p in $procs) {
        $v = Get-ProcVerdict $p.Name $p.Path
        $sig = Get-SigInfo $p.Path
        $spareIt = $v.Spare
        if ($spareIt -and $p.Name -match $closableShells -and -not $ancestors.ContainsKey([int]$p.PID)) { $spareIt = $false }
        if ($p.PID -eq $selfPid -or $spareIt) {
            $global:ExcludedReport += [PSCustomObject]@{ Name = $p.Name; PID = $p.PID; Path = $p.Path; SizeMB = Get-SizeMB $p.Path
                Signature = $sig.Status; Publisher = $sig.Publisher
                Reason = $(if ($p.PID -eq $selfPid) { "this script's own process" } else { "$($v.Class): $($v.Reason)" }) }
        } else {
            $candidates += [PSCustomObject]@{ P = $p; V = $v; Sig = $sig }
        }
    }

    if (-not $candidates) {
        Write-Host "Nothing to close - only verified programs are running." -ForegroundColor Gray
        $global:CloseLog = @()
        Show-AppStateAfterCleanup $appsBefore
        return
    }

    Write-Host "Closing $($candidates.Count) program(s) that are not verified Windows / Roblox / recorder / Malwarebytes / allowed VPN$(if ($global:SpareDiscord) { ' / Discord' })..." -ForegroundColor Cyan
    Write-Host ""

    # Close parents before their children. Killing a child first makes apps like Discord (Electron)
    # relaunch it or show a crash window; killing the parent first lets the children exit quietly.
    $depthOf = @{}
    foreach ($pp in $procs) {
        $d = 0; $w = [int]$pp.PID
        while ($d -lt 20 -and $byPid.ContainsKey($w)) {
            $par = [int]$byPid[$w].PPID
            if ($par -le 0 -or -not $byPid.ContainsKey($par)) { break }
            $d++; $w = $par
        }
        $depthOf[[int]$pp.PID] = $d
    }
    $candidates = @($candidates | Sort-Object { $depthOf[[int]$_.P.PID] })

    $log = @()
    foreach ($c in $candidates) {
        $p = $c.P; $v = $c.V; $sig = $c.Sig
        $reason = @()
        $susp = $false
        if ($v.Mismatch) { $susp = $true; $reason += $v.Reason }
        if ($sig.Status -ne 'Valid' -and $p.Path) { $susp = $true; $reason += "unsigned or invalid signature ($($sig.Status))" }
        if (Test-UserWritablePath $p.Path) { $susp = $true; $reason += 'running from a temp/downloads/desktop/appdata folder' }
        if (-not $p.Path) { $reason += 'path unavailable' }

        $status = 'Unknown'
        if (-not (Get-Process -Id $p.PID -ErrorAction SilentlyContinue)) { $status = 'Closed (already exited)' }
        else {
        try { Stop-Process -Id $p.PID -Force -ErrorAction Stop; $status = 'Closed' }
        catch {
            try {
                $svcs = @(Get-CimInstance Win32_Service -Filter "ProcessId = $($p.PID)" -ErrorAction Stop)
                foreach ($s in $svcs) { try { Stop-Service -Name $s.Name -Force -ErrorAction Stop } catch {} }
                Start-Sleep -Milliseconds 500
                if (-not (Get-Process -Id $p.PID -ErrorAction SilentlyContinue)) { $status = "Closed (service stopped: $(($svcs | ForEach-Object { $_.Name }) -join ', '))" }
                else {
                    $tk = & taskkill /F /PID $p.PID 2>&1
                    if ($LASTEXITCODE -eq 0) { $status = 'Closed (via taskkill)' } else { $status = "Failed to close: $tk" }
                }
            } catch { $status = "Failed to close: $($_.Exception.Message)" }
        }
        }
        $log += [PSCustomObject]@{ Name = $p.Name; PID = $p.PID; Path = $p.Path; SizeMB = Get-SizeMB $p.Path
            Signed = ($sig.Status -eq 'Valid'); Publisher = $sig.Publisher; StartTime = $p.Created
            Suspicious = $susp; Notes = ($reason -join '; '); Status = $status }
        $col = if ($status -like 'Closed*') { 'Green' } else { 'DarkYellow' }
        Write-Host ("{0,-25} PID {1,-7} {2}" -f $p.Name, $p.PID, $status) -ForegroundColor $col
        Add-TL 'CLEANUP' ("{0} (PID {1}) {2} -> {3}" -f $p.Name, $p.PID, $p.Path, $status)
        if ($status -notlike 'Closed*' -and -not $v.Verified) {
            Add-Finding 'CHECK' 'Software' 'A program with no verified identity could not be closed during cleanup' ("{0} (PID {1}) {2}: {3} :: {4}" -f $p.Name, $p.PID, $p.Path, $status, $v.Reason)
        }
    }
    $global:CloseLog = $log

    Write-Host ""
    $closed = @($log | Where-Object { $_.Status -like 'Closed*' }).Count
    Write-Host "Closed $closed of $($candidates.Count)." -ForegroundColor Green
    $failed = @($log | Where-Object { $_.Status -notlike 'Closed*' })
    if ($failed.Count -gt 0) {
        Write-Host "Could NOT be closed (explain them on camera):" -ForegroundColor DarkYellow
        foreach ($f in $failed) { Write-Host ("  {0} (PID {1}) {2}" -f $f.Name, $f.PID, $f.Path) -ForegroundColor DarkYellow }
    }
    Show-AppStateAfterCleanup $appsBefore
}


