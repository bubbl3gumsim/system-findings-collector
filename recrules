function Invoke-FpsUncap {
    Section "FPS Uncap"
    $settingsPath = Join-Path $env:LOCALAPPDATA "Roblox\GlobalBasicSettings_13.xml"

    $ans = $null
    while ($ans -notmatch '^[YyNn]$') { $ans = Read-Host "Uncap your FPS above 240? (Y/N)" }
    if ($ans -match '^[Nn]$') { Write-Host "Skipped - FPS cap left at the Roblox default." -ForegroundColor Gray; return }

    # Roblox rewrites this file on exit, so it must be closed while we edit.
    Get-Process RobloxPlayerBeta, RobloxPlayerLauncher, RobloxCrashHandler -ErrorAction SilentlyContinue |
        Stop-Process -Force -ErrorAction SilentlyContinue
    Start-Sleep -Seconds 1

    $fps = $null
    while ($null -eq $fps) {
        $raw = (Read-Host "Enter your FPS cap (whole number above 240), or just press Enter to edit it yourself in Notepad").Trim()
        if (-not $raw) { break }
        if ($raw -match '^\d{3,5}$' -and [int]$raw -gt 240) { $fps = [int]$raw }
        else { Write-Host "  Enter a whole number above 240 (e.g. 360), or leave blank for Notepad." -ForegroundColor Yellow }
    }

    # A clean reinstall may not have generated the file yet - create it from the default template.
    $utf8 = New-Object System.Text.UTF8Encoding($false)
    if (-not (Test-Path -LiteralPath $settingsPath)) {
        try {
            New-Item -ItemType Directory -Path (Split-Path $settingsPath) -Force | Out-Null
            [System.IO.File]::WriteAllText($settingsPath, ($RobloxSettingsTemplate -replace "`r?`n", "`r`n"), $utf8)
            Write-Host "Settings file didn't exist yet - created it from the default template." -ForegroundColor DarkYellow
        } catch {
            Write-Host "Could not create $settingsPath : $($_.Exception.Message)" -ForegroundColor Red
            return
        }
    }

    if ($null -ne $fps) {
        $ok = $false
        try {
            $xml = [System.IO.File]::ReadAllText($settingsPath)
            $pattern = '(<int name="FramerateCap">)-?\d+(</int>)'
            if ($xml -match $pattern) {
                $new = [regex]::Replace($xml, $pattern, ('${1}' + $fps + '${2}'))
                [System.IO.File]::WriteAllText($settingsPath, $new, $utf8)
                $check = [System.IO.File]::ReadAllText($settingsPath)
                if ($check -match ('<int name="FramerateCap">' + $fps + '</int>')) { $ok = $true }
            }
        } catch {}
        if ($ok) {
            Write-Host "FramerateCap set to $fps in GlobalBasicSettings_13.xml." -ForegroundColor Green
            return
        }
        Write-Host "Couldn't edit the file automatically - opening it in Notepad instead." -ForegroundColor Yellow
    }

    Write-Host "Change  <int name=`"FramerateCap`">-1</int>  to your value, save, then close Notepad." -ForegroundColor $theme.Accent
    Start-Process notepad.exe -ArgumentList ('"' + $settingsPath + '"') -Wait
}

function Invoke-Prerequisites {
    Section "Prerequisites"
    Write-Host " Your recording must meet ALL of these:" -ForegroundColor $theme.Accent
    Write-Host ""
    Write-Host "  1. Quality   : 1920x1080 (1080p) MIN  |  60 FPS MIN  |  5000 kbps MIN" -ForegroundColor White
    Write-Host "  2. Capture   : DISPLAY CAPTURE (full screen) only - no Game/Window/App Capture" -ForegroundColor White
    Write-Host "  3. Taskbar   : visible the whole time (no auto-hide)" -ForegroundColor White
    Write-Host "  4. Audio     : desktop audio captured (Sound mixer options opened for you)" -ForegroundColor White
    Write-Host "  5. Displays  : ONE display only (checked automatically)" -ForegroundColor White
    Write-Host "  6. Roblox    : official Roblox ONLY - straps are BANNED (Fishstrap, Bloxstrap, Voidstrap, etc.)" -ForegroundColor White
    if ($tier -eq '3') {
        Write-Host "  7. Phone rec : started BEFORE powering on the PC, landscape, keyboard/mouse/monitor in frame" -ForegroundColor White
    }
    Write-Host ""
    Write-Host "  Below the quality values = automatic re-record." -ForegroundColor Red
    Write-Host ""

    try { Start-Process "ms-settings:apps-volume" } catch {}

    # Automatic: single display, then Memory Integrity status
    Write-Host "  Checking displays..." -ForegroundColor Gray
    Assert-SingleDisplay
    Test-SecurityRules 'at set-up'
    $miLine = (Get-SystemStateLines | Where-Object { $_ -like 'Memory Integrity*' } | Select-Object -First 1)
    if ($miLine -match 'NOT RUNNING') { Write-Host "  $miLine  <- required to be ON (enable it and restart your PC BEFORE recording)" -ForegroundColor Red }
    elseif ($miLine) { Write-Host "  $miLine" -ForegroundColor Green }

    # Automatic: Roblox straps
    $strapNames = @("Bloxstrap","Fishstrap","Voidstrap")
    $strapDirs  = @("Bloxstrap","Fishstrap","Voidstrap") | ForEach-Object { Join-Path $env:LOCALAPPDATA $_ }
    $strapsFound = @()
    $strapsFound += $strapNames | Where-Object { Get-Process -Name $_ -ErrorAction SilentlyContinue }
    $strapsFound += $strapDirs  | Where-Object { Test-Path $_ }
    if ($strapsFound) {
        Write-Host ""
        Write-Host "  Roblox strap detected: $(($strapsFound | Select-Object -Unique) -join ', ')" -ForegroundColor Red
        Write-Host "  Straps are banned. It must be DELETED to continue (Roblox will be reinstalled clean)." -ForegroundColor Red
        $del = $null
        while ($del -notmatch '^[YyNn]$') { $del = Read-Host "  Delete the strap now and continue? (Y/N)" }
        if ($del -match '^[Nn]$') {
            Stop-SessionGuard
            Write-Host "Straps are not allowed - re-run once it's removed. Nothing else was changed." -ForegroundColor Cyan
            $global:AbortRun = $true
            return
        }
        Add-Finding 'CHECK' 'Set-up' 'A Roblox strap was present when the script started (the script then removed it)' (($strapsFound | Select-Object -Unique) -join ', ')
        Write-Host "  Removing strap..." -ForegroundColor Cyan
        if (Remove-RobloxStrap $strapNames) {
            $global:StrapRemoved = $true
            Write-Host "  Strap removed." -ForegroundColor Green
        } else {
            Stop-SessionGuard
            Write-Host "  Couldn't fully remove it - delete the folder(s) above manually, then re-run." -ForegroundColor Red
            $global:AbortRun = $true
            return
        }
    } else {
        Write-Host "  No Roblox strap detected." -ForegroundColor Green
    }

    Write-Host ""
    $go = $null
    while ($go -notmatch '^[YyNn]$') { $go = Read-Host "  Meet all of the above? Continue (Y/N)" }
    if ($go -match '^[Nn]$') {
        Stop-SessionGuard
        Write-Host "Fix the items above, then re-run. Nothing was changed." -ForegroundColor Cyan
        $global:AbortRun = $true
        return
    }
    Show-DisplayAlertIfAny
}

