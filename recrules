function Write-GroupedFindings($sb, $items, [int]$max) {
    $groups = $items | Group-Object Area, Title
    foreach ($g in ($groups | Sort-Object { $_.Group[0].Area }, Name)) {
        [void]$sb.AppendLine(('   {0}: {1}   [{2}]' -f $g.Group[0].Area, $g.Group[0].Title, $g.Count))
        $shown = 0
        foreach ($f in ($g.Group | Sort-Object Time)) {
            if ($shown -ge $max) { break }
            [void]$sb.AppendLine(('      - [{0} {1}] {2}' -f $f.Time.ToString('HH:mm:ss'), $f.Phase, $f.Detail))
            $shown++
        }
        if ($g.Count -gt $max) { [void]$sb.AppendLine(('      ... {0} more in 00_ALL_FLAGS.csv' -f ($g.Count - $max))) }
    }
}

function Build-FlagsText {
    $sb = New-Object System.Text.StringBuilder
    $line = '====================================================================='
    [void]$sb.AppendLine($line)
    [void]$sb.AppendLine(' RECORDING RULES - FINDINGS SUMMARY')
    [void]$sb.AppendLine(' Every line below is something the script measured. Nothing is scored.')
    [void]$sb.AppendLine($line)
    [void]$sb.AppendLine((' Computer / user : {0} / {1}' -f $env:COMPUTERNAME, $env:USERNAME))
    [void]$sb.AppendLine((' Tier            : {0}' -f $tier))
    [void]$sb.AppendLine((' Script started  : {0}' -f $global:SessionStart.ToString('yyyy-MM-dd HH:mm:ss')))
    if ($global:MatchStart) { [void]$sb.AppendLine((' Match window    : {0}  to  {1}' -f $global:MatchStart.ToString('yyyy-MM-dd HH:mm:ss'), $(if ($global:MatchEnd) { $global:MatchEnd.ToString('yyyy-MM-dd HH:mm:ss') } else { '(not finished)' }))) }
    if ($global:DisplayLockedAt) { [void]$sb.AppendLine((' Display check   : passed (one display) at {0}' -f $global:DisplayLockedAt.ToString('HH:mm:ss'))) }
    [void]$sb.AppendLine((' Run method      : {0}' -f $global:RunMethod))
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine(' RULE CHECKS')
    $rules = @($global:Findings | Where-Object { $_.Kind -eq 'RULE' })
    foreach ($id in $global:RuleDefs.Keys) {
        $hits = @($rules | Where-Object { $_.Area -eq $id })
        if ($hits.Count -gt 0) { $res = 'FAIL' } elseif ($global:RuleChecked[$id]) { $res = 'PASS' } else { $res = 'NOT CHECKED' }
        if ($id -in @('Display','Desktop') -and $res -eq 'PASS' -and $global:GuardStats) { $res = 'PASS' }
        [void]$sb.AppendLine(('   [{0,-11}] {1}' -f $res, $global:RuleDefs[$id]))
        foreach ($h in ($hits | Sort-Object Time | Select-Object -First 25)) {
            [void]$sb.AppendLine(('                   - [{0} {1}] {2}: {3}' -f $h.Time.ToString('HH:mm:ss'), $h.Phase, $h.Title, $h.Detail))
        }
        if ($hits.Count -gt 25) { [void]$sb.AppendLine(('                   ... {0} more in 00_ALL_FLAGS.csv' -f ($hits.Count - 25))) }
    }
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine($line)
    [void]$sb.AppendLine(' SYSTEM STATE (at the end of the session)')
    [void]$sb.AppendLine($line)
    foreach ($l in (Get-SystemStateLines)) { [void]$sb.AppendLine("   $l") }
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine($line)
    [void]$sb.AppendLine(' OBSERVATIONS FOR STAFF TO COMPARE WITH THE VIDEO')
    [void]$sb.AppendLine(' (facts only; many are harmless on their own - see the detail line)')
    [void]$sb.AppendLine($line)
    $checks = @($global:Findings | Where-Object { $_.Kind -eq 'CHECK' })
    if ($checks.Count -eq 0) { [void]$sb.AppendLine('   (none)') } else { Write-GroupedFindings $sb $checks 15 }
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine($line)
    [void]$sb.AppendLine(' WHAT WAS AND WAS NOT MEASURED')
    [void]$sb.AppendLine($line)
    if ($global:GuardStats) {
        [void]$sb.AppendLine(("   - Display and virtual-desktop checks: {0} checks, longest gap between two checks {1} s." -f $global:GuardStats.Checks, $global:GuardStats.MaxGap))
        [void]$sb.AppendLine(("   - Proxy lock re-applied {0} time(s)." -f $global:GuardStats.ProxyFix))
    }
    [void]$sb.AppendLine(("   - Process-creation auditing (Security event 4688): {0}." -f $global:ProcAuditInfo))
    [void]$sb.AppendLine(("   - Native helper (protected-process paths, monitor paths, Roblox memory): {0}." -f $(if ($global:NativeOk) { 'available' } else { 'NOT available; slower methods used' })))
    if (-not $global:FullChecks) { [void]$sb.AppendLine('   - Tier 1: only the display, virtual-desktop and proxy-lock guard runs automatically, plus the file seal.') }
    foreach ($n in $global:ScanNotes) { [void]$sb.AppendLine("   - $n") }
    return $sb.ToString()
}

function Build-TimelineText {
    $sb = New-Object System.Text.StringBuilder
    [void]$sb.AppendLine('TIMELINE - everything the script saw, oldest first')
    [void]$sb.AppendLine('Format:  date time | BEFORE/DURING/AFTER the match | source | what happened')
    [void]$sb.AppendLine(('Match window: {0}  ->  {1}' -f $(if ($global:MatchStart) { $global:MatchStart.ToString('yyyy-MM-dd HH:mm:ss') } else { 'n/a' }), $(if ($global:MatchEnd) { $global:MatchEnd.ToString('yyyy-MM-dd HH:mm:ss') } else { 'n/a' })))
    [void]$sb.AppendLine('')
    foreach ($t in ($global:Timeline | Sort-Object Time)) {
        [void]$sb.AppendLine(('{0} | {1,-6} | {2,-10} | {3}' -f $t.Time.ToString('yyyy-MM-dd HH:mm:ss'), $t.Phase, $t.Source, $t.Detail))
    }
    return $sb.ToString()
}

# =========================================================================
# ZIP + SEAL
# =========================================================================
function Add-FilesToZip([string]$zipPath, [string]$root, $files) {
    Add-Type -AssemblyName System.IO.Compression
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    if (-not (Test-Path $zipPath)) { $z0 = [System.IO.Compression.ZipFile]::Open($zipPath, 'Create'); $z0.Dispose() }
    $zip = [System.IO.Compression.ZipFile]::Open($zipPath, 'Update')
    try {
        foreach ($f in $files) {
            $rel = $f.FullName.Substring($root.Length).TrimStart('\', '/') -replace '\\', '/'
            $old = $zip.GetEntry($rel); if ($old) { $old.Delete() }
            [void][System.IO.Compression.ZipFileExtensions]::CreateEntryFromFile($zip, $f.FullName, $rel, [System.IO.Compression.CompressionLevel]::Optimal)
        }
    } finally { $zip.Dispose() }
}

# Writes <sealName> into the zip: SHA256 of every other entry. Returns the SHA256 of the seal text.
function New-ZipSeal([string]$zipPath, [string]$sealName, [string]$title) {
    Add-Type -AssemblyName System.IO.Compression
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    $zip = [System.IO.Compression.ZipFile]::Open($zipPath, 'Update')
    $text = $null
    try {
        $lines = @($title, ('Sealed at: {0}' -f (Get-Date).ToString('yyyy-MM-dd HH:mm:ss')),
                   'To check: unzip, then compare each file hash (Get-FileHash <file>) with the list below.',
                   'A file edited after sealing shows a different hash.', '')
        $skip = @($sealName, 'SEAL.txt')
        foreach ($e in ($zip.Entries | Where-Object { $skip -notcontains $_.FullName } | Sort-Object FullName)) {
            $st = $e.Open(); $sha = [System.Security.Cryptography.SHA256]::Create()
            try { $h = ([BitConverter]::ToString($sha.ComputeHash($st))).Replace('-', '') } finally { $st.Dispose(); $sha.Dispose() }
            $lines += ('{0}  {1}' -f $h, $e.FullName)
        }
        $text = ($lines -join "`r`n") + "`r`n"
        $old = $zip.GetEntry($sealName); if ($old) { $old.Delete() }
        $se = $zip.CreateEntry($sealName)
        $bytes = (New-Object System.Text.UTF8Encoding($false)).GetBytes($text)
        $out = $se.Open()
        try { $out.Write($bytes, 0, $bytes.Length) } finally { $out.Dispose() }
    } finally { $zip.Dispose() }
    $sha2 = [System.Security.Cryptography.SHA256]::Create()
    try { return ([BitConverter]::ToString($sha2.ComputeHash((New-Object System.Text.UTF8Encoding($false)).GetBytes($text)))).Replace('-', '') } finally { $sha2.Dispose() }
}

function Get-AcFolder {
    $f = Join-Path ([Environment]::GetFolderPath('Desktop')) 'AC-FINDINGS'
    New-Item -ItemType Directory -Path $f -Force | Out-Null
    return $f
}

function Save-FinalPackage {
    $stamp = Get-Date -Format 'yyyy-MM-dd_HH-mm-ss'
    $acFolder = Get-AcFolder
    $work = Join-Path $env:TEMP "recrep_$stamp"
    New-Item -ItemType Directory -Path $work -Force | Out-Null
    $flagsTxt = Build-FlagsText
    Set-Content -Path (Join-Path $work '00_FLAGS_SUMMARY.txt') -Value $flagsTxt -Encoding UTF8
    Set-Content -Path (Join-Path $work '00_TIMELINE.txt') -Value (Build-TimelineText) -Encoding UTF8
    $diff = @(Compare-Snapshots $global:SnapStart $global:SnapEnd)
    if (-not $global:FullChecks) { $diff = @('Tier 1: snapshot comparison is not used.') }
    Set-Content -Path (Join-Path $work '00_START_vs_END_CHANGES.txt') -Value (@('Everything that changed between the start-of-match and end-of-match snapshots:', '') + $diff) -Encoding UTF8
    try { @($global:GuardLog | Select-Object Time, Kind, Name, PID, PPID, Path, Detail, Sig, Signer, Sha256) | Export-Csv -Path (Join-Path $work '00_GUARD_LOG.csv') -NoTypeInformation -Encoding UTF8 } catch {}
    try { @($global:Findings | Select-Object Time, Phase, Kind, Area, Title, Detail) | Export-Csv -Path (Join-Path $work '00_ALL_FLAGS.csv') -NoTypeInformation -Encoding UTF8 } catch {}
    try { if ($global:ProcAuditRows -and @($global:ProcAuditRows).Count -gt 0) { @($global:ProcAuditRows) | Export-Csv -Path (Join-Path $work '00_PROCESS_CREATION_4688.csv') -NoTypeInformation -Encoding UTF8 } } catch {}

    $zipPath = $global:FindingsZip
    if (-not $zipPath -or -not (Test-Path $zipPath)) { $zipPath = Join-Path $acFolder "FINDINGS-$stamp.zip" }
    Add-FilesToZip $zipPath $work (Get-ChildItem $work -File)
    $global:SealHash = New-ZipSeal $zipPath 'SEAL.txt' 'SEAL - SHA256 of every file inside this package (taken when the player finished).'

    $summaryCopy = Join-Path $acFolder "FLAGS-SUMMARY-$stamp.txt"
    Copy-Item (Join-Path $work '00_FLAGS_SUMMARY.txt') $summaryCopy -Force
    Remove-Item $work -Recurse -Force -ErrorAction SilentlyContinue
    $global:FindingsZip = $zipPath
    $global:FlagsCopy = $summaryCopy
    $global:ZipHash = Get-FileSha $zipPath
}
