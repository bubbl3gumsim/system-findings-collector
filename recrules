# =========================================================================
# DETECTION SCANS (run at set-up and again after the match - never mid-game)
# =========================================================================
function Get-ProcTable {
    $rows = @()
    try {
        $all = @(Get-CimInstance Win32_Process -ErrorAction Stop)
        $names = @{}
        foreach ($p in $all) { $names[[int]$p.ProcessId] = $p.Name }
        foreach ($p in $all) {
            $pn = $null
            if ($names.ContainsKey([int]$p.ParentProcessId)) { $pn = $names[[int]$p.ParentProcessId] }
            $rows += [PSCustomObject]@{ Name = $p.Name; PID = [int]$p.ProcessId; PPID = [int]$p.ParentProcessId
                ParentName = $pn; Path = $p.ExecutablePath; Cmd = $p.CommandLine; Created = $p.CreationDate }
        }
    } catch {}
    return $rows
}

function Test-UserWritablePath([string]$path) {
    if (-not $path) { return $false }
    return ($path -match '(?i)\\(temp|tmp|downloads|desktop|documents|appdata\\local\\temp|appdata\\roaming|public|programdata|\$recycle\.bin)\\')
}

# ---- 1. running programs: identity, look-alikes, cheat/macro/remote tools ----
function Scan-Processes([string]$label = 'SCAN') {
    $self = $PID
    foreach ($p in (Get-ProcTable)) {
        if ($p.PID -eq $self -or $p.PID -le 4) { continue }
        $v = Get-ProcVerdict $p.Name $p.Path
        $tag = "{0} (PID {1}) {2}" -f $p.Name, $p.PID, $p.Path
        if ($v.Impersonation) {
            Add-Flag 'Fake or renamed programs' 70 'Program is pretending to be a trusted one' "$tag :: $($v.Reason)"
            continue
        }
        if ($v.Unverifiable) { Add-Flag 'Fake or renamed programs' 3 'Core Windows program whose path could not be checked' $tag }
        $look = Get-LookalikeOf $p.Name
        if ($look) { Add-Flag 'Fake or renamed programs' 45 "Name looks like '$look' but is not it" $tag }
        if ($v.Trusted) { continue }

        $sig = Get-SigInfo $p.Path
        $nm = ($p.Name -replace '\.exe$', '')
        if ($nm -match $global:CheatRx -or ($p.Cmd -and $p.Cmd -match $global:CheatRx -and $p.Name -notmatch '(?i)^(powershell|pwsh|conhost|cmd)')) {
            Add-Flag 'Cheat tools and macros' 60 'Name/command line matches a known cheat or injector tool' "$tag :: $($p.Cmd)"
        }
        if ($nm -match $global:MacroRx) { Add-Flag 'Cheat tools and macros' 25 'Macro / hotkey / auto-clicker software running' $tag }
        if ($nm -match $global:RemoteRx) { Add-Flag 'Private cheat indicators' 35 'Remote-control or tunnel tool running' $tag }
        if (Test-UserWritablePath $p.Path) {
            Add-Flag 'Cheat tools and macros' 25 'Program running from Temp/Downloads/Desktop/AppData' $tag
        }
        if ($sig.Status -ne 'Valid' -and $sig.Status -ne 'NoPath') {
            Add-Flag 'Unsigned or injected code' 10 "Running program has no valid signature ($($sig.Status))" $tag
        }
        if ($p.Name -match '(?i)^(python|pythonw|node|java|javaw|wscript|cscript|mshta|rundll32|regsvr32|autohotkey.*|ahk.*)\.exe$' -and $p.Cmd) {
            Add-Flag 'Cheat tools and macros' 20 'Script interpreter running with a command line' "$tag :: $($p.Cmd)"
        }
        if (-not $p.Path) { Add-Flag 'Fake or renamed programs' 15 'Running program with unreadable path (hidden?)' "$($p.Name) (PID $($p.PID))" }
    }
}

# ---- 2. Roblox loaded modules + executable memory with no file behind it ----
function Scan-RobloxModules {
    $rp = @(Get-Process RobloxPlayerBeta -ErrorAction SilentlyContinue)
    if ($rp.Count -eq 0) { Add-Note 'Roblox was not running during this module scan.'; return }
    foreach ($proc in $rp) {
        $mods = $null
        try { $mods = @($proc.Modules) } catch { $mods = $null }
        if (-not $mods) { Add-Note 'Roblox blocked module listing (its own protection). Memory scan below used instead.'; continue }
        foreach ($m in $mods) {
            $mp = $m.FileName
            if (-not $mp) { continue }
            if ($mp -match '(?i)\\windows\\(system32|syswow64|winsxs)\\') { continue }
            $sig = Get-SigInfo $mp
            if ($sig.Status -ne 'Valid') {
                Add-Flag 'Unsigned or injected code' 45 'Unsigned module loaded inside Roblox' "$mp ($($sig.Status))"
            } elseif ($mp -notmatch '(?i)\\roblox\\' -and $sig.Publisher -notmatch 'Microsoft|NVIDIA|Advanced Micro|Intel|Realtek|Roblox|OBS|Google') {
                Add-Flag 'Unsigned or injected code' 25 'Third-party module loaded inside Roblox' "$mp ($($sig.Publisher))"
            }
        }
    }
}

$global:MemTypeLoaded = $false
function Initialize-MemScanType {
    if ($global:MemTypeLoaded) { return $true }
    try {
        Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
public static class RecMem {
    [StructLayout(LayoutKind.Sequential)]
    public struct MBI { public IntPtr BaseAddress; public IntPtr AllocationBase; public uint AllocationProtect; public ushort PartitionId; public IntPtr RegionSize; public uint State; public uint Protect; public uint Type; }
    [DllImport("kernel32.dll", SetLastError=true)] public static extern IntPtr OpenProcess(uint access, bool inherit, int pid);
    [DllImport("kernel32.dll", SetLastError=true)] public static extern bool CloseHandle(IntPtr h);
    [DllImport("kernel32.dll", SetLastError=true)] public static extern UIntPtr VirtualQueryEx(IntPtr h, IntPtr addr, out MBI mbi, UIntPtr len);
    public static string Scan(int pid) {
        IntPtr h = OpenProcess(0x0400 | 0x0010, false, pid);
        if (h == IntPtr.Zero) return "BLOCKED:" + Marshal.GetLastWin32Error();
        long addr = 0; int rwx = 0; int rx = 0; long rwxBytes = 0;
        MBI mbi = new MBI();
        UIntPtr sz = (UIntPtr)Marshal.SizeOf(typeof(MBI));
        while (addr < 0x7FFFFFFEFFFFL) {
            UIntPtr r = VirtualQueryEx(h, (IntPtr)addr, out mbi, sz);
            if (r == UIntPtr.Zero) break;
            long size = mbi.RegionSize.ToInt64();
            if (mbi.State == 0x1000 && mbi.Type == 0x20000) {
                if (mbi.Protect == 0x40) { rwx++; rwxBytes += size; }
                else if (mbi.Protect == 0x20) { rx++; }
            }
            long next = addr + size;
            if (next <= addr) break;
            addr = next;
        }
        CloseHandle(h);
        return "OK:" + rwx + ":" + rwxBytes + ":" + rx;
    }
}
'@ -ErrorAction Stop
        $global:MemTypeLoaded = $true
    } catch { return $false }
    return $true
}

function Scan-RobloxMemory {
    $rp = @(Get-Process RobloxPlayerBeta -ErrorAction SilentlyContinue)
    if ($rp.Count -eq 0) { return }
    if (-not (Initialize-MemScanType)) { Add-Note 'Memory scanner could not be compiled on this PC.'; return }
    foreach ($proc in $rp) {
        $res = $null
        try { $res = [RecMem]::Scan($proc.Id) } catch { $res = "ERROR:$($_.Exception.Message)" }
        if ($res -like 'OK:*') {
            $parts = $res.Split(':')
            $rwx = [int]$parts[1]; $mb = [math]::Round([double]$parts[2] / 1MB, 2); $rx = [int]$parts[3]
            Add-Note ("Roblox memory (PID {0}): {1} private read-write-execute regions ({2} MB), {3} private execute-only regions." -f $proc.Id, $rwx, $mb, $rx)
            if ($rwx -ge 8)     { Add-Flag 'Unsigned or injected code' 35 'Many executable memory regions with no file behind them in Roblox' "PID $($proc.Id): $rwx regions, $mb MB (heuristic - Roblox itself can use some)" }
            elseif ($rwx -ge 3) { Add-Flag 'Unsigned or injected code' 15 'Some executable memory regions with no file behind them in Roblox' "PID $($proc.Id): $rwx regions, $mb MB (low confidence)" }
        } else {
            Add-Note "Roblox memory scan not possible: $res (Roblox protection or permissions)."
        }
    }
}

# ---- 3. startup items, scheduled tasks, hotkeys and what they launch ----
function Scan-Startup([string]$label = 'SCAN') {
    $runKeys = @('HKCU:\Software\Microsoft\Windows\CurrentVersion\Run','HKCU:\Software\Microsoft\Windows\CurrentVersion\RunOnce',
                 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Run','HKLM:\Software\Microsoft\Windows\CurrentVersion\RunOnce',
                 'HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Run')
    foreach ($k in $runKeys) {
        if (-not (Test-Path $k)) { continue }
        $pr = Get-ItemProperty -Path $k -ErrorAction SilentlyContinue
        foreach ($prop in $pr.PSObject.Properties) {
            if ($prop.Name -like 'PS*') { continue }
            $val = [string]$prop.Value
            Add-TL 'STARTUP' ("Run key {0}: {1} = {2}" -f $k.Replace('HKCU:\Software\Microsoft\Windows\CurrentVersion\','HKCU..\').Replace('HKLM:\Software\Microsoft\Windows\CurrentVersion\','HKLM..\'), $prop.Name, $val)
            if ($val -match $global:CheatRx) { Add-Flag 'Cheat tools and macros' 50 'Startup entry matches a cheat tool' "$($prop.Name) = $val" }
            elseif ($val -match $global:MacroRx) { Add-Flag 'Cheat tools and macros' 20 'Startup entry for macro/hotkey software' "$($prop.Name) = $val" }
            elseif (Test-UserWritablePath $val) { Add-Flag 'Cheat tools and macros' 20 'Startup entry launches from Temp/Downloads/AppData' "$($prop.Name) = $val" }
        }
    }
    foreach ($d in @("$env:APPDATA\Microsoft\Windows\Start Menu\Programs\Startup", "$env:ProgramData\Microsoft\Windows\Start Menu\Programs\StartUp")) {
        if (-not (Test-Path $d)) { continue }
        foreach ($f in (Get-ChildItem $d -File -ErrorAction SilentlyContinue)) {
            Add-TL 'STARTUP' "Startup folder item: $($f.FullName) (modified $($f.LastWriteTime))" $f.LastWriteTime
            if ($f.Name -match $global:CheatRx) { Add-Flag 'Cheat tools and macros' 45 'Startup-folder item matches a cheat tool' $f.FullName }
        }
    }
    # scheduled tasks that are NOT Microsoft's and run something from a user folder
    try {
        foreach ($t in (Get-ScheduledTask -ErrorAction Stop | Where-Object { $_.TaskPath -notmatch '^\\Microsoft\\' -and $_.State -ne 'Disabled' })) {
            foreach ($a in @($t.Actions)) {
                $ex = [string]$a.Execute
                if (-not $ex) { continue }
                $line = "$ex $($a.Arguments)"
                if ($line -match $global:CheatRx) { Add-Flag 'Cheat tools and macros' 45 'Scheduled task matches a cheat tool' "$($t.TaskName): $line" }
                elseif (Test-UserWritablePath $ex) { Add-Flag 'Cheat tools and macros' 15 'Scheduled task launches from a user folder' "$($t.TaskName): $line" }
            }
        }
    } catch {}
    # shortcut files with a hotkey assigned, and what they open
    try {
        $sh = New-Object -ComObject WScript.Shell
        $dirs = @([Environment]::GetFolderPath('Desktop'), [Environment]::GetFolderPath('CommonDesktopDirectory'),
                  "$env:APPDATA\Microsoft\Windows\Start Menu\Programs", "$env:ProgramData\Microsoft\Windows\Start Menu\Programs") | Where-Object { $_ -and (Test-Path $_) }
        foreach ($d in $dirs) {
            foreach ($l in (Get-ChildItem $d -Filter *.lnk -Recurse -File -ErrorAction SilentlyContinue | Select-Object -First 800)) {
                try {
                    $s = $sh.CreateShortcut($l.FullName)
                    if ($s.Hotkey) {
                        Add-TL 'HOTKEY' ("Shortcut hotkey [{0}] on '{1}' launches {2} {3}" -f $s.Hotkey, $l.Name, $s.TargetPath, $s.Arguments)
                        Add-Flag 'Cheat tools and macros' 8 "Keyboard hotkey assigned to a shortcut ($($s.Hotkey))" "$($l.Name) -> $($s.TargetPath) $($s.Arguments)"
                    }
                } catch {}
            }
        }
    } catch {}
    # AutoHotkey scripts: list every hotkey and what it runs
    $roots = @("$env:USERPROFILE\Desktop", "$env:USERPROFILE\Documents", "$env:USERPROFILE\Downloads", "$env:APPDATA", "$env:LOCALAPPDATA\Temp")
    foreach ($r in $roots) {
        if (-not (Test-Path $r)) { continue }
        foreach ($f in (Get-ChildItem $r -Include *.ahk,*.ahk2 -Recurse -File -Depth 4 -ErrorAction SilentlyContinue | Select-Object -First 40)) {
            Add-Flag 'Cheat tools and macros' 35 'AutoHotkey script file found' "$($f.FullName) (modified $($f.LastWriteTime))"
            Add-TL 'HOTKEY' "AutoHotkey script: $($f.FullName)" $f.LastWriteTime
            try {
                foreach ($ln in (Get-Content -LiteralPath $f.FullName -TotalCount 400 -ErrorAction Stop)) {
                    if ($ln -match '^\s*([\^\+!#~\*\$<>]*[A-Za-z0-9_]+|[\^\+!#~\*\$<>]*(F\d+|XButton\d|LButton|RButton|MButton|WheelUp|WheelDown))\s*::') { Add-TL 'HOTKEY' ("  hotkey in {0}: {1}" -f $f.Name, $ln.Trim()) }
                    elseif ($ln -match '^\s*(Run|RunWait)\b') { Add-TL 'HOTKEY' ("  launches in {0}: {1}" -f $f.Name, $ln.Trim()) }
                }
            } catch {}
        }
    }
    # config folders of mouse/keyboard macro suites (log only - they are legal hardware tools)
    foreach ($c in @("$env:LOCALAPPDATA\LGHUB","$env:PROGRAMDATA\Razer","$env:LOCALAPPDATA\Razer","$env:PROGRAMFILES\Corsair","$env:APPDATA\SteelSeries","$env:APPDATA\TinyTask","$env:APPDATA\Pulover*")) {
        if (Test-Path $c) { Add-TL 'HOTKEY' "Macro-capable software settings present: $c"; Add-Flag 'Cheat tools and macros' 5 'Macro-capable mouse/keyboard software installed' $c }
    }
}

# ---- 4. network, DNS, hosts file, proxy, certificates, tunnels, command history ----
function Scan-Network([string]$label = 'SCAN') {
    $procs = @{}
    foreach ($p in (Get-ProcTable)) { $procs[[int]$p.PID] = $p }
    try {
        foreach ($c in (Get-NetTCPConnection -State Established -ErrorAction Stop)) {
            $ra = $c.RemoteAddress
            if ($ra -match '^(127\.|::1|0\.|10\.|192\.168\.|169\.254\.|172\.(1[6-9]|2\d|3[01])\.|fe80|fc|fd)') { continue }
            $p = $procs[[int]$c.OwningProcess]
            if (-not $p) { continue }
            $v = Get-ProcVerdict $p.Name $p.Path
            if ($v.Class -in @('Windows','MicrosoftOther','Roblox','OBS','NVIDIA','AMD','Malwarebytes','Discord','Browser','ScriptTool')) { continue }
            Add-TL 'NETWORK' ("{0} (PID {1}) -> {2}:{3}" -f $p.Name, $p.PID, $ra, $c.RemotePort)
            $sig = Get-SigInfo $p.Path
            if ($sig.Status -ne 'Valid') { Add-Flag 'Private cheat indicators' 30 'Unsigned/untrusted program talking to the internet' ("{0} -> {1}:{2} ({3})" -f $p.Name, $ra, $c.RemotePort, $p.Path) }
        }
        foreach ($c in (Get-NetTCPConnection -State Listen -ErrorAction Stop | Where-Object { $_.LocalAddress -in @('0.0.0.0','::') -and $_.LocalPort -gt 1024 })) {
            $p = $procs[[int]$c.OwningProcess]
            if (-not $p) { continue }
            $v = Get-ProcVerdict $p.Name $p.Path
            if (-not $v.Trusted -and $v.Class -notin @('Discord','Browser','ScriptTool')) {
                Add-Flag 'Private cheat indicators' 20 'Untrusted program is listening for outside connections' ("{0} port {1} ({2})" -f $p.Name, $c.LocalPort, $p.Path)
            }
        }
    } catch {}
    try {
        $dns = @(Get-DnsClientCache -ErrorAction Stop | Select-Object -ExpandProperty Entry -Unique)
        foreach ($d in $dns) {
            if ($d -match '(?i)(trycloudflare\.com|ngrok(-free)?\.(io|app|dev)|duckdns\.org|ddns\.net|no-ip\.|serveo\.net|localtunnel|playit\.gg|portmap\.io|loca\.lt|hopto\.org|zapto\.org)') {
                Add-Flag 'Private cheat indicators' 30 'Recent lookup of a tunnel / dynamic-DNS host' $d
            } elseif ($d -match '(?i)(synapse|krnl|fluxus|solara|wearedevs|executor|exploit|cheat|injector|sploit|scriptblox|rscripts|v3rmillion|unknowncheats|aimbot)') {
                Add-Flag 'Private cheat indicators' 40 'Recent lookup of a cheat-related website' $d
            } elseif ($d -match '^\d{1,3}(\.\d{1,3}){3}$') {
                Add-Flag 'Private cheat indicators' 10 'Program looked up a raw IP address' $d
            }
        }
        Add-TL 'NETWORK' ("DNS cache holds {0} entries at this moment" -f $dns.Count)
    } catch {}
    try {
        $hosts = @(Get-Content "$env:WINDIR\System32\drivers\etc\hosts" -ErrorAction Stop | Where-Object { $_ -match '^\s*[^#\s]' })
        foreach ($h in $hosts) {
            if ($h -notmatch '^\s*(127\.0\.0\.1|::1)\s+localhost\s*$') { Add-Flag 'Private cheat indicators' 40 'Custom entry in the hosts file' $h.Trim() }
        }
    } catch {}
    try {
        $ie = Get-ItemProperty 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Internet Settings' -ErrorAction Stop
        if ($ie.ProxyEnable -eq 1 -and $ie.ProxyServer) { Add-Flag 'Private cheat indicators' 30 'A Windows proxy is switched on' ([string]$ie.ProxyServer) }
        if ($ie.AutoConfigURL) { Add-Flag 'Private cheat indicators' 30 'Auto-proxy script configured' ([string]$ie.AutoConfigURL) }
    } catch {}
    try {
        foreach ($a in (Get-NetAdapter -IncludeHidden -ErrorAction Stop | Where-Object { $_.Status -eq 'Up' -and $_.InterfaceDescription -match '(?i)(tap-windows|wireguard|tailscale|zerotier|openvpn|hamachi|wintun|vpn|tunnel)' })) {
            Add-Flag 'Private cheat indicators' 15 'VPN / tunnel network adapter is up' "$($a.Name) - $($a.InterfaceDescription)"
        }
    } catch {}
    try {
        $cut = (Get-Date).AddDays(-45)
        foreach ($c in (Get-ChildItem Cert:\LocalMachine\Root -ErrorAction Stop | Where-Object { $_.NotBefore -gt $cut -and $_.Issuer -notmatch 'Microsoft' })) {
            Add-Flag 'Private cheat indicators' 30 'Recently added root certificate (can hide a man-in-the-middle proxy)' "$($c.Subject) added/valid from $($c.NotBefore)"
        }
    } catch {}
    $hist = "$env:APPDATA\Microsoft\Windows\PowerShell\PSReadLine\ConsoleHost_history.txt"
    if (Test-Path $hist) {
        try {
            $lines = @(Get-Content $hist -Tail 300 -ErrorAction Stop)
            foreach ($l in $lines) {
                if ($l -match '(?i)(wevtutil\s+(cl|clear-log)|Clear-EventLog|fsutil\s+usn\s+deletejournal|del(ete)?\s+.*\.pf|Remove-Item.*prefetch|Set-MpPreference|Add-MpPreference|bcdedit.*(testsigning|nointegritychecks|debug)|vssadmin\s+delete|sc\s+(stop|config).*(sysmain|eventlog|windefend))') {
                    Add-Flag 'Tampering and cleanup' 45 'PowerShell history shows a clean-up / security-change command' $l.Trim()
                } elseif ($l -match '(?i)(DownloadString|DownloadFile|Invoke-WebRequest|\biwr\b|\birm\b|curl\s+-|bitsadmin|certutil.*urlcache|Start-BitsTransfer|Invoke-Expression|\biex\b)' -and $l -notmatch 'bubbl3gumsim') {
                    Add-Flag 'Private cheat indicators' 20 'PowerShell history shows a download/run command' $l.Trim()
                }
            }
        } catch {}
    }
}

# ---- 5. tampering: prefetch, logs, clock, journals, defender, signing mode, drivers ----
function Scan-Tamper([string]$label = 'SCAN') {
    $pfDir = "$env:WINDIR\Prefetch"
    try {
        $en = (Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters' -ErrorAction Stop).EnablePrefetcher
        if ($en -eq 0) { Add-Flag 'Tampering and cleanup' 60 'Prefetch is switched OFF in the registry' 'EnablePrefetcher = 0 (normal is 3)' }
    } catch {}
    try {
        $sm = Get-Service SysMain -ErrorAction Stop
        if ($sm.Status -ne 'Running') { Add-Flag 'Tampering and cleanup' 45 'SysMain (Prefetch service) is not running' "$($sm.Status), start type $($sm.StartType)" }
    } catch {}
    $boot = $null
    try { $boot = (Get-CimInstance Win32_OperatingSystem -ErrorAction Stop).LastBootUpTime } catch {}
    try {
        $pf = @(Get-ChildItem $pfDir -Filter *.pf -ErrorAction Stop)
        Add-TL 'PREFETCH' ("Prefetch folder holds {0} files at this moment" -f $pf.Count)
        if ($pf.Count -eq 0) { Add-Flag 'Tampering and cleanup' 60 'Prefetch folder is EMPTY' $pfDir }
        elseif ($pf.Count -lt 40) { Add-Flag 'Tampering and cleanup' 20 'Prefetch folder has very few files (a used PC normally has 100+)' "$($pf.Count) files" }
        if ($pf.Count -gt 0 -and $boot) {
            $newest = ($pf | Sort-Object LastWriteTime -Descending | Select-Object -First 1)
            $oldest = ($pf | Sort-Object CreationTime | Select-Object -First 1)
            if ($newest.LastWriteTime -lt $boot) { Add-Flag 'Tampering and cleanup' 30 'No Prefetch file is newer than the last boot' "newest $($newest.Name) at $($newest.LastWriteTime), boot $boot" }
            if ($oldest.CreationTime -gt (Get-Date).AddDays(-2) -and (Get-Date) -gt $boot.AddHours(1)) { Add-Flag 'Tampering and cleanup' 25 'All Prefetch files were created in the last 2 days (folder looks recently wiped)' "oldest created $($oldest.CreationTime)" }
        }
        foreach ($f in ($pf | Where-Object { $_.Name -match $global:CheatRx })) { Add-Flag 'Cheat tools and macros' 55 'Prefetch shows a cheat-named program has run' "$($f.Name) last run $($f.LastWriteTime)" }
    } catch { Add-Flag 'Tampering and cleanup' 25 'Prefetch folder could not be read' "$pfDir" }
    try {
        $evs = @(Get-WinEvent -FilterHashtable @{ LogName = 'Security'; Id = 1102; StartTime = (Get-Date).AddDays(-14) } -MaxEvents 5 -ErrorAction Stop)
        foreach ($e in $evs) { Add-Flag 'Tampering and cleanup' 55 'Security event log was CLEARED' "at $($e.TimeCreated)" }
    } catch {}
    try {
        $evs = @(Get-WinEvent -FilterHashtable @{ LogName = 'System'; Id = 104; StartTime = (Get-Date).AddDays(-14) } -MaxEvents 5 -ErrorAction Stop)
        foreach ($e in $evs) { Add-Flag 'Tampering and cleanup' 55 'A Windows event log was CLEARED' "at $($e.TimeCreated)" }
    } catch {}
    try {
        $evs = @(Get-WinEvent -FilterHashtable @{ LogName = 'Security'; Id = 4616; StartTime = (Get-Date).AddDays(-2) } -MaxEvents 10 -ErrorAction Stop)
        foreach ($e in $evs) { Add-Flag 'Tampering and cleanup' 30 'System clock was changed recently' "at $($e.TimeCreated)" }
    } catch {}
    try {
        $evs = @(Get-WinEvent -FilterHashtable @{ LogName = 'System'; ProviderName = 'Microsoft-Windows-Kernel-General'; Id = 1; StartTime = (Get-Date).AddDays(-2) } -MaxEvents 10 -ErrorAction Stop)
        foreach ($e in ($evs | Where-Object { $_.Message -match 'change' })) { Add-Flag 'Tampering and cleanup' 20 'Kernel recorded a system-time change' "at $($e.TimeCreated)" }
    } catch {}
    try {
        $out = (& fsutil usn queryjournal $env:SystemDrive 2>&1 | Out-String)
        if ($out -match '(?i)not active|not found|error') { Add-Flag 'Tampering and cleanup' 35 'USN file-change journal is off or was deleted' ($out.Trim() -replace '\s+', ' ') }
        elseif ($out -match 'First USN\s*:\s*(\d+)' -and [int64]$matches[1] -gt 0 -and $boot) {
            Add-TL 'USN' ("USN journal first record number = {0}" -f $matches[1])
        }
    } catch {}
    try {
        $bcd = (& bcdedit /enum '{current}' 2>&1 | Out-String)
        if ($bcd -match '(?i)testsigning\s+Yes') { Add-Flag 'Tampering and cleanup' 60 'Windows TEST-SIGNING mode is on (allows unsigned drivers)' 'bcdedit testsigning Yes' }
        if ($bcd -match '(?i)nointegritychecks\s+Yes') { Add-Flag 'Tampering and cleanup' 60 'Driver integrity checks are turned off' 'bcdedit nointegritychecks Yes' }
        if ($bcd -match '(?i)\bdebug\s+Yes') { Add-Flag 'Tampering and cleanup' 40 'Kernel debugging is on' 'bcdedit debug Yes' }
    } catch {}
    try {
        $mp = Get-MpPreference -ErrorAction Stop
        foreach ($x in @($mp.ExclusionPath) + @($mp.ExclusionProcess) + @($mp.ExclusionExtension)) { if ($x) { Add-Flag 'Tampering and cleanup' 35 'Windows Defender exclusion present' $x } }
        if ($mp.DisableRealtimeMonitoring) { Add-Flag 'Tampering and cleanup' 25 'Defender real-time protection is off' '(may be normal if another antivirus is installed)' }
    } catch {}
    try {
        if (-not (Confirm-SecureBootUEFI -ErrorAction Stop)) { Add-Flag 'Tampering and cleanup' 15 'Secure Boot is OFF' '' }
    } catch {}
    try {
        $dg = Get-CimInstance -ClassName Win32_DeviceGuard -Namespace root\Microsoft\Windows\DeviceGuard -ErrorAction Stop
        if ($dg.VirtualizationBasedSecurityStatus -ne 2) { Add-Flag 'Tampering and cleanup' 15 'Virtualization-based security is not running' "status $($dg.VirtualizationBasedSecurityStatus)" }
        if (@($dg.SecurityServicesRunning) -notcontains 2) { Add-Flag 'Tampering and cleanup' 20 'Memory Integrity (HVCI) is not running' '' }
        if (@($dg.AvailableSecurityProperties) -notcontains 3) { Add-Flag 'Hardware and DMA' 10 'DMA protection is not available/enabled on this PC' 'Cannot rule out DMA devices as easily' }
    } catch {}
    # drivers
    try {
        foreach ($d in (Get-CimInstance Win32_SystemDriver -ErrorAction Stop | Where-Object { $_.State -eq 'Running' })) {
            $p = $d.PathName; if ($p) { $p = $p -replace '^\\\?\?\\', ''; $p = $p -replace '^\\SystemRoot', $env:WINDIR; $p = $p -replace '^system32', "$env:WINDIR\system32" }
            $base = [IO.Path]::GetFileNameWithoutExtension([string]$p)
            if ($d.Name -match $global:ByovdRx -or $base -match $global:ByovdRx) { Add-Flag 'Unsigned or injected code' 55 'Known abused/vulnerable driver is loaded' "$($d.Name) $p" }
            $sig = Get-SigInfo $p
            if ($p -and $sig.Status -notin @('Valid','Missing','NoPath')) { Add-Flag 'Unsigned or injected code' 45 'Running driver with an invalid or missing signature' "$($d.Name) $p ($($sig.Status))" }
            elseif ($p -and (Test-UserWritablePath $p)) { Add-Flag 'Unsigned or injected code' 45 'Driver running from a user folder' "$($d.Name) $p" }
        }
        foreach ($s in (Get-CimInstance Win32_Service -ErrorAction Stop | Where-Object { $_.PathName -match '(?i)(\\temp\\|\\downloads\\|\\appdata\\|\\users\\public\\)' })) {
            Add-Flag 'Cheat tools and macros' 30 'Service whose program lives in a user/temp folder' "$($s.Name): $($s.PathName)"
        }
    } catch {}
    try {
        $cs = Get-CimInstance Win32_ComputerSystem -ErrorAction Stop
        if ($cs.Model -match '(?i)(virtual|vmware|virtualbox|kvm|qemu|hyper-v)' -or $cs.Manufacturer -match '(?i)(vmware|qemu|xen|innotek|parallels)') {
            Add-Flag 'Tampering and cleanup' 40 'This PC is a VIRTUAL MACHINE' "$($cs.Manufacturer) / $($cs.Model)"
        }
    } catch {}
}

# ---- 6. hardware: DMA indicators, capture cards, microcontroller input devices ----
function Scan-Hardware([string]$label = 'SCAN') {
    try {
        $present = @(Get-PnpDevice -PresentOnly -ErrorAction Stop)
        foreach ($d in $present) {
            $id = [string]$d.InstanceId; $nm = [string]$d.FriendlyName
            if ($id -match $global:FpgaVenRx -and $id -match '^PCI\\') { Add-Flag 'Hardware and DMA' 45 'PCI device from an FPGA / bridge-chip vendor (typical of DMA cards)' "$nm [$id]" }
            if ($nm -match $global:DmaNameRx -or $id -match $global:DmaNameRx) { Add-Flag 'Hardware and DMA' 55 'Device name matches DMA/FPGA hardware' "$nm [$id]" }
            if ($id -match 'VID_0403&PID_(601F|601E)') { Add-Flag 'Hardware and DMA' 35 'FTDI FT601 USB3 bridge (used by some DMA cards)' "$nm [$id]" }
            if ($nm -match $global:CaptureRx) { Add-Flag 'Hardware and DMA' 30 'Video capture card present (can feed a second PC)' "$nm [$id]" }
            if ($id -match '^(USB|HID)\\' -and ($id -match $global:MicroVidRx -or $nm -match $global:MicroRx)) { Add-Flag 'Hardware and DMA' 40 'Microcontroller-type USB device (can fake mouse/keyboard input)' "$nm [$id]" }
            if ($d.Class -eq 'Net' -and $nm -match '(?i)(tap|tun|wintun)') { Add-TL 'HARDWARE' "Virtual network device: $nm" }
        }
        $cnt = @($present | Where-Object { $_.InstanceId -like 'PCI\*' }).Count
        Add-TL 'HARDWARE' ("{0} PCI devices, {1} USB devices present" -f $cnt, @($present | Where-Object { $_.InstanceId -like 'USB\*' }).Count)
    } catch { Add-Note 'Hardware list could not be read.' }
    try {
        foreach ($d in (Get-PnpDevice -ErrorAction Stop | Where-Object { $_.Status -eq 'Unknown' -or $_.Present -eq $false })) {
            $id = [string]$d.InstanceId; $nm = [string]$d.FriendlyName
            if ($nm -match $global:DmaNameRx -or $id -match $global:FpgaVenRx -or $nm -match $global:CaptureRx -or $id -match $global:MicroVidRx) {
                Add-Flag 'Hardware and DMA' 25 'A matching device was connected before but is not plugged in now' "$nm [$id]"
            }
        }
    } catch {}
    try {
        $gpus = @(Get-CimInstance Win32_VideoController -ErrorAction Stop)
        Add-TL 'HARDWARE' ("Graphics: " + (($gpus | ForEach-Object { $_.Name }) -join ' | '))
        if (@($gpus | Where-Object { $_.Name -notmatch '(?i)(basic|remote|virtual|meta|parsec)' }).Count -gt 2) { Add-Flag 'Hardware and DMA' 10 'More than two graphics adapters' (($gpus | ForEach-Object { $_.Name }) -join ' | ') }
    } catch {}
}

# ---- 7. screens (full evidence, incl. mirrored ones) ----
function Scan-Displays {
    $n = Get-ActiveDisplayCount
    $ev = @()
    try { foreach ($m in (Get-CimInstance -Namespace root\wmi -ClassName WmiMonitorID -ErrorAction Stop | Where-Object { $_.Active })) {
        $nm = ''; try { $nm = -join ($m.UserFriendlyName | Where-Object { $_ -gt 0 } | ForEach-Object { [char]$_ }) } catch {}
        $ev += ("monitor '{0}' [{1}]" -f $nm, $m.InstanceName) } } catch {}
    Add-TL 'DISPLAY' ("Active display count = {0}. {1}" -f $n, ($ev -join '; '))
    if ($n -gt 1) { Add-Flag 'Extra screens' 100 'MORE THAN ONE SCREEN DETECTED' (("count {0}: " -f $n) + ($ev -join '; ')) }
}

function Invoke-AllScans([string]$label = 'SCAN') {
    Add-TL 'SCAN' "Started $label scans"
    Scan-Displays
    if ($global:FullChecks) {
        $steps = @('Scan-Processes','Scan-RobloxModules','Scan-RobloxMemory','Scan-Startup','Scan-Network','Scan-Tamper','Scan-Hardware')
        foreach ($s in $steps) {
            try { & $s $label } catch { Add-Note "$s failed: $($_.Exception.Message)" }
        }
    }
    Add-TL 'SCAN' "Finished $label scans"
}

