function Save-Text([string]$dir, [string]$name, [scriptblock]$sb) {
    $path = Join-Path $dir "$name.txt"
    try { (& $sb) | Out-String -Width 500 | Set-Content -Path $path -Encoding UTF8 }
    catch { "ERROR: $_" | Set-Content -Path $path -Encoding UTF8 }
}
function Save-Csv([string]$dir, [string]$name, $data) {
    $path = Join-Path $dir "$name.csv"
    try { if ($data) { $data | Export-Csv -Path $path -NoTypeInformation -Encoding UTF8 } else { 'no rows' | Set-Content -Path $path -Encoding UTF8 } }
    catch { "ERROR: $_" | Set-Content -Path $path -Encoding UTF8 }
}
function Copy-ArtifactDir([string]$label, [string]$source, [string]$dest) {
    try {
        if (Test-Path $source) {
            New-Item -ItemType Directory -Path $dest -Force | Out-Null
            Copy-Item -Path (Join-Path $source '*') -Destination $dest -Recurse -Force -ErrorAction SilentlyContinue
            $copied = @(Get-ChildItem $dest -Recurse -File -ErrorAction SilentlyContinue)
            $sum = ($copied | Measure-Object Length -Sum).Sum
            $sizeMB = if ($null -eq $sum) { 0 } else { [math]::Round($sum / 1MB, 2) }
            return "OK   [$label] $($copied.Count) files, $sizeMB MB copied from '$source'"
        }
        return "SKIP [$label] source not found: $source"
    } catch { return "FAIL [$label] error copying from '$source': $_" }
}

function Invoke-StartCollection {
    Section "Findings Collection (start of match)"
    Write-Host "  Collecting the start-of-match state. This takes a few seconds - DO NOT start playing yet." -ForegroundColor Red
    $stamp = Get-Date -Format 'yyyy-MM-dd_HH-mm-ss'
    $dir = Join-Path $env:TEMP "findings_$stamp"
    New-Item -ItemType Directory -Path $dir -Force | Out-Null
    function SizeMB($p) { return (Get-SizeMB $p) }

    Save-Text $dir '01_process_parentage' { Get-ProcTable | Select-Object Name, PID, PPID, ParentName, @{n='SizeMB';e={ SizeMB $_.Path }}, Path, Cmd }
    Save-Text $dir '02_process_details' {
        Get-CimInstance Win32_Process | ForEach-Object {
            $pp = Normalize-Path $_.ExecutablePath; if (-not $pp) { $pp = Normalize-Path (Get-ImagePathById ([int]$_.ProcessId)) }
            [PSCustomObject]@{ ProcessId = $_.ProcessId; Name = $_.Name; ExecutablePath = $pp; SizeMB = SizeMB $pp; WorkingSetMB = [math]::Round($_.WorkingSetSize / 1MB, 2); CommandLine = $_.CommandLine }
        } | Format-List
    }
    Save-Text $dir '03_system_state' { Get-SystemStateLines }
    Save-Text $dir '04_scheduled_tasks' { Get-ScheduledTask | Select-Object TaskPath, TaskName, State, Author }
    Save-Text $dir '05_tasklist' { tasklist /v }
    Save-Text $dir '06_process_starttimes' {
        Get-Process | ForEach-Object {
            $p = $null; try { $p = $_.Path } catch {}; if (-not $p) { $p = Get-ImagePathById $_.Id }
            $st = $null; try { $st = $_.StartTime } catch {}
            [PSCustomObject]@{ Name = $_.Name; PID = $_.Id; StartTime = $st; SizeMB = SizeMB $p; Path = $p }
        } | Sort-Object StartTime -Descending
    }
    Save-Text $dir '07_services_all' {
        Get-CimInstance Win32_Service | ForEach-Object {
            $bin = $_.PathName; $exe = $null
            if ($bin) { if ($bin -match '^"([^"]+)"') { $exe = $matches[1] } elseif ($bin -match '^(\S+\.exe)') { $exe = $matches[1] } }
            [PSCustomObject]@{ Name = $_.Name; DisplayName = $_.DisplayName; State = $_.State; StartMode = $_.StartMode; ProcessId = $_.ProcessId; SizeMB = SizeMB $exe; PathName = $bin }
        } | Sort-Object State, Name
    }
    Save-Text $dir '08_background_services' { Get-Service | Where-Object { $_.Status -eq 'Running' } | Select-Object Name, DisplayName, Status }
    Save-Text $dir '09_duplicate_processes' {
        if (-not $global:DuplicateReport -or @($global:DuplicateReport).Count -eq 0) { 'No process had more than one running instance at cleanup time.' }
        else { $global:DuplicateReport | Sort-Object Name, PID | Format-Table -AutoSize Name, InstanceCount, PID, SizeMB, StartTime, Whitelisted, Path }
    }
    Save-Csv $dir '09_duplicate_processes' $global:DuplicateReport
    Save-Text $dir '10_excluded_from_closing' {
        'Processes deliberately NOT closed, with the reason each was spared.'
        "Recorder family in use: $($global:RecorderFamily)"
        ''
        $global:ExcludedReport | Sort-Object Reason, Name | Format-Table -AutoSize Name, PID, SizeMB, Signature, Reason, Path
    }
    Save-Csv $dir '10_excluded_from_closing' $global:ExcludedReport
    $failed = @($global:CloseLog | Where-Object { $_.Status -notlike 'Closed*' })
    Save-Text $dir '11_failed_to_close' {
        if ($failed.Count -eq 0) { 'Every non-excluded process was closed successfully.' }
        else { 'These processes survived the cleanup stage and were still running.'; ''; $failed | Format-Table -AutoSize Name, PID, SizeMB, Signed, Status, Path }
    }
    Save-Csv $dir '11_failed_to_close' $failed
    Save-Csv $dir '12_closed_processes' $global:CloseLog
    Save-Text $dir '13_network_connections' {
        $pm = @{}; foreach ($p in (Get-ProcTable)) { $pm[[int]$p.PID] = $p }
        Get-NetTCPConnection -ErrorAction SilentlyContinue | Where-Object { $_.State -in @('Listen', 'Established') } | ForEach-Object {
            $pr = $pm[[int]$_.OwningProcess]
            [PSCustomObject]@{ State = $_.State; Local = "$($_.LocalAddress):$($_.LocalPort)"; Remote = "$($_.RemoteAddress):$($_.RemotePort)"; PID = $_.OwningProcess; Process = $(if ($pr) { $pr.Name } else { $null }); Path = $(if ($pr) { $pr.Path } else { $null }) }
        } | Sort-Object State, Process | Format-Table -AutoSize
        'UDP endpoints:'
        Get-NetUDPEndpoint -ErrorAction SilentlyContinue | ForEach-Object { $pr = $pm[[int]$_.OwningProcess]; [PSCustomObject]@{ Local = "$($_.LocalAddress):$($_.LocalPort)"; PID = $_.OwningProcess; Process = $(if ($pr) { $pr.Name } else { $null }) } } | Format-Table -AutoSize
    }
    Save-Text $dir '16_root_certificates' { Get-ChildItem Cert:\LocalMachine\Root | Select-Object Subject, Thumbprint, NotBefore, NotAfter | Sort-Object NotBefore -Descending }
    Save-Text $dir '17_prefetch_files' {
        Get-ChildItem "$env:WINDIR\Prefetch" -Filter *.pf -ErrorAction SilentlyContinue |
            Select-Object Name, @{n='SizeKB';e={[math]::Round($_.Length / 1KB, 2)}}, CreationTime, LastWriteTime, LastAccessTime | Sort-Object LastWriteTime -Descending
    }
    Save-Text $dir '18_recent_items' {
        Get-ChildItem "$env:APPDATA\Microsoft\Windows\Recent" -ErrorAction SilentlyContinue |
            Select-Object Name, @{n='SizeKB';e={[math]::Round($_.Length / 1KB, 2)}}, CreationTime, LastWriteTime | Sort-Object LastWriteTime -Descending
    }
    Save-Text $dir '19_recent_items_targets' {
        $sh = New-Object -ComObject WScript.Shell
        Get-ChildItem "$env:APPDATA\Microsoft\Windows\Recent" -Filter *.lnk -ErrorAction SilentlyContinue | ForEach-Object {
            try { $lnk = $sh.CreateShortcut($_.FullName); [PSCustomObject]@{ Name = $_.Name; Target = $lnk.TargetPath; Arguments = $lnk.Arguments; LastWriteTime = $_.LastWriteTime } }
            catch { [PSCustomObject]@{ Name = $_.Name; Target = 'ERROR'; Arguments = ''; LastWriteTime = $_.LastWriteTime } }
        }
    }
    Save-Text $dir '20_mui_cache' {
        $k = 'HKCU:\Software\Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache'
        if (Test-Path $k) {
            (Get-ItemProperty -Path $k).PSObject.Properties | Where-Object { $_.Name -notlike 'PS*' } | ForEach-Object {
                $exe = ($_.Name -split '\.(FriendlyAppName|ApplicationCompany)$')[0]
                [PSCustomObject]@{ Entry = $_.Name; Value = $_.Value; SizeMB = SizeMB $exe }
            } | Sort-Object Entry
        } else { 'MuiCache key not present.' }
    }
    Save-Text $dir '21_bam_summary' {
        $bam = 'HKLM:\SYSTEM\CurrentControlSet\Services\bam\State\UserSettings'
        if (Test-Path $bam) {
            Get-ChildItem $bam -ErrorAction SilentlyContinue | ForEach-Object {
                "path: $($_.Name)"
                (Get-ItemProperty -Path $_.PSPath).PSObject.Properties | Where-Object { $_.Name -notlike 'PS*' -and $_.Value -is [byte[]] -and $_.Value.Length -ge 8 } | ForEach-Object {
                    $ft = [BitConverter]::ToInt64($_.Value, 0); $when = ''; try { $when = [datetime]::FromFileTime($ft).ToString('yyyy-MM-dd HH:mm:ss') } catch {}
                    "  {0}  last run {1}" -f $_.Name, $when
                }
                ''
            }
        } else { 'BAM key not present.' }
    }
    Save-Text $dir '23_security_summary' {
        Get-SystemStateLines
        ''
        '--- registered antivirus products ---'
        try { Get-CimInstance -Namespace root\SecurityCenter2 -ClassName AntiVirusProduct -ErrorAction Stop | ForEach-Object { "  {0}  (exe: {1})" -f $_.displayName, $_.pathToSignedProductExe } } catch { '  could not query SecurityCenter2' }
        ''
        '--- Malwarebytes verification result ---'
        "  recorder family in use: $($global:RecorderFamily)"
        foreach ($m in @($global:MalwarebytesVerified | Where-Object { $_ })) { "  verified: {0} (PID {1}) path {2}; signer {3}; knownBuild={4}; sha256 {5}" -f $m.Name, $m.PID, $m.Path, $m.Publisher, $m.KnownBuild, $m.SHA256 }
        foreach ($m in @($global:MalwarebytesRejected | Where-Object { $_ })) { "  NOT verified: {0} (PID {1}) path {2}; reasons: {3}" -f $m.Name, $m.PID, $m.Path, ($m.Reason -join '; ') }
        ''
        Get-Service -Name 'MBAMService','MBAMProtection','mbamchameleon','MBVpnTunnelService' -ErrorAction SilentlyContinue | ForEach-Object { "  {0}: {1}" -f $_.Name, $_.Status }
    }
    Save-Text $dir '24_powershell_check' {
        "version $($PSVersionTable.PSVersion), edition $($PSVersionTable.PSEdition)"
        "language mode: $($ExecutionContext.SessionState.LanguageMode)"
        "host: $($Host.Name), pid: $PID"
        "run method: $($global:RunMethod)"
    }
    Save-Text $dir '25_display_state' {
        "Active display count: $(Get-ActiveDisplayCount)"
        Get-DisplayDetail | Format-Table -AutoSize
        Get-MonitorNames
        "Virtual desktop count: $(Get-VirtualDesktopCount)"
    }
    $copyLog = @()
    $copyLog += Copy-ArtifactDir 'Prefetch (start)' "$env:WINDIR\Prefetch" (Join-Path $dir 'artifacts\start\Prefetch')
    $copyLog += Copy-ArtifactDir 'Recent items (start)' "$env:APPDATA\Microsoft\Windows\Recent" (Join-Path $dir 'artifacts\start\Recent')
    $copyLog | Set-Content -Path (Join-Path $dir '27_raw_artifact_copy_log_start.txt') -Encoding UTF8

    $acFolder = Get-AcFolder
    $zipPath = Join-Path $acFolder "FINDINGS-$stamp.zip"
    Add-FilesToZip $zipPath $dir (Get-ChildItem $dir -Recurse -File)
    Remove-Item $dir -Recurse -Force -ErrorAction SilentlyContinue
    $global:FindingsZip = $zipPath
    $global:StartSealHash = New-ZipSeal $zipPath 'START_SEAL.txt' 'START SEAL - SHA256 of every file collected at the start of the match.'
    Write-Host ""
    Write-Host "  SHOW THIS ON CAMERA NOW (it proves the start-of-match files cannot be changed during the match):" -ForegroundColor Yellow
    Write-Host "    START SEAL SHA256 : $global:StartSealHash" -ForegroundColor White
    Write-Host ""
    Read-Host "  Press Enter once the value above is shown on your recording"
    Write-Host ""
    Write-Host "  >>> START-OF-MATCH FILES SAVED - YOU MAY NOW START PLAYING <<<" -ForegroundColor Green
    Write-Host "  Leave this window open until the match is over." -ForegroundColor Red
    Write-Host "  Reminder: only reopen $(if ($tier -eq '2') { 'DISCORD APP, BROWSER and TASK MANAGER' } else { 'DISCORD APP and TASK MANAGER' }) - anything else = automatic fail." -ForegroundColor Red
    Write-Host ""
}

function Invoke-EndCollection {
    Section "End-of-match evidence"
    Write-Host "Collecting end-of-match evidence. This can take 1-2 minutes - please wait..." -ForegroundColor Gray
    $stamp = Get-Date -Format 'yyyy-MM-dd_HH-mm-ss'
    $dir = Join-Path $env:TEMP "findings_end_$stamp"
    New-Item -ItemType Directory -Path $dir -Force | Out-Null

    Save-Text $dir '14_driver_list' {
        Get-CimInstance Win32_SystemDriver | ForEach-Object {
            $p = Normalize-Path $_.PathName
            if ($p -and $p -match '^(?i)system32\\') { $p = "$env:WINDIR\$p" }
            $sig = Get-SigInfo $p
            $sha = ''
            if ($p -and $sig.Status -ne 'Missing' -and -not ($sig.Publisher -match '(?i)^CN="?Microsoft ')) { $sha = Get-ShaIfSmall $p }
            [PSCustomObject]@{ Name = $_.Name; State = $_.State; StartMode = $_.StartMode; Signature = $sig.Status; Signer = $sig.Cn; Path = $p; Sha256_nonMicrosoft = $sha }
        } | Sort-Object State, Name | Format-List
    }
    Save-Text $dir '15_user_folder_executables' {
        'Executable and script files in Downloads, Desktop, Documents, Temp and Public (3 folder levels deep), newest 300.'
        ''
        $roots = @("$env:USERPROFILE\Downloads", "$env:USERPROFILE\Desktop", "$env:USERPROFILE\Documents", "$env:TEMP", 'C:\Users\Public') | Where-Object { Test-Path $_ }
        $files = @(Get-ChildItem -Path $roots -Recurse -Depth 3 -File -ErrorAction SilentlyContinue | Where-Object { $_.Extension -match '(?i)^\.(exe|dll|sys|bat|cmd|ps1|vbs|scr|msi|ahk|jar|py|lua)$' } | Sort-Object LastWriteTime -Descending | Select-Object -First 300)
        $hashed = 0
        $fileRows = foreach ($f in $files) {
            $sig = $null; $sha = ''
            if ($f.Extension -match '(?i)^\.(exe|dll|sys)$') { $sig = Get-SigInfo $f.FullName; if ($sig.Status -ne 'Valid' -and $hashed -lt 60) { $sha = Get-ShaIfSmall $f.FullName; $hashed++ } }
            [PSCustomObject]@{ Created = $f.CreationTime; Modified = $f.LastWriteTime; SizeKB = [math]::Round($f.Length / 1KB, 1); Signature = $(if ($sig) { $sig.Status } else { 'not checked' }); Sha256_unsigned = $sha; Path = $f.FullName }
        }
        $fileRows | Format-List
    }
    Save-Text $dir '13b_dns_cache' { Get-DnsClientCache -ErrorAction SilentlyContinue | Select-Object Entry, Name, Type, Data | Sort-Object Entry }

    # ---- file creations/deletions since the script started (USN change journal) ----
    $usnLines = @()
    try {
        $raw = @()
        if ($global:SessionUsn) { $raw = @(& fsutil usn readjournal $env:SystemDrive "startusn=$($global:SessionUsn)" csv 2>&1) }
        $hasRows = (@($raw | Where-Object { $_ -match '^\d+,"' }).Count -gt 0)
        if (-not $hasRows) { $raw = @(& fsutil usn readjournal $env:SystemDrive csv 2>&1) }
        $rx = '^(\d+),"([^"]*\.(exe|dll|sys|bat|cmd|ps1|vbs|scr|msi|ahk|jar|py|lua))",\d+,0x[0-9a-fA-F]+,"([^"]*)","([^"]*)"'
        foreach ($l in $raw) {
            $m = [regex]::Match([string]$l, $rx, 'IgnoreCase')
            if (-not $m.Success) { continue }
            $t = $null; try { $t = [datetime]::Parse($m.Groups[5].Value) } catch {}
            if ($t -and $t -lt $global:SessionStart) { continue }
            if ($m.Groups[4].Value -notmatch 'File create|File delete|Rename') { continue }
            $usnLines += [PSCustomObject]@{ Time = $t; Name = $m.Groups[2].Value; Ext = $m.Groups[3].Value.ToLower(); Reason = $m.Groups[4].Value }
        }
    } catch { Add-Note "USN journal could not be read: $($_.Exception.Message)" }
    $usnLines = @($usnLines | Sort-Object Time)
    Set-Content -Path (Join-Path $dir '22_usn_journal_since_session.txt') -Encoding UTF8 -Value (@('Executable/script file creations, deletions and renames recorded by NTFS since the script started.', 'The journal stores file names only, not folders.', '') + @($usnLines | ForEach-Object { '{0} | {1} | {2}' -f $_.Time, $_.Name, $_.Reason }))
    $made = @{}; $dead = @{}
    foreach ($u in $usnLines) { if ($u.Ext -match '^(exe|bat|cmd|ps1|vbs|scr|ahk|sys)$') { if ($u.Reason -match 'File create') { $made[$u.Name.ToLower()] = 1 }; if ($u.Reason -match 'File delete') { $dead[$u.Name.ToLower()] = 1 } } }
    $both = @($made.Keys | Where-Object { $dead.ContainsKey($_) } | Sort-Object)
    if ($both.Count -gt 0) { Add-Finding 'CHECK' 'Software' 'Executable/script files were both created and deleted since the script started (NTFS journal; names only)' ("{0} name(s): {1}. Full list in 22_usn_journal_since_session.txt" -f $both.Count, (($both | Select-Object -First 25) -join ', ')) }

    Save-Csv $dir '00_HARDWARE_INVENTORY' @(Get-PnpDevice -PresentOnly -ErrorAction SilentlyContinue | Where-Object { $_.InstanceId -match '^(PCI|USB|HID|DISPLAY|BTH)' } | Select-Object Class, FriendlyName, Status, Manufacturer, InstanceId)

    Test-DeviceHistory
    Get-SessionEventFacts

    $copyLog = @()
    $copyLog += Copy-ArtifactDir 'Prefetch (end)' "$env:WINDIR\Prefetch" (Join-Path $dir 'artifacts\end\Prefetch')
    $copyLog += Copy-ArtifactDir 'Recent items (end)' "$env:APPDATA\Microsoft\Windows\Recent" (Join-Path $dir 'artifacts\end\Recent')
    $logSrc = "$env:WINDIR\System32\winevt\Logs"
    $logDst = Join-Path $dir 'artifacts\end\EventLogs'
    New-Item -ItemType Directory -Path $logDst -Force | Out-Null
    foreach ($ln in @('Security','System','Application','Windows PowerShell','Microsoft-Windows-PowerShell%4Operational','Microsoft-Windows-CodeIntegrity%4Operational','Microsoft-Windows-Windows Defender%4Operational','Microsoft-Windows-TaskScheduler%4Operational','Microsoft-Windows-Kernel-PnP%4Configuration','Microsoft-Windows-DriverFrameworks-UserMode%4Operational','Microsoft-Windows-WMI-Activity%4Operational','Microsoft-Windows-Bits-Client%4Operational','Microsoft-Windows-DNS-Client%4Operational','Microsoft-Windows-Sysmon%4Operational')) {
        $src = Join-Path $logSrc "$ln.evtx"
        if (Test-Path -LiteralPath $src) { try { Copy-Item -LiteralPath $src -Destination $logDst -Force -ErrorAction Stop; $copyLog += "OK   [event log] $ln" } catch { $copyLog += "FAIL [event log] $ln : $($_.Exception.Message)" } }
        else { $copyLog += "SKIP [event log] $ln (not present)" }
    }
    $copyLog | Set-Content -Path (Join-Path $dir '27_raw_artifact_copy_log_end.txt') -Encoding UTF8
    Add-FilesToZip $global:FindingsZip $dir (Get-ChildItem $dir -Recurse -File)
    Remove-Item $dir -Recurse -Force -ErrorAction SilentlyContinue
}
# =========================================================================
# STAGE: CLEAN REINSTALL (Tier 2/3 only)
# =========================================================================
function Invoke-RobloxReinstall {
    Section "Roblox Clean Reinstall"
    $robloxProcs = Get-Process RobloxPlayerBeta, RobloxPlayerLauncher, RobloxCrashHandler -ErrorAction SilentlyContinue
    if ($robloxProcs) {
        Write-Host "Closing Roblox..." -ForegroundColor Cyan
        $robloxProcs | Stop-Process -Force
        $robloxProcs | Wait-Process -Timeout 10 -ErrorAction SilentlyContinue
        Start-Sleep -Seconds 1
    }

    $robloxPath = "$env:LOCALAPPDATA\Roblox"
    if (Test-Path $robloxPath) {
        for ($attempt = 1; $attempt -le 3; $attempt++) {
            try {
                Remove-Item $robloxPath -Recurse -Force -ErrorAction Stop
                Write-Host "Removed: $robloxPath" -ForegroundColor Green
                break
            } catch {
                if ($attempt -lt 3) { Start-Sleep -Seconds 2 } else { Write-Host "Could not fully delete $robloxPath : $_" -ForegroundColor Red }
            }
        }
    }

    Write-Host "Opening the Roblox download page - install it yourself, this will detect when it's done." -ForegroundColor Cyan
    Start-Process "https://www.roblox.com/download"

    $installed = $false
    $elapsed = 0
    while (-not $installed -and $elapsed -lt 600) {
        Start-Sleep -Seconds 3
        $elapsed += 3
        if ((Test-Path (Join-Path $robloxPath "Versions")) -or (Get-Process RobloxPlayerBeta, RobloxPlayerLauncher -ErrorAction SilentlyContinue)) {
            $installed = $true
        } else { Write-Host "." -NoNewline -ForegroundColor DarkGray }
    }
    Write-Host ""
    if (-not $installed) {
        Write-Host "Didn't detect a completed install after 10 minutes. Launch Roblox once manually, then re-run." -ForegroundColor Red
        return $false
    }
    Write-Host "Roblox install detected." -ForegroundColor Green
    return $true
}

# =========================================================================
# BEFORE-LAUNCHING STEP FUNCTIONS
# =========================================================================
function Step-TrayIcons {
    Section "Hidden Tray Icons"
    Pause-ForCamera "Click the small arrow in the system tray ('Show hidden icons') and hover over each one."
}

function Step-Autoruns {
    Section "Sysinternals Autoruns"
    $exe = Find-Exe @("autoruns64.exe", "autoruns.exe") $searchDirs
    if ($exe) { Start-Process $exe -Verb RunAs } else { Write-Host "Launch Autoruns manually as Administrator." -ForegroundColor DarkYellow }
    Pause-ForCamera "Stay in the 'Everything' tab, wait for the scan (bottom left), when it says 'Ready', scroll slowly top to bottom."
}

function Step-DeviceManager {
    Section "Device Manager"
    Start-Process "devmgmt.msc"
    Pause-ForCamera "View > Show Hidden Devices, expand Display Adapters and Monitors."
}

function Step-UAC {
    Section "UAC Level"
    try { Start-Process "UserAccountControlSettings" } catch { Start-Process "control.exe" -ArgumentList "/name Microsoft.UserAccounts" }
    Pause-ForCamera "Confirm UAC slider is on the second-lowest setting."
}

function Step-RegeditExclusions {
    Section "Defender Exclusions (Registry)"
    $regeditKey = "HKCU:\Software\Microsoft\Windows\CurrentVersion\Applets\Regedit"
    try {
        if (-not (Test-Path $regeditKey)) { New-Item -Path $regeditKey -Force | Out-Null }
        Set-ItemProperty -Path $regeditKey -Name "LastKey" -Value "Computer\HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Defender\Exclusions" -Force
    } catch {}
    Start-Process "regedit.exe"
    Pause-ForCamera "Confirm it opened at ...\Windows Defender\Exclusions and click through all 5 subfolders."
}

function Step-Folders {
    Section "Prefetch + Recent Items"
    Start-Process "explorer.exe" -ArgumentList "$env:WINDIR\Prefetch"
    Start-Process "explorer.exe" -ArgumentList "shell:recent"
    Pause-ForCamera "Both folders opened: scroll each to the bottom and open any subfolders."
}

function Step-Malwarebytes([switch]$SkipScan) {
    Section "Malwarebytes"
    $exe = Find-Exe @("MBAM.exe", "Malwarebytes.exe", "mbam.exe") @("$env:ProgramFiles\Malwarebytes\Anti-Malware", "$env:ProgramFiles\Malwarebytes", "${env:ProgramFiles(x86)}\Malwarebytes")
    if ($exe) { Start-Process $exe } else { Write-Host "Launch Malwarebytes manually." -ForegroundColor DarkYellow }

    if (-not $SkipScan) { Pause-ForCamera "Dashboard > Scanner > Scan. Wait, then quarantine all detections." }

    Write-Host "Show ALL of the following on camera:" -ForegroundColor $theme.Header
    Confirm-MultiStep @(
        "Dashboard > Detection History > Allow List: only nohope.eu permitted.",
        "Settings > Protection: confirm everything is enabled EXCEPT 'Tamper Protection' at the bottom.",
        "Settings > Notifications: confirm all Protection notifications are on."
    )
}

function Step-CoreIsolation {
    Section "Core Isolation / Memory Integrity"
    Start-Process "windowsdefender://coreisolation"
    Write-Host "IF THIS TOGGLE ISN'T AVAILABLE/GREYED OUT: you cannot just skip it." -ForegroundColor Red
    Write-Host "Stop your recording, enable it, RESTART your PC, then start a new recording" -ForegroundColor Red
    Write-Host "from the beginning." -ForegroundColor Red
    Write-Host ""
    Write-Host "Show ALL of the following on camera:" -ForegroundColor $theme.Header
    Confirm-MultiStep @(
        "Memory Integrity (Core Isolation) is ON.",
        "Kernel-Mode Hardware-enforced Stack Protection is ON.",
        "Microsoft Vulnerable Driver Blocklist is ON."
    )
}

function Step-Hotkeys {
    Section "Recording Software Hotkeys"
    Pause-ForCamera "Open your recorder's hotkey settings and show them."
}

function Step-UnnecessarySoftwareCheck {
    # Tier 1 only. Reminder - nothing to type.
    Section "Unnecessary Hotkey/Mouse Software"
    Write-Host "Close any unnecessary hotkey/mouse software. Anything left open must be justified on camera." -ForegroundColor $theme.Accent
}

function Step-ProxyLock {
    Section "WinHTTP Proxy Lock"
    Enable-ProxyLock
    Write-Host "Proxy lock is ACTIVE - just continue." -ForegroundColor Green
    Write-Host "Keep this window open until your match is over." -ForegroundColor Red
}

function Step-JoinGame {
    Section "Join Game"
    Write-Host "Hold Windows + Tab while your game is loading up. Only one desktop is allowed." -ForegroundColor $theme.Accent
    Read-Host "Once joined and loaded, press Enter to continue"
    Show-DisplayAlertIfAny
}

function Step-DesktopCheck {
    Section "Desktop Check"
    Write-Host "Press Windows + Tab now. Only one desktop is allowed." -ForegroundColor $theme.Accent
    Read-Host "Press Enter once shown"
    Show-DisplayAlertIfAny
}

function Step-TaskManager([switch]$After) {
    Section "Task Manager"
    Start-Process "taskmgr.exe"
    if ($After) {
        Write-Host "Task Manager reopened - show it again, scroll to the VERY BOTTOM." -ForegroundColor Yellow
    } else {
        Write-Host "  1. Right-click the Name column header: enable Process Name AND Command Line." -ForegroundColor White
        Write-Host "  2. Widen Command Line until Disk and Network are OFF screen (CPU + Memory stay visible)." -ForegroundColor White
        Write-Host "  3. View > Expand All, then scroll to the VERY BOTTOM." -ForegroundColor White
    }
    Pause-ForCamera "Show Task Manager configured like this."
}

function Step-PowerShellDump {
    Section "PowerShell Process/System Dump"
    Get-CimInstance Win32_Process | Select-Object Name, ProcessId,
        @{n='SizeMB';e={ Get-SizeMB $_.ExecutablePath }}, CommandLine | Format-Table -AutoSize
    systeminfo | findstr /i "hyper os version page virtualization"
    Write-Host "Show ALL of the following on camera:" -ForegroundColor $theme.Header
    Confirm-MultiStep @(
        "Scroll the process dump above top to bottom, then back up.",
        "The systeminfo output above (Hyper-V / virtualization lines) is visible."
    )
}

function Invoke-BeforeLaunching([switch]$Repeat) {
    Step-TrayIcons
    if ($tier -in @('2','3')) {
        Step-Autoruns
    }
    if ($tier -eq '3') { Step-DeviceManager }
    Step-UAC
    Step-RegeditExclusions
    if ($tier -in @('1','3')) { Step-Folders }
    if ($tier -in @('2','3')) { Step-Malwarebytes -SkipScan:$Repeat }
    Step-CoreIsolation
    if ($tier -in @('2','3')) { Step-Hotkeys }
    if ($tier -eq '1' -and -not $Repeat) { Step-UnnecessarySoftwareCheck }
    Step-ProxyLock
    if ($Repeat) { Step-DesktopCheck } else { Step-JoinGame }
}

function Invoke-AfterLaunching([switch]$Repeat) {
    Step-TaskManager
    if ($tier -eq '1') { Step-PowerShellDump }
}

# =========================================================================
# RUN / MAIN ORCHESTRATION
# =========================================================================
Write-Host "IMPORTANT: START YOUR RECORDING NOW, BEFORE GOING ANY FURTHER." -ForegroundColor Red
Write-Host "This script does not detect your recorder for you - confirm it yourself." -ForegroundColor Red
Write-Host ""
Write-Host "IMPORTANT: MAXIMIZE this PowerShell window now and keep it maximized." -ForegroundColor $theme.Header
if ($tier -in @('2','3')) {
    Write-Host ""
    Write-Host "This will fully delete Roblox and reinstall it, then close every non-essential" -ForegroundColor $theme.Accent
    Write-Host "process once you've joined your match." -ForegroundColor $theme.Accent
    Write-Host ""
    Write-Host "Unsaved work in other apps WILL be lost. Save everything first." -ForegroundColor Red
} else {
    Write-Host ""
    Write-Host "Tier 1 does NOT reinstall Roblox and does NOT close your other apps." -ForegroundColor $theme.Accent
}
Write-Host ""
$confirm = Read-Host "Continue? (Y/N)"
if ($confirm -notmatch '^[Yy]') {
    Write-Host "Cancelled. Nothing was changed." -ForegroundColor Cyan
    return
}

$global:FullChecks = ($tier -ne '1')
if ($PSCommandPath) { $global:RunMethod = "local file $PSCommandPath (sha256 $(Get-FileSha $PSCommandPath))" }
else { $global:RunMethod = 'in memory (not a local file, e.g. irm | iex)' }
try { $q0 = (& fsutil usn queryjournal $env:SystemDrive 2>&1 | Out-String); if ($q0 -match 'Next Usn\s*:\s*(0x[0-9a-fA-F]+|\d+)') { $global:SessionUsn = $matches[1] } } catch {}
if ($global:FullChecks) { Enable-ProcessAudit }
Test-SessionIntegrity
Start-SessionGuard
Add-TL 'SESSION' "Script started, tier $tier. Process auditing: $global:ProcAuditInfo"

try {
    if ($tier -in @('2','3')) { Invoke-ToolCheck }
    Invoke-Prerequisites
    if ($global:AbortRun) { return }
    if ($tier -in @('2','3')) {
        Invoke-RecorderSetup
        Invoke-MalwarebytesVerification
    }

    if (($tier -in @('2','3')) -or $global:StrapRemoved) {
        if ($tier -eq '1') { Write-Host "Strap was removed - the official Roblox must be reinstalled." -ForegroundColor $theme.Accent }
        $ok = Invoke-RobloxReinstall
        if (-not $ok) { return }
        Invoke-FpsUncap
        Section "Please complete the Before Launching steps now."
    } else {
        Write-Host "Tier 1: skipping reinstall. Make sure Roblox is already installed and closed." -ForegroundColor $theme.Accent
    }

    Invoke-BeforeLaunching
    Invoke-AfterLaunching

    if ($tier -in @('2','3')) {
        Invoke-CloseNonEssential
        Show-ReopenWarning
        Step-TaskManager -After
        Invoke-StartCollection
    } else {
        Invoke-AllScans 'TIER1-START'
        Write-Host "A sealed file will be saved when you finish." -ForegroundColor Gray
    }
    Test-SecurityRules 'at the start of the match'
    $global:SnapStart = Get-Snapshot 'START'
    $global:MatchStart = Get-Date
    Add-TL 'MATCH' 'Match window opened (start-of-match snapshot taken)'
    try { (Get-Process -Id $PID).PriorityClass = 'BelowNormal' } catch {}

    Write-Host ""
    if ($tier -eq '1') { Write-Host "=== SETUP COMPLETE - YOU MAY NOW PLAY YOUR MATCH ===" -ForegroundColor $theme.Header }
    else { Write-Host "=== START-OF-MATCH FILES SAVED - KEEP PLAYING YOUR MATCH ===" -ForegroundColor $theme.Header }
    Write-Host "Do NOT close this window (the display guard and proxy lock depend on it)." -ForegroundColor Red

    $ready = $null
    while ($ready -notmatch '^\s*done\s*$') {
        $ready = Read-Host "When your match is completely finished, type DONE to start the end-of-match checks"
    }

    $global:MatchEnd = Get-Date
    try { (Get-Process -Id $PID).PriorityClass = 'Normal' } catch {}
    Add-TL 'MATCH' 'Player typed DONE - match window closed'
    Section "After Match Is Finished"
    Write-Host "Collecting end-of-match data - please wait..." -ForegroundColor Gray
    Test-SecurityRules 'at the end of the match'
    Set-RuleChecked 'Display'; Set-RuleChecked 'Desktop'
    if ($global:FullChecks) { Set-RuleChecked 'AllowedPrograms' }
    Invoke-AllScans 'END-OF-MATCH'
    $global:SnapEnd = Get-Snapshot 'END'
    $endCount = $global:SnapEnd.Displays
    if ($endCount -gt 1) { Add-Finding 'RULE' 'Display' 'More than one display was active when the match ended' "active displays: $endCount" $global:MatchEnd }
    if ($null -ne $global:SnapEnd.VDesk -and $global:SnapEnd.VDesk -gt 1) { Add-Finding 'RULE' 'Desktop' 'More than one virtual desktop existed when the match ended' "virtual desktops: $($global:SnapEnd.VDesk)" $global:MatchEnd }
    if ($null -eq $global:SnapEnd.VDesk) { Add-Note 'Virtual desktop count could not be read from the registry; the one-desktop rule was not measured.'; $global:RuleChecked.Remove('Desktop') }
    Show-DisplayAlertIfAny
    if ($global:FullChecks) { Invoke-EndCollection }
    else { Test-DeviceHistory }
    Invoke-BeforeLaunching -Repeat
    Invoke-AfterLaunching -Repeat

    Section "Removing Proxy Lock"
    netsh winhttp reset proxy
    Write-Host "Proxy lock removed automatically." -ForegroundColor Green
    Start-Sleep -Seconds 2

    Section "Sealing Findings"
    Stop-SessionGuard
    Convert-GuardLog
    Save-FinalPackage
    Write-Host "Findings package sealed: $global:FindingsZip" -ForegroundColor Green
    Write-Host ""
    Write-Host "SHOW THIS ON CAMERA (it proves the files were not edited afterwards):" -ForegroundColor Yellow
    if ($global:StartSealHash) { Write-Host "  START SEAL SHA256 : $global:StartSealHash   (same value as shown before the match)" -ForegroundColor White }
    Write-Host "  ZIP  SHA256       : $global:ZipHash" -ForegroundColor White
    Write-Host "  SEAL SHA256       : $global:SealHash" -ForegroundColor White
    Write-Host "  Sealed at         : $((Get-Date).ToString('yyyy-MM-dd HH:mm:ss'))" -ForegroundColor White
    Write-Host ""
    Read-Host "Press Enter once the values above are shown on your recording"

    if ($tier -in @('2','3')) {
        Section "Uploads"
        $zipDir = Join-Path ([Environment]::GetFolderPath('Desktop')) "AC-FINDINGS"
        if (Test-Path $zipDir) { Start-Process "explorer.exe" -ArgumentList $zipDir }
        Write-Host "Do these IN ORDER while still recording:" -ForegroundColor $theme.Accent
        Write-Host "  1. Upload the ZIP from AC-FINDINGS to 'ow-submissions' (do NOT open or edit it first)." -ForegroundColor White
        Read-Host "Press Enter once the upload is done"
        Write-Host "You may now stop your recording, then upload it to YouTube and post the link in 'ow-submissions'." -ForegroundColor $theme.Header
    } else {
        Write-Host "A sealed file was saved in the AC-FINDINGS folder on your Desktop - keep it, staff may ask for it." -ForegroundColor Gray
        Write-Host "=== TIER 1 CHECKS COMPLETE - YOU MAY NOW STOP YOUR RECORDING ===" -ForegroundColor $theme.Header
    }
}
finally {
    # Always put the player's PC back the way it was, even if the script stops early.
    try { (Get-Process -Id $PID).PriorityClass = 'Normal' } catch {}
    try { if ($global:GuardCtl) { Stop-SessionGuard } } catch {}
    try { netsh winhttp reset proxy | Out-Null } catch {}
    try { Restore-ProcessAudit } catch {}
}
