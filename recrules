function Get-ToolNameMatch([string]$name, $verdict) {
    $nm = ($name -replace '\.exe$', '')
    if ($nm -match $global:ToolStrongRx) { return 'strong' }
    if ($nm -match $global:ToolWeakRx -and $verdict -and -not $verdict.Verified) { return 'weak' }
    return $null
}

function Get-FileFacts($v) {
    if (-not $v.Path) { return '' }
    $s = "signature=$($v.SigStatus)"
    if ($v.Signer) { $s += "; signer=$($v.Signer)" }
    if (-not $v.Verified -or $v.Location -eq 'user-writable') { $s += "; sha256=" + (Get-ShaIfSmall $v.Path) }
    return $s
}

# =========================================================================
# DETECTION SCANS (run at set-up and after the match - never mid-game)
# Each scan only states facts it measured. Nothing here scores or concludes.
# =========================================================================
function Get-ProcTable {
    $rows = @()
    try {
        $all = @(Get-CimInstance Win32_Process -ErrorAction Stop)
        $names = @{}
        foreach ($p in $all) { $names[[int]$p.ProcessId] = $p.Name }
        foreach ($p in $all) {
            $pn = $null
            if ($names.ContainsKey([int]$p.ParentProcessId)) { $pn = $names[[int]$p.ParentProcessId] }
            $path = Normalize-Path $p.ExecutablePath
            if (-not $path) { $path = Normalize-Path (Get-ImagePathById ([int]$p.ProcessId)) }
            $rows += [PSCustomObject]@{ Name = $p.Name; PID = [int]$p.ProcessId; PPID = [int]$p.ParentProcessId
                ParentName = $pn; Path = $path; Cmd = $p.CommandLine; Created = $p.CreationDate }
        }
    } catch {}
    return $rows
}

# ---- 1. running programs ----
function Scan-Processes([string]$label = 'SCAN') {
    $pre = ($label -eq 'PRE-CLEANUP')
    $unreadable = @()
    foreach ($p in (Get-ProcTable)) {
        if ($p.PID -eq $PID -or $p.PID -le 4) { continue }
        $v = Get-ProcVerdict $p.Name $p.Path $p.PID
        $tag = "{0} (PID {1}) {2}" -f $p.Name, $p.PID, $v.Path
        $nm = ($p.Name -replace '\.exe$', '')
        if ($v.Unreadable -and $v.Class -eq 'Unreadable') { $unreadable += $p.Name }
        if ($v.Mismatch) { Add-Finding 'CHECK' 'Software' 'File name matches a known program but its identity does not' "$tag :: $($v.Reason)" }
        if (-not $v.Verified -and -not $v.Unreadable) {
            $look = Get-LookalikeOf $p.Name
            if ($look) { Add-Finding 'CHECK' 'Software' "File name differs from '$look' by 1-2 characters and has no verified identity" "$tag :: $($v.Reason)" }
        }
        $tm = Get-ToolNameMatch $p.Name $v
        if ($tm) { Add-Finding 'CHECK' 'Software' 'Running program has a name on the cheat/injector/debugger tool-name list' "$tag :: $(Get-FileFacts $v)" }
        elseif ($p.Cmd -and $p.Cmd -match $global:ToolCmdRx -and $nm -notmatch '(?i)^(powershell|pwsh|conhost|cmd)$') {
            Add-Finding 'CHECK' 'Software' 'Command line of a running program contains a tool name from the list' "$tag :: $($p.Cmd)"
        }
        if ($nm -match $global:MacroRx) { Add-Finding 'CHECK' 'Software' 'Hotkey / macro-capable software is running' "$tag :: $(Get-FileFacts $v)" }
        if ($v.Class -eq 'VPN' -and ($nm -notmatch $global:RemoteRx -or $nm -match '^(wireguard|openvpn.*)$')) { Add-TL 'NETWORK' "Allowed VPN software running: $tag :: $(Get-FileFacts $v)" }
        elseif ($nm -match $global:RemoteRx) { Add-Finding 'CHECK' 'Network' 'Remote-control, input-sharing or tunnel software is running' "$tag :: $(Get-FileFacts $v)" }
        if ($nm -match $global:VmProcRx) { Add-Finding 'CHECK' 'System state' 'Virtual-machine host process is running' $tag }
        if ($pre) { continue }
        if (-not $v.Verified -and -not $v.Unreadable -and -not $v.Mismatch) {
            Add-Finding 'CHECK' 'Software' 'Running program has no verified identity' "$tag :: $($v.Reason); $(Get-FileFacts $v)"
        }
        if ($p.Name -match '(?i)^(python|pythonw|node|java|javaw|wscript|cscript|mshta)\.exe$' -and $p.Cmd) {
            Add-Finding 'CHECK' 'Software' 'Script interpreter is running' "$tag :: $($p.Cmd)"
        }
    }
    if ($unreadable.Count -gt 0) {
        Add-Note ("{0} running process(es) had no readable file path and could not be identity-checked: {1}" -f $unreadable.Count, (($unreadable | Select-Object -Unique) -join ', '))
    }
}

# ---- 2. Roblox loaded modules + executable memory ----
function Scan-RobloxModules {
    $rp = @(Get-Process RobloxPlayerBeta -ErrorAction SilentlyContinue)
    if ($rp.Count -eq 0) { Add-Note 'Roblox module list: Roblox was not running during this scan.'; return }
    foreach ($proc in $rp) {
        $mods = $null
        try { $mods = @($proc.Modules) } catch { $mods = $null }
        if (-not $mods) { Add-Note "Roblox module list (PID $($proc.Id)): not readable (access denied by Roblox)."; continue }
        foreach ($m in $mods) {
            $mp = Normalize-Path $m.FileName
            if (-not $mp) { continue }
            if ($mp -match '(?i)\\windows\\(system32|syswow64|winsxs)\\') { continue }
            $sig = Get-SigInfo $mp
            if ($sig.Status -ne 'Valid') {
                Add-Finding 'CHECK' 'Software' 'A module loaded in Roblox has no valid signature' "$mp (status $($sig.Status))"
            } elseif ($mp -notmatch '(?i)\\roblox\\' -and $sig.Publisher -notmatch 'Microsoft|NVIDIA|Advanced Micro|Intel|Realtek|Roblox|OBS|Open Broadcaster|Google|Discord|Valve') {
                Add-Finding 'CHECK' 'Software' 'A module loaded in Roblox is signed by a publisher outside the overlay/driver list' "$mp (signer $($sig.Cn))"
            }
        }
    }
}

function Scan-RobloxMemory {
    $rp = @(Get-Process RobloxPlayerBeta -ErrorAction SilentlyContinue)
    if ($rp.Count -eq 0) { return }
    if (-not $global:NativeOk) { Add-Note 'Roblox memory scan not run: the native helper could not be compiled on this PC.'; return }
    foreach ($proc in $rp) {
        $res = $null
        try { $res = [RecNative]::Scan($proc.Id) } catch { $res = "ERROR:$($_.Exception.Message)" }
        if ($res -like 'OK:*') {
            $parts = $res.Split(':')
            $rwx = [int]$parts[1]; $mb = [math]::Round([double]$parts[2] / 1MB, 2); $rx = [int]$parts[3]
            Add-Note ("Roblox memory (PID {0}): {1} private read-write-execute region(s) ({2} MB), {3} private execute-only region(s)." -f $proc.Id, $rwx, $mb, $rx)
            if ($rwx -gt 0) { Add-Finding 'CHECK' 'Software' 'Roblox process holds private read-write-execute memory regions' "PID $($proc.Id): $rwx region(s), $mb MB" }
        } else {
            Add-Note "Roblox memory scan not possible (PID $($proc.Id)): $res"
        }
    }
}

# ---- 3. startup items, scheduled tasks, hotkeys ----
function Scan-Startup([string]$label = 'SCAN') {
    $runKeys = @('HKCU:\Software\Microsoft\Windows\CurrentVersion\Run','HKCU:\Software\Microsoft\Windows\CurrentVersion\RunOnce',
                 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Run','HKLM:\Software\Microsoft\Windows\CurrentVersion\RunOnce',
                 'HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Run')
    foreach ($k in $runKeys) {
        if (-not (Test-Path $k)) { continue }
        $pr = Get-ItemProperty -Path $k -ErrorAction SilentlyContinue
        foreach ($prop in $pr.PSObject.Properties) {
            if ($prop.Name -like 'PS*') { continue }
            $val = [string]$prop.Value
            Add-TL 'STARTUP' ("Run key {0}: {1} = {2}" -f $k, $prop.Name, $val)
            $exe = $val
            if ($val -match '^\s*"([^"]+)"') { $exe = $matches[1] } elseif ($val -match '^\s*(\S+\.exe)') { $exe = $matches[1] }
            $exeBase = [IO.Path]::GetFileNameWithoutExtension($exe)
            if ($exeBase -match $global:ToolStrongRx) { Add-Finding 'CHECK' 'Startup' 'Startup entry points to a program on the tool-name list' "$($prop.Name) = $val" }
            elseif ($exeBase -match $global:MacroRx) { Add-Finding 'CHECK' 'Startup' 'Startup entry for hotkey/macro-capable software' "$($prop.Name) = $val" }
            elseif (Test-UserWritablePath (Normalize-Path $exe)) { Add-Finding 'CHECK' 'Startup' 'Startup entry points into a Temp/Downloads/Desktop/Documents/Roaming folder' "$($prop.Name) = $val" }
        }
    }
    foreach ($d in @("$env:APPDATA\Microsoft\Windows\Start Menu\Programs\Startup", "$env:ProgramData\Microsoft\Windows\Start Menu\Programs\StartUp")) {
        if (-not (Test-Path $d)) { continue }
        foreach ($f in (Get-ChildItem $d -File -ErrorAction SilentlyContinue)) {
            Add-TL 'STARTUP' "Startup folder item: $($f.FullName) (modified $($f.LastWriteTime))" $f.LastWriteTime
            $b = [IO.Path]::GetFileNameWithoutExtension($f.Name)
            if ($b -match $global:ToolStrongRx) { Add-Finding 'CHECK' 'Startup' 'Startup-folder item has a name on the tool-name list' $f.FullName }
        }
    }
    try {
        foreach ($t in (Get-ScheduledTask -ErrorAction Stop | Where-Object { $_.TaskPath -notmatch '^\\Microsoft\\' -and $_.State -ne 'Disabled' })) {
            foreach ($a in @($t.Actions)) {
                $ex = Normalize-Path ([string]$a.Execute)
                if (-not $ex) { continue }
                $line = "$ex $($a.Arguments)"
                $b = [IO.Path]::GetFileNameWithoutExtension($ex)
                if ($b -match $global:ToolStrongRx -or $line -match $global:ToolCmdRx) { Add-Finding 'CHECK' 'Startup' 'Scheduled task runs a program on the tool-name list' "$($t.TaskPath)$($t.TaskName): $line" }
                elseif (Test-UserWritablePath $ex) { Add-Finding 'CHECK' 'Startup' 'Scheduled task runs a program from a Temp/Downloads/Desktop/Documents/Roaming folder' "$($t.TaskPath)$($t.TaskName): $line" }
            }
        }
    } catch {}
    try {
        $sh = New-Object -ComObject WScript.Shell
        $dirs = @([Environment]::GetFolderPath('Desktop'), [Environment]::GetFolderPath('CommonDesktopDirectory'),
                  "$env:APPDATA\Microsoft\Windows\Start Menu\Programs", "$env:ProgramData\Microsoft\Windows\Start Menu\Programs") | Where-Object { $_ -and (Test-Path $_) }
        foreach ($d in $dirs) {
            foreach ($l in (Get-ChildItem $d -Filter *.lnk -Recurse -File -ErrorAction SilentlyContinue | Select-Object -First 800)) {
                try {
                    $s = $sh.CreateShortcut($l.FullName)
                    if ($s.Hotkey) {
                        Add-TL 'HOTKEY' ("Shortcut hotkey [{0}] on '{1}' launches {2} {3}" -f $s.Hotkey, $l.Name, $s.TargetPath, $s.Arguments)
                        Add-Finding 'CHECK' 'Startup' "A shortcut has a keyboard hotkey assigned ($($s.Hotkey))" "$($l.FullName) -> $($s.TargetPath) $($s.Arguments)"
                    }
                } catch {}
            }
        }
    } catch {}
    $roots = @("$env:USERPROFILE\Desktop", "$env:USERPROFILE\Documents", "$env:USERPROFILE\Downloads", "$env:APPDATA", "$env:LOCALAPPDATA\Temp")
    foreach ($r in $roots) {
        if (-not (Test-Path $r)) { continue }
        foreach ($f in (Get-ChildItem $r -Include *.ahk,*.ahk2 -Recurse -File -Depth 4 -ErrorAction SilentlyContinue | Select-Object -First 40)) {
            Add-Finding 'CHECK' 'Software' 'AutoHotkey script file exists' "$($f.FullName) (modified $($f.LastWriteTime))"
            Add-TL 'HOTKEY' "AutoHotkey script: $($f.FullName)" $f.LastWriteTime
            try {
                foreach ($ln in (Get-Content -LiteralPath $f.FullName -TotalCount 400 -ErrorAction Stop)) {
                    if ($ln -match '^\s*([\^\+!#~\*\$<>]*[A-Za-z0-9_]+|[\^\+!#~\*\$<>]*(F\d+|XButton\d|LButton|RButton|MButton|WheelUp|WheelDown))\s*::') { Add-TL 'HOTKEY' ("  hotkey in {0}: {1}" -f $f.Name, $ln.Trim()) }
                    elseif ($ln -match '^\s*(Run|RunWait)\b') { Add-TL 'HOTKEY' ("  launches in {0}: {1}" -f $f.Name, $ln.Trim()) }
                }
            } catch {}
        }
    }
}

