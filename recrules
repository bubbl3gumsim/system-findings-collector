        try {
            foreach ($l in @(Get-Content $hist -Tail 300 -ErrorAction Stop)) {
                if ($l -match '(?i)(wevtutil\s+(cl|clear-log)|Clear-EventLog|fsutil\s+usn\s+deletejournal|del(ete)?\s+.*\.pf|Remove-Item.*prefetch|Set-MpPreference|Add-MpPreference|auditpol|bcdedit.*(testsigning|nointegritychecks|debug)|vssadmin\s+delete|sc\s+(stop|config).*(sysmain|eventlog|windefend))') {
                    Add-Finding 'CHECK' 'Tampering evidence' 'PowerShell history contains a clean-up or security-setting command' $l.Trim()
                } elseif ($l -match '(?i)(DownloadString|DownloadFile|Invoke-WebRequest|\biwr\b|\birm\b|curl\s+-|bitsadmin|certutil.*urlcache|Start-BitsTransfer|Invoke-Expression|\biex\b)') {
                    if (-not (Test-OfficialLaunchLine $l)) { Add-Finding 'CHECK' 'Network' 'PowerShell history contains a download or run-from-string command' $l.Trim() }
                }
            }
        } catch {}
    } else { Add-Note 'PowerShell console history file does not exist (nothing to read).' }
}

