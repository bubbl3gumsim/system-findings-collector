function Get-PhaseFor([datetime]$when) {
    if (-not $global:MatchStart -or $when -lt $global:MatchStart) { return 'BEFORE' }
    if ($global:MatchEnd -and $when -gt $global:MatchEnd) { return 'AFTER' }
    return 'DURING'
}

function Add-TL([string]$src, [string]$msg, $when = $null) {
    if ($null -eq $when) { $when = Get-Date }
    [void]$global:Timeline.Add([PSCustomObject]@{
        Time = [datetime]$when; Phase = (Get-PhaseFor ([datetime]$when)); Source = $src; Detail = $msg })
}

function Add-Flag([string]$cat, [int]$pts, [string]$title, [string]$detail = '') {
    $key = "$cat|$title|$detail"
    if ($global:FlagKeys.ContainsKey($key)) { return }
    $global:FlagKeys[$key] = $true
    $now = Get-Date
    if ($global:FlagTimeOverride) { $now = [datetime]$global:FlagTimeOverride }
    [void]$global:Flags.Add([PSCustomObject]@{
        Time = $now; Phase = (Get-PhaseFor $now); Category = $cat; Points = $pts; Title = $title; Detail = $detail })
    Add-TL 'FLAG' ("[{0}] {1} {2}" -f $cat, $title, $detail) $now
}

function Add-Note([string]$msg) { [void]$global:ScanNotes.Add(("[{0}] {1}" -f (Get-Date -Format 'HH:mm:ss'), $msg)) }

function Get-CategoryScore([string]$cat) {
    $sum = 0
    foreach ($f in $global:Flags) { if ($f.Category -eq $cat) { $sum += $f.Points } }
    return [int][Math]::Min(100, $sum)
}

function Get-OverallScore {
    # Chance-style combine: one very high category pulls the overall up,
    # many small flags add up, but a pile of tiny things can never hit 100 alone.
    $keep = 1.0
    foreach ($c in $global:FlagCategories.Keys) {
        $keep = $keep * (1 - ((Get-CategoryScore $c) / 100.0))
    }
    return [int][Math]::Round(100 * (1 - $keep))
}

function Get-ScoreBand([int]$s) {
    if ($s -lt 30) { return 'LOW CONCERN (good - normally fine to accept)' }
    if ($s -lt 60) { return 'MEDIUM CONCERN (a person should look at the evidence below)' }
    return 'HIGH CONCERN (manager decision needed)'
}

# ---------- signatures ----------
function Get-SigInfo($path) {
    if (-not $path) { return [PSCustomObject]@{ Status = 'NoPath'; Publisher = $null } }
    $k = $path.ToLower()
    if ($global:SigCache.ContainsKey($k)) { return $global:SigCache[$k] }
    $r = [PSCustomObject]@{ Status = 'Missing'; Publisher = $null }
    try {
        if (Test-Path -LiteralPath $path) {
            $s = Get-AuthenticodeSignature -LiteralPath $path -ErrorAction Stop
            $pub = $null
            if ($s.SignerCertificate) { $pub = $s.SignerCertificate.Subject }
            $r = [PSCustomObject]@{ Status = [string]$s.Status; Publisher = $pub }
        }
    } catch { $r = [PSCustomObject]@{ Status = 'Unreadable'; Publisher = $null } }
    $global:SigCache[$k] = $r
    return $r
}

