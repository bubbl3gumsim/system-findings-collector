function Invoke-RobloxReinstall {
    Section "Roblox Clean Reinstall"
    $robloxProcs = Get-Process RobloxPlayerBeta, RobloxPlayerLauncher, RobloxCrashHandler -ErrorAction SilentlyContinue
    if ($robloxProcs) {
        Write-Host "Closing Roblox..." -ForegroundColor Cyan
        $robloxProcs | Stop-Process -Force
        $robloxProcs | Wait-Process -Timeout 10 -ErrorAction SilentlyContinue
        Start-Sleep -Seconds 1
    }

    $robloxPath = "$env:LOCALAPPDATA\Roblox"
    if (Test-Path $robloxPath) {
        for ($attempt = 1; $attempt -le 3; $attempt++) {
            try {
                Remove-Item $robloxPath -Recurse -Force -ErrorAction Stop
                Write-Host "Removed: $robloxPath" -ForegroundColor Green
                break
            } catch {
                if ($attempt -lt 3) { Start-Sleep -Seconds 2 } else { Write-Host "Could not fully delete $robloxPath : $_" -ForegroundColor Red }
            }
        }
    }

    Write-Host "Opening the Roblox download page - install it yourself, this will detect when it's done." -ForegroundColor Cyan
    Start-Process "https://www.roblox.com/download"

    $installed = $false
    $elapsed = 0
    while (-not $installed -and $elapsed -lt 600) {
        Start-Sleep -Seconds 3
        $elapsed += 3
        if ((Test-Path (Join-Path $robloxPath "Versions")) -or (Get-Process RobloxPlayerBeta, RobloxPlayerLauncher -ErrorAction SilentlyContinue)) {
            $installed = $true
        } else { Write-Host "." -NoNewline -ForegroundColor DarkGray }
    }
    Write-Host ""
    if (-not $installed) {
        Write-Host "Didn't detect a completed install after 10 minutes. Launch Roblox once manually, then re-run." -ForegroundColor Red
        return $false
    }
    Write-Host "Roblox install detected." -ForegroundColor Green
    return $true
}

# =========================================================================
# BEFORE-LAUNCHING STEP FUNCTIONS
# =========================================================================
function Step-TrayIcons {
    Section "Hidden Tray Icons"
    Pause-ForCamera "Click the small arrow in the system tray ('Show hidden icons') and hover over each one."
}

function Step-Autoruns {
    Section "Sysinternals Autoruns"
    $exe = Find-Exe @("autoruns64.exe", "autoruns.exe") $searchDirs
    if ($exe) { Start-Process $exe -Verb RunAs } else { Write-Host "Launch Autoruns manually as Administrator." -ForegroundColor DarkYellow }
    Pause-ForCamera "Stay in the 'Everything' tab, wait for the scan (bottom left), when it says 'Ready', scroll slowly top to bottom."
}

function Step-DeviceManager {
    Section "Device Manager"
    Start-Process "devmgmt.msc"
    Pause-ForCamera "View > Show Hidden Devices, expand Display Adapters and Monitors."
}

function Step-UAC {
    Section "UAC Level"
    try { Start-Process "UserAccountControlSettings" } catch { Start-Process "control.exe" -ArgumentList "/name Microsoft.UserAccounts" }
    Pause-ForCamera "Confirm UAC slider is on the second-lowest setting."
}

function Step-RegeditExclusions {
    Section "Defender Exclusions (Registry)"
    $regeditKey = "HKCU:\Software\Microsoft\Windows\CurrentVersion\Applets\Regedit"
    try {
        if (-not (Test-Path $regeditKey)) { New-Item -Path $regeditKey -Force | Out-Null }
        Set-ItemProperty -Path $regeditKey -Name "LastKey" -Value "Computer\HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Defender\Exclusions" -Force
    } catch {}
    Start-Process "regedit.exe"
    Pause-ForCamera "Confirm it opened at ...\Windows Defender\Exclusions and click through all 5 subfolders."
}

function Step-Folders {
    Section "Prefetch + Recent Items"
    Start-Process "explorer.exe" -ArgumentList "$env:WINDIR\Prefetch"
    Start-Process "explorer.exe" -ArgumentList "shell:recent"
    Pause-ForCamera "Both folders opened: scroll each to the bottom and open any subfolders."
}

function Step-Malwarebytes([switch]$SkipScan) {
    Section "Malwarebytes"
    $exe = Find-Exe @("MBAM.exe", "Malwarebytes.exe", "mbam.exe") @("$env:ProgramFiles\Malwarebytes\Anti-Malware", "$env:ProgramFiles\Malwarebytes", "${env:ProgramFiles(x86)}\Malwarebytes")
    if ($exe) { Start-Process $exe } else { Write-Host "Launch Malwarebytes manually." -ForegroundColor DarkYellow }

    if (-not $SkipScan) { Pause-ForCamera "Dashboard > Scanner > Scan. Wait, then quarantine all detections." }

    Write-Host "Show ALL of the following on camera:" -ForegroundColor $theme.Header
    Confirm-MultiStep @(
        "Dashboard > Detection History > Allow List: only nohope.eu permitted.",
        "Settings > Protection: confirm everything is enabled EXCEPT 'Tamper Protection' at the bottom.",
        "Settings > Notifications: confirm all Protection notifications are on."
    )
}

function Step-CoreIsolation {
    Section "Core Isolation / Memory Integrity"
    Start-Process "windowsdefender://coreisolation"
    Write-Host "IF THIS TOGGLE ISN'T AVAILABLE/GREYED OUT: you cannot just skip it." -ForegroundColor Red
    Write-Host "Stop your recording, enable it, RESTART your PC, then start a new recording" -ForegroundColor Red
    Write-Host "from the beginning." -ForegroundColor Red
    Write-Host ""
    Write-Host "Show ALL of the following on camera:" -ForegroundColor $theme.Header
    Confirm-MultiStep @(
        "Memory Integrity (Core Isolation) is ON.",
        "Kernel-Mode Hardware-enforced Stack Protection is ON.",
        "Microsoft Vulnerable Driver Blocklist is ON."
    )
}

function Step-Hotkeys {
    Section "Recording Software Hotkeys"
    Pause-ForCamera "Open your recorder's hotkey settings and show them."
}

function Step-UnnecessarySoftwareCheck {
    # Tier 1 only. Reminder - nothing to type.
    Section "Unnecessary Hotkey/Mouse Software"
    Write-Host "Close any unnecessary hotkey/mouse software. Anything left open must be justified on camera." -ForegroundColor $theme.Accent
}

function Step-ProxyLock {
    Section "WinHTTP Proxy Lock"
    Enable-ProxyLock
    Write-Host "Proxy lock is ACTIVE - just continue." -ForegroundColor Green
    Write-Host "Keep this window open until your match is over." -ForegroundColor Red
}

function Step-JoinGame {
    Section "Join Game"
    Write-Host "Hold Windows + Tab while your game is loading up. Only one desktop is allowed." -ForegroundColor $theme.Accent
    Read-Host "Once joined and loaded, press Enter to continue"
    Show-DisplayAlertIfAny
}

function Step-DesktopCheck {
    Section "Desktop Check"
    Write-Host "Press Windows + Tab now. Only one desktop is allowed." -ForegroundColor $theme.Accent
    Read-Host "Press Enter once shown"
    Show-DisplayAlertIfAny
}

function Step-TaskManager([switch]$After) {
    Section "Task Manager"
    Start-Process "taskmgr.exe"
    if ($After) {
        Write-Host "Task Manager reopened - show it again, scroll to the VERY BOTTOM." -ForegroundColor Yellow
    } else {
        Write-Host "  1. Right-click the Name column header: enable Process Name AND Command Line." -ForegroundColor White
        Write-Host "  2. Widen Command Line until Disk and Network are OFF screen (CPU + Memory stay visible)." -ForegroundColor White
        Write-Host "  3. View > Expand All, then scroll to the VERY BOTTOM." -ForegroundColor White
    }
    Pause-ForCamera "Show Task Manager configured like this."
}

function Step-PowerShellDump {
    Section "PowerShell Process/System Dump"
    Get-CimInstance Win32_Process | Select-Object Name, ProcessId,
        @{n='SizeMB';e={ Get-SizeMB $_.ExecutablePath }}, CommandLine | Format-Table -AutoSize
    systeminfo | findstr /i "hyper os version page virtualization"
    Write-Host "Show ALL of the following on camera:" -ForegroundColor $theme.Header
    Confirm-MultiStep @(
        "Scroll the process dump above top to bottom, then back up.",
        "The systeminfo output above (Hyper-V / virtualization lines) is visible."
    )
}

function Invoke-BeforeLaunching([switch]$Repeat) {
    Step-TrayIcons
    if ($tier -in @('2','3')) {
        Step-Autoruns
    }
    if ($tier -eq '3') { Step-DeviceManager }
    Step-UAC
    Step-RegeditExclusions
    if ($tier -in @('1','3')) { Step-Folders }
    if ($tier -in @('2','3')) { Step-Malwarebytes -SkipScan:$Repeat }
    Step-CoreIsolation
    if ($tier -in @('2','3')) { Step-Hotkeys }
    if ($tier -eq '1' -and -not $Repeat) { Step-UnnecessarySoftwareCheck }
    Step-ProxyLock
    if ($Repeat) { Step-DesktopCheck } else { Step-JoinGame }
}

function Invoke-AfterLaunching([switch]$Repeat) {
    Step-TaskManager
    if ($tier -eq '1') { Step-PowerShellDump }
}

# =========================================================================
# RUN / MAIN ORCHESTRATION
# =========================================================================
Write-Host "IMPORTANT: START YOUR RECORDING NOW, BEFORE GOING ANY FURTHER." -ForegroundColor Red
Write-Host "This script does not detect your recorder for you - confirm it yourself." -ForegroundColor Red
Write-Host ""
Write-Host "IMPORTANT: MAXIMIZE this PowerShell window now and keep it maximized." -ForegroundColor $theme.Header
if ($tier -in @('2','3')) {
    Write-Host ""
    Write-Host "This will fully delete Roblox and reinstall it, then close every non-essential" -ForegroundColor $theme.Accent
    Write-Host "process once you've joined your match." -ForegroundColor $theme.Accent
    Write-Host ""
    Write-Host "Unsaved work in other apps WILL be lost. Save everything first." -ForegroundColor Red
} else {
    Write-Host ""
    Write-Host "Tier 1 does NOT reinstall Roblox and does NOT close your other apps." -ForegroundColor $theme.Accent
}
Write-Host ""
$confirm = Read-Host "Continue? (Y/N)"
if ($confirm -notmatch '^[Yy]') {
    Write-Host "Cancelled. Nothing was changed." -ForegroundColor Cyan
    return
}

$global:FullChecks = ($tier -ne '1')
if ($PSCommandPath) { $global:RunMethod = "local file $PSCommandPath (sha256 $(Get-FileSha $PSCommandPath))" }
else { $global:RunMethod = 'in memory (not a local file, e.g. irm | iex)' }
try { $q0 = (& fsutil usn queryjournal $env:SystemDrive 2>&1 | Out-String); if ($q0 -match 'Next Usn\s*:\s*(0x[0-9a-fA-F]+|\d+)') { $global:SessionUsn = $matches[1] } } catch {}
if ($global:FullChecks) { Enable-ProcessAudit }
Test-SessionIntegrity
Start-EtwTrace
Start-SessionGuard
Add-TL 'SESSION' "Script started, tier $tier. Process auditing: $global:ProcAuditInfo"
Start-BgForensic 'execution history, Defender, drivers, autoruns, certificates, DMA hardware, process memory' 'artifacts'
Start-BgForensic 'live sampler: CPU, GPU, processes, USB drives, clock, event logs, protections, disguised programs' 'sampler'

try {
    if ($tier -in @('2','3')) { Invoke-ToolCheck }
    Invoke-Prerequisites
    if ($global:AbortRun) { return }
    if ($tier -in @('2','3')) {
        Invoke-RecorderSetup
        Invoke-MalwarebytesVerification
    }

    if (($tier -in @('2','3')) -or $global:StrapRemoved) {
        if ($tier -eq '1') { Write-Host "Strap was removed - the official Roblox must be reinstalled." -ForegroundColor $theme.Accent }
        $ok = Invoke-RobloxReinstall
        if (-not $ok) { return }
        Start-BgForensic 'Roblox install integrity' 'roblox'
        Invoke-FpsUncap
        Section "Please complete the Before Launching steps now."
    } else {
        Write-Host "Tier 1: skipping reinstall. Make sure Roblox is already installed and closed." -ForegroundColor $theme.Accent
    }

    Invoke-BeforeLaunching
    Invoke-AfterLaunching

    if ($tier -in @('2','3')) {
        Invoke-CloseNonEssential
        Show-ReopenWarning
        Step-TaskManager -After
        Invoke-StartCollection
    } else {
        Invoke-AllScans 'TIER1-START'
        Write-Host "A sealed file will be saved when you finish." -ForegroundColor Gray
    }
    Test-SecurityRules 'at the start of the match'
    $global:SnapStart = Get-Snapshot 'START'
    $global:MatchStart = Get-Date
    $global:SamplerCtx.MatchStart = $global:MatchStart
    Add-TL 'MATCH' 'Match window opened (start-of-match snapshot taken)'
    try { (Get-Process -Id $PID).PriorityClass = 'BelowNormal' } catch {}
    Start-MouseWatch

    Write-Host ""
    if ($tier -eq '1') { Write-Host "=== SETUP COMPLETE - YOU MAY NOW PLAY YOUR MATCH ===" -ForegroundColor $theme.Header }
    else { Write-Host "=== START-OF-MATCH FILES SAVED - KEEP PLAYING YOUR MATCH ===" -ForegroundColor $theme.Header }
    Write-Host "Do NOT close this window (the display guard and proxy lock depend on it)." -ForegroundColor Red

    $ready = $null
    while ($ready -notmatch '^\s*done\s*$') {
        $ready = Read-Host "When your match is completely finished, type DONE to start the end-of-match checks"
    }

    $global:MatchEnd = Get-Date
    $global:SamplerCtx.Stop = $true
    try { (Get-Process -Id $PID).PriorityClass = 'Normal' } catch {}
    Add-TL 'MATCH' 'Player typed DONE - match window closed'
    Stop-MouseWatch
    Section "After Match Is Finished"
    Write-Host "Collecting end-of-match data - please wait..." -ForegroundColor Gray
    Test-SecurityRules 'at the end of the match'
    Set-RuleChecked 'Display'; Set-RuleChecked 'Desktop'
    if ($global:FullChecks) { Set-RuleChecked 'AllowedPrograms' }
    Invoke-AllScans 'END-OF-MATCH'
    $global:SnapEnd = Get-Snapshot 'END'
    $endCount = $global:SnapEnd.Displays
    if ($endCount -gt 1) { Add-Finding 'RULE' 'Display' 'More than one display was active when the match ended' "active displays: $endCount" $global:MatchEnd }
    if ($null -ne $global:SnapEnd.VDesk -and $global:SnapEnd.VDesk -gt 1) { Add-Finding 'RULE' 'Desktop' 'More than one virtual desktop existed when the match ended' "virtual desktops: $($global:SnapEnd.VDesk)" $global:MatchEnd }
    if ($null -eq $global:SnapEnd.VDesk) { Add-Note 'Virtual desktop count could not be read from the registry; the one-desktop rule was not measured.'; $global:RuleChecked.Remove('Desktop') }
    Show-DisplayAlertIfAny
    if ($global:FullChecks) { Invoke-EndCollection }
    else { Test-DeviceHistory }
    Invoke-BeforeLaunching -Repeat
    Invoke-AfterLaunching -Repeat

    Section "Removing Proxy Lock"
    netsh winhttp reset proxy
    Write-Host "Proxy lock removed automatically." -ForegroundColor Green
    Start-Sleep -Seconds 2

    Section "Sealing Findings"
    Stop-SessionGuard
    Test-RemovableRuns
    Test-EtwAgainstGuard
    Convert-GuardLog
    Save-FinalPackage
    Write-Host "Findings package sealed: $global:FindingsZip" -ForegroundColor Green
    Write-Host ""
    Write-Host "SHOW THIS ON CAMERA (it proves the files were not edited afterwards):" -ForegroundColor Yellow
    if ($global:StartSealHash) { Write-Host "  START SEAL SHA256 : $global:StartSealHash   (same value as shown before the match)" -ForegroundColor White }
    Write-Host "  ZIP  SHA256       : $global:ZipHash" -ForegroundColor White
    Write-Host "  SEAL SHA256       : $global:SealHash" -ForegroundColor White
    Write-Host "  Sealed at         : $((Get-Date).ToString('yyyy-MM-dd HH:mm:ss'))" -ForegroundColor White
    Write-Host ""
    Read-Host "Press Enter once the values above are shown on your recording"

    if ($tier -in @('2','3')) {
        Section "Uploads"
        $zipDir = Join-Path ([Environment]::GetFolderPath('Desktop')) "AC-FINDINGS"
        if (Test-Path $zipDir) { Start-Process "explorer.exe" -ArgumentList $zipDir }
        Write-Host "Do these IN ORDER while still recording:" -ForegroundColor $theme.Accent
        Write-Host "  1. Upload the ZIP from AC-FINDINGS to 'ow-submissions' (do NOT open or edit it first)." -ForegroundColor White
        Read-Host "Press Enter once the upload is done"
        Write-Host "You may now stop your recording, then upload it to YouTube and post the link in 'ow-submissions'." -ForegroundColor $theme.Header
    } else {
        Write-Host "A sealed file was saved in the AC-FINDINGS folder on your Desktop - keep it, staff may ask for it." -ForegroundColor Gray
        Write-Host "=== TIER 1 CHECKS COMPLETE - YOU MAY NOW STOP YOUR RECORDING ===" -ForegroundColor $theme.Header
    }
}
finally {
    # Always put the player's PC back the way it was, even if the script stops early.
    try { (Get-Process -Id $PID).PriorityClass = 'Normal' } catch {}
    try { $global:SamplerCtx.Stop = $true } catch {}
    try { if ($global:GuardCtl) { Stop-SessionGuard } } catch {}
    try { if ($global:MouseWatchOn) { [void][RecMouse]::Stop() } } catch {}
    try { netsh winhttp reset proxy | Out-Null } catch {}
    try { Restore-ProcessAudit } catch {}
}
