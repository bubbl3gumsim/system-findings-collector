        $names = @([regex]::Matches($txt, '(?i)"(?:threat_?name|detection_?name|malware_?name|vendor_?id|category)"\s*:\s*"([^"]{2,120})"') | ForEach-Object { $_.Groups[1].Value } | Select-Object -Unique -First 12)
        $paths = @([regex]::Matches($txt, '(?i)"(?:file_?path|path|object)"\s*:\s*"([A-Za-z]:\\\\[^"]{3,260})"') | ForEach-Object { ($_.Groups[1].Value -replace '\\\\', '\') } | Select-Object -Unique -First 12)
        if ($names.Count -gt 0 -or $paths.Count -gt 0) {
