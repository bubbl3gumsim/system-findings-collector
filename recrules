# ---- 5. system state and tampering evidence ----
function Get-SystemStateLines {
    $out = @()
    try { $os = Get-CimInstance Win32_OperatingSystem -ErrorAction Stop; $out += "Windows           : $($os.Caption) build $($os.BuildNumber); last boot $($os.LastBootUpTime)" } catch {}
    try { $cs = Get-CimInstance Win32_ComputerSystem -ErrorAction Stop; $out += "Computer          : $($cs.Manufacturer) / $($cs.Model); HypervisorPresent=$($cs.HypervisorPresent)" } catch {}
    try { if (Confirm-SecureBootUEFI -ErrorAction Stop) { $out += 'Secure Boot       : ON' } else { $out += 'Secure Boot       : OFF' } } catch { $out += 'Secure Boot       : state unavailable (legacy BIOS or access denied)' }
    try {
        $dg = Get-CimInstance -ClassName Win32_DeviceGuard -Namespace root\Microsoft\Windows\DeviceGuard -ErrorAction Stop
        $out += "VBS               : status $($dg.VirtualizationBasedSecurityStatus) (2 = running)"
        $out += ("Memory Integrity  : {0}" -f $(if (@($dg.SecurityServicesRunning) -contains 2) { 'RUNNING' } else { 'NOT RUNNING' }))
    } catch { $out += 'Memory Integrity  : state unavailable (Device Guard class could not be read)' }
    try {
        $bl = Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\CI\Config' -Name VulnerableDriverBlocklistEnable -ErrorAction Stop
        $out += "Driver blocklist  : registry VulnerableDriverBlocklistEnable = $($bl.VulnerableDriverBlocklistEnable)"
    } catch { $out += 'Driver blocklist  : registry value not present (Windows default applies)' }
    try { $out += "Process auditing  : $global:ProcAuditInfo" } catch {}
    return $out
}

function Test-SecurityRules([string]$when) {
    try {
        $dg = Get-CimInstance -ClassName Win32_DeviceGuard -Namespace root\Microsoft\Windows\DeviceGuard -ErrorAction Stop
        Set-RuleChecked 'MemoryIntegrity'
        if (@($dg.SecurityServicesRunning) -notcontains 2) { Add-Finding 'RULE' 'MemoryIntegrity' "Memory Integrity (HVCI) was not running ($when)" "SecurityServicesRunning = $(@($dg.SecurityServicesRunning) -join ',')" }
    } catch { Add-Note "Memory Integrity state could not be read ($when)." }
    try {
        Set-RuleChecked 'Blocklist'
        $bl = Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\CI\Config' -Name VulnerableDriverBlocklistEnable -ErrorAction Stop
        if ($bl.VulnerableDriverBlocklistEnable -eq 0) { Add-Finding 'RULE' 'Blocklist' "Vulnerable driver blocklist is switched off in the registry ($when)" 'VulnerableDriverBlocklistEnable = 0' }
    } catch {}
}

function Get-TimeChangeFacts([int]$days = 3) {
    $seen = @{}
    try {
        foreach ($e in @(Get-WinEvent -FilterHashtable @{ LogName = 'System'; ProviderName = 'Microsoft-Windows-Kernel-General'; Id = 1; StartTime = (Get-Date).AddDays(-$days) } -ErrorAction Stop)) {
            try {
                $x = [xml]$e.ToXml(); $d = @{}
                foreach ($n in $x.Event.EventData.Data) { $d[$n.Name] = $n.'#text' }
                $new = [datetime]::Parse($d['NewTime'], [Globalization.CultureInfo]::InvariantCulture, [Globalization.DateTimeStyles]::RoundtripKind).ToLocalTime()
                $old = [datetime]::Parse($d['OldTime'], [Globalization.CultureInfo]::InvariantCulture, [Globalization.DateTimeStyles]::RoundtripKind).ToLocalTime()
                $delta = [math]::Round(($new - $old).TotalSeconds)
                if ([math]::Abs($delta) -ge 60) {
                    $k = $new.ToString('yyyyMMddHHmm')
                    if (-not $seen.ContainsKey($k)) { $seen[$k] = $true
                        Add-Finding 'CHECK' 'Tampering evidence' 'System clock moved by 60 seconds or more (Kernel-General event 1)' ("{0}s: from {1} to {2}" -f $delta, $old.ToString('yyyy-MM-dd HH:mm:ss'), $new.ToString('yyyy-MM-dd HH:mm:ss')) $e.TimeCreated }
                }
            } catch {}
        }
    } catch {}
    try {
        foreach ($e in @(Get-WinEvent -FilterHashtable @{ LogName = 'Security'; Id = 4616; StartTime = (Get-Date).AddDays(-$days) } -ErrorAction Stop)) {
            try {
                $x = [xml]$e.ToXml(); $d = @{}
                foreach ($n in $x.Event.EventData.Data) { $d[$n.Name] = $n.'#text' }
                $new = [datetime]::Parse($d['NewTime'], [Globalization.CultureInfo]::InvariantCulture, [Globalization.DateTimeStyles]::RoundtripKind).ToLocalTime()
                $old = [datetime]::Parse($d['PreviousTime'], [Globalization.CultureInfo]::InvariantCulture, [Globalization.DateTimeStyles]::RoundtripKind).ToLocalTime()
                $delta = [math]::Round(($new - $old).TotalSeconds)
                $k = $new.ToString('yyyyMMddHHmm')
                if ([math]::Abs($delta) -ge 60 -and -not $seen.ContainsKey($k)) { $seen[$k] = $true
                    Add-Finding 'CHECK' 'Tampering evidence' 'System clock moved by 60 seconds or more (Security event 4616)' ("{0}s by {1}: from {2} to {3}" -f $delta, $d['ProcessName'], $old.ToString('yyyy-MM-dd HH:mm:ss'), $new.ToString('yyyy-MM-dd HH:mm:ss')) $e.TimeCreated }
            } catch {}
        }
    } catch {}
}

function Get-LogClearFacts([datetime]$since) {
    foreach ($spec in @(@('Security', 1102), @('System', 104))) {
        try {
            foreach ($e in @(Get-WinEvent -FilterHashtable @{ LogName = $spec[0]; Id = $spec[1]; StartTime = $since } -MaxEvents 10 -ErrorAction Stop)) {
                $who = ''; $chan = $spec[0]
                try { $x = [xml]$e.ToXml(); $u = $x.Event.UserData.LogFileCleared; if ($u.SubjectUserName) { $who = " by $($u.SubjectUserName)" }; if ($u.Channel) { $chan = $u.Channel } } catch {}
                Add-Finding 'CHECK' 'Tampering evidence' "Windows event log '$chan' was cleared" ("at {0}{1} (event {2} in the {3} log)" -f $e.TimeCreated, $who, $spec[1], $spec[0]) $e.TimeCreated
            }
        } catch {}
    }
}

function Scan-Tamper([string]$label = 'SCAN') {
    $pfDir = "$env:WINDIR\Prefetch"
    try {
        $en = (Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters' -ErrorAction Stop).EnablePrefetcher
        if ($en -eq 0) { Add-Finding 'CHECK' 'Tampering evidence' 'Prefetch is switched off in the registry' 'EnablePrefetcher = 0' }
    } catch {}
    try {
        $sm = Get-Service SysMain -ErrorAction Stop
        if ($sm.Status -ne 'Running') { Add-Finding 'CHECK' 'Tampering evidence' 'The SysMain (Prefetch) service is not running' "status $($sm.Status), start type $($sm.StartType)" }
    } catch {}
    try {
        $pf = @(Get-ChildItem $pfDir -Filter *.pf -ErrorAction Stop)
        Add-TL 'PREFETCH' ("Prefetch folder holds {0} files at this moment" -f $pf.Count)
        if ($pf.Count -eq 0) { Add-Finding 'CHECK' 'Tampering evidence' 'The Prefetch folder is empty' $pfDir }
        foreach ($f in ($pf | Where-Object { ($_.Name -replace '\.exe-.*$', '') -match $global:ToolStrongRx })) {
            Add-Finding 'CHECK' 'Software' 'Prefetch records a run of a program on the tool-name list' "$($f.Name) last run $($f.LastWriteTime)"
        }
    } catch { Add-Finding 'CHECK' 'Tampering evidence' 'The Prefetch folder could not be read' $pfDir }
    Get-LogClearFacts (Get-Date).AddDays(-14)
    Get-TimeChangeFacts 3
    try {
        $out = (& fsutil usn queryjournal $env:SystemDrive 2>&1 | Out-String)
        if ($out -match '(?i)not active|not found|error') { Add-Finding 'CHECK' 'Tampering evidence' 'The USN change journal is not active or could not be queried' ($out.Trim() -replace '\s+', ' ') }
    } catch {}
    try {
        $bcd = (& bcdedit /enum '{current}' 2>&1 | Out-String)
        if ($bcd -match '(?i)testsigning\s+Yes') { Add-Finding 'CHECK' 'System state' 'A Windows boot option differs from the default' 'bcdedit: testsigning Yes' }
        if ($bcd -match '(?i)nointegritychecks\s+Yes') { Add-Finding 'CHECK' 'System state' 'A Windows boot option differs from the default' 'bcdedit: nointegritychecks Yes' }
        if ($bcd -match '(?im)^\s*debug\s+Yes') { Add-Finding 'CHECK' 'System state' 'A Windows boot option differs from the default' 'bcdedit: debug Yes' }
    } catch {}
    try {
        $mp = Get-MpPreference -ErrorAction Stop
        foreach ($x in @($mp.ExclusionPath) + @($mp.ExclusionProcess) + @($mp.ExclusionExtension)) { if ($x) { Add-Finding 'CHECK' 'Windows Defender' 'A Defender exclusion is configured' $x } }
        if ($mp.DisableRealtimeMonitoring) { Add-Finding 'CHECK' 'Windows Defender' 'Defender real-time protection is off' 'DisableRealtimeMonitoring = True' }
    } catch { Add-Note 'Defender settings could not be read (Get-MpPreference failed).' }
    try {
        $cs = Get-CimInstance Win32_ComputerSystem -ErrorAction Stop
        if ($cs.Model -match '(?i)(virtual|vmware|virtualbox|kvm|qemu|hyper-v)' -or $cs.Manufacturer -match '(?i)(vmware|qemu|xen|innotek|parallels)') {
            Add-Finding 'CHECK' 'System state' 'The computer reports itself as a virtual machine' "$($cs.Manufacturer) / $($cs.Model)"
        }
    } catch {}
    try {
        foreach ($d in (Get-CimInstance Win32_SystemDriver -ErrorAction Stop | Where-Object { $_.State -eq 'Running' })) {
            $p = Normalize-Path $d.PathName
            if ($p -and $p -notmatch '^[a-zA-Z]:\\') { if ($p -match '^(?i)system32\\') { $p = "$env:WINDIR\$p" } }
            $base = [IO.Path]::GetFileNameWithoutExtension([string]$p)
            if ($p -and (Test-Path -LiteralPath $p)) {
                $sig = Get-SigInfo $p
                if ($sig.Status -notin @('Valid')) { Add-Finding 'CHECK' 'Drivers' 'A loaded driver file has no valid signature' "$($d.Name) $p (status $($sig.Status))" }
                if (Test-UserWritablePath $p) { Add-Finding 'CHECK' 'Drivers' 'A loaded driver file is in a user-writable folder' "$($d.Name) $p" }
            }
        }
        foreach ($s in (Get-CimInstance Win32_Service -ErrorAction Stop | Where-Object { $_.PathName -match '(?i)(\\temp\\|\\downloads\\|\\appdata\\|\\users\\public\\)' })) {
            Add-Finding 'CHECK' 'Software' 'A Windows service runs a program from a user/temp folder' "$($s.Name): $($s.PathName)"
        }
    } catch {}
}

