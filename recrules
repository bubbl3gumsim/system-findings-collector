# Kernel pseudo-processes: they have no file on disk, so they have no path.
$global:PseudoProcs = @('system','idle','registry','memory compression','secure system','vmmem','vmmemwsl','system idle process')

function Get-ProcVerdict([string]$name, [string]$path) {
    $n = ($name -replace '\.exe$', '').ToLower()
    $v = [PSCustomObject]@{ Class = 'Untrusted'; Trusted = $false; Spare = $false; Reason = ''; Impersonation = $false; Unverifiable = $false }

    if (-not $path) {
        if ($global:PseudoProcs -contains $n) { $v.Class = 'Windows'; $v.Trusted = $true; $v.Spare = $true; $v.Reason = 'kernel pseudo-process'; return $v }
        foreach ($r in $global:TrustRules) {
            if ($n -match $r.Names -and $r.Class -eq 'Windows') {
                # Windows could not tell us the path (protected process). Never close these.
                $v.Class = 'Windows'; $v.Spare = $true; $v.Unverifiable = $true
                $v.Reason = 'core Windows name but path could not be read'; return $v
            }
        }
        $v.Reason = 'path could not be read'; return $v
    }

    $sig = Get-SigInfo $path
    $nameHit = $false
    foreach ($r in $global:TrustRules) {
        if ($n -notmatch $r.Names) { continue }
        $nameHit = $true
        $pathOk = ($path -match $r.Path)
        $sigOk  = ($sig.Status -eq 'Valid' -and $sig.Publisher -and ($sig.Publisher -match $r.Pub))
        if (-not $sigOk -and $r.AllowUnsigned -and $sig.Status -eq 'NotSigned') { $sigOk = $true }
        if ($pathOk -and $sigOk) {
            $v.Class = $r.Class; $v.Trusted = $true; $v.Spare = [bool]$r.Spare
            $v.Reason = "name + folder + signature all match ($($r.Class))"; return $v
        }
        $why = @()
        if (-not $pathOk) { $why += 'wrong folder' }
        if (-not $sigOk)  { $why += "signature is '$($sig.Status)' / wrong publisher" }
        $v.Class = 'Impersonation'; $v.Impersonation = $true
        $v.Reason = "named like $($r.Class) but " + ($why -join ' and ')
        return $v
    }
    # Any other Microsoft-signed program that lives in the Windows folders is trusted (but never exempted from cleanup).
    if ($path -match '(?i)^[a-z]:\\windows\\|\\windowsapps\\microsoft\.|\\program files( \(x86\))?\\(windowsapps|microsoft)\\' -and $sig.Status -eq 'Valid' -and $sig.Publisher -match 'Microsoft') {
        $v.Class = 'MicrosoftOther'; $v.Trusted = $true; $v.Reason = 'Microsoft-signed program in a Windows folder'; return $v
    }
    $v.Reason = 'not on the allowed list'
    return $v
}

# Levenshtein distance - catches look-alike names such as svch0st / expl0rer
function Get-EditDistance([string]$a, [string]$b) {
    # two-row version (no 2D arrays, works in Windows PowerShell 5.1)
    $m = $a.Length; $n = $b.Length
    if ($m -eq 0) { return $n }
    if ($n -eq 0) { return $m }
    $prev = New-Object 'int[]' ($n + 1)
    $cur  = New-Object 'int[]' ($n + 1)
    for ($j = 0; $j -le $n; $j++) { $prev[$j] = $j }
    for ($i = 1; $i -le $m; $i++) {
        $cur[0] = $i
        for ($j = 1; $j -le $n; $j++) {
            $cost = 1
            if ($a[$i - 1] -eq $b[$j - 1]) { $cost = 0 }
            $del = $prev[$j] + 1
            $ins = $cur[$j - 1] + 1
            $sub = $prev[$j - 1] + $cost
            $best = $del
            if ($ins -lt $best) { $best = $ins }
            if ($sub -lt $best) { $best = $sub }
            $cur[$j] = $best
        }
        $tmp = $prev; $prev = $cur; $cur = $tmp
    }
    return $prev[$n]
}
$global:LookalikeTargets = @('svchost','csrss','lsass','smss','wininit','winlogon','services','explorer','taskhostw','runtimebroker','conhost','dllhost','spoolsv','fontdrvhost','taskmgr','powershell','robloxplayerbeta','robloxplayerlauncher','discord','chrome','msedge','obs64','nvcontainer','mbamservice','audiodg','dwm','sihost','ctfmon','searchindexer','wmiprvse','msmpeng')

function Get-LookalikeOf([string]$name) {
    $n = ($name -replace '\.exe$', '').ToLower()
    if ($n.Length -lt 3) { return $null }
    if ($global:LookalikeTargets -contains $n) { return $null }
    foreach ($t in $global:LookalikeTargets) {
        if ([Math]::Abs($t.Length - $n.Length) -gt 1) { continue }
        $dist = Get-EditDistance $n $t
        if ($dist -le 1 -and $t.Length -ge 5) { return $t }
        if ($dist -le 2 -and $t.Length -ge 8) { return $t }
    }
    return $null
}

