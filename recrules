# Running programs outside the Windows folder: { Pid, Name, Path }
function FProcs {
    $o = @()
    try {
        foreach ($p in @(Get-CimInstance Win32_Process -ErrorAction Stop)) {
            if ($p.ProcessId -le 4 -or $p.ProcessId -eq $PID) { continue }
            $path = [string]$p.ExecutablePath
            if (-not $path -or $path -match '(?i)^[a-z]:\\windows\\') { continue }
            $o += [PSCustomObject]@{ Pid = [int]$p.ProcessId; Name = [string]$p.Name; Path = $path }
        }
    } catch {}
    return $o
}

# ---- 4. USB history: hobby microcontroller boards (used to fake mouse input), even if unplugged ----
function FScanUsbVendors {
    $root = $null; try { $root = [Microsoft.Win32.Registry]::LocalMachine.OpenSubKey('SYSTEM\CurrentControlSet\Enum\USB') } catch {}
    if (-not $root) { return }
    $n = 0
    foreach ($dn in $root.GetSubKeyNames()) {
        if ($dn -notmatch '^VID_([0-9A-Fa-f]{4})&PID_([0-9A-Fa-f]{4})') { continue }
        $n++; $vid = $matches[1].ToUpper()
        if (-not $global:FMcuVid.ContainsKey($vid)) { continue }
        $dk = $root.OpenSubKey($dn)
        foreach ($inst in $dk.GetSubKeyNames()) {
            $ik = $dk.OpenSubKey($inst); if (-not $ik) { continue }
            $desc = ([string]$ik.GetValue('DeviceDesc') -split ';')[-1]
            $arr = $null; $rem = $null
            try {
                $pk = $ik.OpenSubKey('Properties\{83da6326-97a6-4088-9453-a1923f573b29}')
                if ($pk) {
                    $sk = $pk.OpenSubKey('0066'); if ($sk) { $arr = FFileTime ([byte[]]$sk.GetValue('')) 0 }
                    $sk = $pk.OpenSubKey('0067'); if ($sk) { $rem = FFileTime ([byte[]]$sk.GetValue('')) 0 }
                }
            } catch {}
            FCheckU 'Hardware' 'A USB device from a Microcontroller / hobby-board vendor is in the device history (such boards can fake mouse or keyboard input)' ("{0} [{1}\{2}]; vendor {3}; last connected {4}; last removed {5}" -f $desc, $dn, $inst, $global:FMcuVid[$vid], $(if ($arr) { $arr.ToString('yyyy-MM-dd HH:mm') } else { 'unknown' }), $(if ($rem) { $rem.ToString('yyyy-MM-dd HH:mm') } else { 'unknown' })) $arr
        }
    }
    FNote ("USB device history: {0} USB device type(s) in the registry were checked against hobby-board vendor IDs." -f $n)
}

# ---- 6. renamed / disguised programs: built-in name and publisher versus file name and signer ----
function FScanVersionInfo {
    $claims = '(?i)(microsoft|nvidia|intel|advanced micro devices|realtek|google|valve|discord|roblox)'
    $strong = $global:FCtx.ToolStrongRx; $weak = $global:FCtx.ToolWeakRx; $n = 0
    foreach ($p in @(FProcs)) {
        $vi = $null; try { $vi = [System.Diagnostics.FileVersionInfo]::GetVersionInfo($p.Path) } catch { continue }
        $n++
        $leaf = (FBase $p.Path).ToLower()
        $orig = ''; if ($vi.OriginalFilename) { $orig = (FBase ([string]$vi.OriginalFilename)).ToLower() }
        $prod = [string]$vi.ProductName
        if ($strong -and (($orig -and $orig -ne $leaf -and ($orig -match $strong -or $orig -match $weak)) -or ($prod -and $prod -match $strong -and $leaf -notmatch $strong))) {
            FCheckU 'Software' 'A program was renamed: its built-in original name or product name is on the cheat/tool-name list but its file name is not' ("{0} (PID {1}) {2}; file name '{3}', built-in original name '{4}', product '{5}'" -f $p.Name, $p.Pid, $p.Path, $leaf, $orig, $prod)
        }
        $m = [regex]::Match([string]$vi.CompanyName, $claims)
        if ($m.Success) {
            $sig = FSig $p.Path
            if ($sig.Status -ne 'Valid') { FCheckU 'Software' 'A program claims a well-known publisher in its file properties but has no valid signature (disguised program indicator)' ("{0} (PID {1}) {2}; claims '{3}'; signature {4}" -f $p.Name, $p.Pid, $p.Path, $vi.CompanyName, $sig.Status) }
            elseif ($sig.Subject -notmatch [regex]::Escape($m.Value)) { FCheckU 'Software' 'A program claims a well-known publisher in its file properties but is signed by someone else (disguised program indicator)' ("{0} (PID {1}) {2}; claims '{3}'; signed by '{4}'" -f $p.Name, $p.Pid, $p.Path, $vi.CompanyName, $sig.Cn) }
        }
    }
    FNote ("Disguise check: file properties of {0} running program(s) compared with their file names and signers." -f $n)
}

# ---- 7. capability scan: which Windows functions does a program import? ----
function FPeImports([string]$path) {
    $names = New-Object System.Collections.ArrayList
    $fs = $null
    try {
        $fs = [System.IO.File]::Open($path, 'Open', 'Read', 'ReadWrite')
        if ($fs.Length -lt 1024 -or $fs.Length -gt 120MB) { return @() }
        $br = New-Object System.IO.BinaryReader($fs)
        $fs.Position = 0x3C; $pe = $br.ReadInt32()
        if ($pe -lt 0 -or $pe -gt $fs.Length - 512) { return @() }
        $fs.Position = $pe; if ($br.ReadUInt32() -ne 0x4550) { return @() }
        $fs.Position = $pe + 6; $ns = [int]$br.ReadUInt16()
        $fs.Position = $pe + 20; $osz = [int]$br.ReadUInt16()
        $opt = $pe + 24; $fs.Position = $opt; $magic = $br.ReadUInt16()
        $is64 = ($magic -eq 0x20B)
        $dd = $(if ($is64) { $opt + 112 } else { $opt + 96 })
        $fs.Position = $dd + 8; $impRva = [long]$br.ReadUInt32()
        if ($impRva -eq 0 -or $ns -gt 96) { return @() }
        $secs = New-Object System.Collections.ArrayList; $sb = $opt + $osz
        for ($i = 0; $i -lt $ns; $i++) {
            $fs.Position = $sb + 40 * $i + 8
            $vs = [long]$br.ReadUInt32(); $va = [long]$br.ReadUInt32(); $rs = [long]$br.ReadUInt32(); $rp = [long]$br.ReadUInt32()
            [void]$secs.Add(@($va, [math]::Max($vs, $rs), $rp))
        }
        $toOff = { param([long]$r) foreach ($s in $secs) { if ($r -ge $s[0] -and $r -lt ($s[0] + $s[1])) { return [long]($r - $s[0] + $s[2]) } }; return [long]-1 }
        $d = & $toOff $impRva; if ($d -lt 0) { return @() }
        $esz = $(if ($is64) { 8 } else { 4 }); $hi = $(if ($is64) { [uint64]9223372036854775808 } else { [uint64]2147483648 })
        for ($k = 0; $k -lt 300; $k++) {
            $fs.Position = $d + 20 * $k
            $oft = [long]$br.ReadUInt32(); [void]$br.ReadUInt32(); [void]$br.ReadUInt32(); $nameRva = [long]$br.ReadUInt32(); $ft = [long]$br.ReadUInt32()
            if ($nameRva -eq 0 -and $ft -eq 0) { break }
            $tr = $(if ($oft -ne 0) { $oft } else { $ft }); $to = & $toOff $tr; if ($to -lt 0) { continue }
            for ($j = 0; $j -lt 2000; $j++) {
                $fs.Position = $to + $esz * $j
                $v = $(if ($is64) { $br.ReadUInt64() } else { [uint64]$br.ReadUInt32() })
                if ($v -eq 0) { break }
                if ($v -band $hi) { continue }
                $no = & $toOff ([long]$v); if ($no -lt 0) { continue }
                $fs.Position = $no + 2
                $sbd = New-Object System.Text.StringBuilder
                for ($c = 0; $c -lt 80; $c++) { $b = $fs.ReadByte(); if ($b -le 0) { break }; [void]$sbd.Append([char]$b) }
                [void]$names.Add($sbd.ToString().ToLower())
                if ($names.Count -gt 6000) { return @($names) }
            }
        }
    } catch {} finally { if ($fs) { $fs.Dispose() } }
    return @($names)
}

function FScanImports {
    $seen = @{}; $n = 0
    foreach ($p in @(FProcs)) {
        $k = $p.Path.ToLower(); if ($seen.ContainsKey($k)) { continue }; $seen[$k] = 1
        if ($n -ge 70) { break }
        $sig = FSig $p.Path
        if ($sig.Status -eq 'Valid' -and $sig.Subject -match $global:FTrustedSignerRx) { continue }
        $imp = @(FPeImports $p.Path); if ($imp.Count -eq 0) { continue }
        $n++
        $set = @{}; foreach ($i in $imp) { $set[$i] = 1 }
        $rw = @('readprocessmemory', 'writeprocessmemory', 'ntreadvirtualmemory', 'ntwritevirtualmemory', 'zwreadvirtualmemory', 'zwwritevirtualmemory', 'createremotethread', 'createremotethreadex') | Where-Object { $set.ContainsKey($_) }
        $op = @('openprocess', 'ntopenprocess', 'zwopenprocess') | Where-Object { $set.ContainsKey($_) }
        if (@($rw).Count -gt 0 -and @($op).Count -gt 0) {
            $extra = @('setlayeredwindowattributes', 'dwmextendframeintoclientarea', 'getasynckeystate', 'mouse_event', 'sendinput') | Where-Object { $set.ContainsKey($_) }
            $t = $(if ($sig.Status -eq 'Valid') { 'A running third-party program imports functions that read or write another program''s memory (capability only; debuggers, anti-cheat and some game tools do this legitimately)' } else { 'A running program with no valid signature imports functions that read or write another program''s memory (capability only)' })
            FCheckU 'Software' $t ("{0} (PID {1}) {2}; signature {3}{4}; imports: {5}{6}" -f $p.Name, $p.Pid, $p.Path, $sig.Status, $(if ($sig.Cn) { " ($($sig.Cn))" } else { '' }), (@($rw) + @($op) -join ', '), $(if (@($extra).Count) { "; also: " + (@($extra) -join ', ') } else { '' }))
        }
    }
    FNote ("Capability check: import tables of {0} third-party program(s) read." -f $n)
}

# ---- 8. unsigned DLL from a user-writable folder inside a validly signed program ----
function FScanSideload {
    $t0 = Get-Date; $n = 0
    foreach ($p in @(FProcs | Select-Object -First 80)) {
        if (((Get-Date) - $t0).TotalSeconds -gt 90) { FNote 'DLL sideload sweep stopped after 90 seconds.'; break }
        if ($global:FCtx.Sync -and $global:FCtx.Sync.Stop) { break }
        $ps = FSig $p.Path; if ($ps.Status -ne 'Valid') { continue }
        $mods = @(); try { $mods = @((Get-Process -Id $p.Pid -ErrorAction Stop).Modules) } catch { continue }
        $n++; $hits = 0
        foreach ($m in $mods) {
            $mp = [string]$m.FileName
            if (($mp -notmatch $global:FUserRx -and $mp -notmatch '(?i)^[a-z]:\\programdata\\') -or $mp -match '(?i)\.node$') { continue }
            $ms = FSig $mp
            if ($ms.Status -ne 'Valid' -and $hits -lt 3) { $hits++; FCheckU 'Software' 'An unsigned DLL from a user-writable folder is loaded inside a validly signed program (DLL sideloading indicator)' ("{0} (PID {1}, signed by {2}) loads {3}; DLL signature {4}" -f $p.Name, $p.Pid, $ps.Cn, $mp, $ms.Status) }
        }
    }
    FNote ("Sideload check: modules of {0} signed program(s) inspected." -f $n)
}

# ---- 9. certificate quality of running signed programs (revocation, brand-new certificates) ----
function FScanCertQuality {
    $seen = @{}; $n = 0
    foreach ($p in @(FProcs)) {
        $k = $p.Path.ToLower(); if ($seen.ContainsKey($k)) { continue }; $seen[$k] = 1
        if ($n -ge 30 -or ($global:FCtx.Sync -and $global:FCtx.Sync.Stop)) { break }
        $s = $null; try { $s = Get-AuthenticodeSignature -LiteralPath $p.Path -ErrorAction Stop } catch { continue }
        if (-not $s.SignerCertificate -or [string]$s.Status -ne 'Valid') { continue }
        $n++; $c = $s.SignerCertificate; $who = ($c.Subject -split ',')[0]
        if ($c.NotBefore -gt (Get-Date).AddDays(-30)) { FCheckU 'Software' 'A running program is signed with a recently issued certificate (issued in the last 30 days)' ("{0} (PID {1}) {2}; {3}; certificate issued {4}" -f $p.Name, $p.Pid, $p.Path, $who, $c.NotBefore.ToString('yyyy-MM-dd')) }
        try {
            $ch = New-Object System.Security.Cryptography.X509Certificates.X509Chain
            $ch.ChainPolicy.RevocationMode = 'Online'; $ch.ChainPolicy.RevocationFlag = 'ExcludeRoot'; $ch.ChainPolicy.UrlRetrievalTimeout = [TimeSpan]::FromSeconds(4)
            [void]$ch.Build($c)
            if (@($ch.ChainStatus | Where-Object { [string]$_.Status -match 'Revoked' }).Count -gt 0) { FCheckU 'Software' 'A running program is signed with a REVOKED certificate' ("{0} (PID {1}) {2}; {3}" -f $p.Name, $p.Pid, $p.Path, $who) }
        } catch {}
    }
    FNote ("Certificate check: {0} signed program(s) checked for revocation and certificate age (needs internet for revocation)." -f $n)
}

# ---- 10. remote-control tools ----
function FScanRemoteTools {
    $rx = '(?i)^(anydesk|teamviewer(_service)?|tv_w32|tv_x64|parsecd?|rustdesk|ultraviewer.*|splashtop.*|sunloginclient|todesk|chromoting|remoting_host|vncserver|winvnc|tvnserver|ammyy.*|supremo|screenconnect.*|dwagent|radmin|rutserv|logmein.*|gotomypc.*|moonlight|sunshine|rdpclip)$'
