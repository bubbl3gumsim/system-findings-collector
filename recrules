            if ($s.SignerCertificate) {
                $sub = [string]$s.SignerCertificate.Subject; $th = [string]$s.SignerCertificate.Thumbprint
                if ($sub -match 'CN="?([^",]+)') { $cn = $matches[1].Trim() }
                if ($s.SignerCertificate.Subject -eq $s.SignerCertificate.Issuer) { $self = $true }
            }
            $r = [PSCustomObject]@{ Status = [string]$s.Status; Cn = $cn; Self = $self; Thumb = $th; Subject = $sub }
        }
    } catch { $r = [PSCustomObject]@{ Status = 'Unreadable'; Cn = $null; Self = $false; Thumb = $null; Subject = $null } }
