Clear-Host

$banner = @"
    _    ____    ____  _____ ____ ___  ____  ____ ___ _   _  ____
   / \  / ___|  |  _ \| ____/ ___/ _ \|  _ \|  _ \_ _| \ | |/ ___|
  / _ \| |      | |_) |  _|| |  | | | | |_) | | | | ||  \| | |  _
 / ___ \ |___   |  _ <| |__| |__| |_| |  _ <| |_| | || |\  | |_| |
/_/   \_\____|  |_| \_\_____\____\___/|_| \_\____/___|_| \_|\____|

              R  U  L  E  S
"@
Write-Host $banner -ForegroundColor Yellow
Write-Host ""
Write-Host "  Roblox Clean Reinstall" -ForegroundColor DarkYellow
Write-Host "  ------------------------------------------------------------" -ForegroundColor DarkGray
Write-Host ""

Write-Host "This will fully delete Roblox and its saved data from this PC, then download and run a fresh installer." -ForegroundColor Yellow
Write-Host "This includes local settings/cache under the Roblox folder - it does NOT touch your Roblox account or anything saved to Roblox's servers." -ForegroundColor Yellow
Write-Host ""
Write-Host "IMPORTANT:" -ForegroundColor Red
Write-Host "This will reset your FPS cap and reset your sensitivity." -ForegroundColor Red
Write-Host "If you want to uncap your FPS, go to C:\Users\<you>\AppData\Local\Roblox," -ForegroundColor Red
Write-Host "open GlobalBasicSettings_13 with Notepad, and edit:" -ForegroundColor Red
Write-Host "    <int name=`"FramerateCap`">-1</int>" -ForegroundColor Red
Write-Host "(This is the ONLY permissible change that is allowed.)" -ForegroundColor Red
Write-Host ""

$confirm = Read-Host "Continue? (Y/N)"

if ($confirm -notmatch '^[Yy]') {
    Write-Host "Cancelled. Nothing was deleted." -ForegroundColor Cyan
    return
}

# Kill any running Roblox processes and give handles time to release
$robloxProcs = Get-Process RobloxPlayerBeta, RobloxPlayerLauncher, RobloxCrashHandler -ErrorAction SilentlyContinue
if ($robloxProcs) {
    Write-Host "Closing Roblox..." -ForegroundColor Cyan
    $robloxProcs | Stop-Process -Force
    $robloxProcs | Wait-Process -Timeout 10 -ErrorAction SilentlyContinue
    Start-Sleep -Seconds 1
} else {
    Write-Host "Roblox is not currently running." -ForegroundColor Gray
}

# Remove the whole Roblox client folder for a clean reinstall (with retry in case a handle is still closing)
$robloxPath = "$env:LOCALAPPDATA\Roblox"
if (Test-Path $robloxPath) {
    $maxAttempts = 3
    $deleted = $false
    for ($attempt = 1; $attempt -le $maxAttempts -and -not $deleted; $attempt++) {
        try {
            Remove-Item $robloxPath -Recurse -Force -ErrorAction Stop
            $deleted = $true
            Write-Host "Removed: $robloxPath" -ForegroundColor Green
        } catch {
            if ($attempt -lt $maxAttempts) {
                Write-Host "Folder still in use, retrying in 2s... (attempt $attempt/$maxAttempts)" -ForegroundColor Yellow
                Start-Sleep -Seconds 2
            } else {
                Write-Host "Could not fully delete $robloxPath : $_" -ForegroundColor Red
                Write-Host "Try closing Roblox manually and re-running this script." -ForegroundColor Red
            }
        }
    }
} else {
    Write-Host "Roblox folder not found at $robloxPath" -ForegroundColor Gray
}

# Download the installer directly (instead of opening a browser tab)
$installerUrl = "https://www.roblox.com/download/client?os=win&renderingPlatform=nextjs"
$installerPath = Join-Path $env:TEMP "RobloxPlayerInstaller.exe"

Write-Host "Downloading installer..." -ForegroundColor Cyan
try {
    Invoke-WebRequest -Uri $installerUrl -OutFile $installerPath -UseBasicParsing
    Write-Host "Downloaded to: $installerPath" -ForegroundColor Green

    Write-Host "Launching installer..." -ForegroundColor Cyan
    Start-Process -FilePath $installerPath
} catch {
    Write-Host "Download failed: $_" -ForegroundColor Red
    Write-Host "Falling back to opening the download page in your browser." -ForegroundColor Yellow
    Start-Process "https://www.roblox.com/download"
}
